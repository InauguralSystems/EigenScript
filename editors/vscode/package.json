{
  "name": "eigenscript",
  "displayName": "EigenScript",
  "description": "EigenScript language support (.eigs): syntax highlighting plus the eigenlsp language server — diagnostics, symbols, hover, go-to-definition, rename — and the eigsdap tape debugger (step back / reverse continue over a recorded trace tape).",
  "version": "0.14.0",
  "publisher": "inauguralsystems",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/InauguralSystems/EigenScript",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:eigenscript", "onDebugResolve:eigenscript-tape"],
  "contributes": {
    "languages": [
      {
        "id": "eigenscript",
        "aliases": ["EigenScript", "eigenscript"],
        "extensions": [".eigs"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "eigenscript",
        "scopeName": "source.eigenscript",
        "path": "./syntaxes/eigenscript.tmLanguage.json"
      }
    ],
    "breakpoints": [{ "language": "eigenscript" }],
    "debuggers": [
      {
        "type": "eigenscript-tape",
        "label": "EigenScript Tape (time-travel over a recorded trace)",
        "languages": ["eigenscript"],
        "configurationAttributes": {
          "launch": {
            "required": ["tape"],
            "properties": {
              "tape": {
                "type": "string",
                "description": "Path to a recorded trace tape (EIGS_TRACE=run.tape eigenscript prog.eigs). A tape is valid only for the EigenScript version that recorded it."
              },
              "source": {
                "type": "string",
                "description": "Path to the .eigs source the tape was recorded from (enables source highlighting)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "eigenscript-tape",
            "request": "launch",
            "name": "Step a recorded tape",
            "tape": "${workspaceFolder}/run.tape",
            "source": "${file}"
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
