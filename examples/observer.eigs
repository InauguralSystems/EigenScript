# Observer Semantics in EigenScript
# Numeric bindings track their value, exact-aware displacement and observation age.
# Non-numeric bindings retain entropy and entropy change.
# The runtime watches how values change over time.

# Assign a value and update it several times
x is 10.0
x is 8.0
x is 6.0
x is 4.0
x is 2.0

# Numeric observe returns [status, value, displacement, previous displacement].
# The displacement entries are null until their corresponding steps exist.
state is observe of x
print of ("Observer state: " + (str of state))

# report returns the status as a string
status is report of x
print of ("Status: " + status)

# The observer classifies value trajectories:
#   "improving"   — a significant new running lower best within the last ten steps
#   "diverging"   — non-vanishing same-direction displacement
#   "stable"      — a full window fits the 1% band about its midrange
#   "equilibrium" — a settled window without persistent one-direction motion
#   "oscillating" — alternating or folding value motion
#   "converged"   — a full window's diameter fits the settled tolerance
# Predicates can overlap; report keeps its documented priority order.

# A repeated value; three assignments still leave the full window incomplete.
y is 5.0
y is 5.0
y is 5.0
print of ("Stable: " + (report of y))

# This is the foundation of selective observation:
# the runtime can tell you which values are still changing
# and which have settled, without you asking explicitly.
