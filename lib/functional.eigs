# ============================================================
# Functional Library — composition and higher-order utilities
# ============================================================
#
# How to use:
#   load_file of "lib/functional.eigs"
#
#   composed is compose of [f, g]           # f(g(x))
#   chain of [[f, g, h], value]             # h(g(f(value)))
#   applied is apply_all of [[f, g, h], x]  # [f(x), g(x), h(x)]
#   identity of x                           # x
#   constantly of 42                        # 42 (sentinel/default pattern)
#   complement of [pred, value]             # boolean negation of pred(value)
#   times of [5, fn]                        # call fn(i) for i in 0..4

# ---- identity: return argument unchanged ----
define identity(x) as:
    return x

# ---- constantly: return the given value unchanged ----
# Use this as a sentinel or default value pattern.
define constantly(x) as:
    return x

# ---- compose: create composed function f(g(x)) ----
# compose of [f, g] -> a callable closure that computes f(g(x))
define compose(f, g) as:
    define composed(x) as:
        return f of (g of x)
    return composed

# ---- chain: apply a pipeline of functions to a value ----
# chain of [fn_list, value] -> result
# Applies functions left to right: chain of [[f, g, h], x] = h(g(f(x)))
define chain(fns, val) as:
    for i in range of (len of fns):
        val is fns[i] of val
    return val

# ---- apply_all: apply each function to the same value ----
# apply_all of [fn_list, value] -> [f1(value), f2(value), ...]
define apply_all(fns, val) as:
    result is []
    for i in range of (len of fns):
        append of [result, fns[i] of val]
    return result

# ---- complement: negate a predicate function ----
# complement of [pred, value] -> true if pred returns falsy, else false
define complement(pred, val) as:
    if pred of val:
        return false
    return true

# ---- times: call function n times with index ----
# times of [count, fn] -> list of results
define times(count, fn) as:
    result is []
    for i in range of count:
        append of [result, fn of i]
    return result

# ---- juxt: apply multiple functions, return list of results ----
# juxt of [[f, g, h], value] -> [f(value), g(value), h(value)]
# Alias for apply_all with a more functional name
define juxt(fns, val) as:
    result is []
    for i in range of (len of fns):
        append of [result, fns[i] of val]
    return result

# ---- apply_when: conditional application ----
# apply_when of [pred, fn, value] -> fn(value) if pred(value), else value
# (Named apply_when, not `when`: `when` is a reserved interrogative keyword and
# cannot be a function name. The old `when` never parsed — load_file swallowed
# the error — so this is the first version that actually loads. See lab.eigs's
# `stable` for the sibling case; both surfaced once load_file started reporting
# parse errors.)
define apply_when(pred, fn, val) as:
    if pred of val:
        return fn of val
    return val

# ---- unless: inverse conditional application ----
# unless of [pred, fn, value] -> fn(value) if NOT pred(value), else value
define unless(pred, fn, val) as:
    if pred of val:
        return val
    return fn of val

# ---- iterate: apply fn n times starting from value ----
# iterate of [fn, value, count] -> fn(fn(...fn(value)...))
define iterate(fn, val, count) as:
    for i in range of count:
        val is fn of val
    return val

# ---- wait_until: bounded retry on a predicate ----
# wait_until of [pred, tries, sleep_fn] -> true the first time `pred of []`
# is truthy, false after `tries` attempts. `sleep_fn` runs between attempts
# only — never after the final failed one, so a timeout costs tries-1
# delays, not tries (#1237). Pass null for a busy retry — the delay primitive is the caller's
# because it differs by host: sleep_ms hosted, gfx_delay on EigenOS.
# Every bounded poll loop in the ecosystem (IRQ ring drains, RTC
# update-in-progress waits, subprocess readiness) is this shape.
define wait_until(pred, tries, sleep_fn) as:
    local i is 0
    loop while i < tries:
        if pred of []:
            return true
        i is i + 1
        if sleep_fn != null and i < tries:
            sleep_fn of []
    return false
