# ============================================================
# JSON Library — JSON manipulation helpers
# ============================================================
#
# How to use:
#   load_file of "lib/json.eigs"
#
#   json_get of [json_str, "key"]           # extract top-level key
#   json_get_path of [json_str, "a.b.c"]    # extract nested value
#   json_has of [json_str, "key"]           # 1 if key exists
#   json_keys of json_str                   # list of top-level keys
#   json_from_pairs of pairs                # [[k,v], ...] -> JSON
#   json_merge of [json_a, json_b]          # merge two JSON objects
#   json_pretty of json_str                 # indented output

# ---- json_get: extract a top-level value by key ----
define json_get(json_str, key) as:
    return json_path of [json_str, key]

# ---- json_get_path: extract a nested value by dot path ----
define json_get_path(json_str, path) as:
    return json_path of [json_str, path]

# ---- json_has: check if top-level key exists ----
# Returns 1 if key exists and value is not null, 0 otherwise
define json_has(json_str, key) as:
    val is json_path of [json_str, key]
    if (type of val) == "null":
        return 0
    return 1

# ---- json_from_pairs: convert [[k,v], ...] to JSON string ----
define json_from_pairs(pairs) as:
    flat is []
    for i in range of (len of pairs):
        pair is pairs[i]
        append of [flat, pair[0]]
        append of [flat, pair[1]]
    return json_build of flat

# ---- json_merge: merge two JSON objects (b overwrites a) ----
# Flat merge: top-level keys of b replace those of a; nested values are
# carried whole, never deep-merged. Returns a JSON object, `{}` when both
# are empty (#1248 — this used to build a list and integer-index dicts).
define json_merge(a, b) as:
    local obj_a is json_decode of a
    local obj_b is json_decode of b
    if (type of obj_a) != "dict" or (type of obj_b) != "dict":
        throw of "json_merge: both arguments must be JSON objects"
    local merged is {}
    for k in keys of obj_a:
        dict_set of [merged, k, obj_a[k]]
    for k in keys of obj_b:
        dict_set of [merged, k, obj_b[k]]
    return json_encode of merged

# ---- json_pretty: simple indented JSON output ----
# Produces readable output for printing. Layout is inserted only OUTSIDE
# string tokens: inside a string every character, including `,{}[]` and
# escapes like \" and \\, is copied verbatim (#1249).
define json_pretty(x) as:
    s is x
    if (type of s) != "str":
        s is json_encode of s
    result is ""
    indent is 0
    i is 0
    length is len of s
    local in_str is 0
    local escaped is 0
    loop while i < length:
        c is char_at of [s, i]
        if in_str == 1:
            result is result + c
            if escaped == 1:
                escaped is 0
            elif c == "\\":
                escaped is 1
            elif c == "\"":
                in_str is 0
        elif c == "\"":
            in_str is 1
            result is result + c
        elif c == "{":
            indent is indent + 2
            result is result + "{\n"
            for sp in range of indent:
                result is result + " "
        elif c == "}":
            indent is indent - 2
            result is result + "\n"
            for sp in range of indent:
                result is result + " "
            result is result + "}"
        elif c == "[":
            indent is indent + 2
            result is result + "[\n"
            for sp in range of indent:
                result is result + " "
        elif c == "]":
            indent is indent - 2
            result is result + "\n"
            for sp in range of indent:
                result is result + " "
            result is result + "]"
        elif c == ",":
            result is result + ",\n"
            for sp in range of indent:
                result is result + " "
        else:
            result is result + c
        i is i + 1
    return result
