# ============================================================
# HTTP Library — HTTP client and server helpers
# ============================================================
#
# How to use:
#   load_file of "lib/http.eigs"
#
# Client:
#   response is http_get of "https://example.com/api"
#   response is http_post_json of ["url", data]
#
# Server:
#   route_get of ["/api/items", handler]
#   route_post of ["/api/items", handler]
#   json_response of data
#   text_response of "hello"
#   error_response of [404, "not found"]
#   parse_query of "key=val&foo=bar"
#   start_server of 8080
#
# Requires full build for server builtins.

# ============================================================
# Client helpers
# ============================================================

# ---- http_get: simple GET request ----
# http_get of "url" -> [exit_code, body]
define _http_is_safe_url(url) as:
    if (type of url) != "str":
        return 0
    if (len of url) == 0:
        return 0
    if (starts_with of [url, "-"]) == 1:
        return 0
    if (starts_with of [url, "http://"]) == 1:
        return 1
    if (starts_with of [url, "https://"]) == 1:
        return 1
    return 0

define http_get(url) as:
    if (_http_is_safe_url of url) == 0:
        return [-1, ""]
    return exec_capture of ["curl", "-s", "-L", "--proto", "=http,https", "--proto-redir", "=http,https", "--", url]

# ---- http_post_json: POST JSON data ----
# http_post_json of ["url", json_string] -> [exit_code, body]
define http_post_json(url, data) as:
    if (_http_is_safe_url of url) == 0:
        return [-1, ""]
    if (type of data) != "str":
        data is json_encode of data
    return exec_capture of ["curl", "-s", "-L", "--proto", "=http,https", "--proto-redir", "=http,https", "-X", "POST", "-H", "Content-Type: application/json", "--data-raw", data, "--", url]

# ============================================================
# Server helpers (require http extension builtins)
# ============================================================

# #877: the parameter is a literal response BODY, not a callback. These
# wrappers used to name it `handler`, which is what invites passing a
# function — http_route now raises on one rather than serving `<fn name>`.
# For per-request logic use the code form: http_route of [m, p, "code", src].

# ---- route_get: register a GET route with a literal body ----
define route_get(path, body) as:
    http_route of ["GET", path, body]

# ---- route_post: register a POST route with a literal body ----
define route_post(path, body) as:
    http_route of ["POST", path, body]

# ---- route_authed_get: authenticated GET route with a literal body ----
define route_authed_get(path, body) as:
    http_route_authed of ["GET", path, body]

# ---- route_authed_post: authenticated POST route with a literal body ----
define route_authed_post(path, body) as:
    http_route_authed of ["POST", path, body]

# ---- json_response: build a JSON response string ----
define json_response(data) as:
    if (type of data) == "str":
        return data
    return json_encode of data

# ---- text_response: wrap text in a JSON response ----
define text_response(text) as:
    return json_build of ["text", text]

# ---- error_response: build an error JSON response ----
# error_response of [code, message]
define error_response(code, msg) as:
    return json_build of ["error", msg, "code", code]

# ---- parse_query: parse query string into map ----
# parse_query of "key=val&foo=bar" -> [["key","val"],["foo","bar"]]
define parse_query(qs) as:
    if (len of qs) == 0:
        return []
    parts is split of [qs, "&"]
    result is []
    for i in range of (len of parts):
        pair is parts[i]
        eq_pos is index_of of [pair, "="]
        if eq_pos > 0:
            key is substr of [pair, 0, eq_pos]
            val is substr of [pair, eq_pos + 1, (len of pair) - eq_pos - 1]
            append of [result, [key, val]]
        else:
            append of [result, [pair, ""]]
    return result

# ---- start_server: bind and start serving ----
define start_server(port) as:
    http_early_bind of null
    http_serve of port
