# lint: allow-file E003 -- fragment of lib/ui.eigs: the loader binds the shared ui state (_theme, _ui, widget registry, sibling widgets) before this file runs
# UI Widgets — Viz: chart, bar_chart, gauge, meter, canvas, waveform_view, code_view, timeline

# ---- chart: x-y series plot (#819) ----
#
# `chart` is a data-coordinate x-y plot, not a y-vs-index strip: every
# series carries its own optional `x` list, the axes/ticks come from the
# data range, and the view has a pan/zoom transform on top. A series with
# no `x` keeps index-x semantics, so a bare y-list still plots as before.
#
# Three properties are structural, not options:
#   - CLIPPED. Every primitive the render path emits is clipped to the
#     widget — series and markers to the plot rect (software Liang-Barsky
#     per segment, plus gfx_clip for the real renderer), tick/legend text
#     through the measured-width clipper. Data that leaves the view, at
#     any pan or zoom, cannot paint over the surrounding chrome (#823).
#   - THEME-KEYED. Nothing here hardcodes a color: plot_bg / plot_grid /
#     plot_axis / plot_border / plot_series come off the active theme, so
#     an app that restyles the chrome restyles the data surface too (#820).
#   - INCREMENTAL. add_point / add_xy extend the cached data bounds in
#     O(1); render rescans only the points appended since the last frame.
#     A live plot at frame rate does not re-walk its history. Replacing or
#     shortening a series' data is detected by the per-series scanned
#     count and forces one full rescan.

define chart(id, x, y, w, h) as:
    return {
        "type": "chart",
        "id": id,
        "x": x, "y": y, "w": w, "h": h,
        "series": [],
        "markers": [],
        "x_label": "",
        "y_label": "",
        # Range: an explicit non-null bound always wins. Otherwise
        # auto_scale 1 derives it from the data (y padded by pad_frac),
        # auto_scale 0 falls back to 0..1.
        "auto_scale": 1,
        "x_min": null,
        "x_max": null,
        "y_min": null,
        "y_max": null,
        "pad_frac": 0.1,
        "grid": 1,
        "axes": 1,
        "legend": 1,
        "ticks_x": 5,
        "ticks_y": 4,
        # x and y units equal per pixel — a circle looks circular.
        "fixed_aspect": 0,
        # View transform: pan is in data units, zoom is a scale about the
        # panned centre. chart_reset_view restores 0/0/1.
        "pan_x": 0.0,
        "pan_y": 0.0,
        "zoom": 1.0,
        "interactive": 1,
        "hover_enabled": 1,
        "pad_left": 44,
        "pad_right": 8,
        "pad_top": 8,
        "pad_bottom": 26,
        "hover_index": -1,
        "hover_series": -1,
        "bg": null,
        # dispatch's wheel path calls this before the scroll_panel walk.
        "on_wheel": _wheel_chart,
        "visible": 1,
        # Incremental bounds cache — private, maintained by _chart_scan.
        # (the per-series scan marks live on the series dicts)
        "_have_bounds": 0,
        "_bx0": 0, "_bx1": 1, "_by0": 0, "_by1": 1
    }

# A series is a plain dict, so a consumer can also write the literal.
# `xs` null means index-x; `color` null takes the theme's series palette
# by position. style: "line" (default), "points", "both".
define chart_series(label, xs, ys, color) as:
    return {
        "label": label,
        "x": xs,
        "data": ys,
        "color": color,
        "style": "line",
        "point_r": 2,
        "_scanned": 0,
        "_last_y": null
    }

define chart_add_series(ch, s) as:
    append of [ch.series, s]
    return (len of ch.series) - 1

# kind: "vline" (at data x), "hline" (at data y), "point" (at x,y).
define chart_marker(kind, x, y, label, color) as:
    return {"kind": kind, "x": x, "y": y, "label": label, "color": color}

define chart_add_marker(ch, m) as:
    append of [ch.markers, m]
    return (len of ch.markers) - 1

# Incremental append. add_point keeps index-x (the historical helper);
# add_xy places the sample at a data coordinate. Both extend the cached
# bounds in O(1) — no rescan, no rebuild.
define add_point(ch, series_idx, value) as:
    if series_idx < 0:
        return null
    if series_idx >= (len of ch.series):
        return null
    local s is ch.series[series_idx]
    local idx is len of s.data
    append of [s.data, value]
    if s.x != null:
        append of [s.x, idx]
    _chart_extend of [ch, series_idx, idx, value]

define add_xy(ch, series_idx, x, y) as:
    if series_idx < 0:
        return null
    if series_idx >= (len of ch.series):
        return null
    local s is ch.series[series_idx]
    if s.x == null:
        s.x is []
        local n is len of s.data
        for i in range of n:
            append of [s.x, i]
    append of [s.x, x]
    append of [s.data, y]
    _chart_extend of [ch, series_idx, x, y]

# Rolling window for live data: keep only the newest max_n samples. The
# dropped points can only have widened the bounds, so this marks the
# cache stale rather than trying to shrink it in place.
define chart_trim(ch, series_idx, max_n) as:
    if series_idx < 0:
        return null
    if series_idx >= (len of ch.series):
        return null
    local s is ch.series[series_idx]
    local n is len of s.data
    if n <= max_n:
        return null
    s.data is list_slice of [s.data, n - max_n, n]
    if s.x != null:
        s.x is list_slice of [s.x, n - max_n, n]
    chart_invalidate of ch

# Widen the cached bounds by one sample and record that it is accounted
# for, so the render-time scan does not revisit it. The bookkeeping lives
# on the SERIES dict, not on the chart: a series the consumer replaced
# wholesale is a fresh dict with no marks, which is exactly the signal
# that its history has never been scanned.
define _chart_extend(ch, si, vx, vy) as:
    local s is ch.series[si]
    if s._scanned == null:
        return null
    if ch._have_bounds == 0:
        return null
    s._scanned is s._scanned + 1
    s._last_y is vy
    if vx < ch._bx0:
        ch._bx0 is vx
    if vx > ch._bx1:
        ch._bx1 is vx
    if vy < ch._by0:
        ch._by0 is vy
    if vy > ch._by1:
        ch._by1 is vy

# Forget the bounds cache. Bounds can only widen incrementally, so any
# edit that could NARROW them — rewriting a data list in place with the
# same length, dropping samples by hand — must say so. add_point, add_xy,
# chart_trim, a replaced series dict and a replaced series list are all
# detected without this; it is the escape hatch for everything else.
define chart_invalidate(ch) as:
    ch._have_bounds is 0
    for si in range of (len of ch.series):
        ch.series[si]._scanned is 0

# Scan whatever the incremental path has not already accounted for.
# One full rescan is forced when any series is new, has shrunk, or no
# longer ends where the cache last saw it — which is what keeps
# `ch.series is [...]` and `s.data is [...]` correct.
define _chart_scan(ch) as:
    local ns is len of ch.series
    local full is 0
    if ch._have_bounds == 0:
        full is 1
    for si in range of ns:
        local s is ch.series[si]
        local sc is s._scanned
        if sc == null:
            full is 1
        elif (len of s.data) < sc:
            full is 1
        elif sc > 0:
            if s.data[sc - 1] != s._last_y:
                full is 1
    if full == 1:
        for si in range of ns:
            ch.series[si]._scanned is 0
        ch._have_bounds is 0
    for si in range of ns:
        local s is ch.series[si]
        local n is len of s.data
        local start is s._scanned
        if n > start:
            local xs is s.x
            for di in range of [start, n]:
                local vx is di
                if xs != null:
                    vx is xs[di]
                local vy is s.data[di]
                if ch._have_bounds == 0:
                    ch._bx0 is vx
                    ch._bx1 is vx
                    ch._by0 is vy
                    ch._by1 is vy
                    ch._have_bounds is 1
                else:
                    if vx < ch._bx0:
                        ch._bx0 is vx
                    if vx > ch._bx1:
                        ch._bx1 is vx
                    if vy < ch._by0:
                        ch._by0 is vy
                    if vy > ch._by1:
                        ch._by1 is vy
            s._scanned is n
            s._last_y is s.data[n - 1]

# The resolved DATA range — auto-scale + explicit overrides, before
# fixed-aspect correction and before pan/zoom.
define chart_bounds(ch) as:
    _chart_scan of ch
    local bx0 is 0
    local bx1 is 1
    local by0 is 0
    local by1 is 1
    if ch.auto_scale != 0 and ch._have_bounds == 1:
        bx0 is ch._bx0
        bx1 is ch._bx1
        by0 is ch._by0
        by1 is ch._by1
        if by1 == by0:
            by0 is by0 - 1
            by1 is by1 + 1
        local pf is ch.pad_frac
        if pf == null:
            pf is 0
        local pad is (by1 - by0) * pf
        by0 is by0 - pad
        by1 is by1 + pad
        if bx1 == bx0:
            bx0 is bx0 - 1
            bx1 is bx1 + 1
    if ch.x_min != null:
        bx0 is ch.x_min
    if ch.x_max != null:
        bx1 is ch.x_max
    if ch.y_min != null:
        by0 is ch.y_min
    if ch.y_max != null:
        by1 is ch.y_max
    if bx1 <= bx0:
        bx1 is bx0 + 1
    if by1 <= by0:
        by1 is by0 + 1
    return {"x0": bx0, "x1": bx1, "y0": by0, "y1": by1}

define _chart_plot_rect(ch, ax, ay) as:
    local pw is ch.w - ch.pad_left - ch.pad_right
    local ph is ch.h - ch.pad_top - ch.pad_bottom
    if pw < 1:
        pw is 1
    if ph < 1:
        ph is 1
    return [ax + ch.pad_left, ay + ch.pad_top, pw, ph]

# _layout caches absolute positions; _render_chart restamps them, so a
# headless consumer that never runs a layout pass still gets the same
# transform the renderer used.
define _chart_origin(ch) as:
    local ox is ch.x
    local oy is ch.y
    if ch._ax != null:
        ox is ch._ax
    if ch._ay != null:
        oy is ch._ay
    return [ox, oy]

# The VISIBLE window plus the plot rect it maps onto: everything the
# data<->pixel transform needs, in one dict. This is the seam a consumer
# reads instead of re-deriving the geometry.
define chart_view(ch) as:
    local o is _chart_origin of ch
    local r is _chart_plot_rect of [ch, o[0], o[1]]
    local b is chart_bounds of ch
    local x0 is b.x0
    local x1 is b.x1
    local y0 is b.y0
    local y1 is b.y1
    if ch.fixed_aspect == 1:
        # Equalize data units per pixel on both axes by growing the axis
        # that is currently denser — never shrinking, so no data leaves.
        local upx is (x1 - x0) / r[2]
        local upy is (y1 - y0) / r[3]
        local u is upx
        if upy > u:
            u is upy
        local ax0 is (x0 + x1) / 2
        local ay0 is (y0 + y1) / 2
        x0 is ax0 - u * r[2] / 2
        x1 is ax0 + u * r[2] / 2
        y0 is ay0 - u * r[3] / 2
        y1 is ay0 + u * r[3] / 2
    local z is ch.zoom
    if z == null:
        z is 1.0
    if z <= 0:
        z is 1.0
    local px is ch.pan_x
    if px == null:
        px is 0
    local py is ch.pan_y
    if py == null:
        py is 0
    if z == 1.0 and px == 0 and py == 0:
        # Untransformed view returns the bounds verbatim: recentring by
        # +-half-span is float-lossy, and the default case should not pay
        # for a transform it is not using.
        return {
            "x0": x0, "x1": x1, "y0": y0, "y1": y1,
            "px": r[0], "py": r[1], "pw": r[2], "ph": r[3]
        }
    local cx is (x0 + x1) / 2 + px
    local cy is (y0 + y1) / 2 + py
    local hw is (x1 - x0) / 2 / z
    local hh is (y1 - y0) / 2 / z
    return {
        "x0": cx - hw, "x1": cx + hw,
        "y0": cy - hh, "y1": cy + hh,
        "px": r[0], "py": r[1], "pw": r[2], "ph": r[3]
    }

define _chart_map(v, dx, dy) as:
    local sx is v.px + (dx - v.x0) / (v.x1 - v.x0) * v.pw
    local sy is v.py + v.ph - (dy - v.y0) / (v.y1 - v.y0) * v.ph
    return [sx, sy]

# Data coordinate -> absolute screen pixel (unrounded, so a consumer can
# do its own sub-pixel work).
define chart_to_pixel(ch, dx, dy) as:
    return _chart_map of [(chart_view of ch), dx, dy]

# Absolute screen pixel -> data coordinate.
define chart_from_pixel(ch, sx, sy) as:
    local v is chart_view of ch
    local dx is v.x0 + (sx - v.px) / v.pw * (v.x1 - v.x0)
    local dy is v.y0 + (v.py + v.ph - sy) / v.ph * (v.y1 - v.y0)
    return [dx, dy]

define chart_reset_view(ch) as:
    ch.pan_x is 0.0
    ch.pan_y is 0.0
    ch.zoom is 1.0

# Pan by a PIXEL delta (a drag): the data under the cursor follows it.
define chart_pan_by(ch, dpx, dpy) as:
    local v is chart_view of ch
    ch.pan_x is ch.pan_x - dpx / v.pw * (v.x1 - v.x0)
    ch.pan_y is ch.pan_y + dpy / v.ph * (v.y1 - v.y0)

# Zoom about an ANCHOR pixel: the data point under (sx, sy) stays under
# (sx, sy). This is why the widget owns zoom — inside lib/ui it can read
# the pointer out of the private _ui state, so a consumer never has to
# shadow mousemove to answer "where was the cursor?" (#822).
define chart_zoom_at(ch, factor, sx, sy) as:
    local before is chart_from_pixel of [ch, sx, sy]
    local z is ch.zoom * factor
    if z < 0.001:
        z is 0.001
    if z > 100000:
        z is 100000
    ch.zoom is z
    local after is chart_from_pixel of [ch, sx, sy]
    ch.pan_x is ch.pan_x + (before[0] - after[0])
    ch.pan_y is ch.pan_y + (before[1] - after[1])

# ---- Ticks ----

define _chart_nice_step(span, target) as:
    if span <= 0:
        return 1
    local t is target
    if t == null:
        t is 4
    if t < 1:
        t is 1
    local raw is span / t
    if raw <= 0:
        return 1
    local mag is 1.0
    loop while mag * 10 <= raw:
        mag is mag * 10
    loop while mag > raw:
        mag is mag / 10
    local nrm is raw / mag
    local mult is 1
    if nrm > 5:
        mult is 10
    elif nrm > 2:
        mult is 5
    elif nrm > 1:
        mult is 2
    return mag * mult

# Round tick values covering [v0, v1] at a 1/2/5-times-power-of-ten step.
# Values are computed as k * step (never accumulated) so a long axis does
# not drift off the round numbers it is supposed to be labelling.
define chart_ticks(v0, v1, target) as:
    local out is []
    local step is _chart_nice_step of [v1 - v0, target]
    if step <= 0:
        return out
    local k is ceil of (v0 / step)
    local guard is 0
    loop while (k * step) <= v1 and guard < 512:
        append of [out, k * step]
        k is k + 1
        guard is guard + 1
    return out

define _chart_fmt(v, step) as:
    local s is abs of step
    local d is 0
    if s > 0:
        loop while s < 1 and d < 6:
            s is s * 10
            d is d + 1
    local m is pow of [10, d]
    local r is (round of (v * m)) / m
    if r == 0:
        return "0"
    return f"{r}"

# ---- Clipped primitives ----
# Liang-Barsky: the segment is clipped to the rect BEFORE it is drawn, so
# the containment holds in the headless suite too, not only in a renderer
# that honours gfx_clip. Returns null when the segment misses entirely.

define _clip_seg(x0, y0, x1, y1, rx, ry, rw, rh) as:
    local t0 is 0.0
    local t1 is 1.0
    local dx is x1 - x0
    local dy is y1 - y0
    local ps is [0 - dx, dx, 0 - dy, dy]
    local qs is [x0 - rx, rx + rw - x0, y0 - ry, ry + rh - y0]
    for i in range of 4:
        local p is ps[i]
        local q is qs[i]
        if p == 0:
            if q < 0:
                return null
        else:
            local rr is q / p
            if p < 0:
                if rr > t1:
                    return null
                if rr > t0:
                    t0 is rr
            else:
                if rr < t0:
                    return null
                if rr < t1:
                    t1 is rr
    return [x0 + t0 * dx, y0 + t0 * dy, x0 + t1 * dx, y0 + t1 * dy]

# r is [x, y, w, h] of the plot area; the clip box is one pixel short on
# each far edge so a floored endpoint still lands inside the rect. The
# clamp after the floor is not belt-and-braces: an intersection parameter
# is a division, so an endpoint that is mathematically ON the boundary
# comes back as ry - 1e-13 and floors to one pixel OUTSIDE. That drew a
# series segment one row above the plot area before the clamp existed.
define _chart_line(x0, y0, x1, y1, r, c) as:
    local s is _clip_seg of [x0, y0, x1, y1, r[0], r[1], r[2] - 1, r[3] - 1]
    if s == null:
        return null
    local ax0 is _clampi of [(floor of s[0]), r[0], r[0] + r[2] - 1]
    local ay0 is _clampi of [(floor of s[1]), r[1], r[1] + r[3] - 1]
    local ax1 is _clampi of [(floor of s[2]), r[0], r[0] + r[2] - 1]
    local ay1 is _clampi of [(floor of s[3]), r[1], r[1] + r[3] - 1]
    gfx_line of [ax0, ay0, ax1, ay1, c[0], c[1], c[2]]

define _clampi(v, lo, hi) as:
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

# Sample marks are drawn as rects intersected with the plot area rather
# than circles, so a point at the very edge is truncated instead of
# spilling its radius outside.
define _chart_dot(x, y, rad, r, c) as:
    local x0 is (floor of x) - rad
    local y0 is (floor of y) - rad
    local ix0 is max of [x0, r[0]]
    local iy0 is max of [y0, r[1]]
    local ix1 is min of [x0 + rad * 2 + 1, r[0] + r[2]]
    local iy1 is min of [y0 + rad * 2 + 1, r[1] + r[3]]
    if ix1 <= ix0:
        return null
    if iy1 <= iy0:
        return null
    gfx_rect of [ix0, iy0, ix1 - ix0, iy1 - iy0, c[0], c[1], c[2]]

# Text inside a rect: dropped when it cannot fit vertically, truncated by
# MEASURED width when it cannot fit horizontally (#823 — a label must
# never be discovered running off the widget in a screenshot).
define _chart_text(x, y, txt, c, scale, r) as:
    if txt == null:
        return null
    if (len of txt) == 0:
        return null
    if y < r[1]:
        return null
    if y + (text_height of scale) > r[1] + r[3]:
        return null
    local tx is x
    if tx < r[0]:
        tx is r[0]
    local avail is r[0] + r[2] - tx
    if avail <= 0:
        return null
    _draw_text_clipped of [tx, y, avail, txt, c, scale]

define _chart_series_color(ch, si) as:
    local s is ch.series[si]
    if s.color != null:
        return s.color
    local pal is _theme_color of ["plot_series", [[80, 140, 220]]]
    return pal[si % (len of pal)]

define bar_chart(id, x, y, w, h, labels, values, on_click) as:
    return {
        "type": "bar_chart",
        "id": id,
        "x": x, "y": y, "w": w, "h": h,
        "labels": labels,
        "values": values,
        "on_click": on_click,
        "color": _theme.accent,
        "colors": null,
        "hover_index": -1,
        "bar_gap": 4,
        "visible": 1
    }

define gauge(id, x, y, size, min_val, max_val, value, label) as:
    return {
        "type": "gauge",
        "id": id,
        "x": x, "y": y, "w": size, "h": size,
        "min_val": min_val, "max_val": max_val,
        "value": value,
        "label": label,
        "color": _theme.accent,
        "visible": 1
    }

define meter(id, x, y, w, h) as:
    return {
        "type": "meter",
        "id": id,
        "x": x, "y": y, "w": w, "h": h,
        "value": 0,
        "peak": 0,
        "peak_hold": 0,
        "visible": 1
    }

# canvas — the custom-widget escape hatch. on_mouse(w, ev) receives
# mousedown, hover mousemove, and (after claim_drag from the mousedown
# handler) drag mousemoves plus the terminating mouseup; branch on
# ev.type. Set w.on_wheel (fn(w, ev)) to consume wheel input (#569).
define canvas(id, x, y, w, h, on_paint, on_mouse) as:
    return {
        "type": "canvas",
        "id": id,
        "x": x, "y": y, "w": w, "h": h,
        "on_paint": on_paint,
        "on_mouse": on_mouse,
        "on_wheel": null,
        "hover": 0,
        "visible": 1
    }

define waveform_view(id, x, y, w, h) as:
    return {
        "type": "waveform_view",
        "id": id,
        "x": x, "y": y, "w": w, "h": h,
        "samples": [],
        "zoom": 1.0,
        "offset": 0,
        "sel_start": -1,
        "sel_end": -1,
        "playhead": -1,
        "color": [80, 160, 220],
        "visible": 1
    }

define code_view(id, x, y, w, h, text) as:
    return {
        "type": "code_view",
        "id": id,
        "x": x, "y": y, "w": w, "h": h,
        "text": text,
        "scroll_y": 0,
        "line_numbers": 1,
        # #838: styled ranges — [{"start", "end", "bg", "fg"}] with
        # absolute half-open byte offsets into `text`. bg paints a rect
        # behind the range, fg recolors its glyphs; either may be null.
        # Empty = exactly the pre-#838 rendering.
        "spans": [],
        "visible": 1
    }

define _render_chart(widget, ax, ay) as:
    # Restamp the layout cache so chart_view (used by hover, pan/zoom and
    # any consumer) resolves against exactly the rect being drawn.
    widget._ax is ax
    widget._ay is ay
    local bg is widget.bg
    if bg == null:
        bg is _theme_color of ["plot_bg", [25, 25, 35]]
    local gcol is _theme_color of ["plot_grid", [40, 40, 55]]
    local acol is _theme_color of ["plot_axis", [70, 70, 95]]
    local bcol is _theme_color of ["plot_border", [40, 40, 55]]
    local dim is _theme.text_dim
    local txt is _theme.text_color
    # The widget rect — everything below stays inside it.
    local wr is [ax, ay, widget.w, widget.h]
    gfx_rect of [ax, ay, widget.w, widget.h, bg[0], bg[1], bg[2]]
    local v is chart_view of widget
    local r is [v.px, v.py, v.pw, v.ph]
    local xstep is _chart_nice_step of [v.x1 - v.x0, widget.ticks_x]
    local ystep is _chart_nice_step of [v.y1 - v.y0, widget.ticks_y]
    # Grid + tick labels
    if widget.grid == 1:
        local xt is chart_ticks of [v.x0, v.x1, widget.ticks_x]
        for i in range of (len of xt):
            local gp is _chart_map of [v, xt[i], v.y0]
            _chart_line of [gp[0], v.py, gp[0], v.py + v.ph, r, gcol]
            local lb is _chart_fmt of [xt[i], xstep]
            local lw is text_width of [lb, 1]
            local lx is (floor of gp[0]) - floor of (lw / 2)
            if lx < ax + 1:
                lx is ax + 1
            if lx + lw > ax + widget.w - 1:
                lx is ax + widget.w - 1 - lw
            _chart_text of [lx, v.py + v.ph + 3, lb, dim, 1, wr]
        local yt is chart_ticks of [v.y0, v.y1, widget.ticks_y]
        for i in range of (len of yt):
            local gp is _chart_map of [v, v.x0, yt[i]]
            _chart_line of [v.px, gp[1], v.px + v.pw, gp[1], r, gcol]
            local lb is _chart_fmt of [yt[i], ystep]
            _chart_text of [ax + 2, (floor of gp[1]) - 3, lb, dim, 1, [ax, ay, widget.pad_left - 4, widget.h]]
    # Axis lines at data zero — the reference a phase portrait is read against
    if widget.axes == 1:
        local zp is _chart_map of [v, 0, 0]
        _chart_line of [zp[0], v.py, zp[0], v.py + v.ph, r, acol]
        _chart_line of [v.px, zp[1], v.px + v.pw, zp[1], r, acol]
    # Series + markers: software-clipped per primitive, and gfx_clip'd as
    # well so the real renderer enforces it independently.
    ui_clip_push of [v.px, v.py, v.pw, v.ph]
    for si in range of (len of widget.series):
        local s is widget.series[si]
        local c is _chart_series_color of [widget, si]
        local style is s.style
        if style == null:
            style is "line"
        local pr is s.point_r
        if pr == null:
            pr is 2
        local xs is s.x
        local n is len of s.data
        local lastx is 0
        local lasty is 0
        local have is 0
        for di in range of n:
            local vx is di
            if xs != null:
                vx is xs[di]
            local p is _chart_map of [v, vx, s.data[di]]
            if have == 1:
                if style != "points":
                    _chart_line of [lastx, lasty, p[0], p[1], r, c]
            if style != "line":
                _chart_dot of [p[0], p[1], pr, r, c]
            lastx is p[0]
            lasty is p[1]
            have is 1
    for mi in range of (len of widget.markers):
        local m is widget.markers[mi]
        local mc is m.color
        if mc == null:
            mc is acol
        local mlab is m.label
        if m.kind == "hline":
            local mp is _chart_map of [v, v.x0, m.y]
            _chart_line of [v.px, mp[1], v.px + v.pw, mp[1], r, mc]
            _chart_text of [v.px + 3, (floor of mp[1]) - (text_height of 1) - 2, mlab, mc, 1, r]
        elif m.kind == "point":
            local mp is _chart_map of [v, m.x, m.y]
            _chart_dot of [mp[0], mp[1], 3, r, mc]
            _chart_text of [(floor of mp[0]) + 5, (floor of mp[1]) - (text_height of 1), mlab, mc, 1, r]
        else:
            local mp is _chart_map of [v, m.x, v.y0]
            _chart_line of [mp[0], v.py, mp[0], v.py + v.ph, r, mc]
            _chart_text of [(floor of mp[0]) + 2, v.py + 1, mlab, mc, 1, r]
    # Hovered sample: a mark plus its data coordinate
    if widget.hover_series >= 0 and widget.hover_series < (len of widget.series):
        local hs is widget.series[widget.hover_series]
        if widget.hover_index >= 0 and widget.hover_index < (len of hs.data):
            local hy is hs.data[widget.hover_index]
            local hx is widget.hover_index
            if hs.x != null:
                hx is hs.x[widget.hover_index]
            local hp is _chart_map of [v, hx, hy]
            local hc is _chart_series_color of [widget, widget.hover_series]
            _chart_dot of [hp[0], hp[1], 3, r, hc]
            local ht is f"{_chart_fmt of [hx, xstep]}, {_chart_fmt of [hy, ystep]}"
            _chart_text of [(floor of hp[0]) + 6, (floor of hp[1]) - (text_height of 1) - 2, ht, txt, 1, r]
    # Legend
    if widget.legend == 1:
        local lgx is v.px + 4
        for si in range of (len of widget.series):
            local s is widget.series[si]
            local c is _chart_series_color of [widget, si]
            local lab is s.label
            if lab == null:
                lab is ""
            _chart_dot of [lgx + 4, v.py + 6, 3, r, c]
            _chart_text of [lgx + 12, v.py + 2, lab, txt, 1, r]
            lgx is lgx + (text_width of [lab, 1]) + 20
    ui_clip_pop of null
    # Axis captions
    if (len of widget.x_label) > 0:
        local xw is text_width of [widget.x_label, 1]
        _chart_text of [v.px + floor of ((v.pw - xw) / 2), ay + widget.h - (text_height of 1) - 2, widget.x_label, dim, 1, wr]
    if (len of widget.y_label) > 0:
        _chart_text of [ax + 2, ay + 1, widget.y_label, dim, 1, wr]
    # Border
    gfx_rrect of [ax, ay, widget.w, 1, 0, bcol[0], bcol[1], bcol[2]]
    gfx_rrect of [ax, ay + widget.h - 1, widget.w, 1, 0, bcol[0], bcol[1], bcol[2]]

define _render_bar_chart(widget, ax, ay) as:
    # Background — theme-keyed (#820), current values as the defaults
    bar_bg is _theme_color of ["plot_bg", [25, 25, 35]]
    bar_border is _theme_color of ["plot_border", [40, 40, 55]]
    gfx_rect of [ax, ay, widget.w, widget.h, bar_bg[0], bar_bg[1], bar_bg[2]]
    n is len of widget.values
    if n > 0:
        bar_area_h is widget.h - 30
        bar_w is floor of ((widget.w - 16) / n) - widget.bar_gap
        if bar_w < 4:
            bar_w is 4
        # Find max value
        v_max is 0
        for vi in range of n:
            if widget.values[vi] > v_max:
                v_max is widget.values[vi]
        if v_max == 0:
            v_max is 1
        for bi in range of n:
            bx is ax + 8 + bi * (bar_w + widget.bar_gap)
            bh is floor of (widget.values[bi] / v_max * bar_area_h)
            if bh < 1:
                bh is 1
            by is ay + widget.h - 20 - bh
            # Bar color
            if widget.colors != null and bi < (len of widget.colors):
                bc is widget.colors[bi]
            else:
                bc is widget.color
            if bi == widget.hover_index:
                # Lighten on hover
                bc is [bc[0] + 30, bc[1] + 30, bc[2] + 30]
            gfx_rrect of [bx, by, bar_w, bh, 2, bc[0], bc[1], bc[2]]
            # Value above bar
            vt is f"{widget.values[bi]}"
            vw is text_width of [vt, 1]
            gfx_text of [bx + floor of ((bar_w - vw) / 2), by - 10, vt, _theme.text_color[0], _theme.text_color[1], _theme.text_color[2], 1]
            # Label below bar
            if bi < (len of widget.labels):
                lt is widget.labels[bi]
                lw is text_width of [lt, 1]
                gfx_text of [bx + floor of ((bar_w - lw) / 2), ay + widget.h - 12, lt, _theme.text_dim[0], _theme.text_dim[1], _theme.text_dim[2], 1]
    # Border
    gfx_rrect of [ax, ay, widget.w, 1, 0, bar_border[0], bar_border[1], bar_border[2]]
    gfx_rrect of [ax, ay + widget.h - 1, widget.w, 1, 0, bar_border[0], bar_border[1], bar_border[2]]

define _render_gauge(widget, ax, ay) as:
    cx is ax + floor of (widget.w / 2)
    cy is ay + floor of (widget.h / 2) - 6
    r is floor of (widget.w / 2) - 4
    # Compute fraction
    g_range is widget.max_val - widget.min_val
    if g_range > 0:
        frac is (widget.value - widget.min_val) / g_range
    else:
        frac is 0
    if frac < 0:
        frac is 0
    if frac > 1:
        frac is 1
    # Arc angles: 225deg (3.927 rad) to -45deg (-0.785 rad) = 270deg sweep
    start_a is 3.927
    end_a is -0.785
    sweep is start_a - end_a
    # Unfilled arc (full sweep, dim)
    _draw_arc of [cx, cy, r, end_a, start_a, 3, _theme.text_dim]
    # Filled arc (from start to current value)
    fill_end is start_a - frac * sweep
    _draw_arc of [cx, cy, r, fill_end, start_a, 3, widget.color]
    # Center text: value
    vt is f"{floor of widget.value}"
    vw is text_width of [vt, _theme.font_scale]
    gfx_text of [cx - floor of (vw / 2), cy - floor of (_theme.char_h / 2), vt, _theme.text_color[0], _theme.text_color[1], _theme.text_color[2], _theme.font_scale]
    # Label below
    if (len of widget.label) > 0:
        lw is text_width of [widget.label, 1]
        gfx_text of [cx - floor of (lw / 2), ay + widget.h - 10, widget.label, _theme.text_dim[0], _theme.text_dim[1], _theme.text_dim[2], 1]

define _render_meter(widget, ax, ay) as:
    # Background
    gfx_rrect of [ax, ay, widget.w, widget.h, 2, 20, 20, 25]
    # Filled bar from bottom — green/yellow/red gradient
    bar_h is floor of (widget.value * widget.h)
    if bar_h > widget.h:
        bar_h is widget.h
    if bar_h > 0:
        # Green zone (bottom 60%)
        green_h is floor of (widget.h * 0.6)
        yellow_h is floor of (widget.h * 0.2)
        # Draw green portion
        gh is bar_h
        if gh > green_h:
            gh is green_h
        if gh > 0:
            gfx_rect of [ax + 1, ay + widget.h - gh, widget.w - 2, gh, 40, 180, 80]
        # Draw yellow portion
        if bar_h > green_h:
            yh is bar_h - green_h
            if yh > yellow_h:
                yh is yellow_h
            gfx_rect of [ax + 1, ay + widget.h - green_h - yh, widget.w - 2, yh, 200, 200, 40]
        # Draw red portion
        if bar_h > green_h + yellow_h:
            rh is bar_h - green_h - yellow_h
            gfx_rect of [ax + 1, ay + widget.h - bar_h, widget.w - 2, rh, 220, 50, 40]
    # Peak hold line
    if widget.peak > 0:
        peak_y is ay + widget.h - floor of (widget.peak * widget.h)
        if peak_y >= ay and peak_y < ay + widget.h:
            gfx_line of [ax + 1, peak_y, ax + widget.w - 1, peak_y, 255, 255, 255]

define _render_canvas(widget, ax, ay) as:
    if widget.on_paint != null:
        widget.on_paint of [widget, ax, ay]

define _render_waveform_view(widget, ax, ay) as:
    # Background — theme-keyed (#820), current values as the defaults
    wv_bg is _theme_color of ["wave_bg", [18, 18, 26]]
    wv_center is _theme_color of ["wave_center", [35, 35, 45]]
    wv_border is _theme_color of ["wave_border", [35, 35, 45]]
    gfx_rect of [ax, ay, widget.w, widget.h, wv_bg[0], wv_bg[1], wv_bg[2]]
    mid_y is ay + floor of (widget.h / 2)
    # Center line
    gfx_line of [ax, mid_y, ax + widget.w, mid_y, wv_center[0], wv_center[1], wv_center[2]]
    # Selection highlight. The fill is deliberately faint (alpha 30), so
    # a selection spanning the whole visible range would be a uniform
    # tint with no visible boundary — imperceptible (select-all looked
    # like a no-op in DeslanStudio). Bright edge markers make any
    # selection read as selected; each edge is drawn only when it lies
    # inside the visible span, and the fill is clamped to the widget.
    if widget.sel_start >= 0 and widget.sel_end >= 0:
        s0 is floor of ((widget.sel_start - widget.offset) / widget.zoom)
        s1 is floor of ((widget.sel_end - widget.offset) / widget.zoom)
        if s1 > s0:
            f0 is s0
            if f0 < 0:
                f0 is 0
            f1 is s1
            if f1 > widget.w:
                f1 is widget.w
            if f1 > f0:
                gfx_rect of [ax + f0, ay, f1 - f0, widget.h, widget.color[0], widget.color[1], widget.color[2], 30]
            # Markers CLAMP to the widget rather than vanish: a
            # selection reaching past an edge (select-all lands at
            # exactly s1 == w) still shows a line AT that edge.
            e0 is s0
            if e0 < 0:
                e0 is 0
            if e0 > widget.w - 1:
                e0 is widget.w - 1
            e1 is s1
            if e1 < 0:
                e1 is 0
            if e1 > widget.w - 1:
                e1 is widget.w - 1
            gfx_line of [ax + e0, ay, ax + e0, ay + widget.h, widget.color[0], widget.color[1], widget.color[2]]
            gfx_line of [ax + e1, ay, ax + e1, ay + widget.h, widget.color[0], widget.color[1], widget.color[2]]
    # Waveform
    n is len of widget.samples
    if n > 0:
        c is widget.color
        prev_y is mid_y
        for px in range of widget.w:
            si is floor of (widget.offset + px * widget.zoom)
            if si >= 0 and si < n:
                amp is widget.samples[si] * (widget.h / 2)
                sy is mid_y - floor of amp
                gfx_line of [ax + px, prev_y, ax + px + 1, sy, c[0], c[1], c[2]]
                prev_y is sy
            else:
                prev_y is mid_y
    # Playhead
    if widget.playhead >= 0:
        px is floor of ((widget.playhead - widget.offset) / widget.zoom)
        if px >= 0 and px < widget.w:
            gfx_line of [ax + px, ay, ax + px, ay + widget.h, 255, 80, 80]
    # Border
    gfx_rrect of [ax, ay, widget.w, 1, 0, wv_border[0], wv_border[1], wv_border[2]]
    gfx_rrect of [ax, ay + widget.h - 1, widget.w, 1, 0, wv_border[0], wv_border[1], wv_border[2]]

define _render_code_view(widget, ax, ay) as:
    # Background
    gfx_rect of [ax, ay, widget.w, widget.h, 20, 20, 30]
    ui_clip_push of [ax + 1, ay + 1, widget.w - 2, widget.h - 2]
    # Split text into lines by scanning for newline; line_offs keeps each
    # line's absolute start offset so span offsets (#838) map to columns.
    lines is []
    line_offs is []
    cur is ""
    cur_off is 0
    src is widget.text
    for ci in range of (len of src):
        ch is substr of [src, ci, 1]
        if ch == "\n":
            append of [lines, cur]
            append of [line_offs, cur_off]
            cur is ""
            cur_off is ci + 1
        else:
            cur is cur + ch
    append of [lines, cur]
    append of [line_offs, cur_off]
    line_h is _theme.char_h + 4
    gutter_w is 0
    if widget.line_numbers == 1:
        gutter_w is 30
    for li in range of (len of lines):
        ly is ay + 2 + li * line_h - widget.scroll_y
        if ly + line_h > ay and ly < ay + widget.h:
            if widget.line_numbers == 1:
                ln_text is f"{li + 1}"
                gfx_text of [ax + 4, ly, ln_text, _theme.text_dim[0], _theme.text_dim[1], _theme.text_dim[2], 1]
            # #838 span backgrounds — under the text
            local tx is ax + gutter_w + 4
            local tmaxw is widget.w - gutter_w - 8
            local sps is widget.spans
            local ls is line_offs[li]
            local le is ls + (len of lines[li])
            if sps != null:
                for si in range of (len of sps):
                    local s is sps[si]
                    local a0 is s.start
                    local a1 is s.end
                    if a0 < ls:
                        a0 is ls
                    if a1 > le:
                        a1 is le
                    if a0 < a1:
                        local bgc is s.bg
                        if bgc != null:
                            local pre is substr of [lines[li], 0, a0 - ls]
                            local seg is substr of [lines[li], a0 - ls, a1 - a0]
                            local sx is tx + (text_width of [pre, 1])
                            local sw is text_width of [seg, 1]
                            if sx < ax + widget.w - 4 and sx + sw > ax:
                                gfx_rect of [sx, ly - 1, sw, line_h - 1, bgc[0], bgc[1], bgc[2]]
            _draw_text_clipped of [tx, ly, tmaxw, lines[li], _theme.text_color, 1]
            # #838 span foregrounds — recolor glyphs over the base text
            # (monospace, so the overdraw is position-exact)
            if sps != null:
                for si in range of (len of sps):
                    local s is sps[si]
                    local a0 is s.start
                    local a1 is s.end
                    if a0 < ls:
                        a0 is ls
                    if a1 > le:
                        a1 is le
                    if a0 < a1:
                        local fgc is s.fg
                        if fgc != null:
                            local pre is substr of [lines[li], 0, a0 - ls]
                            local seg is substr of [lines[li], a0 - ls, a1 - a0]
                            local sx is tx + (text_width of [pre, 1])
                            local sxw is text_width of [pre, 1]
                            _draw_text_clipped of [sx, ly, tmaxw - sxw, seg, fgc, 1]
    ui_clip_pop of null
    # Border
    gfx_rrect of [ax, ay, widget.w, 1, 0, 35, 35, 45]
    gfx_rrect of [ax, ay + widget.h - 1, widget.w, 1, 0, 35, 35, 45]
    # Scrollbar
    total_h is (len of lines) * line_h
    if total_h > widget.h:
        sb_h is floor of (widget.h * widget.h / total_h)
        if sb_h < 16:
            sb_h is 16
        sb_y is ay + floor of (widget.scroll_y * (widget.h - sb_h) / (total_h - widget.h))
        gfx_rrect of [ax + widget.w - 6, sb_y, 4, sb_h, 2, 80, 80, 100]

# Nearest sample in PIXEL space — with a data-coordinate x the samples
# are no longer evenly spaced, so an index-from-x formula would point at
# the wrong one. Costs one pass over the plotted points; a live plot with
# a long history sets hover_enabled to 0.
define _mousemove_chart(hit, root, mx, my) as:
    hit.hover_index is -1
    hit.hover_series is -1
    if hit.hover_enabled == 0:
        return null
    local v is chart_view of hit
    if mx < v.px:
        return null
    if mx > v.px + v.pw:
        return null
    if my < v.py:
        return null
    if my > v.py + v.ph:
        return null
    local best is -1
    local bsi is -1
    local bd is 0 - 1
    for si in range of (len of hit.series):
        local s is hit.series[si]
        local xs is s.x
        local n is len of s.data
        for di in range of n:
            local vx is di
            if xs != null:
                vx is xs[di]
            local p is _chart_map of [v, vx, s.data[di]]
            local ddx is p[0] - mx
            local ddy is p[1] - my
            local d2 is ddx * ddx + ddy * ddy
            if bd < 0:
                bd is d2
                best is di
                bsi is si
            elif d2 < bd:
                bd is d2
                best is di
                bsi is si
    # Snap radius 20px — past that the pointer is not on any sample.
    if bd >= 0:
        if bd <= 400:
            hit.hover_index is best
            hit.hover_series is bsi

# Drag to pan. The chart claims the pointer so every following mousemove
# and the terminating mouseup route here (#567).
define _mousedown_chart(hit, root, mx, my, ev) as:
    if hit.interactive == 0:
        return null
    _ui.drag_widget is hit
    _ui.drag_ox is mx
    _ui.drag_oy is my

define _drag_chart(w, ev) as:
    local dx is ev.x - _ui.drag_ox
    local dy is ev.y - _ui.drag_oy
    _ui.drag_ox is ev.x
    _ui.drag_oy is ev.y
    chart_pan_by of [w, dx, dy]

# Wheel to zoom about the cursor. dispatch hands the wheel to the widget
# under the pointer, and the pointer itself lives in the private _ui
# state — reachable from here, so a consumer never shadows mousemove to
# get it (#822). ev.mx/ev.my are preferred when an event carries them.
define _wheel_chart(w, ev) as:
    if w.interactive == 0:
        return null
    local mx is _ui.last_mouse_x
    local my is _ui.last_mouse_y
    if ev.mx != null:
        mx is ev.mx
    if ev.my != null:
        my is ev.my
    local d is ev.y
    if d == null:
        return null
    if d == 0:
        return null
    local f is 1.0 + 0.2 * d
    if d < 0:
        f is 1.0 / (1.0 - 0.2 * d)
    chart_zoom_at of [w, f, mx, my]

define _mousemove_bar_chart(hit, root, mx, my) as:
    abs_x is hit._ax
    n is len of hit.values
    if n > 0:
        bar_w is floor of ((hit.w - 16) / n) - hit.bar_gap
        if bar_w < 4:
            bar_w is 4
        rel_x is mx - abs_x - 8
        idx is floor of (rel_x / (bar_w + hit.bar_gap))
        if idx >= 0 and idx < n:
            hit.hover_index is idx
        else:
            hit.hover_index is -1
    else:
        hit.hover_index is -1

define _mousedown_canvas(hit, root, mx, my, ev) as:
    if hit.on_mouse != null:
        hit.on_mouse of [hit, ev]

define _mousedown_waveform_view(hit, root, mx, my, ev) as:
    abs_x is hit._ax
    sample_pos is floor of (hit.offset + (mx - abs_x) * hit.zoom)
    hit.sel_start is sample_pos
    hit.sel_end is sample_pos
    _ui.drag_widget is hit
    _ui.drag_ox is abs_x

define _drag_waveform_view(w, ev) as:
    local sample_pos is floor of (w.offset + (ev.x - _ui.drag_ox) * w.zoom)
    w.sel_end is sample_pos

define _mousedown_bar_chart(hit, root, mx, my, ev) as:
    abs_x is hit._ax
    n is len of hit.values
    if n > 0:
        bar_w is floor of ((hit.w - 16) / n) - hit.bar_gap
        if bar_w < 4:
            bar_w is 4
        rel_x is mx - abs_x - 8
        idx is floor of (rel_x / (bar_w + hit.bar_gap))
        if idx >= 0 and idx < n:
            if hit.on_click != null:
                hit.on_click of [hit, idx]

define _clear_hover_chart(widget) as:
    widget.hover_index is -1
    widget.hover_series is -1

define _clear_hover_bar_chart(widget) as:
    widget.hover_index is -1

define _scroll_code_view(widget, dx, dy) as:
    widget.scroll_y is widget.scroll_y + dy
    if widget.scroll_y < 0:
        widget.scroll_y is 0
    # Estimate total height from text
    n_lines is 1
    src is widget.text
    for ci in range of (len of src):
        ch is substr of [src, ci, 1]
        if ch == "\n":
            n_lines is n_lines + 1
    line_h is _theme.char_h + 4
    max_sy is n_lines * line_h - widget.h
    if max_sy < 0:
        max_sy is 0
    if widget.scroll_y > max_sy:
        widget.scroll_y is max_sy

# ---- timeline: lane-based event timeline (#842) ----
#
# N horizontal lanes over a shared time axis. Items are plain dicts the
# consumer hands over: markers {t, lane, kind} are point events, spans
# {t0, t1, lane, kind} are extents (a role held from t0..t1, a task
# running). The widget renders lanes/marks/spans/cursor, period — no
# domain semantics; deriving spans from a domain's event stream is the
# consumer's mapping (liferaft#18 roles, eddy#6 schedules).
#
# The chart's three structural properties hold here too:
#   - CLIPPED (#823): every primitive is intersected with the widget /
#     body rect in software before it is drawn, plus gfx_clip for the
#     real renderer. Data at any pan/zoom cannot paint over the chrome.
#   - THEME-KEYED (#820): nothing hardcodes a color — tl_bg, tl_ruler_bg,
#     tl_lane_alt, tl_lane_line, tl_label, tl_cursor, tl_border and the
#     tl_kinds palette come off the active theme (with fallbacks, so a
#     theme dict predating the keys still renders). timeline_style keys
#     an item KIND to a theme role by name, resolved at render time.
#   - ALLOCATION-LEAN (#828 awareness): the render path computes the
#     time->pixel scale once per frame and places items with inline
#     arithmetic — no per-item list allocation per frame. Appends widen
#     a cached time range in O(1); render never re-walks the history.
#
# Interaction (the chart idiom from #819/#822): drag in the BODY pans,
# wheel zooms about the cursor, drag in the RULER strip scrubs — sets
# tl.cursor and fires on_scrub(tl, t). A consumer sets/reads tl.cursor
# directly (null hides it); that is the seed-replay / anomaly scrubber
# seam.
#
# Extra fields on lane and item dicts pass through untouched, so a
# consumer can carry its whole source record (detail/term/verdict) on
# the item and read it back from tl.hover_item.

define timeline(id, x, y, w, h) as:
    return {
        "type": "timeline",
        "id": id,
        "x": x, "y": y, "w": w, "h": h,
        "lanes": [],
        "markers": [],
        "spans": [],
        # kind -> theme key string or [r, g, b] (timeline_style)
        "kind_style": {},
        # Range: explicit non-null bounds win; otherwise derived from
        # the items (markers' t, spans' t0/t1).
        "t_min": null,
        "t_max": null,
        # Scrubber: a time, or null = hidden. on_scrub(tl, t) fires on
        # ruler click/drag AFTER tl.cursor is updated.
        "cursor": null,
        "on_scrub": null,
        # View transform, x-axis only: pan is in time units, zoom is a
        # scale about the panned centre. timeline_reset_view restores.
        "pan_t": 0.0,
        "zoom": 1.0,
        "interactive": 1,
        "hover_enabled": 1,
        "hover_item": null,
        # Geometry: lane-label gutter, ruler strip, lane height.
        # lane_h null fits all lanes into the body (min 4 px each).
        "pad_left": 64,
        "pad_right": 6,
        "lane_h": null,
        "marker_w": 2,
        "on_wheel": _wheel_timeline,
        "visible": 1,
        # Incremental time-bounds cache — private (_tl_scan).
        "_have_bounds": 0,
        "_bt0": 0, "_bt1": 1,
        "_scan_m": 0,
        "_scan_s": 0,
        # Drag gesture: "" | "pan" | "scrub" (_mousedown_timeline).
        "_drag_mode": ""
    }

# A lane is a plain dict; items address it by its id, so liferaft's
# numeric node ids and eddy's task-name strings both map without a
# translation table. Extra fields pass through.
define timeline_lane(id, label) as:
    return {"id": id, "label": label}

define timeline_add_lane(tl, lane) as:
    append of [tl.lanes, lane]
    return (len of tl.lanes) - 1

# Lane id -> lane index, or -1. Linear scan: lane counts are small
# (nodes / tasks), and item ingestion is one-time, not per-frame.
define timeline_lane_index(tl, lane_id) as:
    for i in range of (len of tl.lanes):
        if tl.lanes[i].id == lane_id:
            return i
    return 0 - 1

# Item builders — sugar over the plain dict shape; a consumer can also
# write the literal (and stash extra fields on it either way).
define timeline_marker(t, lane, kind) as:
    return {"t": t, "lane": lane, "kind": kind, "label": null, "color": null}

define timeline_span(t0, t1, lane, kind) as:
    return {"t0": t0, "t1": t1, "lane": lane, "kind": kind, "label": null, "color": null}

define timeline_add_marker(tl, m) as:
    append of [tl.markers, m]
    # O(1) widen only when everything before this append is already
    # accounted for — an item the consumer appended DIRECTLY leaves a
    # counter gap, and _tl_scan picks that tail up at the next bounds
    # read instead of it being silently skipped.
    if tl._have_bounds == 1 and tl._scan_m == (len of tl.markers) - 1:
        tl._scan_m is len of tl.markers
        _tl_widen of [tl, m.t, m.t]
    return (len of tl.markers) - 1

define timeline_add_span(tl, s) as:
    append of [tl.spans, s]
    if tl._have_bounds == 1 and tl._scan_s == (len of tl.spans) - 1:
        tl._scan_s is len of tl.spans
        _tl_widen of [tl, s.t0, s.t1]
    return (len of tl.spans) - 1

# Key an item KIND to a color. `style` is either a THEME KEY string —
# resolved through the active theme at render time, so a theme switch
# restyles the kinds too — or an [r, g, b] literal for a consumer that
# owns its palette.
define timeline_style(tl, kind, style) as:
    tl.kind_style[kind] is style

# Cursor seam: set (or null to hide) and read tl.cursor. Setting it via
# code does NOT fire on_scrub — that callback reports the USER gesture;
# a consumer driving the cursor programmatically already knows the value.
define timeline_set_cursor(tl, t) as:
    tl.cursor is t

# O(1) widen of the cached time range (the counters are maintained by
# the add_* callers, which know exactly what they accounted for).
define _tl_widen(tl, ta, tb) as:
    if ta < tl._bt0:
        tl._bt0 is ta
    if tb > tl._bt1:
        tl._bt1 is tb

# Forget the bounds cache — the escape hatch for edits the incremental
# path cannot see (rewriting an item's t in place, dropping items).
# Replaced/shrunk item lists are detected without this.
define timeline_invalidate(tl) as:
    tl._have_bounds is 0
    tl._scan_m is 0
    tl._scan_s is 0

define _tl_scan(tl) as:
    local nm is len of tl.markers
    local ns is len of tl.spans
    if nm < tl._scan_m:
        tl._have_bounds is 0
    if ns < tl._scan_s:
        tl._have_bounds is 0
    if tl._have_bounds == 0:
        tl._scan_m is 0
        tl._scan_s is 0
    for mi in range of [tl._scan_m, nm]:
        local m is tl.markers[mi]
        if tl._have_bounds == 0:
            tl._bt0 is m.t
            tl._bt1 is m.t
            tl._have_bounds is 1
        else:
            if m.t < tl._bt0:
                tl._bt0 is m.t
            if m.t > tl._bt1:
                tl._bt1 is m.t
    for si in range of [tl._scan_s, ns]:
        local s is tl.spans[si]
        if tl._have_bounds == 0:
            tl._bt0 is s.t0
            tl._bt1 is s.t1
            tl._have_bounds is 1
        else:
            if s.t0 < tl._bt0:
                tl._bt0 is s.t0
            if s.t1 > tl._bt1:
                tl._bt1 is s.t1
    tl._scan_m is nm
    tl._scan_s is ns

# The resolved DATA time range — auto + explicit overrides, before
# pan/zoom.
define timeline_bounds(tl) as:
    _tl_scan of tl
    local t0 is 0
    local t1 is 1
    if tl._have_bounds == 1:
        t0 is tl._bt0
        t1 is tl._bt1
    if tl.t_min != null:
        t0 is tl.t_min
    if tl.t_max != null:
        t1 is tl.t_max
    if t1 <= t0:
        t1 is t0 + 1
    return {"t0": t0, "t1": t1}

define _tl_origin(tl) as:
    local ox is tl.x
    local oy is tl.y
    if tl._ax != null:
        ox is tl._ax
    if tl._ay != null:
        oy is tl._ay
    return [ox, oy]

# The VISIBLE window plus the geometry it maps onto — the seam a
# consumer reads instead of re-deriving the transform:
#   t0, t1          visible time range (after pan/zoom)
#   px, py, pw, ph  the lane BODY rect (right of the label gutter,
#                   below the ruler)
#   rx, ry, rw, rh  the time RULER strip (scrub target)
#   lane_h          per-lane pixel height
define timeline_view(tl) as:
    local o is _tl_origin of tl
    local rh is (text_height of 1) + 6
    if rh > tl.h:
        rh is tl.h
    local px is o[0] + tl.pad_left
    local pw is tl.w - tl.pad_left - tl.pad_right
    if pw < 1:
        pw is 1
    local py is o[1] + rh
    local ph is tl.h - rh
    if ph < 1:
        ph is 1
    local nl is len of tl.lanes
    local lh is tl.lane_h
    if lh == null:
        if nl > 0:
            lh is floor of (ph / nl)
        else:
            lh is ph
    if lh < 4:
        lh is 4
    local b is timeline_bounds of tl
    local t0 is b.t0
    local t1 is b.t1
    local z is tl.zoom
    if z == null:
        z is 1.0
    if z <= 0:
        z is 1.0
    local pt is tl.pan_t
    if pt == null:
        pt is 0
    if z != 1.0 or pt != 0:
        local ct is (t0 + t1) / 2 + pt
        local hw is (t1 - t0) / 2 / z
        t0 is ct - hw
        t1 is ct + hw
    return {
        "t0": t0, "t1": t1,
        "px": px, "py": py, "pw": pw, "ph": ph,
        "rx": px, "ry": o[1], "rw": pw, "rh": rh,
        "lane_h": lh
    }

# Time -> absolute screen x (unrounded), and back.
define timeline_to_pixel(tl, t) as:
    local v is timeline_view of tl
    return v.px + (t - v.t0) / (v.t1 - v.t0) * v.pw

define timeline_from_pixel(tl, sx) as:
    local v is timeline_view of tl
    return v.t0 + (sx - v.px) / v.pw * (v.t1 - v.t0)

# Absolute screen y -> lane index, or -1 outside every lane band.
define timeline_lane_at(tl, sy) as:
    local v is timeline_view of tl
    if sy < v.py:
        return 0 - 1
    local li is floor of ((sy - v.py) / v.lane_h)
    if li >= (len of tl.lanes):
        return 0 - 1
    return li

define timeline_reset_view(tl) as:
    tl.pan_t is 0.0
    tl.zoom is 1.0

# Pan by a PIXEL delta (a drag): the item under the cursor follows it.
define timeline_pan_by(tl, dpx) as:
    local v is timeline_view of tl
    tl.pan_t is tl.pan_t - dpx / v.pw * (v.t1 - v.t0)

# Zoom about an ANCHOR pixel: the time under sx stays under sx.
define timeline_zoom_at(tl, factor, sx) as:
    local before is timeline_from_pixel of [tl, sx]
    local z is tl.zoom * factor
    if z < 0.001:
        z is 0.001
    if z > 100000:
        z is 100000
    tl.zoom is z
    local after is timeline_from_pixel of [tl, sx]
    tl.pan_t is tl.pan_t + (before - after)

# Kind color resolution: an explicit item color wins; a timeline_style
# entry (theme key string, or literal rgb) is next; otherwise the
# tl_kinds palette by the kind's position in kind_style-then-first-use
# order — stable within a frame because it hashes the kind name.
define _tl_kind_color(tl, kind, explicit) as:
    if explicit != null:
        return explicit
    local st is tl.kind_style[kind]
    if st != null:
        if (type of st) == "str":
            return _theme_color of [st, _theme.accent]
        return st
    local pal is _theme_color of ["tl_kinds", (_theme_color of ["plot_series", [[80, 140, 220]]])]
    local hsum is 0
    local ks is f"{kind}"
    for ci in range of (len of ks):
        hsum is hsum + (ord of (substr of [ks, ci, 1]))
    return pal[hsum % (len of pal)]

define _render_timeline(widget, ax, ay) as:
    widget._ax is ax
    widget._ay is ay
    local bg is _theme_color of ["tl_bg", (_theme_color of ["plot_bg", [25, 25, 35]])]
    local rbg is _theme_color of ["tl_ruler_bg", (_theme_color of ["plot_grid", [40, 40, 55]])]
    local altc is _theme_color of ["tl_lane_alt", (_theme_color of ["plot_grid", [40, 40, 55]])]
    local linec is _theme_color of ["tl_lane_line", (_theme_color of ["plot_border", [40, 40, 55]])]
    local labc is _theme_color of ["tl_label", _theme.text_dim]
    local curc is _theme_color of ["tl_cursor", _theme.accent]
    local bcol is _theme_color of ["tl_border", (_theme_color of ["plot_border", [40, 40, 55]])]
    local dim is _theme.text_dim
    local wr is [ax, ay, widget.w, widget.h]
    gfx_rect of [ax, ay, widget.w, widget.h, bg[0], bg[1], bg[2]]
    local v is timeline_view of widget
    local r is [v.px, v.py, v.pw, v.ph]
    # The one time->x transform for the whole frame — every item below
    # is placed with inline arithmetic off these two numbers (#828).
    local tspan is v.t1 - v.t0
    if tspan <= 0:
        tspan is 1
    local xscale is v.pw / tspan
    local nl is len of widget.lanes
    # Lane bands, separators and gutter labels — under the grid/items.
    for li in range of nl:
        local ly is v.py + li * v.lane_h
        if ly < v.py + v.ph:
            local lh is v.lane_h
            if ly + lh > v.py + v.ph:
                lh is v.py + v.ph - ly
            if li % 2 == 1:
                gfx_rect of [v.px, ly, v.pw, lh, altc[0], altc[1], altc[2]]
            _chart_line of [v.px, ly, v.px + v.pw, ly, r, linec]
            local lab is widget.lanes[li].label
            if lab == null:
                lab is f"{widget.lanes[li].id}"
            _chart_text of [ax + 2, ly + 2, lab, labc, 1, [ax, ay, widget.pad_left - 4, widget.h]]
    # Ruler strip and time grid: background, ticks, tick labels.
    gfx_rect of [v.rx, v.ry, v.rw, v.rh, rbg[0], rbg[1], rbg[2]]
    local tstep is _chart_nice_step of [tspan, 6]
    local ticks is chart_ticks of [v.t0, v.t1, 6]
    for ti in range of (len of ticks):
        local tx is v.px + (ticks[ti] - v.t0) * xscale
        _chart_line of [tx, v.ry, tx, v.ry + v.rh - 1, [v.rx, v.ry, v.rw, v.rh], linec]
        _chart_line of [tx, v.py, tx, v.py + v.ph, r, linec]
        _chart_text of [(floor of tx) + 2, v.ry + 2, (_chart_fmt of [ticks[ti], tstep]), dim, 1, [v.rx, v.ry, v.rw, v.rh]]
    # Items: gfx_clip for the real renderer, software intersect per
    # primitive for the containment property itself.
    ui_clip_push of [v.px, v.py, v.pw, v.ph]
    local bx1 is v.px + v.pw
    for si in range of (len of widget.spans):
        local s is widget.spans[si]
        local sli is timeline_lane_index of [widget, s.lane]
        if sli >= 0:
            local sy is v.py + sli * v.lane_h + 2
            local sh is v.lane_h - 4
            if sh < 1:
                sh is 1
            local sx0 is v.px + (s.t0 - v.t0) * xscale
            local sx1 is v.px + (s.t1 - v.t0) * xscale
            if sx0 < v.px:
                sx0 is v.px
            if sx1 > bx1:
                sx1 is bx1
            if sx1 > sx0 and sy < v.py + v.ph and sy + sh > v.py:
                local isy is sy
                local ish is sh
                if isy < v.py:
                    ish is ish - (v.py - isy)
                    isy is v.py
                if isy + ish > v.py + v.ph:
                    ish is v.py + v.ph - isy
                local sc is _tl_kind_color of [widget, s.kind, s.color]
                gfx_rect of [(floor of sx0), isy, (floor of sx1) - (floor of sx0), ish, sc[0], sc[1], sc[2]]
                if s.label != null:
                    _chart_text of [(floor of sx0) + 2, isy + 1, s.label, _theme.text_color, 1, [(floor of sx0), isy, (floor of sx1) - (floor of sx0), ish]]
    local mw is widget.marker_w
    if mw == null:
        mw is 2
    for mi in range of (len of widget.markers):
        local m is widget.markers[mi]
        local mli is timeline_lane_index of [widget, m.lane]
        if mli >= 0:
            local mx is v.px + (m.t - v.t0) * xscale
            if mx >= v.px and mx < bx1:
                local my is v.py + mli * v.lane_h + 1
                local mh is v.lane_h - 2
                if mh < 1:
                    mh is 1
                if my < v.py + v.ph and my + mh > v.py:
                    local imy is my
                    local imh is mh
                    if imy < v.py:
                        imh is imh - (v.py - imy)
                        imy is v.py
                    if imy + imh > v.py + v.ph:
                        imh is v.py + v.ph - imy
                    local mc is _tl_kind_color of [widget, m.kind, m.color]
                    local imx is floor of mx
                    local imw is mw
                    if imx + imw > bx1:
                        imw is bx1 - imx
                    gfx_rect of [imx, imy, imw, imh, mc[0], mc[1], mc[2]]
    ui_clip_pop of null
    # Cursor/scrubber: a rule across the body plus a handle in the ruler.
    if widget.cursor != null:
        local cx is v.px + (widget.cursor - v.t0) * xscale
        if cx >= v.px and cx < bx1:
            local fcx is floor of cx
            _chart_line of [fcx, v.py, fcx, v.py + v.ph, r, curc]
            local hx is fcx - 2
            if hx < v.rx:
                hx is v.rx
            local hw is 5
            if hx + hw > v.rx + v.rw:
                hw is v.rx + v.rw - hx
            gfx_rect of [hx, v.ry, hw, v.rh, curc[0], curc[1], curc[2]]
    # Border
    gfx_rrect of [ax, ay, widget.w, 1, 0, bcol[0], bcol[1], bcol[2]]
    gfx_rrect of [ax, ay + widget.h - 1, widget.w, 1, 0, bcol[0], bcol[1], bcol[2]]

# Scrub helper shared by mousedown and drag: clamp the pointer to the
# body, update the cursor, then report the gesture.
define _tl_scrub_to(tl, sx) as:
    local v is timeline_view of tl
    local cx is sx
    if cx < v.px:
        cx is v.px
    if cx > v.px + v.pw:
        cx is v.px + v.pw
    tl.cursor is v.t0 + (cx - v.px) / v.pw * (v.t1 - v.t0)
    if tl.on_scrub != null:
        tl.on_scrub of [tl, tl.cursor]

# Ruler press = scrub; body press = pan. Both claim the pointer so the
# following mousemoves and the terminating mouseup route here (#567).
define _mousedown_timeline(hit, root, mx, my, ev) as:
    if hit.interactive == 0:
        return null
    local v is timeline_view of hit
    _ui.drag_widget is hit
    _ui.drag_ox is mx
    _ui.drag_oy is my
    if my < v.py:
        hit._drag_mode is "scrub"
        _tl_scrub_to of [hit, mx]
    else:
        hit._drag_mode is "pan"

define _drag_timeline(w, ev) as:
    if w._drag_mode == "scrub":
        _tl_scrub_to of [w, ev.x]
        return null
    local dx is ev.x - _ui.drag_ox
    _ui.drag_ox is ev.x
    _ui.drag_oy is ev.y
    timeline_pan_by of [w, dx]

# Wheel zooms about the pointer, read from the event or the toolkit's
# cached position (#822) — never from consumer-shadowed state.
define _wheel_timeline(w, ev) as:
    if w.interactive == 0:
        return null
    local mx is _ui.last_mouse_x
    if ev.mx != null:
        mx is ev.mx
    local d is ev.y
    if d == null:
        return null
    if d == 0:
        return null
    local f is 1.0 + 0.2 * d
    if d < 0:
        f is 1.0 / (1.0 - 0.2 * d)
    timeline_zoom_at of [w, f, mx]

# Hover reports the ITEM DICT under the pointer (markers win over spans,
# later items over earlier), so a consumer reads back whatever fields it
# stashed on the item. One pass over the items; a long history sets
# hover_enabled 0.
define _mousemove_timeline(hit, root, mx, my) as:
    hit.hover_item is null
    if hit.hover_enabled == 0:
        return null
    local v is timeline_view of hit
    if mx < v.px or mx > v.px + v.pw:
        return null
    if my < v.py or my > v.py + v.ph:
        return null
    local li is timeline_lane_at of [hit, my]
    if li < 0:
        return null
    local tspan is v.t1 - v.t0
    if tspan <= 0:
        tspan is 1
    local xscale is v.pw / tspan
    local found is null
    for si in range of (len of hit.spans):
        local s is hit.spans[si]
        if (timeline_lane_index of [hit, s.lane]) == li:
            local sx0 is v.px + (s.t0 - v.t0) * xscale
            local sx1 is v.px + (s.t1 - v.t0) * xscale
            if mx >= sx0 and mx <= sx1:
                found is s
    for mi in range of (len of hit.markers):
        local m is hit.markers[mi]
        if (timeline_lane_index of [hit, m.lane]) == li:
            local mmx is v.px + (m.t - v.t0) * xscale
            if (abs of (mmx - mx)) <= 3:
                found is m
    hit.hover_item is found

define _clear_hover_timeline(widget) as:
    widget.hover_item is null

_register_widget of ["chart", {
    "render": _render_chart,
    "hit_test": null,
    "on_mousedown": _mousedown_chart,
    "on_mousemove": _mousemove_chart,
    "on_drag": _drag_chart,
    "clear_hover": _clear_hover_chart,
    "clear_pressed": null,
    "scroll": null,
    "container": 0,
    "focusable": 1
}]

_register_widget of ["bar_chart", {
    "render": _render_bar_chart,
    "hit_test": null,
    "on_mousedown": _mousedown_bar_chart,
    "on_mousemove": _mousemove_bar_chart,
    "clear_hover": _clear_hover_bar_chart,
    "clear_pressed": null,
    "scroll": null,
    "container": 0,
    "focusable": 1
}]

_register_widget of ["gauge", {
    "render": _render_gauge,
    "hit_test": null,
    "on_mousedown": null,
    "on_mousemove": null,
    "clear_hover": null,
    "clear_pressed": null,
    "scroll": null,
    "container": 0,
    "focusable": 1
}]

_register_widget of ["meter", {
    "render": _render_meter,
    "hit_test": null,
    "on_mousedown": null,
    "on_mousemove": null,
    "clear_hover": null,
    "clear_pressed": null,
    "scroll": null,
    "container": 0,
    "focusable": 0
}]

_register_widget of ["canvas", {
    "render": _render_canvas,
    "hit_test": null,
    "on_mousedown": _mousedown_canvas,
    "on_mousemove": null,
    "clear_hover": null,
    "clear_pressed": null,
    "scroll": null,
    "container": 0,
    "focusable": 1
