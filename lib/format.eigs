# ============================================================
# Format Library — number formatting and text output helpers
# ============================================================
#
# How to use:
#   load_file of "lib/format.eigs"
#
#   fmt_num of [value, decimals]            # "3.14"
#   fmt_percent of [0.856, 1]               # "85.6%"
#   fmt_table of [headers, rows]            # aligned text table
#   fmt_bar of [6, 10, 10]                  # "[######....] 60.0%"
#   fmt_padded of [value, width]            # right-aligned in field

# ---- fmt_num: format number to fixed decimal places (never exponent notation) ----
# fmt_num of [value, decimals] -> string
define _fmt_uint(value) as:
    if value == 0:
        return "0"
    digits is ""
    rest is value
    loop while rest >= 1:
        digit is rest % 10
        digits is (str of digit) + digits
        rest is (rest - digit) / 10
    return digits

define _fmt_mul_small(digits, multiplier) as:
    out is ""
    carry is 0
    i is (len of digits) - 1
    loop while i >= 0:
        product is ((num of (char_at of [digits, i])) * multiplier) + carry
        digit is product % 10
        out is (str of digit) + out
        carry is (product - digit) / 10
        i is i - 1
    loop while carry > 0:
        digit is carry % 10
        out is (str of digit) + out
        carry is (carry - digit) / 10
    return out

define _fmt_increment(digits) as:
    out is ""
    carry is 1
    i is (len of digits) - 1
    loop while i >= 0:
        digit is num of (char_at of [digits, i])
        if carry == 1:
            digit is digit + 1
            if digit == 10:
                digit is 0
            else:
                carry is 0
        out is (str of digit) + out
        i is i - 1
    if carry == 1:
        out is "1" + out
    return out

define fmt_num(value, decimals) as:
    if value < 0:
        return "-" + (fmt_num of [0 - value, decimals])
    if value == 0:
        result is "0"
        if decimals > 0:
            result is result + "."
            for i in range of decimals:
                result is result + "0"
        return result

    # Recover the exact binary value as mantissa / 2^shift.  Building its
    # decimal integer with string arithmetic avoids both str's exponent form
    # and floating-point loss when value is scaled by a large power of ten.
    mantissa is value
    shift is 0
    min_mantissa is 4503599627370496
    loop while mantissa < min_mantissa:
        mantissa is mantissa * 2
        shift is shift + 1
    loop while mantissa >= (min_mantissa * 2):
        mantissa is mantissa / 2
        shift is shift - 1
    digits is _fmt_uint of (round of mantissa)
    if shift >= 0:
        for i in range of shift:
            digits is _fmt_mul_small of [digits, 5]
    if shift < 0:
        for i in range of (0 - shift):
            digits is _fmt_mul_small of [digits, 2]
        shift is 0
    loop while (len of digits) <= shift:
        digits is "0" + digits

    whole_len is (len of digits) - shift
    keep_len is whole_len + decimals
    loop while (len of digits) <= keep_len:
        digits is digits + "0"
    kept is substr of [digits, 0, keep_len]
    if (num of (char_at of [digits, keep_len])) >= 5:
        kept is _fmt_increment of kept
    loop while (len of kept) < (decimals + 1):
        kept is "0" + kept
    whole_len is (len of kept) - decimals
    whole is substr of [kept, 0, whole_len]
    if decimals == 0:
        return whole
    fraction is substr of [kept, whole_len, decimals]
    return whole + "." + fraction

# ---- fmt_percent: format as percentage ----
# fmt_percent of [value, decimals] -> string
define fmt_percent(value, decimals) as:
    pct is value * 100.0
    return (fmt_num of [pct, decimals]) + "%"

# ---- fmt_bar: text progress bar ----
# fmt_bar of [value, max_val, width] -> string
define fmt_bar(value, max_val, width) as:
    if max_val <= 0:
        max_val is 1
    ratio is value / max_val
    if ratio < 0:
        ratio is 0
    if ratio > 1:
        ratio is 1
    filled is round of (ratio * width)
    empty is width - filled
    bar is ""
    for i in range of filled:
        bar is bar + "#"
    for i in range of empty:
        bar is bar + "."
    return "[" + bar + "] " + (fmt_percent of [ratio, 1])

# ---- fmt_padded: right-align value in a field ----
# fmt_padded of [value, width] -> string
define fmt_padded(value, width) as:
    s is str of value
    loop while (len of s) < width:
        s is " " + s
    return s

# ---- fmt_table: print aligned table ----
# fmt_table of [headers, rows] -> string
# headers is a list of strings, rows is a list of lists
define fmt_table(headers, rows) as:
    ncols is len of headers
    widths is []
    for i in range of ncols:
        append of [widths, len of (str of headers[i])]
    for i in range of (len of rows):
        row is rows[i]
        for j in range of ncols:
            w is len of (str of row[j])
            if w > widths[j]:
                set_at of [widths, j, w]
    # Build header line
    header_line is ""
    sep_line is ""
    for i in range of ncols:
        cell is str of headers[i]
        loop while (len of cell) < widths[i]:
            cell is cell + " "
        if i > 0:
            header_line is header_line + " | "
            sep_line is sep_line + "-+-"
        header_line is header_line + cell
        dashes is ""
        for d in range of widths[i]:
            dashes is dashes + "-"
        sep_line is sep_line + dashes
    result is header_line + "\n" + sep_line
    # Build data rows
    for i in range of (len of rows):
        row is rows[i]
        line is ""
        for j in range of ncols:
            cell is str of row[j]
            loop while (len of cell) < widths[j]:
                cell is cell + " "
            if j > 0:
                line is line + " | "
            line is line + cell
        result is result + "\n" + line
    return result

# ---- hexdump: bytes as offset / hex / ascii rows ----
# hexdump of data -> multi-line string (data is a string or a buffer):
#   00000000  48 65 6C 6C 6F 21                                |Hello!|
# 16 bytes per row, printable ASCII (32..126) in the gutter, dot
# otherwise. Returns the string; the caller prints. Written for sector
# and packet debugging (regionfs, tidelog, DMG, the M13 frames).

define _hd_len(x) as:
    if (type of x) == "buffer":
        return buf_len of x
    return len of x

define _hd_byte(x, i) as:
    if (type of x) == "buffer":
        return buf_get of [x, i]
    return ord of (char_at of [x, i])

define hexdump(data) as:
    local n is _hd_len of data
    local out is ""
    local row is 0
    loop while row < n:
        local line is (hex of [row, 8]) + "  "
        local col is 0
        local gutter is ""
        loop while col < 16:
            local i is row + col
            if i < n:
                local b is _hd_byte of [data, i]
                line is line + (hex of [b, 2]) + " "
                if (b >= 32) and (b <= 126):
                    gutter is gutter + (chr of b)
                else:
                    gutter is gutter + "."
            else:
                line is line + "   "
            col is col + 1
        out is out + line + " |" + gutter + "|"
        row is row + 16
        if row < n:
            out is out + "\n"
    return out
