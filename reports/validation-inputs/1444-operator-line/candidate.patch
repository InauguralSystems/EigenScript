+# Keep #1424's caller-line section unchanged. These rows own #1425's
+# diagnostics and restoration checks, with native execution witnesses.
+for OL_TIER in "JIT" "EIGS_JIT_OFF=1" "EIGS_JIT_OSR_THRESHOLD=1"; do
+    OL_ENV="EIGS_JIT_STATS=1 EIGS_JIT_HOT=1"; [ "$OL_TIER" = JIT ] || OL_ENV="$OL_ENV $OL_TIER"
+    for OL_PROG in test_operator_line.eigs test_operator_line_parent.eigs; do
+        OL_OUT=$($EIGS_TMO env $OL_ENV ./eigenscript "../tests/$OL_PROG" </dev/null 2>&1); OL_RC=$?
+        TOTAL=$((TOTAL + 1))
+        OL_JIT=$(lar_jit_witness "$OL_TIER" "$OL_OUT")
+        if [ "$OL_PROG" = test_operator_line_parent.eigs ] && [ "$OL_TIER" != EIGS_JIT_OFF=1 ] && [ "$(uname -m)" = x86_64 ]; then
+            # Witness each parent callee and each independent OSR loop.
+            for OL_PARENT in unary index call; do
+                grep -Eq "^parent_${OL_PARENT} +[0-9]+ +yes " <<< "$OL_OUT" || OL_JIT=missing-parent-$OL_PARENT
+                grep -Eq "^osr_parent_${OL_PARENT} .* +yes +[1-9][0-9]* +[0-9]+ " <<< "$OL_OUT" || OL_JIT=missing-osr-$OL_PARENT
+            done
+            grep -Eq "^parent_branch +[0-9]+ +yes " <<< "$OL_OUT" || OL_JIT=missing-parent-branch
+            grep -Eq "^osr_parent_branch .* +yes +[1-9][0-9]* +[0-9]+ " <<< "$OL_OUT" || OL_JIT=missing-osr-branch
+        fi
+        if [ "$OL_JIT" != ok ]; then
+            FAIL=$((FAIL + 1)); echo "  FAIL: e.line, $OL_PROG ($OL_TIER): compiled witness $OL_JIT"
+            printf '%s\n' "$OL_OUT" | eigs_failure_output
+        elif rc_ok "$OL_RC" "$OL_OUT" && grep -q "All tests passed" <<< "$OL_OUT"; then
+            PASS=$((PASS + 1)); echo "  PASS: e.line, $OL_PROG ($OL_TIER)"
+        else
+            FAIL=$((FAIL + 1)); echo "  FAIL: e.line, $OL_PROG ($OL_TIER, rc=$OL_RC)"
+            printf '%s\n' "$OL_OUT" | eigs_failure_output
+        fi
+    done
+    # Semicolons separate exact expected lines; excerpt lines contain '|'.
+    for OL_FX in "operator_line_module.eigs:Error line 8:;     8 |     r is 1 / (;       |            ^;  at <module> (line 8)" \
+                 "operator_line_fn.eigs:Error line 7:;     7 |         b +;       |           ^;  at chain (line 7);  at <module> (line 16)" \
+                 "operator_line_compound.eigs:Error line 6:;     6 |     x += (;       |       ^;  at compound_add (line 6);  at <module> (line 14)"; do
+        OL_FILE=${OL_FX%%:*}; OL_WANT=${OL_FX#*:}
+        OL_OUT=$($EIGS_TMO env $OL_ENV ./eigenscript "../tests/$OL_FILE" </dev/null 2>&1); OL_RC=$?
+        OL_SAN=$(lsan_classify_name "$OL_OUT")
+        OL_MISS=""
+        OL_REST="$OL_WANT;"
+        OL_TAIL=$(printf '%s\n' "$OL_OUT" | sed 's/: .*/:/' | awk -v h="${OL_WANT%%;*}" 'f || $0 == h { f = 1; print }')
+        while [ -n "$OL_REST" ]; do
+            OL_LINE=${OL_REST%%;*}; OL_REST=${OL_REST#*;}
+            grep -qxF -- "$OL_LINE" <<< "$OL_TAIL" || OL_MISS="$OL_MISS [$OL_LINE]"
+        done
+        TOTAL=$((TOTAL + 1))
+        OL_JIT=$(lar_jit_witness "$OL_TIER" "$OL_OUT")
+        if [ "$OL_FILE" = operator_line_compound.eigs ] && [ "$OL_TIER" != EIGS_JIT_OFF=1 ] && [ "$(uname -m)" = x86_64 ]; then
+            grep -Eq "^compound_add +[0-9]+ +yes " <<< "$OL_OUT" || OL_JIT=missing-compound-add
+        fi
+        if [ "$OL_JIT" != ok ]; then
+            FAIL=$((FAIL + 1)); echo "  FAIL: $OL_FILE ($OL_TIER): compiled witness $OL_JIT"
+            printf '%s\n' "$OL_OUT" | eigs_failure_output
+        elif [ "$OL_RC" -eq 1 ] && [ "$OL_SAN" = none ] && [ -z "$OL_MISS" ]; then
+            PASS=$((PASS + 1)); echo "  PASS: header, excerpt, caret and traceback, $OL_FILE ($OL_TIER)"
+        else
+            FAIL=$((FAIL + 1)); echo "  FAIL: $OL_FILE ($OL_TIER, rc=$OL_RC, sanitizer=$OL_SAN) missing:$OL_MISS"
+            printf '%s\n' "$OL_OUT" | eigs_failure_output
