+# #1425 with #1383: successful multiline binaries restore the same tape line
+# in interpreted, function-entry JIT and OSR execution, including both arms.
+define scoped(k, flag) as:
+    local value is k + (
+        1)
+    local branch is value + (flag or
+        value)
