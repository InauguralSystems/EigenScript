{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inauguralsystems.github.io/EigenScript/ai-benchmark/result-schema-v1.json",
  "title": "AI contribution benchmark result v1",
  "type": "object",
  "required": ["schema_version", "inputs", "started_at", "local_completed_at", "remote_first_push", "environment", "adapter", "telemetry", "pricing", "computed_cost", "commands", "precheck_rounds", "changed_test_rounds", "ci_rounds", "commit", "changed_plan_receipt"],
