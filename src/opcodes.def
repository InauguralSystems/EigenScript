/* name, observer class, operand count, then three (verifier role, width) pairs.
 * Keep rows in numeric order: opcode numbers and operand widths are bytecode ABI.
 * New opcodes append at the end; hand-built bytecode hard-codes these numbers.
 * This file is intentionally unguarded and is included with OPCODE defined. */
OPCODE(OP_CONST,                   NONE  , 1, CONST, 16, NONE ,  0, NONE ,  0)
OPCODE(OP_NULL,                    NONE  , 0, NONE ,  0, NONE ,  0, NONE ,  0)
