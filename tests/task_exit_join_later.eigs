# #1736 row 3 (unchanged, #493): a JOINABLE task that dies is held, not fatal.
# Its id is a plain number, so the runtime cannot know a join will not come:
# main carries on past the death, and a LATER try: task_join recovers the
# error. Joined and caught, it no longer fails the process.
# Expected: the worker's trace, MAIN_CONTINUES, RECOVERED, MARK_END, rc 0.
define die() as:
    missing
d is task_spawn of die
task_yield of null
print of f"MAIN_CONTINUES alive={task_alive of d}"
i is 0
loop while i < 1000:
    i is i + 1
task_yield of null
try:
    task_join of d
catch e:
    print of f"RECOVERED {e.kind}"
print of "MARK_END"
