# #1148/#1153: the receiver must never race the sender on buffer storage.
# Reverting the VAL_BUFFER clone makes these synchronized loops access the same
# double concurrently (buf_get versus buf_set), which TSan reports.
data is buffer of 1
buf_set of [data, 0, 1.5]
payload is channel of 1
ready is channel of 1

define reader(args) as:
    local b is recv of args[0]
    send of [args[1], 1]
    local i is 0
    local total is 0
    loop while i < 20000:
        total is total + (buf_get of [b, 0])
        i is i + 1
    return total

send of [payload, data]
h is spawn of [reader, payload, ready]
recv of ready
i is 0
loop while i < 20000:
    buf_set of [data, 0, i]
    i is i + 1
thread_join of h
print of "PASS: transferred buffer storage is independent"
