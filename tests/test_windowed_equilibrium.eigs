# R3.1: numeric equilibrium retains its incumbent full-window tests, with
# zero raw noise floor when every active step is exact; NaN is always false.

print of "=== WINDOWED EQUILIBRIUM (docs/PREDICATES.md, #209) ==="

define want(tag, got, exp) as:
    assert of [got == exp, f"{tag}: equilibrium expected {exp} got {got}"]
    print of f"  PASS: {tag} (equilibrium={got})"

# WE1: a full window at constant 2 has zero mean and variance.
a is 2.0
a is 2.0
a is 2.0
a is 2.0
a is 2.0
a is 2.0
a is 2.0
a is 2.0
a is 2.0
a is 2.0
a is 2.0
want of ["WE1 constant 2 is equilibrium", equilibrium, true]

# WE2: a full window at constant 1e6 also has only zero raw steps.
b is 1000000.0
b is 1000000.0
b is 1000000.0
b is 1000000.0
b is 1000000.0
b is 1000000.0
b is 1000000.0
b is 1000000.0
b is 1000000.0
b is 1000000.0
b is 1000000.0
want of ["WE2 constant 1e6 is equilibrium", equilibrium, true]

# WE3: partial window (count == 9 < N) -> does NOT fire (full-window rule)
c is 2.0
c is 2.0
c is 2.0
c is 2.0
c is 2.0
c is 2.0
c is 2.0
c is 2.0
c is 2.0
c is 2.0
want of ["WE3 partial window does not fire", equilibrium, false]

# WE4: steady one-direction motion is excluded from equilibrium.
d is 30.0
d is 32.0
d is 34.0
d is 36.0
d is 38.0
d is 40.0
d is 42.0
d is 44.0
d is 46.0
d is 48.0
d is 50.0
want of ["WE4 steady drift does not fire (mean)", equilibrium, false]

