# F-string interpolation tests
load_file of "lib/test.eigs"

# Basic interpolation
name is "World"
assert_eq of [f"Hello {name}!", "Hello World!", "basic f-string"]

# Numeric interpolation
x is 42
assert_eq of [f"x is {x}", "x is 42", "numeric f-string"]

# Expression inside braces
assert_eq of [f"doubled: {x * 2}", "doubled: 84", "expr f-string"]

# Multiple interpolations
a is "foo"
b is "bar"
assert_eq of [f"{a} and {b}", "foo and bar", "multi f-string"]

# Empty f-string
assert_eq of [f"", "", "empty f-string"]

# No interpolation (plain f-string)
assert_eq of [f"plain", "plain", "plain f-string"]

# Nested function call in f-string
define double(x) as:
    return x * 2
assert_eq of [f"result: {double of 5}", "result: 10", "fn call in f-string"]

# List length in f-string
items is [1, 2, 3]
assert_eq of [f"count: {len of items}", "count: 3", "len in f-string"]

# String concat comparison
manual is "x is " + (str of x)
interp is f"x is {x}"
assert_eq of [manual, interp, "f-string matches concat"]

# --- #334: whitespace inside the braces must not change the parse ---
w is 5
assert_eq of [f"{ w }", "5", "leading space in interpolation"]
assert_eq of [f"{  w + 1  }", "6", "spaces around expression"]
assert_eq of [f"{w }", "5", "trailing space in interpolation"]

# --- #334: braces inside a nested string literal are text, not nesting ---
assert_eq of [f"{"a}b"}", "a}b", "closing brace inside string"]
assert_eq of [f"{"c{d"}", "c{d", "opening brace inside string"]

# nested f-strings still balance via depth counting
assert_eq of [f"a{f"inner{w}"}b", "ainner5b", "nested f-string"]

# --- #1252: a comment inside an interpolation runs to end of line; braces in
# it are comment text and must not close (or open) the interpolation ---
assert_eq of [f"{1 # }
 + 2}", "3", "closing brace in comment"]
assert_eq of [f"{1 # {
 + 2}", "3", "opening brace in comment"]
assert_eq of [f"{w # }}{{ }
 * 2}", "10", "several braces in comment"]
assert_eq of [f"{1 # comment
 + 2}", "3", "control: brace-free comment"]
assert_eq of [f"{"a#b"}", "a#b", "hash inside a string is not a comment"]
assert_eq of [f"{"#}" + "x"}", "#}x", "hash and brace inside a string"]
assert_eq of [f"n#{w}#", "n#5#", "hash in literal text is text"]
assert_eq of [f"{ {"k": w}["k"] }", "5", "genuine nested braces still balance"]
# same-line comment swallows the closing brace and quote: loud, like `(x # c)`
assert_eq of [try_parse of "print of f\"{w # c}\"", 0, "same-line comment is not a silent value"]
# the two scanners must agree: a `#` or quote inside a NESTED f-string's
# interpolation (review of #1324 — each worked on main and broke when only
# one of the two scans learned comments)
fs_s is "x"
assert_eq of [f"{f"{"#" + fs_s}"}", "#x", "hash string inside a nested interpolation"]
assert_eq of [f"{f"{"a"}{"#"}"}", "a#", "hash string in a second nested interpolation"]
assert_eq of [f"{f"{1 # }
 + 2}"}", "3", "comment with a brace inside a nested interpolation"]
assert_eq of [f"{f"n#{w}"}", "n#5", "hash in nested literal text is text"]
# a same-line comment inside a NESTED interpolation is loud too (review of
# #1325: it swallows the rest of the line, as at top level and in `(x # c)`)
assert_eq of [try_parse of "print of f\"{f\"{w #c}\"}\"\nprint of 1", 0, "same-line comment in a nested interpolation is loud"]

# --- #1253: a brace-bearing string inside a NESTED f-string's interpolation.
# The outer scanner used to treat the nested f"..." as a plain string, stop at
# the inner string's opening quote, and count its brace as nesting. ---
assert_eq of [f"outer:{f"inner:{"a}b"}"}", "outer:inner:a}b", "closing brace in nested string"]
assert_eq of [f"outer:{f"inner:{"a{b"}"}", "outer:inner:a{b", "opening brace in nested string"]
assert_eq of [f"outer:{f"inner:{"abc"}"}", "outer:inner:abc", "control: brace-free nested string"]
assert_eq of [f"<{f"[{f"({"}"})"}]"}>", "<[(})]>", "three levels deep"]
assert_eq of [f"{f"q\"{"}"}\"" + "!"}", "q\"}\"!", "escaped quotes in nested literal text"]
assert_eq of [f"{f"\\{w}"}", "\\5", "escaped backslash before nested interpolation"]
assert_eq of [f"{f"\{x\}"}", "{x}", "escaped braces in nested literal text"]
assert_eq of [f"{f"{ {"k}": w}["k}"] }"}", "5", "dict with brace-bearing keys in nested f-string"]
# malformed nesting still fails with a diagnostic
assert_eq of [try_parse of "print of f\"outer:{f\"inner:{\"a}b\"}\"}", 0, "unterminated nested f-string is loud"]

# --- #1251 / #1337: a physical newline inside a string literal, inside
# f-string literal text, or inside an f-string interpolation is still a
# physical line. Every later token keeps its true line, so `what is x at N`
# and `e.line` key on the right statement. Run through `eval` so the line
# numbers are the eval'd source's own and this file stays line-insensitive. ---
define ml_line_err(src) as:
    local ln is -1
    try:
        eval of src
    catch mle:
        ln is mle.line
    return ln
assert_eq of [eval of "s is \"a\nb\"\nx is 10\nx is 20\nwhat is x at 3", 10, "multi-line string: at N is the physical line"]
assert_eq of [eval of "s is \"a\\nb\"\n\nx is 10\nx is 20\nwhat is x at 3", 10, "control: escaped newline + blank line"]
assert_eq of [eval of "s is f\"a\nb\"\nx is 10\nx is 20\nwhat is x at 3", 10, "multi-line f-string text: at N is the physical line"]
assert_eq of [eval of "s is f\"a\\nb\"\n\nx is 10\nx is 20\nwhat is x at 3", 10, "control: escaped newline in f-string text"]
assert_eq of [eval of "s is \"a\n\n\nb\"\nx is 10\nx is 20\nwhat is x at 5", 10, "several literal newlines each advance the line"]
assert_eq of [eval of "s is f\"a\n{1}\nb{2}\n\"\nx is 10\nx is 20\nwhat is x at 5", 10, "f-string newlines around interpolations"]
assert_eq of [eval of "s is \"a\\\nb\"\nx is 10\nx is 20\nwhat is x at 3", 10, "backslash before a physical newline still advances the line"]
assert_eq of [ml_line_err of "s is \"a\nb\"\nq is 1 / 0", 3, "e.line after a multi-line string"]
assert_eq of [ml_line_err of "s is f\"a\nb\"\nq is 1 / 0", 3, "e.line after a multi-line f-string"]
assert_eq of [ml_line_err of "s is \"a\\nb\"\nq is 1 / 0", 2, "control: escapes do not advance the line"]
assert_eq of [len of (eval of "\"a\n\nb\""), 4, "multi-line string keeps its bytes"]
assert_eq of [eval of "f\"a\n{1 + 1}\nb\"", "a\n2\nb", "multi-line f-string keeps its bytes"]
# #1337: the spliced sub-lex of an interpolation applies no indentation rule
assert_eq of [eval of "f\"{  1 +\n 2}\"", "3", "unaligned continuation line in an interpolation"]
assert_eq of [eval of "f\"{1 +\n        2}\"", "3", "deeper continuation line in an interpolation"]
assert_eq of [eval of "f\"<{f\"{  1 +\n 2}\"}>\"", "<3>", "unaligned continuation in a nested interpolation"]
assert_eq of [ml_line_err of "x is f\"{1 +\n 2}\"\nq is 1 / 0", 3, "e.line after a multi-line interpolation"]
assert_eq of [ml_line_err of "x is f\"{1 +\n\n 2}\"\ny is 1\nq is 1 / 0", 5, "e.line after a two-newline interpolation"]
assert_eq of [ml_line_err of "x is f\"{1 +\n (1 / 0)}\"", 2, "an error inside an interpolation reports its own line"]
assert_eq of [eval of "x is f\"{1 +\n 2}\"\nx is 10\nx is 20\nwhat is x at 3", 10, "at N after a multi-line interpolation"]
assert_eq of [eval of "s is f\"a\\\nb\"\nx is 10\nx is 20\nwhat is x at 3", 10, "backslash before a physical newline in f-string text advances the line"]
# #1251 round 2: the multi-line literal's OWN statement is filed under its own
# line, not the line the literal closes on (a node took the NEXT token's line)
assert_eq of [eval of "x is 5\nx is \"a\nb\"\nwhat is x at 2", "a\nb", "multi-line string: its own statement at its first line"]
assert_eq of [eval of "x is 5\nx is f\"a\nb\"\nwhat is x at 2", "a\nb", "multi-line f-string text: its own statement"]
assert_eq of [eval of "x is 5\nx is f\"a\nb{1}\"\nwhat is x at 2", "a\nb1", "f-string with an interpolation after a newline: its own statement"]
assert_eq of [eval of "x is 5\nx is f\"{1 +\n 2}\"\nwhat is x at 2", "3", "multi-line interpolation: its own statement"]
assert_eq of [eval of "x is 5\nx is [1,\n2]\nwhat is x at 2", [1, 2], "multi-line list literal: its own statement"]
assert_eq of [eval of "x is 5\nx is [\n]\nwhat is x at 2", [], "empty list closing on a later line: its own statement"]
assert_eq of [eval of "x is 5\nx is {\"a\": 1\n}\nwhat is x at 2", {"a": 1}, "dict closing on a later line: its own statement"]
# the literal is the last thing stamped before the raising op, so e.line is
# the literal's own line, not the line of the token after it
assert_eq of [ml_line_err of "y is 0\nz is -\"a\nb\"", 2, "e.line: negating a multi-line string"]
assert_eq of [ml_line_err of "y is 0\nz is -([\n])", 2, "e.line: negating a list closed on a later line"]
assert_eq of [ml_line_err of "y is 0\nz is -({\n})", 2, "e.line: negating a dict closed on a later line"]
assert_eq of [ml_line_err of "y is 0\nz is ~(null\n)", 2, "e.line: complementing null closed on a later line"]
assert_eq of [ml_line_err of "y is 0\nz is [1][(5\n)]", 2, "e.line: indexing with a number closed on a later line"]
assert_eq of [ml_line_err of "define f(xs) as:\n    z is [xs[0].k\n]\n    return z\nf of [[5]]", 2, "e.line: local[const].field closed on a later line"]
assert_eq of [ml_line_err of "define f(a) as:\n    z is [a.k\n]\n    return z\nf of 5", 2, "e.line: local.field closed on a later line"]

# --- #1381 round 5: every store that writes assignment history is filed under
# its statement's FIRST line, not the line the value (or a loop body, a catch
# target, an imported module) left the stamp on. ---
assert_eq of [eval of "a is 0\nb is 0\n[a, b] is [1,\n 2]\nwhat is a at 3", 1, "destructuring spanning lines: first name at its first line"]
assert_eq of [eval of "a is 0\nb is 0\n[a, b] is [1,\n 2]\nwhat is b at 3", 2, "destructuring spanning lines: second name at its first line"]
assert_eq of [eval of "for i in [1,\n 2]:\n    q is i\nwhat is i at 1", 2, "for over a multi-line iterable: loop variable at the for line"]
assert_eq of [eval of "i is 0\nfor i in [1, 2, 3]:\n    x is 0\n    y is 0\nwhat is i at 2", 3, "for: every iteration's loop variable at the for line"]
assert_eq of [eval of "define f() as:\n    for i in [1,\n 2]:\n        x is i\n    return (what is i at 2)\nf of []", 2, "for inside a function: loop variable at the for line"]
assert_eq of [eval of "i is 0\nz is [i for i in\n [5]]\nwhat is i at 2", 5, "comprehension spanning lines: variable at its first line"]
assert_eq of [eval of "define f(a, b is [1,\n 2]) as:\n    return (what is b at 1)\nf of 5", [1, 2], "default spanning lines: parameter at its first line"]
assert_eq of [eval of "e is 0\ntry:\n    q is 1 / 0\ncatch e:\n    y is 1\nwhat is e at 3", 0, "catch binding is not filed under the faulting line"]
assert_eq of [eval of "import log\nhas_key of [(what is log at 1), \"log_info\"]", 1, "import binding at the import line"]
# the #1064 binder restore after a function-scope `for` writes the outer
# binding's history: it is filed under the `for` line, on normal exit and on
# `break`, not under the body's (or the break's) last line
assert_eq of [eval of "define f(i) as:\n    for i in [1, 2, 3]:\n        x is i\n        y is 0\n    return [(what is i at 2), (what is i at 4), i]\nf of 0", [0, 0, 0], "for restore in a function: filed under the for line"]
assert_eq of [eval of "define f(i) as:\n    for i in [1, 2, 3]:\n        if i == 2:\n            break\n        y is 0\n    return [(what is i at 2), (what is i at 4), i]\nf of 0", [0, 0, 0], "for restore after break: filed under the for line"]
assert_eq of [eval of "i is 0\nfor i in [1, 2, 3]:\n    x is i\n    y is 0\n[(what is i at 2), (what is i at 4), i]", [3, 3, 0], "module-scope for: no restore is recorded (pin)"]
# a call in the value runs the callee's own lines: a call-valued store is
# filed under its statement's line, not the callee's return line
assert_eq of [eval of "define r7f() as:\n    return 7\nr7x is r7f of null\n[(what is r7x at 2), (what is r7x at 3)]", [null, 7], "call-valued assignment: not filed under the callee's line"]
assert_eq of [eval of "define r7g() as:\n    return [1, 2]\nr7a is 0\nr7b is 0\n[r7a, r7b] is r7g of null\n[(what is r7a at 2), (what is r7b at 2), (what is r7a at 5)]", [null, null, 1], "call-valued destructuring: not filed under the callee's line"]
assert_eq of [eval of "define r7h() as:\n    return 7\ndefine r7k(r7p, r7q is r7h of null) as:\n    return [(what is r7q at 2), (what is r7q at 3)]\nr7k of 1", [null, 7], "call-valued default: not filed under the callee's line"]

# --- #1322: f-string interpolation converts with the BUILTIN string
# conversion, whatever `str` is bound to. The lexer lowers `{e}` to a call of
# a reserved name no source can spell (it contains `#`), so a user binding of
# `str` in any scope reaches only the user's own `str of` calls. ---
_fs_saved_str is str
assert_eq of [eval of "str is 3\nf\"<{str}>\"", "<3>", "#1322: a global `str is 3` does not break f-strings"]
str is _fs_saved_str
_fs_define is eval of "define str(x) as:\n    return \"HIJACK\"\nf\"<{5}>\""
_fs_own is str of 5
str is _fs_saved_str
assert_eq of [_fs_define, "<5>", "#1322: a global `define str` does not hijack f-strings"]
assert_eq of [_fs_own, "HIJACK", "#1322: a user `define str` still answers the user's own calls"]
assert_eq of [str of 5, "5", "#1322: the builtin `str` is untouched"]
define _fs_param_str(str) as:
    return [f"<{7}>", str]
assert_eq of [_fs_param_str of 3, ["<7>", 3], "#1322: a function parameter named `str` does not reach f-strings"]
define _fs_local_str() as:
    local str is (x) => "LOCAL"
    return [f"<{8}>", str of 8]
assert_eq of [_fs_local_str of null, ["<8>", "LOCAL"], "#1322: a function-local `str` does not reach f-strings"]
import fstr_str_mod
assert_eq of [(fstr_str_mod.show of 9), "<9>", "#1322: a module that rebinds `str` keeps builtin f-strings (in a function)"]
assert_eq of [fstr_str_mod.direct, "[2]", "#1322: a module that rebinds `str` keeps builtin f-strings (top level)"]
assert_eq of [fstr_str_mod.own, "MODHIJACK", "#1322: the module's own `str of` sees its own binding"]
# the reserved name cannot be bound by a door that takes a STRING name either
fstr_str_mod["_#fstr"] is (x) => "NS"
assert_eq of [(fstr_str_mod.show of 9), "<9>", "#1322: a namespace write of the reserved name stays out of the module env"]
# CONST 0; SET_NAME 1; POP; CONST 0; RETURN with constants [3, "_#fstr"]
_fs_bc is vm_run_bytecode of [1, [0, 0, 0, 26, 1, 0, 35, 0, 0, 0, 40], [3, "_#fstr"]]
assert_eq of [_fs_bc, null, "#1322: assembled bytecode that SETs the reserved name is refused"]
assert_eq of [f"<{5}>", "<5>", "#1322: f-strings after the refused SET_NAME"]

test_summary of null
