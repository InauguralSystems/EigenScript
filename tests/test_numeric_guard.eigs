# Regression: EigenScript numeric values must stay finite.
# NaN collapses to 0; overflow and infinity saturate to +/-1e308.

CAP is 1e308

# N13 / R1.6d: final data/byte/index readers refuse raw nonfinite cells.
define ng_final_refuses(operation, argument, label) as:
    local refused is false
    try:
        operation of argument
    catch e:
        refused is e.kind == "value"
    assert of [refused, label]


# Sticky math_flags coverage runs in fresh processes via test_numeric_guard_flags.sh.

# Values themselves are not sticky and belong in this shared program.
reassoc is (1e300 * 1e300) / 1e300
assert of [reassoc == 100000000, "NG23 reassociated result is unchanged"]
other is 1e300 * (1e300 / 1e300)
assert of [other == 1e300, "NG24 the other order is exact"]
capped_operand is 0.0 * 1e400
assert of [capped_operand == 0, "NG26 an over-range literal is capped before use"]
lt is log of 1e-15
assert of [lt == (0 - 34.538776394910684), "NG27a log of 1e-15 is exact, not floored"]
l10 is log of 1e-10
assert of [l10 == (0 - 23.025850929940457), "NG27b log of 1e-10 is exact"]

caught_zdiv is 0
try:
    zdiv is 10 / 0
catch e:
    caught_zdiv is 1
assert of [caught_zdiv == 1, "NG1 10/0 raises"]

tiny_div is 1 / 1e-320
assert of [tiny_div == CAP, "NG2 near-zero division caps"]

root_neg is sqrt of -1
assert of [root_neg == 0, "NG3 sqrt negative returns 0"]

pow_inf is pow of [0, -1]
assert of [pow_inf == CAP, "NG4 pow singular caps"]

exp_inf is exp of 999999
assert of [exp_inf == CAP, "NG5 exp overflow caps"]

asin_hi is asin of 5
assert of [(asin_hi > 1.5707) and (asin_hi < 1.5709), "NG6 asin clamps high domain"]

acos_lo is acos of -2
assert of [(acos_lo > 3.1415) and (acos_lo < 3.1417), "NG7 acos clamps low domain"]

mul_inf is 1e308 * 2
assert of [mul_inf == CAP, "NG8 multiply overflow caps"]

caught_zz is 0
try:
    zero_zero is 0 / 0
catch e:
    caught_zz is 1
assert of [caught_zz == 1, "NG9 0/0 raises"]

tensor_tiny_div is divide of [1, 1e-320]
assert of [tensor_tiny_div == CAP, "NG10 tensor near-zero division caps"]

literal_inf is 1e309
assert of [literal_inf == CAP, "NG11 overflowing literal caps"]

# N10: these are invalid grammar in both strict modes, not float sources.
for invalid_text in ["nan", "inf"]:
    refused is false
    try:
        num of invalid_text
    catch e:
        refused is e.kind == "value"
    assert of [refused, "N10 non-literal numeric text raises"]

neg_mul_inf is -1e308 * 2
assert of [neg_mul_inf == (0 - CAP), "NG14 negative overflow caps"]

reassign_inf is 0
reassign_inf is 1e309
assert of [reassign_inf == CAP, "NG15 reassignment literal caps"]

reassign_inf is -1e309
assert of [reassign_inf == (0 - CAP), "NG16 reassignment negative literal caps"]

box is {"x": 0}
box.x is 1e309
assert of [box.x == CAP, "NG17 dot reassignment literal caps"]

box.x is -1e309
assert of [box.x == (0 - CAP), "NG18 dot reassignment negative literal caps"]

unobserved_inf is 0
unobserved:
    unobserved_inf is 1e309
assert of [unobserved_inf == CAP, "NG19 unobserved reassignment literal caps"]


# #1417: tensor kernels may hold an intermediate IEEE infinity in their
# unboxed result buffer. Every language-level read must use the finite
# data boundary, independent of which opcode consumes the scalar.
raw_inf_input is buffer of 4
raw_inf_input[0] is 1e300
raw_inf_input[1] is 1e300
raw_inf_input[2] is 1e300
raw_inf_input[3] is 1e300
raw_inf_matrix is reshape of [raw_inf_input, 2, 2]
raw_inf_product is matmul of [raw_inf_matrix, raw_inf_matrix]
define ng_read_cmp(b) as:
    return b[0] > CAP
define ng_read_div(b) as:
    return b[0] / b[1]
define ng_read_mod(b) as:
    return b[0] % 3
define ng_read_mul(b) as:
    return b[0] * 0.5 > CAP
define ng_read_add(b) as:
    return b[0] + 0 > CAP
define ng_read_zero(b) as:
    return b[0]
ng_final_refuses of [ng_read_cmp, raw_inf_product, "NG31 N13 indexed comparison refuses infinity"]
ng_final_refuses of [ng_read_div, raw_inf_product, "NG31 N13 indexed division refuses infinity"]
ng_final_refuses of [ng_read_mod, raw_inf_product, "NG31 N13 indexed modulo refuses infinity"]
ng_final_refuses of [ng_read_mul, raw_inf_product, "NG31 N13 indexed multiply refuses infinity"]
ng_final_refuses of [ng_read_add, raw_inf_product, "NG31 N13 indexed addition refuses infinity"]
ng_final_refuses of [ng_read_zero, raw_inf_product, "NG31 N13 index refuses infinity"]
ng_final_refuses of [buf_get, [raw_inf_product, 0], "NG31 N13 buf_get refuses infinity"]

# A NaN uses the same refusing data boundary as infinity. Every
# accessor refuses nonfinite data; none may leak the NaN-box null
# tag merely because it bypasses make_num.
nan_left is buffer of [1, 2]
nan_left[0] is 1e200
nan_left[1] is 1e200
nan_right is buffer of [2, 1]
nan_right[0] is 1e200
nan_right[1] is 0 - 1e200
raw_nan_product is matmul of [nan_left, nan_right]
ng_final_refuses of [ng_read_zero, raw_nan_product, "NG32 N13 indexed NaN refuses"]
ng_final_refuses of [buf_get, [raw_nan_product, 0], "NG33 N13 buf_get refuses NaN"]
# N13 / R1.6c: get_at now uses the final finite-only buffer reader.
ng_get_at_refused is false
try:
    get_at of [raw_nan_product, 0]
catch e:
    ng_get_at_refused is e.kind == "value"
assert of [ng_get_at_refused, "NG34 N13 get_at refuses non-finite payload"]
nan_gathered is gather of [raw_nan_product, [0]]
ng_final_refuses of [ng_read_zero, nan_gathered, "NG35 N13 gathered NaN refuses on read"]

# R1.6z-D1: structural comparisons use stored IEEE doubles; reductions use their declared data readers.
pair_left is buffer of [1, 1]
pair_left[0] is 1e200
pair_right is buffer of [1, 2]
pair_right[0] is 1e200
pair_right[1] is 0 - 1e200
raw_pair is matmul of [pair_left, pair_right]
finite_pair is buffer of 2
finite_pair[0] is CAP
finite_pair[1] is 0 - CAP
assert of [raw_pair != finite_pair, "NG36 IEEE equality distinguishes infinity from finite"]
assert of [not (list_contains of [[raw_pair], finite_pair]), "NG36 list_contains shares IEEE equality"]
assert of [(list_index_of of [[raw_pair], finite_pair]) == -1, "NG36 list_index_of shares IEEE equality"]
# N13 / R1.6b: sum now crosses the final float-reader boundary, which
# refuses non-finite buffer payloads in both strict modes. Other reductions
# keep their earlier normalization policy until their own reader migration.
define ng_sum_refuses_nonfinite(tensor_input, label) as:
    local refused is false
    try:
        sum of tensor_input
    catch e:
        refused is e.kind == "value"
    assert of [refused, label]
ng_sum_refuses_nonfinite of [raw_pair, "NG37 N13 sum refuses non-finite elements before cancellation"]
ng_final_refuses of [mean, raw_pair, "NG37 N13 mean refuses non-finite input"]
assert of [raw_nan_product != raw_nan_product, "NG38 IEEE NaN buffer differs from itself"]
zero_one is buffer of 1
assert of [raw_nan_product != zero_one, "NG39 IEEE NaN differs from zero"]
zero_pair is buffer of 2
# N13 / R1.6c: dot also refuses instead of substituting finite operands.
ng_dot_refused is false
try:
    dot of [raw_pair, zero_pair]
catch e:
    ng_dot_refused is e.kind == "value"
assert of [ng_dot_refused, "NG40 N13 dot refuses non-finite payload"]
ng_final_refuses of [buf_dot, [raw_pair, zero_pair, 0, 0, 2], "NG41 N13 buf_dot refuses infinity"]
ng_final_refuses of [buf_peak, [raw_nan_product, 0, 1], "NG42 N13 buf_peak refuses NaN"]

# Ordinary finite/empty controls preserve the pre-existing reduction policies.
finite is buffer of 2
finite[0] is 3
finite[1] is 4
finite_copy is buffer of 2
finite_copy[0] is 3
finite_copy[1] is 4
assert of [finite == finite_copy, "NG43 finite structural equality"]
assert of [finite == finite, "NG43 finite identity equality"]
finite_copy[1] is 5
assert of [finite != finite_copy, "NG43 unequal finite elements"]
assert of [finite != zero_one, "NG43 unequal buffer lengths"]
assert of [(sum of finite) == 7, "NG44 finite sum"]
assert of [(mean of finite) == 3.5, "NG44 finite mean"]
assert of [(norm of finite) == 5, "NG44 finite norm"]
empty is buffer of 0
assert of [(sum of empty) == 0, "NG45 empty sum"]
assert of [(mean of empty) == 0, "NG45 empty mean"]
assert of [(norm of empty) == 0, "NG45 empty norm"]
# N3/C2: empty sum becomes int, while a wrong-type soft stand-in keeps its
# original float kind. This fixture runs with EIGS_STRICT=0.
sum_soft_wrong_type is sum of "hello"
assert of [sum_soft_wrong_type == 0 and (num_type of sum_soft_wrong_type) == "float", "NG45 N3 sum preserves the legacy float-zero type fallback"]
short is buffer of 1
short[0] is 2
assert of [(dot of [finite, short]) == 6, "NG46 dot retains shorter-length policy"]
assert of [(buf_dot of [finite, finite_copy, 0, 1, 1]) == 15, "NG47 windowed dot keeps distinct offsets"]
assert of [(buf_peak of [finite, 1, 1]) == 4, "NG47 peak keeps its window"]
assert of [(buf_dot of [finite, finite_copy, 2, 2, 0]) == 0, "NG48 empty dot window"]
assert of [(buf_peak of [finite, 2, 0]) == 0, "NG48 empty peak window"]

# A containing list follows its reduction's reader policy (N13 for sum).
ng_sum_refuses_nonfinite of [([raw_pair]), "NG49 N13 nested sum refuses non-finite elements"]
ng_final_refuses of [mean, ([raw_pair]), "NG49 N13 nested mean refuses infinity"]
ng_final_refuses of [norm, ([raw_pair]), "NG49 N13 nested norm refuses infinity"]
ng_sum_refuses_nonfinite of [([raw_nan_product]), "NG50 N13 nested sum refuses NaN"]
ng_final_refuses of [mean, ([raw_nan_product]), "NG50 N13 nested mean refuses NaN"]
ng_final_refuses of [norm, ([raw_nan_product]), "NG50 N13 nested norm refuses NaN"]
assert of [(sum of ([finite])) == 7, "NG51 nested finite sum"]
assert of [(mean of ([finite])) == 3.5, "NG51 nested finite mean"]
assert of [(norm of ([finite])) == 5, "NG51 nested finite norm"]
assert of [(sum of ([empty])) == 0, "NG51 nested empty sum"]
assert of [(mean of ([empty])) == 0, "NG51 nested empty mean"]
assert of [(norm of ([empty])) == 0, "NG51 nested empty norm"]

# N5 indices refuse nonfinite values in both strict modes.
index_dst is buffer of 1
index_dst[0] is 10
ng_final_refuses of [scatter_add, [index_dst, raw_nan_product, 5], "NG52 N5 nonfinite scatter index refuses"]
assert of [index_dst[0] == 10, "NG52 refusal leaves destination unchanged"]
index_matrix is buffer of [1, 1]
index_matrix[0] is 7
ng_final_refuses of [gather, [index_matrix, raw_nan_product], "NG53 N5 nonfinite gather index refuses"]

# Numeric byte decoders enforce N5/Q1 before converting; buffers retain
# their raw work-area representation until the decoder reads a cell.
ng_final_refuses of [str_from_bytes, buf_from_list of [65.75, 321, -191], "NG54 N5/Q1 refuses fractional byte"]
assert of [(f64_from_bytes of (buf_from_list of (f64_to_bytes of 12.5))) == 12.5, "NG54 finite f64 byte round trip"]
ng_final_refuses of [str_from_bytes, raw_nan_product, "NG55 N13 refuses nonfinite buffer input"]
# #1926: keep eight NaNs in buffer storage; indexing would normalize first.
ng56_left is buffer of [8, 2]
for i in range of 16:
    ng56_left[i] is 1e200
ng56_right is buffer of [2, 1]
ng56_right[0] is 1e200
ng56_right[1] is 0 - 1e200
ng56_raw is matmul of [ng56_left, ng56_right]
ng56_refused is false
ng56_length_error is false
try:
    f64_from_bytes of ng56_raw
catch e:
    ng56_refused is e.kind == "value"
    ng56_length_error is (index_of of [e.message, "needs 8 bytes"]) >= 0
assert of [ng56_refused and not ng56_length_error, "NG56 N13 refuses nonfinite buffer input, not length"]
ng_final_refuses of [str_from_bytes, raw_pair, "NG57 N13 refuses nonfinite buffer input"]
ng_final_refuses of [buf_to_pcm16le, [raw_nan_product, 0, 1], "NG58 N13 refuses nonfinite buffer input"]
ng_final_refuses of [buf_to_pcm16le, [raw_pair, 0, 2], "NG59 N13 refuses nonfinite buffer input"]

# Mixed buffer/list results box each buffer element before arithmetic.
# Shaped buffers keep their matrix rows when boxed into nested lists.
finite_mixed_cell is buffer of [1, 1]
finite_mixed_cell[0] is 10
assert of [(add of [finite_mixed_cell, [2]]) == [[12]], "NG60 shaped mixed finite cell retains its row"]
finite_mixed_row is buffer of [1, 2]
finite_mixed_row[0] is 3
finite_mixed_row[1] is 0 - 3
assert of [(add of [finite_mixed_row, [0, 0]]) == [[3, 0 - 3]], "NG60 shaped mixed finite row retains its row"]
assert of [(add of [finite, [1, 2]]) == [4, 6], "NG60 finite mixed tensor left"]
assert of [(add of [[1, 2], finite]) == [4, 6], "NG60 finite mixed tensor right"]
assert of [(add of [empty, []]) == [], "NG60 empty mixed tensor"]
assert of [(add of [raw_nan_product, [2]]) == [[2]], "NG61 non-strict mixed NaN is zero"]
assert of [(add of [raw_pair, [0, 0]]) == [[CAP, 0 - CAP]], "NG62 mixed materialization clamps both infinity signs"]

print of "All numeric-guard tests passed"
