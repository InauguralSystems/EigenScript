# #1141 shape 5: THREE workers interning keys at the same time, each into its
# OWN dict (concurrent writes to one dict would be a user data race, which is
# undefined per #1152 — this probe is about the shared intern table, not about
# dict-array safety). The dicts are the parent's and outlive every worker.
a is {}
b is {}
c is {}
define worker(d) as:
    local i is 0
    loop while i < 12:
        d["k_" + (str of i)] is i
        i is i + 1
    return 0
h1 is spawn of [worker, a]
h2 is spawn of [worker, b]
h3 is spawn of [worker, c]
thread_join of h1
thread_join of h2
thread_join of h3
print of f"KEYS 12 {join of [keys of a, "|"]}"
print of f"KEYS 12 {join of [keys of b, "|"]}"
print of f"KEYS 12 {join of [keys of c, "|"]}"
print of f"VALS 3 {a.k_0}|{b.k_11}|{c.k_7}"
