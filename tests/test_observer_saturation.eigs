# #861 / R2.2 N11: overflow is infinity, never a clamped rest state.
# Keep the original runaway, negative runaway, geometric-decay and finite
# constant scenarios. IEEE non-finite trajectories cannot certify rest;
# a finite 1e308 constant now converges just like the 1e307 control.

pass is 1

define fail(msg) as:
    pass is 0
    print of ("FAIL: " + msg)
    return 0

# The issue's repro: z = z*z from 2.0 overflows, then stays infinite.
define run_runaway() as:
    local z is 2.0
    local k is 0
    loop while k < 20:
        z is z * z
        k is k + 1
    return [report of z, report_value of z, converged of z, diverging of z,
            stable of z, equilibrium of z, improving of z, z]

# Same runaway with the sign flipped every step — reaches negative infinity.
define run_negative() as:
    local z is 0 - 2.0
    local k is 0
    loop while k < 20:
        z is z * z * (0 - 1.0)
        k is k + 1
    return [report of z, diverging of z, z]

# Geometric decay — genuinely settles, and must still be certified.
define run_converge() as:
    local x is 100.0
    local k is 0
    loop while k < 40:                 # #1045: settles once ten steps sit under
        x is x * 0.5                   # dh_zero*scale = 1e-6 (k >= 37); at 30
        k is k + 1                     # it was still `improving` at x = 9e-8
    return [report of x, converged of x]

# The 1e307 constant is a finite non-divergence control.
define run_below_ceiling() as:
    local b is 1e307
    local k is 0
    loop while k < 12:
        b is 1e307
        k is k + 1
    return [report of b, converged of b, diverging of b]

# R2.2: 1e308 is an ordinary finite constant, with no ceiling special case.
define run_literal_ceiling() as:
    local c is 1e308
    local k is 0
    loop while k < 12:
        c is 1e308
        k is k + 1
    return [report of c, converged of c]

# --- Case 1: the runaway is diverging in both channels, and in no rest band.
r is run_runaway of null
print of ("runaway: report=" + r[0] + " report_value=" + r[1] + " value=" + (str of r[7]))
if not (r[7] == (1.0 / 0)):
    fail of "runaway did not reach infinity — repro no longer valid"
if not (r[0] == "diverging"):
    fail of ("entropy channel: expected 'diverging', got " + r[0])
if not (r[1] == "diverging"):
    fail of ("value channel: expected 'diverging', got " + r[1])
if not (r[2] == false):
    fail of "converged certified an infinite value"
if not (r[3] == true):
    fail of "diverging did not claim an infinite value"
if not (r[4] == false):
    fail of "stable certified an infinite value"
if not (r[5] == false):
    fail of "equilibrium certified an infinite value"
if not (r[6] == false):
    fail of "improving claimed an infinite value"

# --- Case 2: the negative infinity behaves identically.
n is run_negative of null
print of ("negative: report=" + n[0] + " value=" + (str of n[2]))
if not (n[2] == (-1.0 / 0)):
    fail of "negative runaway did not reach negative infinity"
if not (n[0] == "diverging"):
    fail of ("negative infinity: expected 'diverging', got " + n[0])
if not (n[1] == true):
    fail of "diverging did not claim the negative infinity"

# --- Case 3: genuine convergence is untouched (the non-regression half).
c is run_converge of null
print of ("decay: report=" + c[0])
if not (c[0] == "converged"):
    fail of ("geometric decay lost its 'converged' verdict, got " + c[0])
if not (c[1] == true):
    fail of "converged predicate lost a genuine convergence"

# --- Case 4: the 1e307 constant is not diverging.
# Preserve the original single assertion for this control; case 5 pins the
# newly reachable convergence verdict at the former clamp boundary.
b is run_below_ceiling of null
print of ("below-ceiling: report=" + b[0] + " (verdict not asserted — #861)")
if not (b[2] == false):
    fail of "a finite 1e307 constant was classified as diverging"

# --- Case 5: the finite 1e308 constant converges under R2.2.
l is run_literal_ceiling of null
print of ("literal-ceiling: report=" + l[0])
if not (l[0] == "converged"):
    fail of ("finite 1e308 constant: expected 'converged', got " + l[0])
if not (l[1] == true):
    fail of "converged did not certify the finite 1e308 constant"

if pass == 1:
    print of "OBSERVER_SATURATION_ALL_PASS"
else:
    print of "SOME TESTS FAILED"
