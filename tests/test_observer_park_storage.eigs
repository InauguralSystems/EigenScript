# #1621: parked call environments may retain only the outer ObserverSlot
# allocation. Every invocation must nevertheless behave like fresh bindings:
# no history, route flags, previous values, or per-binding window override may
# cross the call boundary. This exercises the real call-cache take/park path.

load_file of "lib/test.eigs"

# Minimal calibration path, deliberately shaped like the original cache
# regression: fewer than the default window's samples in one eligible call.
# Omitting the bounded reset makes the second assertion below fail (or trips a
# freed-ring sanitizer diagnostic) through vm_take_call_env, not a mock helper.
define stale_history_probe() as:
    local tracked is 0.001
    tracked is 0.001
    tracked is 0.001
    tracked is 0.001
    tracked is 0.001
    tracked is 0.001
    return converged of tracked

local stale_first is stale_history_probe of null
local stale_second is stale_history_probe of null
assert_eq of [stale_first, false, "stale-history first cached-path call"]
assert_eq of [stale_second, false, "stale-history/override actual cached-call path"]

local probe_mode is 0
local probe_seed is 0
# x is a name-bound parameter inside the fixed frame. String window APIs
# can resolve its slot without introducing an extra dynamic-name binding.
# Parameter binding does not sample the observer: keep the explicit first write.
define probe(x) as:
    local mode is probe_mode
    local seed is x
    x is seed
    local y is seed + 100
    if mode == 1:
        set_observer_window of ["x", 4]
    x is seed
    x is seed
    unobserved:
        x is seed
    x is seed
    x is seed
    y is seed + 100
    y is seed + 100
    # #1637: converged is a bool; encode it as a digit explicitly.
    local cx is 0
    if converged of x:
        cx is 1
    local cy is 0
    if converged of y:
        cy is 1
    return cx * 1000 + cy * 100 + (get_observer_window of "x")

# First fill a short overridden window. The next two calls are the named
# stale-history/override assertion: each has fewer than ten observed x samples, so a fresh
# default-10 trajectory cannot converge and its effective window is 10.
probe_mode is 1
probe_seed is 0.001
local warm is probe of probe_seed
probe_mode is 0
probe_seed is 2.0
local stale_history is probe of probe_seed
probe_seed is 3.0
local again is probe of probe_seed
assert_eq of [warm, 1004, "warm override"]
assert_eq of [stale_history, 10,
                "stale-history/override after observed-unobserved-observed call"]
assert_eq of [again, 10, "fresh settings on repeated cached call"]

# The interrogated binding is already the fixed, name-bound parameter.
# Keep the two explicit writes so prev has the same 11/29 expectations.
define previous_probe(p) as:
    local seed is p
    p is seed - 1
    p is seed
    return prev of p

assert_eq of [previous_probe of 12, 11, "fresh previous value on first call"]
assert_eq of [previous_probe of 30, 29, "fresh previous value on repeated call"]

local unwind_should_throw is 0
local unwind_seed is 0
# The override-bearing parameter is fixed/name-bound too. Normal return
# can park this frame; exception unwinding destroys the taken frame instead.
define unwind_probe(a) as:
    local should_throw is unwind_should_throw
    local seed is a
    a is seed
    if should_throw:
        set_observer_window of ["a", 4]
    a is seed
    a is seed
    a is seed
    a is seed
    if should_throw:
        throw of "ordinary unwind"
    local ca is 0
    if converged of a:
        ca is 1
    return ca * 100 + (get_observer_window of "a")

# Park a real normal call first. The next throwing call must take that cache;
# after the throw destroys its env, the following normal call starts fresh.
unwind_should_throw is 0
unwind_seed is 0.001
local before_unwind is unwind_probe of unwind_seed
assert_eq of [before_unwind, 10, "normal unwind probe warms actual cache"]

try:
    unwind_should_throw is 1
    unwind_seed is 0.001
    unwind_probe of unwind_seed
catch err:
    assert_eq of [err, "ordinary unwind", "ordinary exception value"]

unwind_should_throw is 0
unwind_seed is 7.0
local after_unwind is unwind_probe of unwind_seed
assert_eq of [after_unwind, 10, "fresh history after ordinary unwind"]

print of "OBS_PARK_STORAGE_OK"
test_summary of null
