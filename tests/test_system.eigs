# Tests for random, args, path, filesystem builtins
load_file of "lib/test.eigs"

# ---- random ----
r1 is random of null
assert of [r1 >= 0, "RD1 random >= 0"]
assert of [r1 < 1, "RD2 random < 1"]

ri is random_int of [5, 10]
assert of [ri >= 5, "RI1 random_int >= lo"]
assert of [ri <= 10, "RI2 random_int <= hi"]

# #725: span exactly 2^31 is the widest range lrand48 can serve — must NOT raise
ri_max is random_int of [0, 2147483647]
assert of [ri_max >= 0, "RI3 random_int boundary span >= lo"]
assert of [ri_max <= 2147483647, "RI4 random_int boundary span <= hi"]

seed_random of 99
a is random of null
seed_random of 99
b is random of null
assert of [a == b, "RS1 seeded random is deterministic"]

# ---- args ----
a is args of null
assert of [(type of a) == "list", "AR1 args returns list"]

# ---- path_join ----
assert of [(path_join of ["/home", "test"]) == "/home/test", "PJ1 basic join"]
assert of [(path_join of ["/home/", "/test"]) == "/home/test", "PJ2 strip slashes"]
assert of [(path_join of ["a", "b"]) == "a/b", "PJ3 relative"]

# ---- path_dir ----
assert of [(path_dir of "/a/b/c.txt") == "/a/b", "PD1 dir"]
assert of [(path_dir of "file.txt") == ".", "PD2 no slash"]
assert of [(path_dir of "/file.txt") == "/", "PD3 root"]

# ---- path_base ----
assert of [(path_base of "/a/b/c.txt") == "c.txt", "PB1 base"]
assert of [(path_base of "file.txt") == "file.txt", "PB2 no slash"]

# ---- path_ext ----
assert of [(path_ext of "test.eigs") == ".eigs", "PE1 ext"]
assert of [(path_ext of "noext") == "", "PE2 no ext"]
assert of [(path_ext of "/a/b.tar.gz") == ".gz", "PE3 double ext"]

# ---- mkdir ----
# Create an exclusive parent first so cleanup can never remove another test's
# files, including when multiple worktrees run this test concurrently.
tmpdir_result is exec_capture of ["mktemp", "-d"]
assert of [tmpdir_result[0] == 0, "MK0 mktemp directory"]
tmpdir is trim of tmpdir_result[1]
test_dir is tmpdir + "/system"
ok is mkdir of test_dir
assert of [ok, "MK1 mkdir"]
assert of [(file_exists of test_dir), "MK2 dir exists"]

# ---- ls ----
write_text of [test_dir + "/e.txt", "e"]
write_text of [test_dir + "/c.txt", "c"]
write_text of [test_dir + "/a.txt", "a"]
write_text of [test_dir + "/d.txt", "d"]
write_text of [test_dir + "/b.txt", "b"]
files is ls of test_dir
assert of [(len of files) == 5, "LS1 ls count"]
assert_eq of [files, ["a.txt", "b.txt", "c.txt", "d.txt", "e.txt"], "LS2 ls bytewise order is independent of creation order"]

# ---- getcwd ----
cwd is getcwd of null
assert of [(len of cwd) > 0, "GC1 getcwd non-empty"]

# ---- mktemp ----
tmp is mktemp of null
assert of [(len of tmp) > 0, "MT1 mktemp non-empty"]
assert of [(file_exists of tmp), "MT2 temp file exists"]

# ---- rm ----
rm of tmp
assert of [(not (file_exists of tmp)), "RM1 rm removes file"]

# ---- cleanup ----
rm of (test_dir + "/a.txt")
rm of (test_dir + "/b.txt")
rm of (test_dir + "/c.txt")
rm of (test_dir + "/d.txt")
rm of (test_dir + "/e.txt")
exec_capture of ["rmdir", test_dir]
exec_capture of ["rmdir", tmpdir]

test_summary of null
