# Dot-assignment tests
load_file of "lib/test.eigs"

# Basic dot-assignment
d is {"name": "old"}
d.name is "new"
assert_eq of [d.name, "new", "overwrite existing key"]

# Add new key via dot
d.version is 42
assert_eq of [d.version, 42, "new key via dot"]
assert_eq of [len of d, 2, "len after dot-assign"]

# Numeric value
d.count is 0
d.count is d.count + 1
assert_eq of [d.count, 1, "increment via dot"]

# Nested dict dot-assign
app is {"config": {"debug": 0}}
app.config.debug is 1
assert_eq of [app.config.debug, 1, "nested dot-assign"]

# Dot-assign with f-string value
d.greeting is f"hello {d.name}"
assert_eq of [d.greeting, "hello new", "f-string dot-assign"]

# Index-then-dot assignment: list[i].field is value
items is [{"x": 1}, {"x": 2}, {"x": 3}]
items[0].x is 10
assert_eq of [items[0].x, 10, "index-dot-assign basic"]
items[2].x is 30
assert_eq of [items[2].x, 30, "index-dot-assign last element"]

# Dot-index-dot chain: obj.list[i].field is value
data is {"points": [{"x": 0, "y": 0}, {"x": 0, "y": 0}]}
data.points[0].x is 5
data.points[1].y is 9
assert_eq of [data.points[0].x, 5, "dot-index-dot assign x"]
assert_eq of [data.points[1].y, 9, "dot-index-dot assign y"]

# Double index then dot: grid[r][c].field is value
grid is [[{"v": 0}]]
grid[0][0].v is 42
assert_eq of [grid[0][0].v, 42, "double-index-dot assign"]

# Index-dot assign with expression on RHS
items[1].x is items[0].x + items[2].x
assert_eq of [items[1].x, 40, "index-dot-assign with expr RHS"]

# Index assignment: list[i] is value
nums is [10, 20, 30]
nums[1] is 99
assert_eq of [nums[1], 99, "single index assign"]

# Double index assignment: grid[r][c] is value
matrix is [[1, 2], [3, 4]]
matrix[0][1] is 77
assert_eq of [matrix[0][1], 77, "double index assign"]

# Index assign with expression RHS
matrix[1][0] is matrix[0][0] + matrix[0][1]
assert_eq of [matrix[1][0], 78, "index assign with expr"]


# Compound dot-assignment (desugars via clone_ast of the dot target:
# obj.f += e  →  obj.f is obj.f + e — until these checks, that
# desugaring path had zero suite coverage)
cd is {"k": 10}
cd.k += 5
assert_eq of [cd.k, 15, "dot +="]
cd.k -= 3
assert_eq of [cd.k, 12, "dot -="]
cd.k *= 4
assert_eq of [cd.k, 48, "dot *="]
cd.k /= 2
assert_eq of [cd.k, 24, "dot /="]

cb is {"v": 6}
cb.v <<= 2
assert_eq of [cb.v, 24, "dot <<="]
cb.v |= 1
assert_eq of [cb.v, 25, "dot |="]
cb.v &= 28
assert_eq of [cb.v, 24, "dot &="]
cb.v ^= 5
assert_eq of [cb.v, 29, "dot ^="]
cb.v >>= 2
assert_eq of [cb.v, 7, "dot >>="]

# Compound on an indexed dot target (clones an AST_INDEX subtree)
citems is [{"f": 1}, {"f": 2}]
citems[1].f += 10
assert_eq of [citems[1].f, 12, "indexed dot +="]

# Compound on a nested dot target (clones an AST_DOT subtree)
cnest is {"inner": {"n": 5}}
cnest.inner.n += 1
assert_eq of [cnest.inner.n, 6, "nested dot +="]

# #1250: compound dot assignment evaluates its target ONCE and reads the
# same object it writes. It used to desugar to `t.f is t.f + e`, running a
# side-effecting target twice and mixing values from two different objects.
ev_calls is 0
ev_rows is [{"x": 1}, {"x": 10}]
define ev_next() as:
    ev_calls += 1
    return ev_calls - 1
ev_rows[ev_next of null].x += 2
assert_eq of [ev_calls, 1, "dot += target evaluated once"]
assert_eq of [ev_rows, [{"x": 3}, {"x": 10}], "dot += updates the selected row"]

# Bracket form: the control that was already correct
ev_calls is 0
ev_rows is [{"x": 1}, {"x": 10}]
ev_rows[ev_next of null]["x"] += 2
assert_eq of [ev_calls, 1, "bracket += target evaluated once"]
assert_eq of [ev_rows, [{"x": 3}, {"x": 10}], "bracket += matches dot"]

# Plain dot assignment: also once
ev_calls is 0
ev_rows is [{"x": 1}, {"x": 10}]
ev_rows[ev_next of null].x is 2
assert_eq of [ev_calls, 1, "plain dot is: target evaluated once"]
assert_eq of [ev_rows, [{"x": 2}, {"x": 10}], "plain dot is: row 0 set"]

# The whole operator family shares the lowering
ev_calls is 0
ev_rows is [{"x": 12}, {"x": 100}, {"x": 7}, {"x": 5}, {"x": 6}]
ev_rows[ev_next of null].x -= 2
ev_rows[ev_next of null].x *= 3
ev_rows[ev_next of null].x %= 4
ev_rows[ev_next of null].x <<= 1
ev_rows[ev_next of null].x ^= 3
assert_eq of [ev_calls, 5, "one call per compound op"]
assert_eq of [ev_rows, [{"x": 10}, {"x": 300}, {"x": 3}, {"x": 10}, {"x": 5}], "op family on the selected rows"]

# Inside a function: the fused local / local[const] paths, and a hot loop
# the JIT compiles (results must match the interpreter's)
ev_calls is 0
define ev_fn() as:
    local rows is [{"x": 1}, {"x": 10}]
    local d is {"n": 1}
    local i is 0
    loop while i < 3000:
        d.n += 1
        rows[0].x += 1
        rows[ev_next of null].x += 2
        ev_calls is 0
        i += 1
    return [d.n, rows]
assert_eq of [ev_fn of null, [3001, [{"x": 9001}, {"x": 10}]], "compound dot in a hot fn loop"]

test_summary of null
