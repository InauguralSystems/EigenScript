sb_desc is [SB_ABI, [SB_GET_NAME,0,0, SB_CONST,1,0, SB_CALL,1,0, SB_RETURN], ["inflate", bomb]]
sb_small is sandbox_run of [sb_desc, 1000000, 65536]
check of ["D23 sandboxed inflate charged against max_bytes", sb_small["ok"], false]
sb_round is inflate of bomb
check of ["D24 inflate unaffected outside sandbox", len of sb_round, 1000000]

if fails == 0:
    print of "INFLATE_ALL_PASS"
if fails > 0:
    throw of "inflate tests failed"
