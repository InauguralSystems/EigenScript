# R3.1: numeric improving is D2: relative improvement of a running best,
# patience W, finite active values, and the reference boundedness checks.
# The explicit entropy witness below uses a nonnumeric singleton container.

print of "=== WINDOWED IMPROVING (docs/PREDICATES.md, #207) ==="

define want(tag, got, exp) as:
    assert of [got == exp, f"{tag}: improving expected {exp} got {got}"]
    print of f"  PASS: {tag} (improving={got})"

# WI1: monotone rising loss never beats its initial running best.
a is 3.0
a is 5.0
a is 9.0
a is 19.0
a is 99.0
a is 499.0
i1 is improving
# #861 re-pin: value route: growth 3->499 is a linear/geometric runaway -> diverging; the ENTROPY descent this case drove reads "improving" only on the entropy channel (pinned via classify below for WI1)
want of ["WI1 rising loss does not improve", i1, false]

# WI2: bouncing loss stays above its initial best, so D2 does not fire.
b is 3.0
b is 5.0
b is 40.0
b is 9.0
b is 200.0
b is 60.0
b is 4000.0
i2 is improving
# #861 re-pin: value route: wild bouncing (4 deadband sign-flips) -> oscillating
want of ["WI2 wild bouncing does not improve", i2, false]

# WI3: after the rise, new lows beat the running best; D2 fires.
c is 3.0
c is 4.0
c is 5.0
c is 6.0
c is 2.2
c is 1.6
i3 is improving
want of ["WI3 new low beats the running best", i3, true]

# WI4: steady rising loss never improves its running best.
d is 50.0
d is 52.0
d is 54.0
d is 56.0
d is 58.0
d is 60.0
i4 is improving
want of ["WI4 rising partial loss does not improve", i4, false]

# WI5: the falling tail still never beats the initial best, so D2 is false.
e is 2.0
e is 200.0
e is 60.0
e is 4000.0
e is 1500.0
e is 600.0
i5 is improving
want of ["WI5 tail never beats initial best", i5, false]

# WI6: a constant baseline is never a new improvement.
f is 5.0
f is 5.0
f is 5.0
f is 5.0
f is 5.0
i6 is improving
want of ["WI6 constant baseline is not an improvement", i6, false]

# WI7: a falling partial-window loss beats the running best and fires.
g is 99.0
g is 60.0
g is 40.0
g is 25.0
i7 is improving
want of ["WI7 partial falling loss improves", i7, true]

# WI8: the rising two-step prefix never beats its initial best.
h is 3.0
h is 50.0
h is 9999.0
i8 is improving
want of ["WI8 rising two-step prefix does not improve", i8, false]


# #861: keep the entropy-window mechanics covered — WI1 is the canonical
# entropy-descent (value growth) case; its entropy label must stay "improving".
wi1e is [3.0]
wi1e is [5.0]
wi1e is [9.0]
wi1e is [19.0]
wi1e is [99.0]
wi1e is [499.0]
elabel is classify of [(trajectory of wi1e), "entropy"]
assert of [elabel == "improving", f"WI1e entropy channel lost its improving verdict: {elabel}"]
print of "  PASS: WI1e entropy channel still reads improving via classify"

# #1771: the numeric predicate is directional (ML loss convention). These
# twins have equally contracting magnitudes, but only the decreasing one is
# improving. Pin every checkpoint, including the partial-window prefix.
define rising_improving(n) as:
    x is 0.0
    k is 1
    out is ""
    loop while k <= n:
        x is 1.0 - (pow of [0.5, k])
        out is out + (str of (improving of x)) + " "
        k is k + 1
    return out

define falling_improving(n) as:
    x is 1.0
    k is 1
    out is ""
    loop while k <= n:
        x is x * 0.5
        out is out + (str of (improving of x)) + " "
        k is k + 1
    return out

rise_verdicts is rising_improving of 14
fall_verdicts is falling_improving of 14
assert of [rise_verdicts == "false false false false false false false false false false false false false false ", f"rising plateau must never improve: {rise_verdicts}"]
assert of [fall_verdicts == "true true true true true true true true true true true true true true ", f"falling loss must keep improving: {fall_verdicts}"]
print of "  PASS: #1771 improving is directional (falling only)"

print of "WINDOWED_IMPROVING_ALL_PASS"
