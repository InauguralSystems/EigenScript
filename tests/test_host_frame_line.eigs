# A sandbox policy error is caught by sandbox_run's C boundary just like an
# arithmetic error. Neither call may leak its diagnostic or host-frame trace to
# stderr; the runner captures stderr separately and requires it to be empty.
desc is [1, [25,0,0, 0,1,0, 39,1,0, 40], ["write_text", "/tmp/eigs_host_frame_line_never"]]
r1 is sandbox_run of [desc, 100000]
x is 1
y is 2
z is 3
r2 is sandbox_run of [desc, 100000]
print of (r1["ok"] + r2["ok"])
