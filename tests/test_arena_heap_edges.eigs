# Regression #1184: an arena list owns counted references to heap values.
# Repeated concat creates an arena result list which retains every prior
# promoted string; resetting the arena must drop those otherwise-invisible
# edges before reclaiming the list nodes.

load_file of "lib/test.eigs"

escaped is []
i is 0
arena_mark of null
loop while i < 200:
    # substr makes a fresh, fixed-size string on every iteration. Assignment
    # promotes it to the heap; concat then puts counted refs in arena lists.
    local value is substr of ["arena-escape-val" + (str of i), 0, 16]
    escaped is concat of [escaped, [value]]
    i is i + 1
arena_reset of null

assert_eq of [len of escaped, 200, "#1184 all escaped strings survive reset"]
assert_eq of [escaped[0], "arena-escape-val", "#1184 first escaped string intact"]
assert_eq of [escaped[199], "arena-escape-val", "#1184 last escaped string intact"]

# Exercise detach as well as explicit reset.  The arithmetic result is a heap
# number after local assignment; the arena concat owns a counted edge to it.
# Deliberately leave this arena window open so arena_destroy must release that
# edge before the owning thread's numeric freelist is drained.
arena_mark of null
local teardown_number is 40 + 2
local teardown_list is concat of [[], [teardown_number]]
test_summary of null
