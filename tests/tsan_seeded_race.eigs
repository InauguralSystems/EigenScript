# Deliberate data race on a shared list element. This validates
# that the TSan gate is live (tests/test_tsan.sh asserts ThreadSanitizer catches
# THIS). The ready/release rendezvous makes two spawned workers write the same
# binding without ordering their writes. NEVER add this to the normal suite.
define make_racers() as:
    local victim is [0]
    local ready is channel of null
    local release_a is channel of null
    local release_b is channel of null
    define racer_a as:
        send of [ready, 1]
        recv of release_a
        victim[0] is 1
        return victim[0]
    define racer_b as:
        send of [ready, 1]
        recv of release_b
        victim[0] is 2
        return victim[0]
    return [racer_a, racer_b, ready, release_a, release_b]

racers is make_racers of null
h1 is spawn of racers[0]
h2 is spawn of racers[1]
recv of racers[2]
recv of racers[2]
send of [racers[3], 1]
send of [racers[4], 1]
thread_join of h1
thread_join of h2
print of "seeded binding race: done"
