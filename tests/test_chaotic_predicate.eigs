# #1419: finite-window chaos predicate, graded against the external float64
# Lyapunov oracle recorded on the issue (band 0.05, observer window 16).

periodic is [3.03, 3.04, 3.05, 3.06, 3.07, 3.08, 3.09, 3.10, 3.11, 3.12, 3.13, 3.14, 3.15, 3.16, 3.17, 3.18, 3.19, 3.20, 3.21, 3.22, 3.23, 3.24, 3.25, 3.26, 3.27, 3.28, 3.29, 3.30, 3.31, 3.32, 3.33, 3.34, 3.35, 3.36, 3.37, 3.38, 3.39, 3.40, 3.41, 3.42, 3.46, 3.47, 3.48, 3.49, 3.50, 3.51, 3.52, 3.53, 3.55, 3.56, 3.74, 3.83]
chaos is [3.58, 3.59, 3.60, 3.61, 3.62, 3.64, 3.65, 3.66, 3.67, 3.68, 3.69, 3.70, 3.71, 3.72, 3.73, 3.75, 3.76, 3.77, 3.78, 3.79, 3.80, 3.81, 3.82, 3.86, 3.87, 3.88, 3.89, 3.90, 3.91, 3.92, 3.93, 3.94, 3.95, 3.96, 3.97, 3.98, 3.99, 4.00]

define regime(r) as:
    x is 0.2
    set_observer_window of ["x", 16]
    i is 0
    loop while i < 1000:
        x is r * x * (1.0 - x)
        i is i + 1
    return [chaotic of x, converged of x, report of x]

define classify_bare(r) as:
    x is 0.2
    set_observer_window of ["x", 16]
    i is 0
    loop while i < 1000:
        x is r * x * (1.0 - x)
        i is i + 1
    x is r * x * (1.0 - x)
    return chaotic  # lint: allow W016 -- this function is the bare-form regression

for r in periodic:
    result is regime of r
    assert of [result[0] == 0, f"periodic r={r} classified chaotic"]

for r in chaos:
    result is regime of r
    assert of [result[0] == 1, f"chaotic r={r} not classified chaotic"]

deadband is regime of 2.9
assert of [deadband[1] == 1, "r=2.9 must remain converged"]
assert of [deadband[0] == 0, "r=2.9 rounding cycle must not be chaotic"]
assert of [(classify_bare of 3.9) == 1, "bare chaotic predicate must use the shared classifier"]
assert of [(regime of 3.56)[0] == 0, "graded period-8 regression"]
assert of [(regime of 3.74)[0] == 0, "in-band period-5 regression"]
assert of [(regime of 3.83)[0] == 0, "in-band period-3 regression"]
assert of [(regime of 3.60)[0] == 1, "r=3.6 chaos regression"]
assert of [(regime of 3.90)[0] == 1, "r=3.9 chaos regression"]
assert of [(regime of 4.00)[0] == 1, "r=4.0 chaos regression"]
assert of [(regime of 3.90)[2] == "oscillating", "report vocabulary/priority must not change"]

partial is 0.2
partial is 0.7
partial is 0.8
assert of [(chaotic of partial) == 0, "partial window must not be chaotic"]
nonnumeric is "a"
nonnumeric is "b"
assert of [(chaotic of nonnumeric) == 0, "nonnumeric binding must not be chaotic"]
drift is 0.0
for n in range of 20:
    drift is drift + 1.0
assert of [(chaotic of drift) == 0, "non-oscillating binding must not be chaotic"]

print of "CHAOTIC_PREDICATE_ALL_PASS periodic=52 chaotic=38 ungraded=11"
