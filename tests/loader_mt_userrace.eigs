# The SCOPE BOUNDARY of #1144, made executable.
#
# Two workers rendezvous with main before one reloads a module and the other
# calls the global function that reload rebinds. Main does not release either
# worker until both are waiting, so the rebind and call are concurrent in the
# happens-before sense even on one core: neither worker's access is ordered
# before the other's. That is the user-level
# shared-mutable-state race
# (docs/CONCURRENCY.md, "Loading from workers") and the same-slot value /
# assign-count class `src/eigenscript.c`'s #607 comment declares out of scope
# — it is filed on its own and is NOT expected to be ThreadSanitizer-clean.
#
# What tests/test_tsan.sh asserts about this program is therefore not "zero
# reports" but "no LOADER STRUCTURE appears in any report": no in-flight load
# stack, no module cache, no module-namespace table. If #1144 regresses, one
# of those symbols comes back and the row goes red — which is the executable
# form of "out of scope", instead of a sentence.
lm_ur_ready1 is 0
lm_ur_ready2 is 0
# Unlike globals, a list element is not protected by the environment mutex.
# Both workers inherit this same heap object by reference.
lm_ur_collision is [0]
define lm_ur_worker(do_load) as:
    # This spin barrier uses the environment's synchronized global accesses.
    # Each worker publishes arrival and waits until the other has arrived, so
    # both are guaranteed to proceed to the deliberately unprotected list
    # access below.
    if do_load == 1:
        lm_ur_ready1 is 1
        loop while lm_ur_ready2 == 0:
            null
    else:
        lm_ur_ready2 is 1
        loop while lm_ur_ready1 == 0:
            null
    # Both workers necessarily access the same unprotected list element after
    # rendezvous.  Their accesses have no happens-before ordering, so TSan
    # observes this race even if a one-core scheduler runs them sequentially;
    # detection does not depend on overlapping scheduling quanta.
    set_at of [lm_ur_collision, 0, do_load]
    local i is 0
    local n is 0
    loop while i < 40:
        if do_load == 1:
            load_file of "loader_mt_modules/lm_rebind.eigs"
        else:
            n is n + (lm_rebind_fn of 2)
        i is i + 1
    return n
# Establish the function before the caller starts; only the worker reloads it.
load_file of "loader_mt_modules/lm_rebind.eigs"
h1 is spawn of [lm_ur_worker, 1]
h2 is spawn of [lm_ur_worker, 0]
mi is 0
loop while mi < 40:
    load_file of "loader_mt_modules/lm_other.eigs"
    mi is mi + 1
print of f"UR {thread_join of h1} {thread_join of h2}"
