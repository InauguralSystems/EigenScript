# Shared-binding lifetime regression for #1171.
#
# Two workers load_file the same module 40x while main loads another; the
# shared module's `define` rebinds one global that the other thread is
# calling. Reads must pin the shared slot's value inside the replacement hold;
# tests/test_tsan.sh requires this whole program to be TSan-clean.
define lm_ur_worker(k) as:
    local i is 0
    local n is 0
    loop while i < 40:
        load_file of "loader_mt_modules/lm_rebind.eigs"
        n is n + (lm_rebind_fn of k)
        i is i + 1
    return n
h1 is spawn of [lm_ur_worker, 1]
h2 is spawn of [lm_ur_worker, 2]
mi is 0
loop while mi < 40:
    load_file of "loader_mt_modules/lm_other.eigs"
    mi is mi + 1
print of f"UR {thread_join of h1} {thread_join of h2}"
