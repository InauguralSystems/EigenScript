# The SCOPE BOUNDARY of #1144, made executable.
#
# Two workers load_file the same module 40x while main loads another, and a
# second pair of workers races on purpose. What tests/test_tsan.sh asserts
# about this program is not "zero reports" but "no LOADER STRUCTURE appears in
# any report": no in-flight load stack, no module cache, no module-namespace
# table. If #1144 regresses, one of those symbols comes back and the row goes
# red, which is the executable form of "out of scope" instead of a sentence.
#
# The loaders' module `define` rebinds one global the other worker is calling.
# That used to be this file's race (#1171): its reports were on the binding's
# value and refcount, and on 965dfbd0 it could crash. #1171 made the rebind
# safe, so it no longer reports, and a positive control that has to RACE
# cannot lean on it (#1489).
#
# The deliberate race is the racer pair: two closures each write ONCE to the
# same double in a buffer they share, a race docs/CONCURRENCY.md still
# leaves to the program. A ready channel plus
# separate release channels form a real rendezvous: main observes both workers
# at the barrier before releasing either, and neither release orders one
# worker's victim write before the other's. The
# racing word is not a spin/handshake word, so repeated polling cannot evict
# the first conflicting access from TSan's short per-word history (#1489).
# Capture each worker's local buffer reference BEFORE the rendezvous, and use
# float index/value literals. Phase 2's integer literals take a boxing path;
# its allocation/cleanup and shared closure lookups must not sit between the
# release and the deliberately unsynchronized payload write. The float buffer
# arm writes the shared double directly without changing any heap ownership.
define lm_ur_worker(k) as:
    local i is 0
    local n is 0
    loop while i < 40:
        load_file of "loader_mt_modules/lm_rebind.eigs"
        n is n + (lm_rebind_fn of k)
        i is i + 1
    return n

define lm_ur_race_pair() as:
    local victim is buffer of 1
    local ready is channel of null
    local release_a is channel of null
    local release_b is channel of null
    define racer_a as:
        local cell is victim
        send of [ready, 1]
        recv of release_a
        cell[0.0] is 1.0
        return 0
    define racer_b as:
        local cell is victim
        send of [ready, 1]
        recv of release_b
        cell[0.0] is 2.0
        return 0
    return [racer_a, racer_b, ready, release_a, release_b]

racers is lm_ur_race_pair of null
h1 is spawn of [lm_ur_worker, 1]
h2 is spawn of [lm_ur_worker, 2]
h3 is spawn of racers[0]
h4 is spawn of racers[1]
recv of racers[2]
recv of racers[2]
send of [racers[3], 1]
send of [racers[4], 1]
mi is 0
loop while mi < 40:
    load_file of "loader_mt_modules/lm_other.eigs"
    mi is mi + 1
thread_join of h3
thread_join of h4
print of f"UR {thread_join of h1} {thread_join of h2}"
