# Regression for #728: a chunk JIT-compiled on main BEFORE the first spawn is
# reachable from workers — jit.c's #296 gate only blocks COMPILING under MT
# (main-compiled code is memory-safe to run from a worker). But INVOKING it is
# not: every thunk epilogue writes the shared chunk->jit_advance (vm_run reads
# it back), and helper calls inside the thunk (jit_helper_get_name /
# jit_helper_set_name*) fill the shared chunk->env_ic inline caches ungated —
# the same fields the interpreter only touches under !g_vm_multithreaded
# (#297). Two workers running one warm thunk raced write/write on both. Thunk
# invocation is now gated on !g_vm_multithreaded (matching the OSR site at
# CASE(JUMP_BACK)), so workers interpret shared chunks instead.
#
# Shape: warm `helper` past the JIT entry threshold single-threaded (so it
# compiles), then run it from parallel workers (spawn all, join all). The
# GET_NAME of `gmul` is what makes the race TSan-visible: emitted code is
# uninstrumented, but the IC fill in jit_helper_get_name is C. Values are
# pinned here; race-freedom is gated by tests/test_tsan.sh.

gmul is 3

define helper(x) as:
    return (x * gmul) + 1

define warm() as:
    local s is 0
    local i is 0
    loop while i < 80:
        s is s + (helper of i)
        i is i + 1
    return s        # sum over i in 0..79 of (3i+1) = 3*3160 + 80 = 9560

define worker(k) as:
    local s is 0
    local i is 0
    loop while i < 400:
        s is s + (helper of i)
        i is i + 1
    return s + k    # sum over i in 0..399 of (3i+1) = 3*79800 + 400 = 239800

checks is 0
passed is 0
define check(label, got, want) as:
    checks is checks + 1
    if got == want:
        passed is passed + 1
    else:
        print of ("MISMATCH " + label + ": got=" + str of got + " want=" + str of want)

check of ["warm", warm of [], 9560]

# spawn ALL first (parallel), then join ALL
handles is []
n is 0
loop while n < 8:
    append of [handles, spawn of [worker, n]]
    n is n + 1
n is 0
loop while n < 8:
    check of ["w" + (str of n), thread_join of handles[n], 239800 + n]
    n is n + 1

if passed == checks:
    print of "All tests passed"
else:
    print of f"FAIL: {passed}/{checks} passed"
