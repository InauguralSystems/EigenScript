# #1386: Loading the meta-interpreter snapshots the builtin used by its own
# tokenizer, parser, evaluator, and default environment. A later host `len`
# rebinding must affect neither parsing nor the meta-level builtin.
load_file of "lib/eigen.eigs"

len is (x) => 0

failed is 0
define check(label, got, want) as:
    if got != want:
        failed is failed + 1
        print of ("FAIL: " + label)

check of ["literal still tokenizes after host len rebinding", eigen_run of "42", 42]
check of ["meta len remains the captured builtin", eigen_run of "len of [1, 2, 3]", 3]

if failed == 0:
    print of "All tests passed"
else:
    assert of [0, "meta host-len checks failed"]
