# HTTP extension builtin tests (state-only, no network).
# Covers route registration, static handler registration, request-state defaults.
# Runs only when the binary is compiled with EIGENSCRIPT_EXT_HTTP=1
# (gated by run_all_tests.sh).

load_file of "lib/test.eigs"

# ---- http_route: minimal 3-arg form (method, path, body) ----
r1 is http_route of ["GET", "/a", "body-a"]
assert_true of [r1 == "route registered", "HTTP01 http_route GET returns ack"]

# ---- http_route: 4-arg form (method, path, kind, payload) ----
r2 is http_route of ["POST", "/b", "static", "body-b"]
assert_true of [r2 == "route registered", "HTTP02 http_route POST 4-arg returns ack"]

# ---- http_route: bad argument shape raises (#356 — was a silent null
# whose return value nobody checks, so the route just never existed) ----
c3 is 0
m3 is ""
try:
    r_bad1 is http_route of 42
catch e:
    c3 is 1
    m3 is e
assert_true of [c3 == 1, "HTTP03 http_route non-list arg raises"]
assert_true of [(contains of [m3.message, "http_route requires"]), "HTTP03 message"]

c4 is 0
try:
    r_bad2 is http_route of (["GET"])
catch e:
    c4 is 1
assert_true of [c4 == 1, "HTTP04 http_route too-few-elements raises"]

# ---- http_route_authed: registers a route requiring auth ----
r3 is http_route_authed of ["GET", "/secret", "secret-body"]
assert_true of [r3 == "route registered", "HTTP05 http_route_authed returns ack"]

# ---- http_static: registers static prefix + dir ----
s1 is http_static of ["/static", "/tmp"]
assert_true of [s1 == "static registered", "HTTP06 http_static returns ack"]

# ---- http_static: bad args return null ----
s_bad is http_static of "just-a-string"
assert_true of [s_bad == null, "HTTP07 http_static non-list returns null"]

# ---- http_request_body: default empty-request returns '{}' ----
body is http_request_body of null
assert_true of [body == "{}", "HTTP08 http_request_body default is '{}'"]

# ---- http_session_id: default session is 'anonymous' ----
sid is http_session_id of null
assert_true of [sid == "anonymous", "HTTP09 http_session_id default is 'anonymous'"]

# ---- http_request_headers: default empty outside a request ----
hdrs is http_request_headers of null
assert_true of [hdrs == "", "HTTP10 http_request_headers default is empty"]

# ---- http_post: malformed args return empty string ----
# (Does not actually hit the network; argv validation only.)
p_bad1 is http_post of null
assert_true of [p_bad1 == "", "HTTP11 http_post null returns empty string"]

p_bad2 is http_post of (["just-url"])
assert_true of [p_bad2 == "", "HTTP12 http_post too-few-elements returns empty string"]

p_bad3 is http_post of ["", "{}", "body"]
assert_true of [p_bad3 == "", "HTTP13 http_post empty URL returns empty string"]

p_bad4 is http_post of ["--version", "{}", "body"]
assert_true of [p_bad4 == "", "HTTP14 http_post rejects curl-option URL"]

p_bad5 is http_post of ["file:///etc/hostname", "{}", "body"]
assert_true of [p_bad5 == "", "HTTP15 http_post rejects non-HTTP URL"]

# Header configuration must raise even without EIGS_STRICT.
header_error is 0
try:
    http_response_header of ["Content-Length", "42"]
catch e:
    header_error is (contains of [e.message, "http_response_header"]) and (contains of [e.message, "owned"])
assert_true of [header_error, "HTTP16 response header owned name raises"]
header_shape is 0
try:
    http_response_header of null
catch e:
    header_shape is contains of [e.message, "requires"]
assert_true of [header_shape, "HTTP17 response header shape raises"]

# N3 / (A): shared counters preserve integer arithmetic, including boxed
# ints. Follow every refused update with another operation to exercise the
# lock cleanup and prove that storage was not changed by the raise.
counter_big is 9007199254740992
assert_true of [(num_type of counter_big) == "int", "HTTP18 N3 boxed counter fixture is int"]
shared_set of ["phase2-big", counter_big]
counter_next is shared_incr of ["phase2-big", 1]
assert_true of [counter_next == 9007199254740993, "HTTP18 N3 shared counter adds exactly above 2^53"]
assert_true of [(num_type of counter_next) == "int", "HTTP18 N3 shared result is int"]
counter_read is shared_get of "phase2-big"
assert_true of [counter_read == counter_next and (num_type of counter_read) == "int", "HTTP18 N14 stored boxed counter stays exact int"]

shared_set of ["phase2-max", 9223372036854775807]
counter_overflow is ""
try:
    shared_incr of ["phase2-max", 1]
catch e:
    counter_overflow is e.kind
assert_true of [counter_overflow == "value", "HTTP19 A shared INT64_MAX overflow raises value"]
assert_true of [(shared_get of "phase2-max") == 9223372036854775807, "HTTP19 A overflow leaves counter unchanged and unlocks"]
assert_true of [(shared_incr of ["phase2-max", -1]) == 9223372036854775806, "HTTP19 A next increment succeeds after overflow"]

counter_min is -9223372036854775807 - 1
assert_true of [(num_type of counter_min) == "int", "HTTP20 N3 INT64_MIN fixture is int"]
shared_set of ["phase2-min", counter_min]
counter_underflow is ""
try:
    shared_incr of ["phase2-min", -1]
catch e:
    counter_underflow is e.kind
assert_true of [counter_underflow == "value", "HTTP20 A shared INT64_MIN underflow raises value"]
assert_true of [(shared_get of "phase2-min") == counter_min, "HTTP20 A underflow leaves counter unchanged and unlocks"]
assert_true of [(shared_incr of ["phase2-min", 1]) == -9223372036854775807, "HTTP20 A next increment succeeds after underflow"]

shared_set of ["phase2-float", 1.5]
counter_float is shared_incr of ["phase2-float", 2]
assert_true of [counter_float == 3.5 and (num_type of counter_float) == "float", "HTTP21 N3 float counter keeps float arithmetic"]
shared_set of ["phase2-mixed", 1]
counter_mixed is shared_incr of ["phase2-mixed", 0.5]
assert_true of [counter_mixed == 1.5 and (num_type of counter_mixed) == "float", "HTTP21 N3 float delta produces float"]
counter_new is shared_incr of ["phase2-new", 7]
assert_true of [counter_new == 7 and (num_type of counter_new) == "int", "HTTP22 N3 absent counter starts at int zero"]
counter_new_float is shared_incr of ["phase2-new-float", 0.5]
assert_true of [counter_new_float == 0.5 and (num_type of counter_new_float) == "float", "HTTP22 N3 absent float counter stays float"]
shared_set of ["phase2-string", "heap counter mismatch"]
assert_true of [(shared_incr of ["phase2-string", 1]) == null, "HTTP23 nonnumeric shared counter still returns null"]
assert_true of [(shared_get of "phase2-string") == "heap counter mismatch", "HTTP23 nonnumeric counter remains unchanged and unlocks"]

test_summary of null
