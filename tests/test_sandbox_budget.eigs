# #292: sandbox_run must impose an allocation budget. Before this, an allowlisted
# allocator (zeros/fill/buffer/range) could exhaust memory in one capped-but-large
# call — or aggregate across a loop — and the resulting x_oom -> abort() was
# uncatchable by the sandbox's g_has_error path, killing the host (SIGABRT).
# Now the size-controlled allocators charge a per-run byte budget; exceeding it
# raises a CATCHABLE error so sandbox_run returns {ok:0} instead of aborting.

load_file of "lib/test.eigs"

# Bytecode opcodes (see test_vm_run_bytecode.eigs).
# #704: every descriptor carries the bytecode ABI revision. Unstamped, each is
# refused before the budget is ever armed — and every "must be denied" check
# here would then pass for the wrong reason.
ABI is 1
CONST is 0
GET_NAME is 25
POP is 35
CALL is 39
RETURN is 40

# zeros of N  /  fill of [N, v]  descriptors (GET_NAME fn; CONST arg; CALL 1).
define zeros_desc(n) as:
    return [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["zeros", n]]
define fill_desc(n) as:
    return [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["fill", [n, 0.0]]]

# --- 1. A big allocation under a tiny budget is rejected (ok=0), not aborted ---
ok_big is (sandbox_run of [zeros_desc of 1000000, 1000000, 1000])["ok"]
assert_eq of [ok_big, 0, "budget: zeros(1M) under 1000-byte budget -> {ok:0}"]

# --- 2. A small allocation under a generous budget runs (ok=1) ---
ok_small is (sandbox_run of [zeros_desc of 10, 1000000, 1000000])["ok"]
assert_eq of [ok_small, 1, "budget: zeros(10) under 1MB budget -> {ok:1}"]

# --- 3. fill (the aggregate-allocation vector) is charged too ---
ok_fill is (sandbox_run of [fill_desc of 1000000, 1000000, 1000])["ok"]
assert_eq of [ok_fill, 0, "budget: fill(1M) under 1000-byte budget -> {ok:0}"]

# --- 4. The DEFAULT budget (no max_bytes arg) bounds an otherwise-uncapped bomb,
#        so it returns {ok:0} instead of x_oom/abort ---
ok_default is (sandbox_run of [zeros_desc of 9000000, 1000000])["ok"]
assert_eq of [ok_default, 0, "budget: default budget bounds zeros(9M) -> {ok:0}, no abort"]

# --- 5. CUMULATIVE (F2): two fills that each fit but together exceed the budget.
#        fill(60k) result stays under the boundary result-scan budget
#        (SANDBOX_RESULT_MAX_NODES = 100000) — the original 600k-element result
#        was refused AT THE BOUNDARY once that scan budget landed, silently
#        failing the loose case for as long as this file could not fail (see
#        the test_summary note below). Charge per fill is MEASURED at N*8
#        bytes (480,000 for N=60000): tight budget 600,000 admits one fill,
#        denies the second (960,000 > 600,000); the loose budget admits both
#        AND the result survives the boundary scan. ---
two_fills is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, POP,
               GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["fill", [60000, 0.0]]]
ok_two_tight is (sandbox_run of [two_fills, 1000000, 600000])["ok"]
assert_eq of [ok_two_tight, 0, "budget: two fills under a one-fill budget -> {ok:0} (cumulative)"]
ok_two_loose is (sandbox_run of [two_fills, 1000000, 12000000])["ok"]
assert_eq of [ok_two_loose, 1, "budget: two fills under an ample budget -> {ok:1}"]

# --- 5b. The boundary result-scan budget is its own refusal: a WITHIN-byte-
#         budget run whose RESULT exceeds SANDBOX_RESULT_MAX_NODES nodes is
#         refused at the boundary (callable-scan cost is bounded; a huge
#         result cannot make the verifier the DoS). Pinned deliberately —
#         this is the behavior that silently broke the old 600k case. ---
big_fill is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["fill", [600000, 0.0]]]
sr_bigres is sandbox_run of [big_fill, 1000000, 64000000]
assert_eq of [sr_bigres["ok"], 0, "boundary: >100k-node result refused at the scan"]

# --- 6. The budget is per-run: a tight run doesn't poison a later generous run ---
ok_after is (sandbox_run of [zeros_desc of 10, 1000000, 1000000])["ok"]
assert_eq of [ok_after, 1, "budget: resets per run (generous run after a tight one)"]

# --- 7. concat (the quadratic `result is concat of [result, more]` vector) is
#        charged on its output too. `la` (50 elems) is built outside the sandbox;
#        concat of [la, la] = 100 slots = 800 bytes. ---
la is range of 50
cdesc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["concat", [la, la]]]
ok_concat_tight is (sandbox_run of [cdesc, 1000000, 100])["ok"]
assert_eq of [ok_concat_tight, 0, "budget: concat(100 slots) under 100-byte budget -> {ok:0}"]
ok_concat_loose is (sandbox_run of [cdesc, 1000000, 100000])["ok"]
assert_eq of [ok_concat_loose, 1, "budget: concat(100 slots) under 100KB budget -> {ok:1}"]

# --- string concat is charged (the `s is s + s` doubling class) -------------
# #292 charged only the size-controlled builtins; ADD on two strings allocated
# uncharged, so a sandboxed doubling loop blew past max_bytes to an
# uncatchable x_oom abort — the process died instead of the run failing.
# Chunk: CONST big; CONST big; ADD; RETURN under a 1000-byte budget.
ADD is 4
big is ""
for i in range of 200:
    big is big + "xxxxxxxx"
cat_desc is [ABI, [CONST,0,0, CONST,1,0, ADD, RETURN], [big, big]]
sr_cat is sandbox_run of [cat_desc, 100000, 1000]
assert_eq of [sr_cat["ok"], 0, "budget: oversized string concat -> {ok:0}, not abort"]
cat_kind is sr_cat["error"]["kind"]
assert_eq of [cat_kind, "sandbox", "budget: concat refusal names the sandbox"]
# Control: the same concat under an ample budget succeeds.
sr_cat_ok is sandbox_run of [cat_desc, 100000, 1000000]
assert_eq of [sr_cat_ok["ok"], 1, "budget: same concat within budget stays ok"]

# --- join is charged (the concat side door) ----------------------------------
# join is output-proportional (sum(parts) + sep*(count-1)) and was left
# uncharged by the concat fix: `join of [[s, s], ""]` was the same doubling
# primitive through an allowlisted builtin, and a large-const-input join drove
# the uncatchable x_oom abort through an armed 1000-byte budget.
join_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["join", [[big, big], ""]]]
sr_join is sandbox_run of [join_desc, 100000, 1000]
assert_eq of [sr_join["ok"], 0, "budget: oversized join -> {ok:0}, not bypass/abort"]
join_kind is sr_join["error"]["kind"]
assert_eq of [join_kind, "sandbox", "budget: join refusal names the sandbox"]
sr_join_ok is sandbox_run of [join_desc, 100000, 1000000]
assert_eq of [sr_join_ok["ok"], 1, "budget: same join within budget stays ok"]

# --- str_replace is charged (same class, catchably capped at 256MB) ----------
srep_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["str_replace", [big, "x", "xxxxxxxxxxxxxxxx"]]]
sr_srep is sandbox_run of [srep_desc, 100000, 1000]
assert_eq of [sr_srep["ok"], 0, "budget: expanding str_replace -> {ok:0}"]
sr_srep_ok is sandbox_run of [srep_desc, 100000, 4000000]
assert_eq of [sr_srep_ok["ok"], 1, "budget: same str_replace within budget stays ok"]

# --- text_builder growth is charged at its chokepoint ------------------------
# Uncharged, a 50000-append loop reached the uncatchable x_oom abort from
# inside grade()'s own generation vocabulary. One extend over a host-built
# list exercises the same growth path without a bytecode loop.
SET_NAME_LOCAL is 27
blist is []
for i in range of 300:
    append of [blist, "xxxxxxxx"]
tb_code is [GET_NAME,0,0, CALL,0,0, SET_NAME_LOCAL,1,0, POP,
            GET_NAME,2,0, GET_NAME,1,0, CONST,3,0, CALL,2,0, RETURN]
tb_desc is [ABI, tb_code, ["text_builder_new", "tb", "text_builder_extend", blist]]
sr_tb is sandbox_run of [tb_desc, 100000, 1000]
assert_eq of [sr_tb["ok"], 0, "budget: text_builder growth -> {ok:0}, not abort"]
tb_kind is sr_tb["error"]["kind"]
assert_eq of [tb_kind, "sandbox", "budget: text_builder refusal names the sandbox"]
small_list is ["a", "b", "c"]
tb_small is [ABI, tb_code, ["text_builder_new", "tb", "text_builder_extend", small_list]]
sr_tb_ok is sandbox_run of [tb_small, 100000, 1000000]
assert_eq of [sr_tb_ok["ok"], 1, "budget: small text_builder within budget stays ok"]

# --- split is charged (counted output: input bytes + per-part overhead) ------
split_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CONST,2,0, CALL,2,0, RETURN], ["split", big, "x"]]
sr_split is sandbox_run of [split_desc, 100000, 1000]
assert_eq of [sr_split["ok"], 0, "budget: oversized split -> {ok:0}, not abort"]
sr_split_ok is sandbox_run of [split_desc, 100000, 4000000]
assert_eq of [sr_split_ok["ok"], 1, "budget: same split within budget stays ok"]

# --- strbuf consumers are charged at strbuf_reserve (json_encode probe) ------
je_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["json_encode", big]]
sr_je is sandbox_run of [je_desc, 100000, 500]
assert_eq of [sr_je["ok"], 0, "budget: json_encode of a big value -> {ok:0}"]
sr_je_ok is sandbox_run of [je_desc, 100000, 1000000]
assert_eq of [sr_je_ok["ok"], 1, "budget: same json_encode within budget stays ok"]

# --- the Value-tree/list class is charged (json_decode amplification) --------
# A "[0,0,...]" const amplifies ~40x into Value nodes + list slots; the tree
# is DISCARDED (POP) so the post-run result-scan cannot mask the mid-run
# allocation. Uncharged, this reached x_oom through an armed budget.
jd_json is "["
for i in range of 500:
    jd_json is jd_json + "0,0,0,0,0,0,0,"
jd_json is jd_json + "0]"
jd_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, POP, CONST,2,0, RETURN], ["json_decode", jd_json, 1]]
sr_jd is sandbox_run of [jd_desc, 100000, 5000]
assert_eq of [sr_jd["ok"], 0, "budget: json_decode amplification -> {ok:0}, not bypass"]
jd_kind is sr_jd["error"]["kind"]
assert_eq of [jd_kind, "sandbox", "budget: json_decode refusal names the sandbox"]
sr_jd_ok is sandbox_run of [jd_desc, 100000, 1000000]
assert_eq of [sr_jd_ok["ok"], 1, "budget: same decode within an ample budget stays ok"]

# --- scan_ints: same class through the scanner family ------------------------
# (whitespace-separated — scan_ints rejects comma-joined runs as invalid)
si_text is ""
for i in range of 500:
    si_text is si_text + "0 0 0 0 0 0 0 0 "
si_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, POP, CONST,2,0, RETURN], ["scan_ints", si_text, 1]]
sr_si is sandbox_run of [si_desc, 100000, 5000]
assert_eq of [sr_si["ok"], 0, "budget: scan_ints amplification -> {ok:0}"]

# --- small-container nesting cannot bypass the birth charge ------------------
# Charging only >8 pre-sizes and doublings left <=8-element containers free:
# nested seven-element arrays under-charged ~8x per level (387MB RSS under an
# 80MB budget; a 7x7 nesting resurrected the abort). Every container now
# charges at birth. Outer array of 20000 seven-element arrays, discarded.
nest_json is "["
for i in range of 300:
    nest_json is nest_json + "[0,0,0,0,0,0,0],"
nest_json is nest_json + "[0]]"
nest_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, POP, CONST,2,0, RETURN], ["json_decode", nest_json, 1]]
sr_nest is sandbox_run of [nest_desc, 100000, 5000]
assert_eq of [sr_nest["ok"], 0, "budget: nested small-array amplification -> {ok:0}"]
sr_nest_ok is sandbox_run of [nest_desc, 100000, 1000000]
assert_eq of [sr_nest_ok["ok"], 1, "budget: same nested decode within ample budget stays ok"]

# --- small JSON OBJECTS are charged too (dict half of the same hole) ---------
obj_json is "["
for i in range of 300:
    obj_json is obj_json + "{\"a\":0,\"b\":0},"
obj_json is obj_json + "{\"a\":0}]"
obj_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, POP, CONST,2,0, RETURN], ["json_decode", obj_json, 1]]
sr_obj is sandbox_run of [obj_desc, 100000, 5000]
assert_eq of [sr_obj["ok"], 0, "budget: small-object amplification -> {ok:0}"]

# --- make_dict's BIRTH charge in isolation -----------------------------------
# The small-object rows above also grow the outer array, so list_append's
# charge catches them even with the dict birth charge gutted (a mutation run
# proved the suite stayed green). This row is sized so ONLY the dict birth
# charge can refuse it: 8-element outer array (no growth past the default
# capacity) of 8-key objects under an 800-byte budget.
iso_json is "[{\"k1\":0,\"k2\":0,\"k3\":0,\"k4\":0,\"k5\":0,\"k6\":0,\"k7\":0,\"k8\":0}"
for i in range of 7:
    iso_json is iso_json + ",{\"k1\":0,\"k2\":0,\"k3\":0,\"k4\":0,\"k5\":0,\"k6\":0,\"k7\":0,\"k8\":0}"
iso_json is iso_json + "]"
iso_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, POP, CONST,2,0, RETURN], ["json_decode", iso_json, 1]]
sr_iso is sandbox_run of [iso_desc, 100000, 800]
assert_eq of [sr_iso["ok"], 0, "budget: dict birth charge fires in isolation"]

# --- the BUFFER class is charged (matmul outer-product amplification) --------
# "inputs charged" was a false waiver: an outer product amplifies two
# 3000-element buffers into a 9M-element (72MB) output, which passed a 64MiB
# budget and loop-aggregated to the uncatchable abort through grade().
mm_code is [GET_NAME,0,0,
            GET_NAME,1,0, CONST,2,0, CONST,3,0, CALL,2,0,
            GET_NAME,1,0, CONST,3,0, CONST,2,0, CALL,2,0,
            CALL,2,0, POP, CONST,4,0, RETURN]
mm_desc is [ABI, mm_code, ["matmul", "buffer", 500, 1, 1]]
sr_mm is sandbox_run of [mm_desc, 100000, 1000000]
assert_eq of [sr_mm["ok"], 0, "budget: outer-product matmul -> {ok:0}, not bypass"]
mm_kind is sr_mm["error"]["kind"]
assert_eq of [mm_kind, "sandbox", "budget: buffer refusal names the sandbox"]
mm_small is [ABI, mm_code, ["matmul", "buffer", 10, 1, 1]]
sr_mm_ok is sandbox_run of [mm_small, 100000, 1000000]
assert_eq of [sr_mm_ok["ok"], 1, "budget: small matmul within budget stays ok"]

# --- buf_from_list / reshape: the last two raw-xcalloc buffer producers ------
# 50 copies of an 800k buffer held 320MB under the default budget (ok:1) until
# these two charged like every other buffer producer. One aggregating loop.
bl_src is []
for i in range of 2000:
    append of [bl_src, 0.0]
bfl_code is [GET_NAME,0,0, CONST,1,0, CALL,1,0, POP, CONST,2,0, RETURN]
bfl_desc is [ABI, bfl_code, ["buf_from_list", bl_src, 1]]
sr_bfl is sandbox_run of [bfl_desc, 100000, 8000]
assert_eq of [sr_bfl["ok"], 0, "budget: buf_from_list -> {ok:0}, not bypass"]
sr_bfl_ok is sandbox_run of [bfl_desc, 100000, 4000000]
assert_eq of [sr_bfl_ok["ok"], 1, "budget: buf_from_list within budget stays ok"]

# --- #965: pure string transforms charge their payload bytes -----------------
# str_lower/str_upper/trim/substr/str_from_bytes built output via an uncharged
# copy constructor, so one charged input reused across a loop aggregated N
# uncharged payloads (the list SLOTS were charged, the payloads were not).
# An unbounded str_lower loop — the proven test_vm_run_bytecode `loopcode`
# skeleton (NUM_ONE; JUMP_IF_FALSE; LOOP_CAP_CHECK; JUMP_BACK) with a
# transform body — can stop only two ways: the iteration cap ("loop budget
# exhausted ... partial run") or the byte budget ("sandbox memory budget
# exceeded"). A 30000-byte budget against a 2001-byte payload must stop the
# loop on the BYTE budget (~15 iterations), long before the 100000-iteration
# cap — so the refusal message is the discriminator.
NUM_ONE is 3
JUMP_IF_FALSE is 31
JUMP_BACK is 30
LOOP_CAP_CHECK is 63
big965 is ""
for i in range of 250:
    big965 is big965 + "XXXXXXXX"
loop965 is [NUM_ONE, JUMP_IF_FALSE,19,0, LOOP_CAP_CHECK,16,0,
            GET_NAME,0,0, CONST,1,0, CALL,1,0, SET_NAME_LOCAL,2,0, POP,
            JUMP_BACK,23,0,
            GET_NAME,2,0, RETURN]
loop_desc is [ABI, loop965, ["str_lower", big965, "x"]]
sr_loop is sandbox_run of [loop_desc, 100000, 30000]
assert_eq of [sr_loop["ok"], 0, "budget: looped str_lower of a reused input -> {ok:0}"]
# Error fields exist only when ok flips the expected way, so read them behind
# a guard: a regression must surface as a failed ASSERTION (the guarded
# default never matches), never as a crash that skips the remaining checks.
loop_kind is ""
loop_msg is ""
if sr_loop["ok"] == 0:
    loop_kind is sr_loop["error"]["kind"]
    loop_msg is sr_loop["error"]["message"]
assert_eq of [loop_kind, "sandbox", "budget: string-transform refusal names the sandbox"]
loop_mem is index_of of [loop_msg, "memory budget"]
assert_eq of [loop_mem >= 0, 1, "budget: loop stops on the byte budget, not the iteration cap"]
# Per-call: one str_lower over the same input is charged its payload.
lower_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["str_lower", big965]]
assert_eq of [(sandbox_run of [lower_desc, 100000, 1000])["ok"], 0, "budget: str_lower payload -> {ok:0}"]
sr_lower_ok is sandbox_run of [lower_desc, 100000, 100000]
assert_eq of [sr_lower_ok["ok"], 1, "budget: str_lower within budget stays ok"]
lower_result is ""
if sr_lower_ok["ok"] == 1:
    lower_result is sr_lower_ok["result"]
assert_eq of [lower_result, str_lower of big965, "budget: str_lower transforms correctly"]

# --- #965: each named transform is charged per call --------------------------
sfb_bytes is []
for i in range of 2000:
    append of [sfb_bytes, 65]
sfb_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["str_from_bytes", sfb_bytes]]
assert_eq of [(sandbox_run of [sfb_desc, 100000, 1000])["ok"], 0, "budget: str_from_bytes payload -> {ok:0}"]
assert_eq of [(sandbox_run of [sfb_desc, 100000, 100000])["ok"], 1, "budget: str_from_bytes within budget stays ok"]
upper_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["str_upper", big965]]
assert_eq of [(sandbox_run of [upper_desc, 100000, 1000])["ok"], 0, "budget: str_upper payload -> {ok:0}"]
assert_eq of [(sandbox_run of [upper_desc, 100000, 100000])["ok"], 1, "budget: str_upper within budget stays ok"]
sub_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["substr", [big965, 0, 2000]]]
assert_eq of [(sandbox_run of [sub_desc, 100000, 1000])["ok"], 0, "budget: substr payload -> {ok:0}"]
assert_eq of [(sandbox_run of [sub_desc, 100000, 100000])["ok"], 1, "budget: substr within budget stays ok"]
trim_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["trim", big965]]
assert_eq of [(sandbox_run of [trim_desc, 100000, 1000])["ok"], 0, "budget: trim payload -> {ok:0}"]
assert_eq of [(sandbox_run of [trim_desc, 100000, 100000])["ok"], 1, "budget: trim within budget stays ok"]

# --- #965: a strbuf-charged producer is NOT charged twice --------------------
# json_encode of a 100000-char string grows its strbuf to 131072 (charged
# 131008 at strbuf_reserve). A second charge of the 100001-byte payload at the
# result wrap would total 231009 > 200000 — this budget admits exactly the
# single charge.
big_je is ""
for i in range of 12500:
    big_je is big_je + "xxxxxxxx"
je2_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["json_encode", big_je]]
assert_eq of [(sandbox_run of [je2_desc, 100000, 200000])["ok"], 1, "budget: json_encode charged once, not twice"]

# --- #965: a VAL_BUFFER result counts its element storage at the scan --------
# The boundary callable-scan counted a buffer as ONE node regardless of
# element count, so a 200k-element buffer (1.6MB, within the byte budget)
# crossed the boundary as a single node. The scan now spends one node per
# element: 200000 > SANDBOX_RESULT_MAX_NODES (100000) refuses the result.
buf_big_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["buffer", 200000]]
sr_bufbig is sandbox_run of [buf_big_desc, 100000, 4000000]
assert_eq of [sr_bufbig["ok"], 0, "boundary: 200k-element buffer result counts its elements"]
bufbig_msg is ""
if sr_bufbig["ok"] == 0:
    bufbig_msg is sr_bufbig["error"]["message"]
bufbig_scan is index_of of [bufbig_msg, "too large to scan"]
assert_eq of [bufbig_scan >= 0, 1, "boundary: buffer refusal is the result scan, not the byte budget"]
buf_small_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["buffer", 1000]]
assert_eq of [(sandbox_run of [buf_small_desc, 100000, 4000000])["ok"], 1, "boundary: 1k-element buffer result still crosses"]

# --- #965 (fix1): SMALL strbuf-backed payloads are charged too ----------------
# strbuf_init's 64-byte initial capacity is never charged and strbuf_reserve
# charges only growth DELTAS, so a result of <=63 payload bytes transferred by
# ownership paid ZERO. A loop of small json_encode results must accumulate a
# per-call payload charge: 4 bytes per "x" result, so a 30000-byte budget
# stops the loop long before the 100000-iteration cap — the refusal message
# is again the discriminator. Same proven loopcode skeleton as above.
je_loop is [NUM_ONE, JUMP_IF_FALSE,19,0, LOOP_CAP_CHECK,16,0,
            GET_NAME,0,0, CONST,1,0, CALL,1,0, SET_NAME_LOCAL,2,0, POP,
            JUMP_BACK,23,0,
            GET_NAME,2,0, RETURN]
je_loop_desc is [ABI, je_loop, ["json_encode", "x", "r"]]
sr_jeloop is sandbox_run of [je_loop_desc, 100000, 30000]
assert_eq of [sr_jeloop["ok"], 0, "budget: looped small json_encode -> {ok:0}"]
jeloop_kind is ""
jeloop_msg is ""
if sr_jeloop["ok"] == 0:
    jeloop_kind is sr_jeloop["error"]["kind"]
    jeloop_msg is sr_jeloop["error"]["message"]
assert_eq of [jeloop_kind, "sandbox", "budget: small-strbuf refusal names the sandbox"]
jeloop_mem is index_of of [jeloop_msg, "memory budget"]
assert_eq of [jeloop_mem >= 0, 1, "budget: small-strbuf loop stops on bytes, not the iteration cap"]
# Per-call: one 3-byte json_encode result charges its 4 payload bytes.
je_small is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["json_encode", "x"]]
assert_eq of [(sandbox_run of [je_small, 100000, 3])["ok"], 0, "budget: small json_encode payload -> {ok:0}"]
sr_jes is sandbox_run of [je_small, 100000, 1000]
assert_eq of [sr_jes["ok"], 1, "budget: small json_encode within budget stays ok"]
jes_result is ""
if sr_jes["ok"] == 1:
    jes_result is sr_jes["result"]
assert_eq of [jes_result, "\"x\"", "budget: small json_encode result is correct"]

# --- #965 (fix1): a GROWN strbuf result is charged exactly once ---------------
# A 100-char string encodes to 102 strbuf bytes: growth charges 64 (64->128),
# the payload remainder (103 - 64 = 39) is charged at the ownership transfer —
# total exactly 103, the payload. Budget 102 must refuse; 103 must admit.
# Charging the payload AGAIN at the wrap (the old make_str shape) would total
# 64 + 39 + 103 = 206 and refuse the 103 budget, so the pair pins exact-once.
mid100 is ""
for i in range of 12:
    mid100 is mid100 + "xxxxxxxx"
mid100 is mid100 + "xxxx"
je_mid is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["json_encode", mid100]]
assert_eq of [(sandbox_run of [je_mid, 100000, 102])["ok"], 0, "budget: grown strbuf payload (103) refused at 102"]
assert_eq of [(sandbox_run of [je_mid, 100000, 103])["ok"], 1, "budget: grown strbuf charged exactly once (103 admitted)"]

# --- #965 (fix1): the original refusal diagnostic survives error construction --
# The error-result dict is built while its make_dict/make_str calls could
# themselves attempt refused charges against the just-exhausted budget and
# CLOBBER g_error_raw before it is read into the message. Here the first
# concat commits 1201 of a 1300 budget and the second is refused, leaving no
# room for any diagnostic allocation: the reported message must still be the
# ORIGINAL "used 1201 + 1201 > 1300", not a re-entrant refusal's numbers.
big_cc is ""
for i in range of 75:
    big_cc is big_cc + "xxxxxxxx"
cc_code is [CONST,0,0, CONST,0,0, ADD, POP, CONST,0,0, CONST,0,0, ADD, RETURN]
cc_desc is [ABI, cc_code, [big_cc]]
sr_cc is sandbox_run of [cc_desc, 100000, 1300]
assert_eq of [sr_cc["ok"], 0, "budget: second oversized concat -> {ok:0}"]
cc_kind is ""
cc_msg is ""
if sr_cc["ok"] == 0:
    cc_kind is sr_cc["error"]["kind"]
    cc_msg is sr_cc["error"]["message"]
assert_eq of [cc_kind, "sandbox", "budget: concat refusal names the sandbox"]
cc_orig is index_of of [cc_msg, "used 1201 + 1201 > 1300"]
assert_eq of [cc_orig >= 0, 1, "budget: original refusal diagnostic survives error construction"]

# --- #965 (fix1): the exact result-scan node boundary --------------------------
# The scan spends one node per VALUE: a container costs 1 + its elements, so a
# buffer costs 1 container node + 1 per element — identical arithmetic to a
# flat list of the same length. Against SANDBOX_RESULT_MAX_NODES = 100000:
# 1 + 99998 = 99999 nodes crosses; 1 + 99999 = 100000 exhausts the budget and
# fails closed (the scan's strict exhaustion rule, same as lists).
buf_edge_lo is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["buffer", 99998]]
assert_eq of [(sandbox_run of [buf_edge_lo, 100000, 4000000])["ok"], 1, "boundary: 1+99998-node buffer result crosses"]
buf_edge_hi is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["buffer", 99999]]
sr_edge is sandbox_run of [buf_edge_hi, 100000, 4000000]
assert_eq of [sr_edge["ok"], 0, "boundary: 1+99999-node buffer result refused at the exact limit"]
edge_msg is ""
if sr_edge["ok"] == 0:
    edge_msg is sr_edge["error"]["message"]
edge_scan is index_of of [edge_msg, "too large to scan"]
assert_eq of [edge_scan >= 0, 1, "boundary: exact-limit refusal is the result scan"]

# --- #965 (fix3): the first budget refusal wins across one producer ---------
# json_decode is allowlisted and continues an array after a refused string.
# On the runner sizeof(Value) + 8*sizeof(Value*) is 72 + 8*8 = C=136 bytes for
# the parser's initial make_list(8). The first 128-byte string grows 64->128,
# then requests 128 with 200 used and C+127 available; the independent 64-byte
# second string later requests 64 with only 63 left. The first refusal must stay
# visible, rather than being overwritten by that later request.
first128 is ""
for i in range of 16:
    first128 is first128 + "xxxxxxxx"
second64 is ""
for i in range of 8:
    second64 is second64 + "xxxxxxxx"
multi_json is "[\"" + first128 + "\",\"" + second64 + "\"]"
multi_json_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN],
                    ["json_decode", multi_json]]
sr_multi_json is sandbox_run of [multi_json_desc, 100000, 263]
assert_eq of [sr_multi_json["ok"], 0,
              "budget: later independent strbuf refusal keeps {ok:0}"]
multi_json_msg is ""
if sr_multi_json["ok"] == 0:
    multi_json_msg is sr_multi_json["error"]["message"]
assert_eq of [multi_json_msg,
              "sandbox memory budget exceeded (used 200 + 128 > 263 bytes)",
              "budget: first refusal remains exact across multiple strbufs"]

# --- #965 (fix3): sandbox descriptors cannot smuggle callable constants ----
# The production mutation killed by these assertions is accepting a VAL_BUILTIN
# or VAL_FN in the descriptor constant pool. The fixture is local-only: on the
# vulnerable path read_bytes_buf is invoked directly by OP_CONST/OP_CALL despite
# its name being absent from SANDBOX_ALLOW. The safe pool contract is recursive
# over data containers, never callable or host-mutable capability values.
descriptor_fixture is "/tmp/eigs_965_sandbox_descriptor_const.bin"
write_bytes of [descriptor_fixture, [65], 0]
define descriptor_const_fn(x) as:
    return x
builtin_const_desc is [ABI, [CONST,0,0, CONST,1,0, CALL,1,0, RETURN],
                       [read_bytes_buf, [descriptor_fixture, 1]]]
sr_builtin_const is sandbox_run of [builtin_const_desc, 100000, 1000000]
assert_eq of [sr_builtin_const["ok"], 0,
              "sandbox descriptor: builtin constant is rejected at trust boundary"]
builtin_const_error is ""
if sr_builtin_const["ok"] == 0:
    builtin_const_error is sr_builtin_const["error"]["message"]
assert_eq of [builtin_const_error, "invalid chunk descriptor",
              "sandbox descriptor: builtin constant reports invalid descriptor"]
fn_const_desc is [ABI, [CONST,0,0, CONST,1,0, CALL,1,0, RETURN],
                  [descriptor_const_fn, 7]]
sr_fn_const is sandbox_run of [fn_const_desc, 100000, 1000000]
assert_eq of [sr_fn_const["ok"], 0,
              "sandbox descriptor: function constant is rejected at trust boundary"]
fn_const_error is ""
if sr_fn_const["ok"] == 0:
    fn_const_error is sr_fn_const["error"]["message"]
assert_eq of [fn_const_error, "invalid chunk descriptor",
              "sandbox descriptor: function constant reports invalid descriptor"]
remove_file of descriptor_fixture

# --- #965 (fix2): raw VM slices charge each newly retained allocation -------
# OP_SLICE_GET is reachable in an assembled sandbox chunk even though it is
# not a builtin. Reuse one 1000-byte input, retain each fresh 1000-byte slice,
# and let the byte budget—not the loop cap or result scan—be the discriminator.
SLICE_GET is 80
LIST is 42
SET_NAME_LOCAL is 27
slice_src is ""
for i in range of 125:
    slice_src is slice_src + "xxxxxxxx"
slice_src is slice_src + "xxxx"
slice_loop_code is [LIST,0,0, SET_NAME_LOCAL,4,0, POP,
                    NUM_ONE, JUMP_IF_FALSE,29,0, LOOP_CAP_CHECK,26,0,
                    GET_NAME,0,0, GET_NAME,4,0,
                    CONST,1,0, CONST,2,0, CONST,3,0, SLICE_GET,
                    LIST,2,0, CALL,1,0, POP,
                    JUMP_BACK,33,0,
                    GET_NAME,4,0, RETURN]
slice_loop_desc is [ABI, slice_loop_code,
                    ["append", slice_src, 0, 1000, "slice_acc"]]
sr_slice_loop is sandbox_run of [slice_loop_desc, 7, 1000]
assert_eq of [sr_slice_loop["ok"], 0, "budget: retained string slices -> {ok:0}"]
slice_loop_kind is ""
slice_loop_msg is ""
if sr_slice_loop["ok"] == 0:
    slice_loop_kind is sr_slice_loop["error"]["kind"]
    slice_loop_msg is sr_slice_loop["error"]["message"]
assert_eq of [slice_loop_kind, "sandbox", "budget: string-slice refusal names the sandbox"]
slice_loop_mem is index_of of [slice_loop_msg, "memory budget"]
assert_eq of [slice_loop_mem >= 0, 1, "budget: retained string slices stop on bytes, not the iteration cap"]

# A positive buffer slice is below the result-scan ceiling, so only its newly
# allocated element storage should decide this tight budget.
slice_target is buffer of 2000
buf_slice_desc is [ABI, [CONST,0,0, CONST,1,0, CONST,2,0, SLICE_GET, RETURN],
                   [slice_target, 0, 1000]]
sr_buf_slice is sandbox_run of [buf_slice_desc, 100000, 1000]
assert_eq of [sr_buf_slice["ok"], 0, "budget: positive buffer slice charges element storage"]

# Reserve refusal is the first diagnostic. strbuf_finish must transfer the
# poisoned partial buffer without attempting a second charge that overwrites
# the original reserve numbers before sandbox_run restores its state.
refuse_input is ""
for i in range of 15:
    refuse_input is refuse_input + "xxxxxxxx"
refuse_input is refuse_input + "xxxxxx"
refuse_json_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN],
                     ["json_encode", refuse_input]]
sr_refuse_json is sandbox_run of [refuse_json_desc, 100000, 127]
assert_eq of [sr_refuse_json["ok"], 0, "budget: refused strbuf -> {ok:0}"]
refuse_kind is ""
refuse_msg is ""
if sr_refuse_json["ok"] == 0:
    refuse_kind is sr_refuse_json["error"]["kind"]
    refuse_msg is sr_refuse_json["error"]["message"]
assert_eq of [refuse_kind, "sandbox", "budget: refused strbuf names the sandbox"]
refuse_orig is index_of of [refuse_msg, "used 64 + 128 > 127"]
assert_eq of [refuse_orig >= 0, 1, "budget: first strbuf refusal diagnostic survives finish"]

# Empty buffers have no element nodes. Pin the flat and one-level-nested
# shapes at the same strict boundary as an equal-length list: 99,999 total
# nodes cross, while the overcounted empty-buffer implementation reaches 100k.
empty_buf is buffer of 0
empty_flat is []
for i in range of 99997:
    append of [empty_flat, 0]
append of [empty_flat, empty_buf]
empty_flat_desc is [ABI, [CONST,0,0, RETURN], [empty_flat]]
assert_eq of [(sandbox_run of [empty_flat_desc, 100000, 4000000])["ok"], 1,
              "boundary: empty buffer has weight 1 in a flat result"]
empty_nested is []
for i in range of 99996:
    append of [empty_nested, 0]
append of [empty_nested, [empty_buf]]
empty_nested_desc is [ABI, [CONST,0,0, RETURN], [empty_nested]]
assert_eq of [(sandbox_run of [empty_nested_desc, 100000, 4000000])["ok"], 1,
              "boundary: nested empty buffer has weight 1 plus its container"]

# --- #965 (fix1): changed strbuf consumers outside a sandbox are unchanged -----
assert_eq of [json_encode of "x", "\"x\"", "nosandbox: json_encode unchanged"]
assert_eq of [json_build of ["k", 1], "{\"k\": 1}", "nosandbox: json_build unchanged"]
assert_eq of [str of [1, 2], "[1, 2]", "nosandbox: str of list unchanged"]
assert_eq of [regex_replace of ["aXbXc", "X", "-"], "a-b-c", "nosandbox: regex_replace unchanged"]

# --- #965: the same operations outside a sandbox are unchanged ---------------
assert_eq of [str_lower of "AbC", "abc", "nosandbox: str_lower unchanged"]
assert_eq of [trim of "  ab  ", "ab", "nosandbox: trim unchanged"]
assert_eq of [substr of ["abcdef", 1, 3], "bcd", "nosandbox: substr unchanged"]
assert_eq of [str_from_bytes of [65, 66, 67], "ABC", "nosandbox: str_from_bytes unchanged"]
assert_eq of [buf_len of (buffer of 3), 3, "nosandbox: buffer unchanged"]

# test_summary (lib/test.eigs) is what makes assertions LOAD-BEARING: it
# exits nonzero when any assert_eq failed. This file used to print the
# runner's pass-marker unconditionally — a vacuous gate that reported green
# over a red assertion for as long as the result-scan budget existed
# (found by a blind review round, 2026-08-17).
test_summary of null
