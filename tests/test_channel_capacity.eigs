# #1643: channel's argument is its capacity, not ignored decoration.
failures is 0

define verdict(ok, label) as:
    if ok:
        print of ("PASS: " + label)
    else:
        print of ("FAIL: " + label)
        failures is failures + 1

# An unbuffered channel is a rendezvous: the send cannot complete until recv.
rendezvous is channel of 0
r0_ready is channel of null
r0_done is channel of null
define rendezvous_sender() as:
    send of [r0_ready, 1]
    send of [rendezvous, 10]
    send of [r0_done, 1]
r0_worker is spawn of rendezvous_sender
recv of r0_ready
verdict of [(type of (recv_timeout of [r0_done, 50])) == "null", "capacity 0 send waits for a receiver"]
verdict of [(recv of rendezvous) == 10, "capacity 0 rendezvous transfers its value"]
verdict of [(recv_timeout of [r0_done, 1000]) == 1, "capacity 0 sender resumes after receive"]
thread_join of r0_worker

# One value fits; the second send blocks until the first value is received.
one is channel of 1
c1_ready is channel of null
c1_done is channel of null
define one_sender() as:
    send of [one, 11]
    send of [c1_ready, 1]
    send of [one, 12]
    send of [c1_done, 1]
c1_worker is spawn of one_sender
recv of c1_ready
verdict of [(type of (recv_timeout of [c1_done, 50])) == "null", "capacity 1 blocks the second send under timeout"]
verdict of [(recv of one) == 11, "capacity 1 preserves the first value"]
verdict of [(recv_timeout of [c1_done, 1000]) == 1, "capacity 1 unblocks the second send after receive"]
verdict of [(recv of one) == 12, "capacity 1 preserves the second value"]
thread_join of c1_worker

# A larger capacity is exact as well: three fit and the fourth waits.
three is channel of 3
c3_ready is channel of null
c3_done is channel of null
define three_sender() as:
    send of [three, 21]
    send of [three, 22]
    send of [three, 23]
    send of [c3_ready, 1]
    send of [three, 24]
    send of [c3_done, 1]
c3_worker is spawn of three_sender
recv of c3_ready
verdict of [(type of (recv_timeout of [c3_done, 50])) == "null", "capacity 3 blocks the fourth send under timeout"]
verdict of [(recv of three) == 21, "capacity 3 preserves FIFO order"]
verdict of [(recv_timeout of [c3_done, 1000]) == 1, "capacity 3 unblocks after one receive"]
verdict of [(recv of three) == 22 and (recv of three) == 23 and (recv of three) == 24, "capacity 3 drains all buffered values in FIFO order"]
thread_join of c3_worker

define invalid_capacity(value, label) as:
    raised is false
    kind is ""
    try:
        ignored is channel of value
    catch e:
        raised is true
        kind is e.kind
    verdict of [raised, label]

invalid_capacity of [-1, "negative channel capacity raises"]
invalid_capacity of [1.5, "non-integer channel capacity raises"]
invalid_capacity of ["1", "string channel capacity raises"]
invalid_capacity of [[1], "list channel capacity raises"]

if failures > 0:
    exit of 1
