# #2344: byte-for-byte oracle for the linear template renderer.
load_file of "lib/test.eigs"
load_file of "lib/template.eigs"

# Behavioural copy of render before #2344.  It adds `local` to seven
# assignments and omits three explanatory comments; its output is unchanged.
# It deliberately keeps the repeated prefix/suffix copies, so it is an oracle,
# not production code.
define render_before_2344(tmpl, vars) as:
    local result is ""
    local remaining is tmpl
    loop while (len of remaining) > 0:
        local open_pos is index_of of [remaining, "{{"]
        if open_pos < 0:
            result is result + remaining
            return result
        result is result + (substr of [remaining, 0, open_pos])
        local after_open is substr of [remaining, open_pos + 2, (len of remaining) - open_pos - 2]
        local close_pos is index_of of [after_open, "}}"]
        if close_pos < 0:
            result is result + (substr of [remaining, open_pos, (len of remaining) - open_pos])
            return result
        local key is substr of [after_open, 0, close_pos]
        local val is "{{" + key + "}}"
        for i in range of (len of vars):
            if vars[i][0] == key:
                val is str of vars[i][1]
        result is result + val
        remaining is substr of [after_open, close_pos + 2, (len of after_open) - close_pos - 2]
    return result

local cases is [
    ["plain text", []],
    ["{{a}}{{b}}", [["a", "A"], ["b", "B"]]],
    ["{{a}} middle {{b}}", [["a", "A"], ["b", "B"]]],
    ["before {{open", [["open", "X"]]],
    ["close }} only", []],
    ["{{}}", [["", "empty"]]],
    ["{{missing}}", []],
    ["{{x}}/{{x}}/{{x}}/{{x}}", [["x", "repeat"]]],
    ["{{{x}}}", [["{x", "left"], ["x", "center"]]],
    ["{{x}}", [["x", "{{inner}} and }}"]]],
    ["λ {{名}} café", [["名", "世界"]]],
    ["{{outer {{inner}} tail", [["outer {{inner", "nested"]]],
    ["Hello {{user}}!", [["user", "World"]]],
    ["Hi {{name}}, count={{n}}.", [["name", "World"], ["n", "42"]]],
    ["{{missing}} remains", []],
    ["prefix {{forever", [["forever", "nope"]]],
    ["{{name}} is running v{{version}}", [["name", "EigenScript"], ["version", "1"]]]
]

local compared is 0
local differences is 0
for c in cases:
    local actual is render of [c[0], c[1]]
    local expected is render_before_2344 of [c[0], c[1]]
    assert_eq of [actual, expected, "render oracle case"]
    if actual != expected:
        differences += 1
    compared += 1

for size in [1, 2, 2000]:
    local pieces is []
    for i in range of size:
        append of [pieces, "{{x}}"]
    local large_template is join of [pieces, ""]
    local actual is render of [large_template, [["x", "a"]]]
    local expected is render_before_2344 of [large_template, [["x", "a"]]]
    assert_eq of [actual, expected, "render oracle generated size"]
    if actual != expected:
        differences += 1
    compared += 1

if differences == 0:
    print of ("TEMPLATE ORACLE: " + (str of compared) + " inputs, zero differences")

# Exhaust every string of length 0..9 over the delimiter alphabet.  Include
# both present and absent keys so lookup and missing-key preservation agree.
local exhaustive_vars is [
    ["", "empty"], ["a", "A"], ["{", "left"], ["a{", "a-left"],
    ["{a", "left-a"], ["}", "right"], ["aa", "AA"]
]
local population is [""]
local exhaustive_compared is 0
local exhaustive_differences is 0
for length in range of 10:
    for sample in population:
        local actual is render of [sample, exhaustive_vars]
        local expected is render_before_2344 of [sample, exhaustive_vars]
        assert_eq of [actual, expected, "render exhaustive oracle"]
        if actual != expected:
            exhaustive_differences += 1
        exhaustive_compared += 1
    if length < 9:
        local next_population is []
        for prefix in population:
            append of [next_population, prefix + "{"]
            append of [next_population, prefix + "}"]
            append of [next_population, prefix + "a"]
        population is next_population

assert_eq of [exhaustive_compared, 29524, "exhaustive template population"]
if exhaustive_differences == 0:
    print of ("TEMPLATE EXHAUSTIVE: " + (str of exhaustive_compared) + " strings, zero differences")
test_summary of null
