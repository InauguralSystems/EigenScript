# stable (restored by the Round 3 reveal, #2407): a full window of ten finite
# steps, each under 1% of the larger value it joins, no two steps in a row of
# opposite sign both above 0.1%, and no raw runaway or swing. Each reason
# below is tools/reveal_restored_reference.py's (branch mode).
# get_observer_thresholds retains compiled h_low for nonnumeric bindings.

print of "=== WINDOWED STABLE (docs/PREDICATES.md, #205) ==="

define want(tag, got, exp) as:
    assert of [got == exp, f"{tag}: stable expected {exp} got {got}"]
    print of f"  PASS: {tag} (stable={got})"

# WS1: a +2 linear climb is a raw runaway (and 2/32 > 1%).
a is 30.0
a is 32.0
a is 34.0
a is 36.0
a is 38.0
a is 40.0
a is 42.0
a is 44.0
a is 46.0
a is 48.0
a is 50.0
# #861 re-pin: value route: +2/step linear climb -> diverging; entropy small-dH "stable" was the additive-runaway blindness (#422)
want of ["WS1 linear climb is not stable", stable, false]

# WS2: constant2: every step is 0.
