# R3.1 D1: stable requires a full finite W+1-value window inside the 1%
# ball about its midrange; all-exact windows use the absolute tolerance.
# The h_low API remains available for nonnumeric bindings until R3.2.

print of "=== WINDOWED STABLE (docs/PREDICATES.md, #205) ==="

define want(tag, got, exp) as:
    assert of [got == exp, f"{tag}: stable expected {exp} got {got}"]
    print of f"  PASS: {tag} (stable={got})"

# WS1: broad finite drift is outside the midrange ball.
a is 30.0
a is 32.0
a is 34.0
a is 36.0
a is 38.0
a is 40.0
a is 42.0
a is 44.0
a is 46.0
a is 48.0
a is 50.0
# #861 re-pin: value route: +2/step linear climb -> diverging; entropy small-dH "stable" was the additive-runaway blindness (#422)
want of ["WS1 broad full-window drift is outside midrange band", stable, false]

# WS2: constant2 is inside the ball.
b is 2.0
b is 2.0
b is 2.0
b is 2.0
b is 2.0
b is 2.0
b is 2.0
b is 2.0
b is 2.0
b is 2.0
b is 2.0
want of ["WS2 constant2 is stable", stable, true]

# WS3: partial window (count == 9 < N) -> does NOT fire (full-window rule)
c is 30.0
c is 32.0
c is 34.0
c is 36.0
c is 38.0
c is 40.0
c is 42.0
c is 44.0
c is 46.0
c is 48.0
want of ["WS3 partial window does not fire", stable, false]

# WS4: the jump makes the full value window exceed the midrange ball.
d is 40.0
d is 42.0
d is 44.0
d is 46.0
d is 48.0
d is 50.0
d is 52.0
d is 54.0
d is 56.0
d is 58.0
d is 200.0
want of ["WS4 window with a jump is outside midrange band", stable, false]

# WS5: constant1e6 is inside the ball at any magnitude.
e is 1000000.0
e is 1000000.0
e is 1000000.0
e is 1000000.0
e is 1000000.0
e is 1000000.0
e is 1000000.0
e is 1000000.0
e is 1000000.0
e is 1000000.0
e is 1000000.0
want of ["WS5 constant1e6 is stable", stable, true]

# WS6: the 70..75 range exceeds the midrange ball.
f is 70.0
f is 75.0
f is 70.0
f is 75.0
f is 70.0
f is 75.0
f is 70.0
f is 75.0
f is 70.0
f is 75.0
f is 70.0
want of ["WS6 oscillation does not fire", stable, false]

# WS7: constant42 is stable.
g is 42.0
g is 42.0
g is 42.0
g is 42.0
g is 42.0
g is 42.0
g is 42.0
g is 42.0
g is 42.0
g is 42.0
g is 42.0
want of ["WS7 constant42 is stable", stable, true]

# WS8: constant100 is stable.
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
want of ["WS8 constant100 is stable", stable, true]

print of "WINDOWED_STABLE_ALL_PASS"
