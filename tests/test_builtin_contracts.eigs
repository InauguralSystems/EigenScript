# #2502: invalid argument types raise independently of arithmetic traps.
define guard_kind(thunk, expected_kind, label) as:
    local seen_kind is "none"
    try:
        thunk of null
    catch guard_error:
        seen_kind is guard_error.kind
    assert of [seen_kind == expected_kind, label]

# Builtin contract fixes: #312 (negative indices), #316 (string predicates
# reject non-strings), #317 (min/max are true N-ary reductions).
load_file of "lib/test.eigs"

# ---- #317: min/max N-ary reduction ----
assert_eq of [min of ([5]), 5, "min of 1-element list is the element"]
assert_eq of [max of ([5]), 5, "max of 1-element list is the element"]
assert_eq of [min of [3, 7], 3, "min 2-arg unchanged"]
assert_eq of [max of [3, 7], 7, "max 2-arg unchanged"]
assert_eq of [max of [1, 2, 3], 3, "max reduces past the first two elements"]
assert_eq of [min of [4, 2, 9, 1, 5], 1, "min N-ary reduction"]
assert_eq of [max of [-3, -1, -2], -1, "max of all-negative list"]
assert_eq of [min of (7), 7, "min of a bare number is itself (mirrors sum)"]
# R1.6b-D2 / #1895: no numeric winner exists, including in soft mode.
for thunk in [(x) => min of [], (x) => min of ([]), (x) => max of [], (x) => max of ([])]:
    empty_kind is ""
    try:
        thunk of null
    catch e:
        empty_kind is e.kind
    assert_eq of [empty_kind, "value", "R1.6b-D2 empty min/max raises"]
bad_max_caught is false
try:
    ignored_bad_max is max of ["a", 5]
catch e:
    bad_max_caught is contains of [e.message, "max: element 0 is str"]
assert_true of [bad_max_caught, "non-number element raises even in compatibility mode"]

# ---- #316: string predicates reject non-string operands ----
guard_kind of [(_) => (index_of of [[1, 2, 3], 2]), "type_mismatch", "index_of rejects wrong argument types"]
guard_kind of [(_) => (index_of of [123, 2]), "type_mismatch", "index_of rejects wrong argument types"]
guard_kind of [(_) => (index_of of ["abc", 5]), "type_mismatch", "index_of rejects wrong argument types"]
assert_eq of [index_of of ["abc", "c"], 2, "index_of still finds real needles"]
guard_kind of [(_) => (contains of [[1, 2, 3], 2]), "type_mismatch", "contains rejects a list haystack"]
guard_kind of [(_) => (contains of ["abc", 5]), "type_mismatch", "contains rejects wrong argument types"]
assert_eq of [contains of ["abc", "b"], true, "contains still matches"]
guard_kind of [(_) => (starts_with of [[1, 2, 3], 1]), "type_mismatch", "starts_with rejects wrong argument types"]
assert_eq of [starts_with of ["abc", "ab"], true, "starts_with still matches"]
guard_kind of [(_) => (ends_with of [999, 9]), "type_mismatch", "ends_with rejects wrong argument types"]
assert_eq of [ends_with of ["abc", "bc"], true, "ends_with still matches"]
assert_eq of [ends_with of ["abc", ""], true, "empty suffix still matches a real string"]

# ---- #312: builtin accessors honor negative indices like [] ----
xs is [10, 20, 30]
assert_eq of [get_at of [xs, -1], 30, "get_at -1 is the last element"]
assert_eq of [get_at of [xs, -1], xs[-1], "get_at -1 matches the [] operator"]
assert_eq of [get_at of [xs, -3], 10, "get_at -len is the first element"]
# #499: past-the-start now raises index_range, matching the [] operator
# (xs[-4] on a 3-list raises) — the whole point of #312 was "honor negative
# indices like []", and [] raises out of range rather than folding to 0.
ga_past is 0
ga_past_k is ""
try:
    ig is get_at of [xs, -4]
catch e:
    ga_past is 1
    ga_past_k is e.kind
assert_true of [ga_past == 1 and ga_past_k == "index_range", "get_at past-the-start raises index_range"]
set_at of [xs, -1, 99]
assert_eq of [xs[2], 99, "set_at -1 writes the last element"]
sa_past is 0
try:
    set_at of [xs, -4, 111]
catch e:
    sa_past is 1
assert_true of [sa_past == 1, "set_at past-the-start raises (was a silent no-op)"]
assert_eq of [xs[0], 10, "set_at past-the-start left the list unchanged"]
grid is [[1, 2], [3, 4]]
assert_eq of [get_at of [grid, -1, -1], 4, "2D get_at negative row and col"]
set_at of [grid, -1, -2, 77]
assert_eq of [grid[1][0], 77, "2D set_at negative row and col"]
assert_eq of [char_at of ["hello", -1], "o", "char_at -1 is the last char"]
assert_eq of [char_at of ["hello", -1], "hello"[-1], "char_at -1 matches the [] operator"]
assert_eq of [char_at of ["hi", -3], "", "char_at past-the-start keeps the empty miss"]

test_summary of null
