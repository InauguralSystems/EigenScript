# R3.1: numeric interrogations read value, displacement and relative-step
# settledness. First samples have no displacement or settledness.

pass_count is 0
fail_count is 0

define check(args) as:
    label is args[0]
    cond is args[1]
    if cond:
        pass_count is pass_count + 1
    else:
        fail_count is fail_count + 1
        print of ("FAIL: " + label)

# --- numeric value channel ---
x is 1.0
check of ["first why is null", (why is x) == null]
check of ["first how is null", (how is x) == null]
check of ["numeric where preserves 1.0", (where is x) == 1.0]
nx is 0 - 1.0
check of ["numeric where preserves negative sign", (where is nx) == (0 - 1.0)]
z is 0.0
check of ["numeric where preserves zero", (where is z) == 0.0]

y is 1.0
i is 0
loop while i < 12:
    y is 1.0
    i is i + 1
check of ["flat run at 1.0 certifies converged", (report of y) == "converged"]
check of ["constant 1.0 is converged", (converged of y)]
check of ["constant where is its current value", (where is y) == 1.0]

# a genuine convergence to the home region still classifies converged
c is 100.0
j is 0
loop while j < 40:
    c is c * 0.5
    j is j + 1
check of ["decay toward 0 still converges", (report of c) == "converged"]

# --- how gradient ---
s is 5.0
k is 0
loop while k < 12:
    s is 5.0
    k is k + 1
check of ["settled binding: how == 1", (how is s) == 1.0]

b is 5.0
b is 1.0
check of ["how normalizes the relative step", (abs of ((how is b) - (0.001 / (0.001 + 0.8)))) < 0.000000000000001]
check of ["why records the displacement", (why is b) == (0 - 4.0)]

# in [0, 1] always
q is 3.0
q is 3.0001
hq is how is q
check of ["how stays in [0,1]", (hq >= 0.0) and (hq <= 1.0)]

total is pass_count + fail_count
print of f"Observer coherence tests: {pass_count}/{total} passed"
if fail_count == 0:
    print of "All tests passed"
else:
    assert of [0, "Some observer coherence tests failed"]
