# road-bind: v total
# road-native: required
v is 100.0
total is 0.0
for i in range of 1200.0:
    if i % 2.0 == 0.0:
        local v is 10.0
    for b in [0.0, 1.0]:
        k is 0.0
        loop while k < 12.0:
            v is v + 1.0
            total is total + v
            k is k + 1.0
print of [v, total]
