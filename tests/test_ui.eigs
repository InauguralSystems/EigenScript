assert_ui_result1 of [_ease_in_out, 0.75, 0.875, "ease-in-out second half"]
assert_eq of [_point_in_rect of [11, 21, 10, 20, 4, 5], true, "point inside rectangle"]
assert_eq of [_point_in_rect of [14, 21, 10, 20, 4, 5], false, "right rectangle edge excluded"]
assert_eq of [text_width of ["ab", 2], 24, "bitmap text advance"]
assert_ui_result1 of [text_height, 2, 14, "bitmap text height"]
assert_eq of [_combo_matches of ["ctrl+shift+x", 1, 1, 0, "x"], true, "hotkey exact modifiers"]
assert_eq of [_combo_matches of ["ctrl+shift+x", 1, 0, 0, "x"], false, "hotkey missing shift"]

