# Source-only input-family behavior cases. Shared transition2/4 and render1
# helpers must invoke the first function argument before checking fields/logs.
coverage_input_saved is {"focus": _ui.focused_input, "edit": _ui.edit_root, "clipboard": _ui.clipboard, "record": _gfx_rec}
coverage_input_log is {"changes": 0, "commits": 0, "id": "", "text": ""}
define coverage_input_changed(widget) as:
    coverage_input_log.changes is coverage_input_log.changes + 1
    coverage_input_log.id is widget.id
define coverage_input_committed(widget) as:
    coverage_input_log.commits is coverage_input_log.commits + 1
    coverage_input_log.text is widget.text

assert_ui_fields of [text_input of ["cov-ti-constructor", 2, 3, 100, "abc", null], {"type": "text_input", "w": 100, "h": 24, "cursor": 3, "focused": 0}, "input constructor cursor and geometry"]
