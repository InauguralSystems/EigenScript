# ============================================================
# UI Toolkit Unit Tests — layout, hit-testing, focus, registry
# ============================================================
# Runs without SDL2 by stubbing gfx_* functions.

load_file of "lib/test.eigs"

# ---- Stub gfx functions (no-ops for headless testing) ----
#
# The drawing stubs also RECORD, gated on _gfx_rec (0 by default, so the
# rest of the suite is unchanged). A stubbed gfx layer cannot observe
# whether gfx_clip was honoured — so the containment claim for the chart
# widget (#819/#823) is proved on the recorded primitives instead: every
# call the render path makes is checked against the widget rect. That is
# a property of the render code, not of the renderer.

_gfx_rec is 0
_gfx_log is []

define _gfx_note(kind, args) as:
    if _gfx_rec == 1:
        append of [_gfx_log, [kind, args]]

define gfx_open(args) as:
    return 1

define gfx_close(args) as:
    return null

define gfx_clear(args) as:
    return null

define gfx_rect(args) as:
    _gfx_note of ["rect", args]
    return null

define gfx_rrect(args) as:
    _gfx_note of ["rrect", args]
    return null

define gfx_line(args) as:
    _gfx_note of ["line", args]
    return null

define gfx_point(args) as:
    _gfx_note of ["point", args]
    return null

define gfx_circle(args) as:
    _gfx_note of ["circle", args]
    return null

define gfx_text(args) as:
    _gfx_note of ["text", args]
    return null

define gfx_clip(args) as:
    _gfx_note of ["clip", args]
    return null

define gfx_present(args) as:
    return null

define gfx_poll(args) as:
    return null

define gfx_delay(args) as:
    return null

define gfx_ticks(args) as:
    return 1000

# Metrics stubs mirror the bitmap-font math (#593) so every layout
# assertion below keeps its historical value regardless of the fonts
# installed on the machine running the suite.
define gfx_text_width(text, scale) as:
    return (len of text) * 6 * scale

define gfx_text_height(scale) as:
    return 7 * scale

# ---- Load UI toolkit ----

load_file of "lib/ui.eigs"

print of "=== UI Toolkit Tests ==="

# ============================================================
# 1. Constructor tests
# ============================================================

print of "--- Constructor Tests ---"

b is button of ["btn1", 10, 20, 80, 30, "Click", null]
assert_eq of [b.type, "button", "button type"]
assert_eq of [b.id, "btn1", "button id"]
assert_eq of [b.x, 10, "button x"]
assert_eq of [b.y, 20, "button y"]
assert_eq of [b.w, 80, "button w"]
assert_eq of [b.h, 30, "button h"]
assert_eq of [b.label, "Click", "button label"]
assert_eq of [b.hover, 0, "button hover default"]
assert_eq of [b.pressed, 0, "button pressed default"]
assert_eq of [b.enabled, 1, "button enabled default"]
assert_eq of [b.visible, 1, "button visible default"]

s is slider of ["sl1", 5, 10, 200, 0, 100, 50, null]
assert_eq of [s.type, "slider", "slider type"]
assert_eq of [s.value, 50, "slider value"]
assert_eq of [s.min_val, 0, "slider min"]
assert_eq of [s.max_val, 100, "slider max"]

p is panel of ["pan1", 0, 0, 400, 300]
assert_eq of [p.type, "panel", "panel type"]
assert_eq of [len of p.children, 0, "panel empty children"]

lbl is label of ["lbl1", 10, 10, "Hello"]
assert_eq of [lbl.type, "label", "label type"]
assert_eq of [lbl.text, "Hello", "label text"]

t is toggle of ["tog1", 0, 0, 0, null]
assert_eq of [t.type, "toggle", "toggle type"]
assert_eq of [t.value, 0, "toggle default off"]

# ---- Per-widget button colors (#566) ----
# Render every state with custom bg/text_color set: the render path must
# not error (gfx stubs are no-ops) and must not clobber the overrides.
bc is button of ["btnc", 0, 0, 80, 24, "Rec", null]
bc.bg is [200, 40, 40]
bc.text_color is [255, 255, 255]
_render_button of [bc, 0, 0]
bc.hover is 1
_render_button of [bc, 0, 0]
bc.pressed is 1
_render_button of [bc, 0, 0]
bc.enabled is 0
_render_button of [bc, 0, 0]
assert_eq of [bc.bg[0], 200, "custom button bg preserved across renders"]
assert_eq of [bc.text_color[0], 255, "custom button text color preserved"]
bd is button of ["btnd", 0, 0, 80, 24, "Plain", null]
bd.hover is 1
_render_button of [bd, 0, 0]
assert_eq of [bd.bg, null, "plain button has no bg override"]

# ============================================================
# 2. Registry tests
# ============================================================

print of "--- Registry Tests ---"

# Widget types are registered
assert_true of [_widget_registry["button"] != null, "button registered"]
assert_true of [_widget_registry["slider"] != null, "slider registered"]
assert_true of [_widget_registry["panel"] != null, "panel registered"]
assert_true of [_widget_registry["tabs"] != null, "tabs registered"]
assert_true of [_widget_registry["table"] != null, "table registered"]

# Container flag
assert_eq of [_widget_registry["panel"].container, 1, "panel is container"]
assert_eq of [_widget_registry["hbox"].container, 1, "hbox is container"]
assert_eq of [_widget_registry["button"].container, 0, "button not container"]
assert_eq of [_widget_registry["slider"].container, 0, "slider not container"]

# Focusable flag
assert_eq of [_widget_registry["button"].focusable, 1, "button focusable"]
assert_eq of [_widget_registry["slider"].focusable, 1, "slider focusable"]
assert_eq of [_widget_registry["label"].focusable, 0, "label not focusable"]
assert_eq of [_widget_registry["separator"].focusable, 0, "separator not focusable"]

# _is_container uses registry
assert_eq of [_is_container of "panel", 1, "_is_container panel"]
assert_eq of [_is_container of "vbox", 1, "_is_container vbox"]
assert_eq of [_is_container of "button", 0, "_is_container button"]

# ============================================================
# 3. Layout tests
# ============================================================

print of "--- Layout Tests ---"

# hbox with 3 children of equal width
root is panel of ["root", 0, 0, 300, 100]
hb is hbox of ["hb", 0, 0, 300, 50]
hb.gap is 0
hb.padding is 0
c1 is button of ["c1", 0, 0, 100, 30, "A", null]
c2 is button of ["c2", 0, 0, 100, 30, "B", null]
c3 is button of ["c3", 0, 0, 100, 30, "C", null]
add_child of [hb, c1]
add_child of [hb, c2]
add_child of [hb, c3]
add_child of [root, hb]

_layout of [root, 0, 0]

assert_eq of [c1.x, 0, "hbox child1 x"]
assert_eq of [c2.x, 100, "hbox child2 x"]
assert_eq of [c3.x, 200, "hbox child3 x"]

# vbox with gap
root2 is panel of ["root2", 0, 0, 200, 400]
vb is vbox of ["vb", 10, 10, 200, 300]
vb.gap is 10
vb.padding is 5
v1 is button of ["v1", 0, 0, 80, 30, "X", null]
v2 is button of ["v2", 0, 0, 80, 30, "Y", null]
add_child of [vb, v1]
add_child of [vb, v2]
add_child of [root2, vb]

_layout of [root2, 0, 0]

assert_eq of [v1.y, 5, "vbox child1 y (padding)"]
assert_eq of [v2.y, 45, "vbox child2 y (30h + 10gap + 5pad)"]

# Cached absolute positions
assert_eq of [root2._ax, 0, "root _ax"]
assert_eq of [root2._ay, 0, "root _ay"]
assert_eq of [vb._ax, 10, "vbox _ax"]
assert_eq of [vb._ay, 10, "vbox _ay"]
assert_eq of [v1._ax, 15, "vbox child1 _ax (10 + 5pad)"]
assert_eq of [v1._ay, 15, "vbox child1 _ay (10 + 5pad)"]

# ============================================================
# 4. Hit-test tests
# ============================================================

print of "--- Hit-Test Tests ---"

# Build a simple tree
hr is panel of ["hr", 0, 0, 400, 300]
hb1 is button of ["hb1", 10, 10, 80, 30, "Hit", null]
hb2 is button of ["hb2", 100, 10, 80, 30, "Miss", null]
add_child of [hr, hb1]
add_child of [hr, hb2]

_layout of [hr, 0, 0]

# Hit inside button 1
result is _hit_test of [hr, 0, 0, 50, 25]
assert_true of [result != null, "hit test finds widget"]
assert_eq of [result.id, "hb1", "hit test correct widget"]

# Hit inside button 2
result is _hit_test of [hr, 0, 0, 140, 25]
assert_true of [result != null, "hit test button 2"]
assert_eq of [result.id, "hb2", "hit test button 2 id"]

# Miss — empty area
result is _hit_test of [hr, 0, 0, 250, 250]
assert_true of [result == null, "hit test miss returns null"]

# Hit test respects visibility
hb1.visible is 0
result is _hit_test of [hr, 0, 0, 50, 25]
assert_true of [result == null, "invisible widget not hit"]
hb1.visible is 1

# ============================================================
# 5. Focus tests
# ============================================================

print of "--- Focus Tests ---"

# Build tree: panel > [button, label, slider, button]
fp is panel of ["fp", 0, 0, 400, 200]
fb1 is button of ["fb1", 10, 10, 60, 24, "A", null]
fl is label of ["fl", 80, 10, "Text"]
fs is slider of ["fs", 10, 50, 200, 0, 100, 50, null]
fb2 is button of ["fb2", 10, 80, 60, 24, "B", null]
add_child of [fp, fb1]
add_child of [fp, fl]
add_child of [fp, fs]
add_child of [fp, fb2]

_layout of [fp, 0, 0]

_ui.focus_list is []
_build_focus_list of fp
assert_eq of [len of _ui.focus_list, 3, "focus list skips label (3 focusable)"]
assert_eq of [_ui.focus_list[0].id, "fb1", "focus list[0] = button 1"]
assert_eq of [_ui.focus_list[1].id, "fs", "focus list[1] = slider"]
assert_eq of [_ui.focus_list[2].id, "fb2", "focus list[2] = button 2"]

# Focus cycling
_ui.focus_index is -1
_ui.focused_widget is null
_ui.focused_input is null
_focus_next of [fp, 0]
assert_eq of [_ui.focused_widget.id, "fb1", "focus next -> button 1"]

_focus_next of [fp, 0]
assert_eq of [_ui.focused_widget.id, "fs", "focus next -> slider"]

_focus_next of [fp, 0]
assert_eq of [_ui.focused_widget.id, "fb2", "focus next -> button 2"]

_focus_next of [fp, 0]
assert_eq of [_ui.focused_widget.id, "fb1", "focus wraps to button 1"]

# Reverse
_focus_next of [fp, 1]
assert_eq of [_ui.focused_widget.id, "fb2", "focus prev wraps to button 2"]

# Disabled widget skipped
fs.enabled is 0
_ui.focus_list is []
_build_focus_list of fp
assert_eq of [len of _ui.focus_list, 2, "disabled slider not in focus list"]
fs.enabled is 1

# ============================================================
# 6. Scroll tests
# ============================================================

print of "--- Scroll Tests ---"

sp is scroll_panel of ["sp", 0, 0, 200, 100]
sp.content_h is 500

_layout of [sp, 0, 0]

# Scroll down
_scroll_panels of [sp, 0, 60]
assert_eq of [sp.scroll_y, 60, "scroll down 60"]

# Scroll past max
_scroll_panels of [sp, 0, 500]
assert_eq of [sp.scroll_y, 400, "scroll clamped to max (500-100)"]

# Scroll back up past 0
_scroll_panels of [sp, 0, -9999]
assert_eq of [sp.scroll_y, 0, "scroll clamped to 0"]

# Item list scroll
il is item_list of ["il", 0, 0, 100, 60, ["a", "b", "c", "d", "e"], null]

_layout of [il, 0, 0]

_scroll_panels of [il, 0, 30]
assert_eq of [il.scroll_y, 30, "item_list scroll down"]

_scroll_panels of [il, 0, 999]
max_expected is (len of il.items) * il.item_h - il.h
assert_eq of [il.scroll_y, max_expected, "item_list scroll clamped"]

_scroll_panels of [il, 0, -9999]
assert_eq of [il.scroll_y, 0, "item_list scroll min 0"]

# ============================================================
# 7. Keyboard accessibility — 10 new focusable types
# ============================================================

print of "--- Keyboard Accessibility Tests ---"

# Build tree with all 10 new focusable types
kp is panel of ["kp", 0, 0, 800, 600]
add_child of [kp, canvas of ["kc", 0, 0, 100, 100, null, null]]
add_child of [kp, editable_label of ["kel", 0, 0, "edit", null]]
add_child of [kp, grid of ["kg", 0, 0, 4, 4, 20, 20, null]]
add_child of [kp, chart of ["kch", 0, 0, 200, 100]]
add_child of [kp, bar_chart of ["kbc", 0, 0, 200, 100, ["a"], [1], null]]
add_child of [kp, gauge of ["kga", 0, 0, 60, 0, 100, 50, ""]]
add_child of [kp, code_view of ["kcv", 0, 0, 200, 100, "hello"]]
add_child of [kp, color_picker of ["kcp", 0, 0, null]]
add_child of [kp, waveform_view of ["kwv", 0, 0, 200, 100]]
add_child of [kp, piano_keyboard of ["kpk", 0, 0, 2, null]]

_layout of [kp, 0, 0]

_ui.focus_list is []
_build_focus_list of kp
assert_eq of [len of _ui.focus_list, 10, "all 10 new types in focus list"]

# Verify specific types are present
found_canvas is 0
found_grid is 0
found_chart is 0
found_gauge is 0
found_color_picker is 0
for i in range of (len of _ui.focus_list):
    if _ui.focus_list[i].type == "canvas":
        found_canvas is 1
    if _ui.focus_list[i].type == "grid":
        found_grid is 1
    if _ui.focus_list[i].type == "chart":
        found_chart is 1
    if _ui.focus_list[i].type == "gauge":
        found_gauge is 1
    if _ui.focus_list[i].type == "color_picker":
        found_color_picker is 1
assert_eq of [found_canvas, 1, "canvas focusable"]
assert_eq of [found_grid, 1, "grid focusable"]
assert_eq of [found_chart, 1, "chart focusable"]
assert_eq of [found_gauge, 1, "gauge focusable"]
assert_eq of [found_color_picker, 1, "color_picker focusable"]

# Grid keyboard: arrow moves hover
g is grid of ["tg", 0, 0, 4, 4, 20, 20, null]
g.hover_row is 1
g.hover_col is 1
_ui.focused_widget is g
_handle_focus_key of [kp, {"key": "right", "shift": 0, "ctrl": 0, "alt": 0}]
assert_eq of [g.hover_col, 2, "grid right arrow"]
_handle_focus_key of [kp, {"key": "down", "shift": 0, "ctrl": 0, "alt": 0}]
assert_eq of [g.hover_row, 2, "grid down arrow"]

# Grid keyboard: space toggles cell
_handle_focus_key of [kp, {"key": "space", "shift": 0, "ctrl": 0, "alt": 0}]
assert_eq of [g.cells[2][2], 1, "grid space toggles on"]
_handle_focus_key of [kp, {"key": "space", "shift": 0, "ctrl": 0, "alt": 0}]
assert_eq of [g.cells[2][2], 0, "grid space toggles off"]

# Editable label: enter starts editing
el is editable_label of ["tel", 0, 0, "test", null]
_ui.focused_widget is el
_handle_focus_key of [kp, {"key": "return", "shift": 0, "ctrl": 0, "alt": 0}]
assert_eq of [el.editing, 1, "editable_label enter starts editing"]

# ============================================================
# 8. Canvas raw-event seam + drag capture (#567)
# ============================================================
# NOTE: the gfx_ticks stub above returns a constant, so every repeat
# mousedown on the SAME widget id reads as a double-click and skips the
# registry mousedown path — reset _ui.last_click_id between gestures.

print of "--- Canvas Event Seam Tests (#567) ---"

cv_seen is []
define cv_on_mouse(w, ev) as:
    append of [cv_seen, ev.type]
    if ev.type == "mousedown":
        claim_drag of w

cvroot is panel of ["cvroot", 0, 0, 400, 300]
cv is canvas of ["cv", 10, 10, 300, 200, null, cv_on_mouse]
add_child of [cvroot, cv]
_layout of [cvroot, 0, 0]

# Hover mousemove (no button) reaches on_mouse
dispatch of [cvroot, {"type": "mousemove", "x": 60, "y": 60}]
assert_eq of [len of cv_seen, 1, "hover mousemove delivered to canvas on_mouse"]
assert_eq of [cv_seen[0], "mousemove", "hover event type is mousemove"]

# Full press-move-release gesture with capture (the #567 repro)
cv_seen is []
dispatch of [cvroot, {"type": "mousedown", "x": 50, "y": 50, "button": 1}]
assert_true of [_ui.drag_widget != null, "canvas claimed the pointer via claim_drag"]
dispatch of [cvroot, {"type": "mousemove", "x": 80, "y": 60}]
dispatch of [cvroot, {"type": "mousemove", "x": 120, "y": 70}]
dispatch of [cvroot, {"type": "mouseup", "x": 120, "y": 70, "button": 1}]
assert_eq of [len of cv_seen, 4, "canvas saw all 4 gesture events"]
assert_eq of [cv_seen[0], "mousedown", "gesture event 0 = mousedown"]
assert_eq of [cv_seen[1], "mousemove", "drag mousemove delivered while captured"]
assert_eq of [cv_seen[3], "mouseup", "terminating mouseup delivered to canvas"]
assert_true of [_ui.drag_widget == null, "capture released on mouseup"]

# Modifier fields ride along on the event dict (#568 contract)
cv_mods is []
define cv_mod_mouse(w, ev) as:
    append of [cv_mods, ev.shift]
    append of [cv_mods, ev.ctrl]
cv.on_mouse is cv_mod_mouse
_ui.last_click_id is ""
dispatch of [cvroot, {"type": "mousedown", "x": 50, "y": 50, "button": 1, "shift": 1, "ctrl": 0}]
assert_eq of [cv_mods[0], 1, "ev.shift passes through dispatch to on_mouse"]
assert_eq of [cv_mods[1], 0, "ev.ctrl passes through dispatch to on_mouse"]
_ui.drag_widget is null

# Sharp edge (#567): a claimant with no drag handler and no on_mouse is
# a silent no-op — this used to throw type_mismatch in the slider updater.
cv0 is canvas of ["cv0", 10, 10, 100, 100, null, null]
claim_drag of cv0
dispatch of [cvroot, {"type": "mousemove", "x": 100, "y": 60}]
assert_true of [_ui.drag_widget != null, "handler-less claimant keeps capture, no throw"]
release_drag of null
assert_true of [_ui.drag_widget == null, "release_drag clears capture"]

# ============================================================
# 9. Registry-driven drag back-compat (built-in draggable types)
# ============================================================

print of "--- Drag Registry Back-compat Tests ---"

dr is panel of ["dr", 0, 0, 400, 300]
sl_changes is 0
define on_sl_change(w) as:
    sl_changes is sl_changes + 1
dsl is slider of ["dsl", 10, 10, 200, 0, 100, 0, on_sl_change]
dvs is vslider of ["dvs", 10, 50, 100, 0, 100, 0, null]
dkn is knob of ["dkn", 250, 10, 40, 0, 100, 50, null]
dsb is scrollbar of ["dsb", 10, 200, 200, 0, null]
dwv is waveform_view of ["dwv", 10, 220, 200, 60]
dwv.zoom is 2.0
dwv.offset is 100
dcp is color_picker of ["dcp", 220, 60, null]
add_child of [dr, dsl]
add_child of [dr, dvs]
add_child of [dr, dkn]
add_child of [dr, dsb]
add_child of [dr, dwv]
add_child of [dr, dcp]
_layout of [dr, 0, 0]

# slider: press, drag, release
dispatch of [dr, {"type": "mousedown", "x": 60, "y": 18, "button": 1}]
assert_eq of [dsl.value, 25, "slider mousedown sets value"]
dispatch of [dr, {"type": "mousemove", "x": 110, "y": 18}]
assert_eq of [dsl.value, 50, "slider drag updates value via registry on_drag"]
dispatch of [dr, {"type": "mouseup", "x": 110, "y": 18, "button": 1}]
assert_eq of [dsl.dragging, 0, "slider dragging cleared on release"]
assert_true of [_ui.drag_widget == null, "slider capture released"]
assert_eq of [sl_changes, 3, "slider on_change fired on press+drag+release"]

# vslider
dispatch of [dr, {"type": "mousedown", "x": 18, "y": 100, "button": 1}]
dispatch of [dr, {"type": "mousemove", "x": 18, "y": 75}]
assert_eq of [dvs.value, 75, "vslider drag updates value"]
dispatch of [dr, {"type": "mouseup", "x": 18, "y": 75, "button": 1}]

# knob (vertical relative drag)
dispatch of [dr, {"type": "mousedown", "x": 260, "y": 30, "button": 1}]
dispatch of [dr, {"type": "mousemove", "x": 260, "y": 10}]
assert_near of [dkn.value, 60, 0.0001, "knob drag updates value"]
dispatch of [dr, {"type": "mouseup", "x": 260, "y": 10, "button": 1}]

# scrollbar (horizontal)
dispatch of [dr, {"type": "mousedown", "x": 60, "y": 206, "button": 1}]
dispatch of [dr, {"type": "mousemove", "x": 100, "y": 206}]
assert_eq of [dsb.value, 0.4375, "scrollbar drag updates value"]
dispatch of [dr, {"type": "mouseup", "x": 100, "y": 206, "button": 1}]

# waveform_view (sample-space selection)
dispatch of [dr, {"type": "mousedown", "x": 60, "y": 240, "button": 1}]
assert_eq of [dwv.sel_start, 200, "waveform mousedown sets sel_start"]
dispatch of [dr, {"type": "mousemove", "x": 110, "y": 240}]
assert_eq of [dwv.sel_end, 300, "waveform drag extends sel_end"]
dispatch of [dr, {"type": "mouseup", "x": 110, "y": 240, "button": 1}]

# color_picker (SV square)
dispatch of [dr, {"type": "mousedown", "x": 270, "y": 90, "button": 1}]
dispatch of [dr, {"type": "mousemove", "x": 295, "y": 120}]
assert_eq of [dcp.sat, 0.5, "color_picker drag updates sat"]
assert_eq of [dcp.val, 0.5, "color_picker drag updates val"]
dispatch of [dr, {"type": "mouseup", "x": 295, "y": 120, "button": 1}]

# splitter (own root; hit is the divider bar)
spl_resizes is 0
define on_spl_resize(w) as:
    spl_resizes is spl_resizes + 1
sroot is panel of ["sroot", 0, 0, 400, 100]
spl is splitter of ["spl", 0, 0, 400, 100, 100, on_spl_resize]
add_child of [sroot, spl]
_layout of [sroot, 0, 0]
dispatch of [sroot, {"type": "mousedown", "x": 102, "y": 50, "button": 1}]
dispatch of [sroot, {"type": "mousemove", "x": 150, "y": 50}]
assert_eq of [spl.split_pos, 150, "splitter drag moves split_pos"]
assert_eq of [spl_resizes, 1, "splitter on_resize fired during drag"]
dispatch of [sroot, {"type": "mouseup", "x": 150, "y": 50, "button": 1}]

# ============================================================
# 10. Wheel seam (#569)
# ============================================================

print of "--- Wheel Seam Tests (#569) ---"

wheel_seen is []
define cv_on_wheel(w, ev) as:
    append of [wheel_seen, ev.y]
    append of [wheel_seen, ev.ctrl]

wroot is panel of ["wroot", 0, 0, 400, 300]
wsp is scroll_panel of ["wsp", 0, 0, 200, 100]
wsp.content_h is 300
wcv is canvas of ["wcv", 0, 0, 200, 300, null, null]
wcv.on_wheel is cv_on_wheel
add_child of [wsp, wcv]
add_child of [wroot, wsp]
_layout of [wroot, 0, 0]

# Position the cursor over the canvas, then wheel: on_wheel consumes it
dispatch of [wroot, {"type": "mousemove", "x": 50, "y": 50}]
dispatch of [wroot, {"type": "wheel", "x": 0, "y": -3, "ctrl": 1}]
assert_eq of [len of wheel_seen, 2, "canvas on_wheel received the event"]
assert_eq of [wheel_seen[0], -3, "on_wheel sees the y delta"]
assert_eq of [wheel_seen[1], 1, "on_wheel sees ctrl modifier (#568 pairing)"]
assert_eq of [wsp.scroll_y, 0, "consumed wheel does not scroll the enclosing panel"]

# Without on_wheel the scrollable walk handles it as before
wcv.on_wheel is null
dispatch of [wroot, {"type": "wheel", "x": 0, "y": -3}]
assert_eq of [wsp.scroll_y, 60, "wheel falls through to scroll_panel when unconsumed"]

# ev.mx/ev.my carry the pointer on the wheel event itself (#822): the
# hit test anchors there even when the tracked position is stale —
# park the tracked pointer OFF the canvas, then wheel with mx/my ON it.
wcv.on_wheel is cv_on_wheel
wheel_seen is []
dispatch of [wroot, {"type": "mousemove", "x": 380, "y": 280}]
dispatch of [wroot, {"type": "wheel", "x": 0, "y": -2, "mx": 50, "my": 50, "ctrl": 0}]
assert_eq of [len of wheel_seen, 2, "wheel with mx/my hits the widget under mx/my, not the stale pointer"]
assert_eq of [wheel_seen[0], -2, "ev.x/ev.y stay the scroll deltas when mx/my present"]

# A following wheel WITHOUT mx/my uses the position the last carrying
# event refreshed — the fallback path stays coherent after #822.
wheel_seen is []
dispatch of [wroot, {"type": "wheel", "x": 0, "y": -1}]
assert_eq of [len of wheel_seen, 2, "wheel without mx/my falls back to the refreshed tracked position"]

# ============================================================
# 11. scroll_panel child _ax/_ay account for scroll offset (#569)
# ============================================================

print of "--- Scroll Offset Cache Tests (#569) ---"

sp3 is scroll_panel of ["sp3", 0, 0, 200, 100]
sp3.content_h is 300
sp3.content_w is 400
cv3 is canvas of ["cv3", 0, 0, 400, 300, null, null]
add_child of [sp3, cv3]
_layout of [sp3, 0, 0]
assert_eq of [cv3._ay, 0, "unscrolled child _ay"]
sp3.scroll_y is 50
sp3.scroll_x is 30
_layout of [sp3, 0, 0]
assert_eq of [cv3._ay, 0 - 50, "child _ay accounts for scroll_y"]
assert_eq of [cv3._ax, 0 - 30, "child _ax accounts for scroll_x"]

# ============================================================
# 12. Keyboard routing through dispatch (#563)
# ============================================================

print of "--- Keyboard Routing Tests (#563) ---"

# Earlier sections leave focus state behind; these assertions are about
# routing, so start from a known-clear focus.
_ui.focused_input is null
_ui.focused_widget is null

kroot is panel of ["kroot", 0, 0, 800, 600]
hk_fired is [0]
define hk_cb() as:
    hk_fired[0] is hk_fired[0] + 1

register_hotkey of ["ctrl+s", hk_cb]
consumed is dispatch of [kroot, {"type": "keydown", "key": "s", "ctrl": 1, "shift": 0, "alt": 0}]
assert_eq of [hk_fired[0], 1, "hotkey fires through the public dispatch door"]
assert_eq of [consumed, 1, "dispatch reports the hotkey as consumed"]

# A key the toolkit does not claim is reported free for the app. Focus
# navigation reports its own consumption, so an unbound letter is free
# even while a widget holds focus.
free is dispatch of [kroot, {"type": "keydown", "key": "j", "ctrl": 0, "shift": 0, "alt": 0}]
assert_eq of [free, 0, "unclaimed key reported unconsumed"]

# handle_key is the same door app_loop uses — priority is pinned here
# rather than duplicated inside the loop.
hk2 is handle_key of [kroot, {"type": "keydown", "key": "s", "ctrl": 1, "shift": 0, "alt": 0}]
assert_eq of [hk2, 1, "handle_key consumes a registered hotkey"]
assert_eq of [hk_fired[0], 2, "handle_key fired the hotkey callback"]
unregister_hotkey of "ctrl+s"

# keyup is not a toolkit key event — it stays free for the app
ku is dispatch of [kroot, {"type": "keyup", "key": "s", "ctrl": 1, "shift": 0, "alt": 0}]
assert_eq of [ku, 0, "keyup reported unconsumed"]

# Escape pops the modal stack through dispatch
mdlg is dialog of ["mdlg", 200, 100, "T", "M", ["OK"], null]
push_modal of [mdlg, 800, 600]
assert_eq of [len of _ui.modal_stack, 1, "modal pushed"]
esc is dispatch of [kroot, {"type": "keydown", "key": "escape", "ctrl": 0, "shift": 0, "alt": 0}]
assert_eq of [len of _ui.modal_stack, 0, "escape pops modal through dispatch"]
assert_eq of [esc, 1, "escape-pops-modal reported consumed"]

# Focused text input takes keys ahead of focus navigation
ti is text_input of ["ti", 0, 0, 100, "", null]
_ui.focused_input is ti
dispatch of [kroot, {"type": "keydown", "key": "a", "ctrl": 0, "shift": 0, "alt": 0}]
assert_eq of [ti.text, "a", "focused text input receives keys through dispatch"]
_ui.focused_input is null

# ============================================================
# 13. Programmatic quit (#564)
# ============================================================

print of "--- Quit Seam Tests (#564) ---"

assert_eq of [_ui.quit_requested, 0, "quit_requested starts clear"]
request_quit of null
assert_eq of [_ui.quit_requested, 1, "request_quit sets the flag app_loop checks"]
_ui.quit_requested is 0

# ============================================================
# 14. Combobox dropdown mouse selection (#577)
# ============================================================
# NOTE: reset _ui.last_click_id between gestures (see section 8's note).

print of "--- Combobox Dropdown Selection Tests (#577) ---"

cbroot is panel of ["cbroot", 0, 0, 400, 400]
cb_changed is [0]
define cb_on_change(w) as:
    cb_changed[0] is cb_changed[0] + 1

cbx is combobox of ["cbx", 10, 10, 120, ["alpha", "beta", "gamma"], cb_on_change]
add_child of [cbroot, cbx]
_layout of [cbroot, 0, 0]

# Click the closed box — opens the dropdown
dispatch of [cbroot, {"type": "mousedown", "x": 20, "y": 20, "button": 1}]
assert_eq of [cbx.open, 1, "mousedown opens the dropdown"]

# Click item 1 ("beta"): items start at _ay + h + 2 = 36, each 24 tall,
# so item 1 spans y 60..83. This is the #577 repro — before the fix the
# dropdown closed before the hit test and selected stayed -1.
dispatch of [cbroot, {"type": "mousedown", "x": 20, "y": 62, "button": 1}]
assert_eq of [cbx.selected, 1, "dropdown item selected by mouse (#577)"]
assert_eq of [cbx.open, 0, "selecting an item closes the dropdown"]
assert_eq of [cb_changed[0], 1, "on_change fired once for the selection"]

# Item 0 is reachable too — selection follows the click's own y, not a
# stale hover_index (no mousemove precedes these clicks).
_ui.last_click_id is ""
dispatch of [cbroot, {"type": "mousedown", "x": 20, "y": 20, "button": 1}]
assert_eq of [cbx.open, 1, "dropdown reopens"]
dispatch of [cbroot, {"type": "mousedown", "x": 20, "y": 40, "button": 1}]
assert_eq of [cbx.selected, 0, "item 0 selected by its own click position"]

# A click OUTSIDE an open dropdown still closes it and does not select
_ui.last_click_id is ""
dispatch of [cbroot, {"type": "mousedown", "x": 20, "y": 20, "button": 1}]
assert_eq of [cbx.open, 1, "dropdown reopens for the outside-click case"]
dispatch of [cbroot, {"type": "mousedown", "x": 300, "y": 300, "button": 1}]
assert_eq of [cbx.open, 0, "click outside closes the dropdown"]
assert_eq of [cbx.selected, 0, "click outside leaves selection untouched"]
assert_eq of [cb_changed[0], 2, "click outside fired no extra on_change"]

# A second combobox must not be closed-then-missed either: clicking one
# closes the OTHER, and still selects in the one clicked.
cby is combobox of ["cby", 200, 10, 120, ["x", "y"], null]
add_child of [cbroot, cby]
_layout of [cbroot, 0, 0]
_ui.last_click_id is ""
dispatch of [cbroot, {"type": "mousedown", "x": 20, "y": 20, "button": 1}]
assert_eq of [cbx.open, 1, "first combobox open"]
_ui.last_click_id is ""
dispatch of [cbroot, {"type": "mousedown", "x": 210, "y": 20, "button": 1}]
assert_eq of [cbx.open, 0, "clicking a sibling closes the first dropdown"]
assert_eq of [cby.open, 1, "the clicked sibling opens"]

# ============================================================
# 15. label carries w/h (#561)
# ============================================================

print of "--- Label Metrics Tests (#561) ---"

# Stub metrics: text_width = len*6*scale, text_height = 7*scale.
lb is label of ["lb", 0, 0, "BPM"]
assert_eq of [lb.w, 36, "label w measured from its text (3 chars * 6 * 2)"]
assert_eq of [lb.h, 14, "label h measured from its scale (7 * 2)"]

# The #561 repro: a label in a toolbar crashed _layout_toolbar reading
# child.h. Survival + vertical centering is the assertion.
lroot is panel of ["lroot", 0, 0, 800, 600]
ltb is toolbar of ["ltb", 0, 0, 800]
add_child of [ltb, label of ["cap", 0, 0, "BPM"]]
add_child of [lroot, ltb]
_layout of [lroot, 0, 0]
assert_eq of [ltb.children[0].y, 13, "label vertically centered in toolbar"]

# A label's text changes at runtime — layout must remeasure, or a time
# display's box goes stale the first time it restamps.
tl is ltb.children[0]
tl.text is "120.00 BPM  00:01:23"
_layout of [lroot, 0, 0]
assert_eq of [tl.w, 240, "label remeasured after its text changed"]

# hbox lays labels out against their measured width
lhb is hbox of ["lhb", 0, 0, 400, 40]
add_child of [lhb, label of ["la", 0, 0, "one"]]
add_child of [lhb, label of ["lbb", 0, 0, "two"]]
add_child of [lroot, lhb]
_layout of [lroot, 0, 0]
assert_eq of [lhb.children[0].x, 0, "first label at box origin"]
assert_eq of [lhb.children[1].x, 36, "second label advanced by the first's width"]

# auto_size = 0: the app owns the box and _layout must not overwrite it.
# The repro is DeslanStudio's modal click-catcher — an EMPTY label
# stamped to the full window, backing an overlay because containers are
# hit-transparent where no child sits. Remeasuring an empty label's text
# collapses it to w=0 and the catcher silently stops catching.
catcher is label of ["catcher", 0, 0, ""]
catcher.auto_size is 0
catcher.w is 800
catcher.h is 600
add_child of [lroot, catcher]
_layout of [lroot, 0, 0]
assert_eq of [catcher.w, 800, "auto_size 0 keeps the app's width through layout"]
assert_eq of [catcher.h, 600, "auto_size 0 keeps the app's height through layout"]
assert_true of [(_hit_test of [lroot, 0, 0, 400, 300]) != null, "the stamped catcher still catches clicks"]

# auto_size = 0 holds even when the text changes — a fixed-width slot
# for changing text (a padded caption) keeps the box the app chose.
catcher.text is "now it has text"
_layout of [lroot, 0, 0]
assert_eq of [catcher.w, 800, "auto_size 0 survives a text change"]

# Default stays auto: a plain label still tracks its text.
assert_eq of [lb.auto_size, 1, "labels auto-size by default"]

# ============================================================
# 16. grid cell ownership + row-label gutter (#572)
# ============================================================

print of "--- Grid Ownership Tests (#572) ---"

groot is panel of ["groot", 0, 0, 400, 400]
seen_val is [-1]
define g_on_cell(w, r, c) as:
    seen_val[0] is w.cells[r][c]

gd is grid of ["gd", 80, 10, 4, 4, 20, 20, g_on_cell]
add_child of [groot, gd]
_layout of [groot, 0, 0]

# Default: the widget owns the pattern and flips before reporting
assert_eq of [gd.owns_cells, 1, "grid owns its cells by default"]
dispatch of [groot, {"type": "mousedown", "x": 90, "y": 20, "button": 1}]
assert_eq of [gd.cells[0][0], 1, "owning grid flips the cell itself"]
assert_eq of [seen_val[0], 1, "on_cell sees the flipped value"]

# owns_cells = 0: input reports the hit and leaves cells alone, so an app
# whose model is the source of truth decides (the #572 repro).
gd.owns_cells is 0
gd.cells[1][1] is 0
_ui.last_click_id is ""
dispatch of [groot, {"type": "mousedown", "x": 110, "y": 40, "button": 1}]
assert_eq of [gd.cells[1][1], 0, "non-owning grid leaves the cell untouched"]
assert_eq of [seen_val[0], 0, "on_cell still reports the hit"]

# Keyboard must follow the same ownership rule as the mouse
gd.hover_row is 2
gd.hover_col is 2
gd.cells[2][2] is 0
_ui.focused_widget is gd
_handle_focus_key of [groot, {"key": "space", "shift": 0, "ctrl": 0, "alt": 0}]
assert_eq of [gd.cells[2][2], 0, "non-owning grid: keyboard does not flip either"]
gd.owns_cells is 1
_handle_focus_key of [groot, {"key": "space", "shift": 0, "ctrl": 0, "alt": 0}]
assert_eq of [gd.cells[2][2], 1, "owning grid: keyboard flips"]
_ui.focused_widget is null

# The row-label gutter is configurable rather than a hardcoded -60/scale-1
assert_eq of [gd.row_label_w, 60, "row-label gutter defaults to the historical 60"]
assert_eq of [gd.row_label_scale, 1, "row-label scale defaults to the historical 1"]

# ============================================================
# 17. Piano key release (#570)
# ============================================================

print of "--- Piano Release Tests (#570) ---"

proot is panel of ["proot", 0, 0, 400, 400]
pnotes is []
define p_on_note(w, n, on) as:
    append of [pnotes, [n, on]]

pk is piano_keyboard of ["pk", 0, 100, 2, p_on_note]
add_child of [proot, pk]
_layout of [proot, 0, 0]

# Press and release on the key: note-on then note-off
dispatch of [proot, {"type": "mousedown", "x": 5, "y": 110, "button": 1}]
assert_eq of [pk.pressed_note, 0, "mousedown presses the key"]
dispatch of [proot, {"type": "mouseup", "x": 5, "y": 110, "button": 1}]
assert_eq of [pk.pressed_note, 0 - 1, "mouseup releases the key"]
assert_eq of [len of pnotes, 2, "press+release produced two events"]
assert_eq of [pnotes[1][1], 0, "release fired note-off"]

# The #570 residual: press a key, then release with the pointer OFF the
# widget entirely. The note-off used to be a dispatch special case that
# only ran when mouseup hit-tested back to the same widget, so the note
# stuck on forever.
pnotes is []
_ui.last_click_id is ""
dispatch of [proot, {"type": "mousedown", "x": 5, "y": 110, "button": 1}]
assert_eq of [pk.pressed_note, 0, "key pressed before dragging off"]
dispatch of [proot, {"type": "mouseup", "x": 350, "y": 350, "button": 1}]
assert_eq of [pk.pressed_note, 0 - 1, "key released even though mouseup missed it"]
assert_eq of [pnotes[1][1], 0, "note-off fired on release-off-widget (#570)"]

# Releasing over ANOTHER widget must also release the key — that path
# returned early before reaching the release walk.
pbtn is button of ["pbtn", 200, 200, 80, 30, "x", null]
add_child of [proot, pbtn]
_layout of [proot, 0, 0]
pnotes is []
_ui.last_click_id is ""
dispatch of [proot, {"type": "mousedown", "x": 5, "y": 110, "button": 1}]
dispatch of [proot, {"type": "mouseup", "x": 210, "y": 210, "button": 1}]
assert_eq of [pk.pressed_note, 0 - 1, "key released when mouseup landed on a button"]
assert_eq of [pnotes[1][1], 0, "note-off fired when releasing over a button"]

# ============================================================
# 18. Hover feedback beyond buttons (#594)
# ============================================================
# Renders are verified by capturing what the renderer emits: the shade is
# the only gfx_rrect carrying an alpha (9th) argument, so recording those
# tells us whether a widget drew hover feedback at all. dispatch already
# set .hover for checkbox/toggle; only their renderers ignored it.

print of "--- Hover Shade Tests (#594) ---"

shade_alphas is []
define gfx_rrect(x, y, w, h, r, cr, cg, cb, ca) as:
    if ca != null:
        append of [shade_alphas, ca]
    return null

# checkbox: not hovered -> no shade
cbx2 is checkbox of ["cbx2", 0, 0, "Snap", 0, null]
cbx2.hover is 0
shade_alphas is []
_render_checkbox of [cbx2, 0, 0]
assert_eq of [len of shade_alphas, 0, "unhovered checkbox draws no shade"]

# checkbox: hovered -> theme hover_shade alpha
cbx2.hover is 1
shade_alphas is []
_render_checkbox of [cbx2, 0, 0]
assert_eq of [len of shade_alphas, 1, "hovered checkbox draws a shade (#594)"]
assert_eq of [shade_alphas[0], 22, "checkbox shade uses theme hover_shade alpha"]

# checkbox: disabled and hovered -> still no shade
cbx2.enabled is 0
shade_alphas is []
_render_checkbox of [cbx2, 0, 0]
assert_eq of [len of shade_alphas, 0, "disabled checkbox draws no shade even when hovered"]
cbx2.enabled is 1

# toggle: same treatment
tg2 is toggle of ["tg2", 0, 0, 0, null]
tg2.hover is 1
shade_alphas is []
_render_toggle of [tg2, 0, 0]
assert_eq of [len of shade_alphas, 1, "hovered toggle draws a shade (#594)"]
assert_eq of [shade_alphas[0], 22, "toggle shade uses theme hover_shade alpha"]

tg2.hover is 0
shade_alphas is []
_render_toggle of [tg2, 0, 0]
assert_eq of [len of shade_alphas, 0, "unhovered toggle draws no shade"]

# A custom-colored button prefers the pressed shade over the hover one,
# and a theme-colored button still swaps bg instead of shading.
btn2 is button of ["btn2", 0, 0, 60, 24, "Rec", null]
btn2.bg is [200, 60, 60]
btn2.hover is 1
btn2.pressed is 1
shade_alphas is []
_render_button of [btn2, 0, 0]
assert_eq of [shade_alphas[0], 70, "pressed custom button uses pressed_shade alpha"]

btn3 is button of ["btn3", 0, 0, 60, 24, "Play", null]
btn3.hover is 1
shade_alphas is []
_render_button of [btn3, 0, 0]
assert_eq of [len of shade_alphas, 0, "theme-colored button swaps bg rather than shading"]

# ============================================================
# 19. menu_bar (#565)
# ============================================================

print of "--- Menu Bar Tests (#565) ---"

# gfx_rrect was replaced above to capture shades; menu_bar's assertions
# are all state, not paint, so it stays as-is.
_ui.window_w is 800
_ui.window_h is 600

mb_picked is []
define mb_on_file(m, i) as:
    append of [mb_picked, ["file", i]]
define mb_on_help(m, i) as:
    append of [mb_picked, ["help", i]]

mbroot is panel of ["mbroot", 0, 0, 800, 600]
mbar is menu_bar of ["mbar", 0, 0, 800, [
    {"title": "File", "items": ["Open", ["Save", "Ctrl+S"], "-", ["Exit", "Ctrl+Q"]], "on_select": mb_on_file},
    {"title": "Help", "items": ["About"], "on_select": mb_on_help}
]]
add_child of [mbroot, mbar]
_layout of [mbroot, 0, 0]

assert_eq of [mbar.h, 22, "bar height from font metrics"]
assert_eq of [mbar.title_x[0], 0, "first title at bar origin"]
assert_eq of [mbar.title_x[1], 72, "second title advanced by the first's width"]
assert_eq of [mbar.open_index, 0 - 1, "bar starts closed"]

# Clicking a title opens its pull-down
dispatch of [mbroot, {"type": "mousedown", "x": 10, "y": 5, "button": 1}]
assert_eq of [mbar.open_index, 0, "clicking File opens its menu"]

# Picking an item: NOTE no last_click_id reset and no preceding mousemove
# — this is the real user flow (open, then click an item inside 400ms, on
# the same widget id). Both traps that bit #577 are asserted here.
dispatch of [mbroot, {"type": "mousedown", "x": 10, "y": mbar.h + 24 + 5, "button": 1}]
assert_eq of [len of mb_picked, 1, "item selected on the click that landed on it"]
assert_eq of [mb_picked[0][1], 1, "the item under the click was chosen (Save)"]
assert_eq of [mbar.open_index, 0 - 1, "selecting an item closes the bar"]

# A separator is not selectable
mb_picked is []
_ui.last_click_id is ""
dispatch of [mbroot, {"type": "mousedown", "x": 10, "y": 5, "button": 1}]
dispatch of [mbroot, {"type": "mousedown", "x": 10, "y": mbar.h + 2 * 24 + 5, "button": 1}]
assert_eq of [len of mb_picked, 0, "clicking a separator selects nothing"]
assert_eq of [mbar.open_index, 0, "clicking a separator leaves the menu open"]

# Clicking the open title again toggles it closed. (No reset needed: the
# bar is open, so the popup exemption already spares this from the
# double-click check.)
dispatch of [mbroot, {"type": "mousedown", "x": 10, "y": 5, "button": 1}]
assert_eq of [mbar.open_index, 0 - 1, "clicking the open title closes it"]

# Clicking away closes the bar. Reopening a CLOSED bar is a genuine
# repeat click on the same id, so it needs the section-8 reset — the
# gfx_ticks stub makes every click look simultaneous.
_ui.last_click_id is ""
dispatch of [mbroot, {"type": "mousedown", "x": 10, "y": 5, "button": 1}]
assert_eq of [mbar.open_index, 0, "menu reopened for the click-away case"]
dispatch of [mbroot, {"type": "mousedown", "x": 400, "y": 400, "button": 1}]
assert_eq of [mbar.open_index, 0 - 1, "clicking outside closes the bar"]

# Hovering another title while open slides the menu across
_ui.last_click_id is ""
dispatch of [mbroot, {"type": "mousedown", "x": 10, "y": 5, "button": 1}]
assert_eq of [mbar.open_index, 0, "File open before the slide"]
dispatch of [mbroot, {"type": "mousemove", "x": 80, "y": 5}]
assert_eq of [mbar.open_index, 1, "hovering Help while open slides the menu to it"]
_menu_bar_close of mbar

# An open pull-down is painted above the whole tree, so it must take the
# click above the whole tree: a widget added LATER (and therefore drawn
# on top in the tree-order walk) must not steal a click that visually
# landed on the menu. This is the z-order the consumer used to hand-roll
# by adding every menu last to the root.
under_hits is [0]
define under_click(b) as:
    under_hits[0] is under_hits[0] + 1

under is button of ["under", 0, 60, 200, 40, "covered", under_click]
add_child of [mbroot, under]
_layout of [mbroot, 0, 0]

mb_picked is []
_ui.last_click_id is ""
dispatch of [mbroot, {"type": "mousedown", "x": 10, "y": 5, "button": 1}]
# y=96 is inside BOTH the open File menu's item 3 ("Exit", spanning
# 94..117) and the button beneath it (60..100).
dispatch of [mbroot, {"type": "mousedown", "x": 10, "y": 96, "button": 1}]
dispatch of [mbroot, {"type": "mouseup", "x": 10, "y": 96, "button": 1}]
assert_eq of [under_hits[0], 0, "the covered button did not receive the click"]
assert_eq of [len of mb_picked, 1, "the open menu took the click instead"]
assert_eq of [mb_picked[0][1], 3, "the item under the click was chosen (Exit)"]

# With the bar closed, the same point reaches the button normally
_ui.last_click_id is ""
dispatch of [mbroot, {"type": "mousedown", "x": 10, "y": 96, "button": 1}]
dispatch of [mbroot, {"type": "mouseup", "x": 10, "y": 96, "button": 1}]
assert_eq of [under_hits[0], 1, "closed bar leaves the widget beneath clickable"]

# A pull-down near the right edge opens inward instead of off-window
mbar2 is menu_bar of ["mbar2", 700, 0, 100, [
    {"title": "Help", "items": ["About This Program"], "on_select": mb_on_help}
]]
add_child of [mbroot, mbar2]
_layout of [mbroot, 0, 0]
mbar2.open_index is 0
mpos is _menu_bar_popup_pos of [mbar2, 0]
assert_true of [mpos[0] + mbar2.popups[0].w <= 800, "right-edge menu clamped inside the window"]
_menu_bar_close of mbar2

# ============================================================
# 20. dialog hosts children (#575)
# ============================================================

print of "--- Dialog Container Tests (#575) ---"

_ui.window_w is 800
_ui.window_h is 600
_ui.modal_stack is []
_ui.focused_input is null

droot is panel of ["droot", 0, 0, 800, 600]
behind_hits is [0]
define behind_click(b) as:
    behind_hits[0] is behind_hits[0] + 1
behind is button of ["behind", 0, 0, 800, 600, "behind", behind_click]
add_child of [droot, behind]
_layout of [droot, 0, 0]

dbtn is []
define d_on_button(d, i) as:
    append of [dbtn, i]
ddlg is dialog of ["ddlg", 400, 300, "Choose", "", ["OK", "Cancel"], d_on_button]

dti is text_input of ["dti", 16, 60, 300, "", null]
add_child of [ddlg, dti]
dil is item_list of ["dil", 16, 100, 300, 120, ["alpha", "beta"], null]
add_child of [ddlg, dil]
assert_eq of [len of ddlg.children, 2, "a dialog hosts children (#575)"]
assert_eq of [_widget_registry["dialog"].container, 1, "dialog is a container"]

# push_modal centres it AND lays it out, so children have absolute
# positions before the first frame
push_modal of [ddlg, 800, 600]
assert_eq of [ddlg._ax, 200, "modal centred horizontally"]
assert_eq of [dti._ax, 216, "child laid out relative to the dialog"]

# A click on a CHILD reaches the child — not the dialog, not the tree
# behind it. Before #575 the modal path called _handle_dialog_click
# directly, so a dialog child could never be clicked at all.
dispatch of [droot, {"type": "mousedown", "x": dti._ax + 5, "y": dti._ay + 5, "button": 1}]
assert_true of [_ui.focused_input != null, "clicking a dialog child focuses it"]
assert_eq of [_ui.focused_input.id, "dti", "the child itself took the click"]

# ...so keyboard reaches it too (#563's handle_key + this)
dispatch of [droot, {"type": "keydown", "key": "h", "ctrl": 0, "shift": 0, "alt": 0}]
dispatch of [droot, {"type": "keydown", "key": "i", "ctrl": 0, "shift": 0, "alt": 0}]
assert_eq of [dti.text, "hi", "typing reaches a text_input inside a modal"]

# a second child type, to show it is the general widget path
_ui.last_click_id is ""
dispatch of [droot, {"type": "mousedown", "x": dil._ax + 5, "y": dil._ay + 5, "button": 1}]
assert_eq of [dil.selected, 0, "an item_list inside a modal selects"]

# The dialog's buttons show hover. hover_btn was only ever set to -1 and
# read by the renderer — nothing assigned it, because no mousemove could
# reach a modal at all.
dr0 is _dialog_btn_rect of [ddlg, 0, ddlg._ax, ddlg._ay]
dispatch of [droot, {"type": "mousemove", "x": dr0[0] + 2, "y": dr0[1] + 2}]
assert_eq of [ddlg.hover_btn, 0, "dialog button hover tracks the pointer (#575)"]
dispatch of [droot, {"type": "mousemove", "x": ddlg._ax + 5, "y": ddlg._ay + 5}]
assert_eq of [ddlg.hover_btn, 0 - 1, "hover clears off the buttons"]

# Modality: a click outside the dialog reaches nothing behind it
_ui.last_click_id is ""
dispatch of [droot, {"type": "mousedown", "x": 5, "y": 5, "button": 1}]
dispatch of [droot, {"type": "mouseup", "x": 5, "y": 5, "button": 1}]
assert_eq of [behind_hits[0], 0, "a modal swallows clicks meant for the tree behind"]

# The dialog's own buttons still fire and close it
_ui.last_click_id is ""
dispatch of [droot, {"type": "mousedown", "x": dr0[0] + 2, "y": dr0[1] + 2, "button": 1}]
assert_eq of [len of dbtn, 1, "dialog button fired"]
assert_eq of [dbtn[0], 0, "the button under the click fired (OK)"]
assert_eq of [ddlg.visible, 0, "the dialog closed itself"]
_ui.modal_stack is []
_ui.focused_input is null

# ============================================================
# 21. file_dialog (#575)
# ============================================================

print of "--- File Dialog Tests (#575) ---"

FD_ROOT is "/tmp/eigs_fd_probe"
FD_SUB is "/tmp/eigs_fd_probe/sub"
mkdir of FD_SUB
write_text of ["/tmp/eigs_fd_probe/b.txt", "b"]
write_text of ["/tmp/eigs_fd_probe/a.wav", "a"]
write_text of ["/tmp/eigs_fd_probe/sub/inner.txt", "i"]

froot is panel of ["froot", 0, 0, 800, 600]
_layout of [froot, 0, 0]
fchosen is []
define fd_ok(d, p) as:
    append of [fchosen, p]

fd is file_dialog of ["fd", 460, 340, "Open", FD_ROOT, fd_ok]

# ".." first, then directories (trailing /), then files — each sorted
assert_eq of [len of fd.listing.items, 4, "listing: .. + 1 dir + 2 files"]
assert_eq of [fd.listing.items[0], "..", "listing[0] is .."]
assert_eq of [fd.listing.items[1], "sub/", "directories come first, marked with /"]
assert_eq of [fd.listing.items[2], "a.wav", "files after dirs, sorted"]
assert_eq of [fd.listing.items[3], "b.txt", "files sorted lexicographically"]

push_modal of [fd, 800, 600]

define fd_click(idx) as:
    _ui.last_click_id is ""
    dispatch of [froot, {"type": "mousedown", "x": fd.listing._ax + 5, "y": fd.listing._ay + idx * fd.listing.item_h + 2, "button": 1}]

# clicking a directory navigates into it
fd_click of 1
assert_eq of [fd.dir, FD_SUB, "clicking a directory navigates into it"]
assert_eq of [len of fd.listing.items, 2, "sub/ lists .. + inner.txt"]
assert_eq of [fd.listing.items[1], "inner.txt", "sub/'s file"]

# .. walks back up
fd_click of 0
assert_eq of [fd.dir, FD_ROOT, ".. walks back up"]
assert_eq of [len of fd.listing.items, 4, "back to the parent listing"]

# clicking a file puts it in the path box and does NOT navigate
fd_click of 2
assert_eq of [fd.path_input.text, "/tmp/eigs_fd_probe/a.wav", "clicking a file selects its path"]
assert_eq of [fd.dir, FD_ROOT, "clicking a file does not navigate"]

# Open fires on_ok with the path; Cancel does not
fr0 is _dialog_btn_rect of [fd, 0, fd._ax, fd._ay]
_ui.last_click_id is ""
dispatch of [froot, {"type": "mousedown", "x": fr0[0] + 2, "y": fr0[1] + 2, "button": 1}]
assert_eq of [len of fchosen, 1, "Open fired on_ok"]
assert_eq of [fchosen[0], "/tmp/eigs_fd_probe/a.wav", "on_ok got the chosen path"]
assert_eq of [fd.visible, 0, "Open closed the dialog"]

fd2 is file_dialog of ["fd2", 460, 340, "Open", FD_ROOT, fd_ok]
push_modal of [fd2, 800, 600]
fr1 is _dialog_btn_rect of [fd2, 1, fd2._ax, fd2._ay]
_ui.last_click_id is ""
dispatch of [froot, {"type": "mousedown", "x": fr1[0] + 2, "y": fr1[1] + 2, "button": 1}]
assert_eq of [len of fchosen, 1, "Cancel does not call on_ok"]
assert_eq of [fd2.visible, 0, "Cancel closed the dialog"]

# path joining does not double the separator, and root is handled
assert_eq of [_fd_join of ["/tmp", "x"], "/tmp/x", "join: plain"]
assert_eq of [_fd_join of ["/tmp/", "x"], "/tmp/x", "join: trailing slash not doubled"]
assert_eq of [_fd_parent of "/tmp/a/b", "/tmp/a", "parent: strips the last component"]
assert_eq of [_fd_parent of "/tmp", "/", "parent of a top-level dir is /"]
assert_eq of [_fd_parent of "/", "/", "parent of / stays /"]
assert_eq of [_fd_parent of "rel", ".", "parent of a bare relative name is ."]

# an unreadable/missing directory lists empty rather than throwing
fd3 is file_dialog of ["fd3", 460, 340, "Open", "/tmp/eigs_fd_no_such_dir_zzz", null]
assert_eq of [len of fd3.listing.items, 1, "a missing directory lists just .."]

remove_file of "/tmp/eigs_fd_probe/b.txt"
remove_file of "/tmp/eigs_fd_probe/a.wav"
remove_file of "/tmp/eigs_fd_probe/sub/inner.txt"
_ui.modal_stack is []

# ============================================================
# #631: a modal owns the keyboard, not just the pointer
# ============================================================
# Before the fix, dispatch returned keys with the real root above the modal
# rebind, so Tab escaped to a background widget and Enter activated it — an
# "Are you sure? [Cancel]" dialog could fire the destructive action behind it.
_ui.modal_stack is []
_ui.focus_list is []
_ui.focused_widget is null
_ui.focused_input is null
_ui.focus_index is 0 - 1

m631_root is panel of ["m631_root", 0, 0, 800, 600]
m631_fired is [0]
define m631_boom(b) as:
    m631_fired[0] is m631_fired[0] + 1
m631_bg is button of ["M631_BEHIND", 0, 0, 100, 30, "danger", m631_boom]
add_child of [m631_root, m631_bg]
_layout of [m631_root, 0, 0]
_ui.edit_root is m631_root
_build_focus_list of m631_root

# A dialog hosting two focusable children of its own (#575).
m631_dlg is dialog of ["m631_dlg", 400, 300, "Modal", "", ["OK"], null]
m631_hit is [0]
define m631_ok(b) as:
    m631_hit[0] is m631_hit[0] + 1
m631_c1 is button of ["M631_C1", 0, 0, 60, 24, "One", m631_ok]
m631_c2 is button of ["M631_C2", 0, 0, 60, 24, "Two", m631_ok]
add_child of [m631_dlg, m631_c1]
add_child of [m631_dlg, m631_c2]
push_modal of [m631_dlg, 800, 600]

# Tab scopes to the dialog, never the background.
dispatch of [m631_root, {"type": "keydown", "key": "tab", "shift": 0, "ctrl": 0, "alt": 0}]
assert_true of [_ui.focused_widget != null, "#631 Tab under a modal focuses a dialog child, not nothing"]
assert_eq of [_ui.focused_widget.id, "M631_C1", "#631 Tab lands on the dialog's first child"]

# Enter fires the DIALOG child, never the button behind the modal.
dispatch of [m631_root, {"type": "keydown", "key": "return", "shift": 0, "ctrl": 0, "alt": 0}]
assert_eq of [m631_fired[0], 0, "#631 Enter does not fire the button behind the modal"]
assert_eq of [m631_hit[0], 1, "#631 Enter fires the focused dialog child"]

# Tab again cycles within the dialog (C1 -> C2), still not the background.
dispatch of [m631_root, {"type": "keydown", "key": "tab", "shift": 0, "ctrl": 0, "alt": 0}]
assert_eq of [_ui.focused_widget.id, "M631_C2", "#631 Tab cycles between the dialog's own children"]

# After pop, focus returns to the background list.
pop_modal of null
dispatch of [m631_root, {"type": "keydown", "key": "tab", "shift": 0, "ctrl": 0, "alt": 0}]
assert_eq of [_ui.focused_widget.id, "M631_BEHIND", "#631 after pop_modal, Tab returns to the background widget"]
assert_eq of [m631_fired[0], 0, "#631 the background button never fired via keyboard"]

_ui.modal_stack is []
_ui.edit_root is null

# ============================================================
# #819: chart is an x-y plot — series, scales, clipping, pan/zoom
# ============================================================

print of "--- Chart x-y Plot Tests (#819) ---"

# ---- Primitive extents, for the containment proof ----
# Bounding box [x0, y0, x1, y1) of a recorded call, in the same pixel
# convention _point_in_rect uses (x1/y1 exclusive).

define _prim_extent(rec) as:
    local k is rec[0]
    local a is rec[1]
    if k == "clip":
        return null
    if a == null:
        return null
    if k == "rect":
        return [a[0], a[1], a[0] + a[2], a[1] + a[3]]
    if k == "rrect":
        return [a[0], a[1], a[0] + a[2], a[1] + a[3]]
    if k == "line":
        return [(min of [a[0], a[2]]), (min of [a[1], a[3]]), (max of [a[0], a[2]]) + 1, (max of [a[1], a[3]]) + 1]
    if k == "point":
        return [a[0], a[1], a[0] + 1, a[1] + 1]
    if k == "circle":
        return [a[0] - a[2], a[1] - a[2], a[0] + a[2] + 1, a[1] + a[2] + 1]
    if k == "text":
        local sc is a[6]
        if sc == null:
            sc is 1
        return [a[0], a[1], a[0] + (text_width of [a[2], sc]), a[1] + (text_height of sc)]
    return null

# How many recorded primitives poke outside [rx, ry, rw, rh]?
define _outside(rx, ry, rw, rh) as:
    local bad is 0
    for i in range of (len of _gfx_log):
        local e is _prim_extent of (_gfx_log[i])
        if e != null:
            if e[0] < rx:
                bad is bad + 1
            elif e[1] < ry:
                bad is bad + 1
            elif e[2] > rx + rw:
                bad is bad + 1
            elif e[3] > ry + rh:
                bad is bad + 1
    return bad

define _record_render(w, ax, ay) as:
    _gfx_log is []
    _gfx_rec is 1
    _render_chart of [w, ax, ay]
    _gfx_rec is 0
    return len of _gfx_log

define _count_kind(k) as:
    local n is 0
    for i in range of (len of _gfx_log):
        if _gfx_log[i][0] == k:
            n is n + 1
    return n

# ---- Constructor ----
pl is chart of ["pl", 0, 0, 300, 200]
assert_eq of [pl.type, "chart", "chart type"]
assert_eq of [len of pl.series, 0, "chart starts with no series"]
assert_eq of [len of pl.markers, 0, "chart starts with no markers"]
assert_eq of [pl.zoom, 1.0, "chart zoom default 1"]
assert_eq of [pl.pan_x, 0.0, "chart pan_x default 0"]
assert_eq of [pl.fixed_aspect, 0, "chart fixed_aspect off by default"]
assert_eq of [pl.x_min, null, "chart x_min null means auto"]
assert_true of [pl.on_wheel != null, "chart owns wheel input for cursor-anchored zoom"]

# ---- Series and markers are plain builders ----
s0 is chart_series of ["alpha", null, [0, 1, 2, 3], null]
assert_eq of [s0.label, "alpha", "chart_series label"]
assert_eq of [s0.x, null, "chart_series null x keeps index-x"]
assert_eq of [s0.style, "line", "chart_series default style"]
i0 is chart_add_series of [pl, s0]
assert_eq of [i0, 0, "chart_add_series returns the index"]
mk is chart_marker of ["vline", 2, 0, "restart", [255, 0, 0]]
assert_eq of [mk.kind, "vline", "chart_marker kind"]
assert_eq of [chart_add_marker of [pl, mk], 0, "chart_add_marker returns the index"]

# ---- Scale math: index-x, y padded by pad_frac ----
b0 is chart_bounds of pl
assert_eq of [b0.x0, 0, "index-x lower bound is 0"]
assert_eq of [b0.x1, 3, "index-x upper bound is n-1"]
assert_near of [b0.y0, 0 - 0.3, 0.000001, "y auto lower bound is min - 10%"]
assert_near of [b0.y1, 3.3, 0.000001, "y auto upper bound is max + 10%"]

# Explicit bounds win over auto-scale, per axis.
pl.y_min is 0
pl.y_max is 10
b1 is chart_bounds of pl
assert_eq of [b1.y0, 0, "explicit y_min overrides auto-scale"]
assert_eq of [b1.y1, 10, "explicit y_max overrides auto-scale"]
assert_eq of [b1.x0, 0, "an explicit y bound leaves x on auto"]
pl.y_min is null
pl.y_max is null

# ---- Data-coordinate x ----
xy is chart of ["xy", 0, 0, 300, 200]
xy.pad_frac is 0
si is chart_add_series of [xy, chart_series of ["p", [10, 20, 40], [1, 2, 3], null]]
bx is chart_bounds of xy
assert_eq of [bx.x0, 10, "data-coord x lower bound comes from the x list"]
assert_eq of [bx.x1, 40, "data-coord x upper bound comes from the x list"]
assert_eq of [bx.y0, 1, "y bounds unpadded when pad_frac is 0"]
assert_eq of [bx.y1, 3, "y upper bound"]

# ---- data -> pixel mapping at known coordinates ----
# 300x200 at (0,0): plot rect is [44, 8, 248, 174] from the default pads.
v is chart_view of xy
assert_eq of [v.px, 44, "plot rect x = pad_left"]
assert_eq of [v.py, 8, "plot rect y = pad_top"]
assert_eq of [v.pw, 248, "plot rect w = w - pad_left - pad_right"]
assert_eq of [v.ph, 166, "plot rect h = h - pad_top - pad_bottom"]
tl is chart_to_pixel of [xy, 10, 3]
assert_near of [tl[0], 44, 0.000001, "x0 maps to the left edge of the plot"]
assert_near of [tl[1], 8, 0.000001, "y1 maps to the top edge of the plot"]
br is chart_to_pixel of [xy, 40, 1]
assert_near of [br[0], 292, 0.000001, "x1 maps to the right edge of the plot"]
assert_near of [br[1], 174, 0.000001, "y0 maps to the bottom edge of the plot"]
mid is chart_to_pixel of [xy, 25, 2]
assert_near of [mid[0], 168, 0.000001, "x midpoint maps to the plot centre"]
assert_near of [mid[1], 91, 0.000001, "y midpoint maps to the plot centre"]
# Round trip.
rt is chart_from_pixel of [xy, 168, 91]
assert_near of [rt[0], 25, 0.000001, "pixel -> data round trips x"]
assert_near of [rt[1], 2, 0.000001, "pixel -> data round trips y"]

# ---- Fixed aspect: one data unit is the same number of pixels on both axes ----
fa is chart of ["fa", 0, 0, 300, 200]
fa.pad_frac is 0
chart_add_series of [fa, chart_series of ["circle", [0 - 1, 1, 0, 0], [0, 0, 0 - 1, 1], null]]
fa.fixed_aspect is 0
o1 is chart_to_pixel of [fa, 0, 0]
ox1 is chart_to_pixel of [fa, 1, 0]
oy1 is chart_to_pixel of [fa, 0, 1]
assert_true of [(abs of (ox1[0] - o1[0])) != (abs of (oy1[1] - o1[1])), "without fixed_aspect the axes scale independently"]
fa.fixed_aspect is 1
f1 is chart_to_pixel of [fa, 0, 0]
fx1 is chart_to_pixel of [fa, 1, 0]
fy1 is chart_to_pixel of [fa, 0, 1]
assert_near of [(abs of (fx1[0] - f1[0])), (abs of (fy1[1] - f1[1])), 0.000001, "fixed_aspect makes one unit the same pixel span on x and y"]
# The correction only ever GROWS an axis, so no data is pushed out of view.
fav is chart_view of fa
assert_true of [fav.x0 <= 0 - 1, "fixed_aspect keeps the x data range covered"]
assert_true of [fav.y1 >= 1, "fixed_aspect keeps the y data range covered"]

# ---- Incremental append ----
# add_point / add_xy widen the cached bounds in place; the render-time
# scan then has nothing left to do for the points already accounted for.
inc is chart of ["inc", 0, 0, 300, 200]
inc.pad_frac is 0
chart_add_series of [inc, chart_series of ["live", null, [], null]]
add_point of [inc, 0, 5]
bi is chart_bounds of inc
assert_eq of [bi.y0, 4, "a lone sample gets a degenerate range widened by one"]
assert_eq of [bi.y1, 6, "a lone sample's upper bound"]
add_point of [inc, 0, 9]
assert_eq of [inc.series[0]._scanned, 2, "add_point accounts for its own sample — no rescan pending"]
assert_eq of [(chart_bounds of inc).y1, 9, "an appended maximum widens the bound in O(1)"]
add_point of [inc, 0, 20]
assert_eq of [inc.series[0]._scanned, 3, "a further append stays accounted for"]
assert_eq of [(chart_bounds of inc).y1, 20, "and again, without a rescan"]
# The incrementality is load-bearing, so prove it directly: edit an
# ALREADY-SCANNED sample in place to a value that would move the bound,
# then append. The bound does not move — the history was not re-walked.
# (The tail sample is left alone; changing THAT is what the staleness
# check watches for.)
inc.series[0].data[0] is 0 - 999
add_point of [inc, 0, 21]
assert_eq of [(chart_bounds of inc).y0, 5, "an appended point does not re-walk the scanned history"]
chart_invalidate of inc
assert_eq of [(chart_bounds of inc).y0, 0 - 999, "chart_invalidate re-walks and picks the in-place edit up"]
inc.series[0].data[0] is 5
chart_invalidate of inc
chart_bounds of inc
add_xy of [inc, 0, 100, 1]
assert_eq of [(chart_bounds of inc).x1, 100, "add_xy promotes the series to data-coord x"]
assert_eq of [(chart_bounds of inc).y0, 1, "add_xy widens the lower y bound"]
assert_eq of [len of inc.series[0].x, 5, "promoting to data-coord x backfills the index positions"]
assert_eq of [inc.series[0].x[0], 0, "backfilled x starts at 0"]
# Replacing the data wholesale is detected and forces one full rescan, so
# a bound can shrink again.
inc.series[0].data is [1, 2]
inc.series[0].x is null
bnew is chart_bounds of inc
assert_eq of [bnew.y1, 2, "a replaced series forces a rescan and the bound shrinks"]
assert_eq of [bnew.x1, 1, "a replaced series rescans x too"]
# Assigning a whole new series list is detected the same way.
inc.series is [{"label": "raw", "data": [7, 8], "color": [1, 2, 3]}]
assert_eq of [(chart_bounds of inc).y0, 7, "a wholesale series assignment is rescanned"]
# A same-length in-place data rewrite is caught by the end-of-data mark...
inc.series is [{"label": "raw", "data": [7, 8], "color": [1, 2, 3]}]
chart_bounds of inc
inc.series[0].data is [30, 40]
assert_eq of [(chart_bounds of inc).y1, 40, "a same-length in-place data rewrite is detected by the tail mark"]
# ...and chart_invalidate is the explicit escape hatch when it is not
# (a rewrite that happens to keep the same final sample).
inc.series[0].data is [0 - 5, 40]
chart_invalidate of inc
assert_eq of [(chart_bounds of inc).y0, 0 - 5, "chart_invalidate forces a rescan"]

# ---- Rolling window ----
tr is chart of ["tr", 0, 0, 300, 200]
tr.pad_frac is 0
chart_add_series of [tr, chart_series of ["w", null, [], null]]
for i in range of 10:
    add_point of [tr, 0, i]
chart_trim of [tr, 0, 4]
assert_eq of [len of tr.series[0].data, 4, "chart_trim keeps the newest max_n samples"]
assert_eq of [tr.series[0].data[0], 6, "chart_trim drops the oldest"]
assert_eq of [(chart_bounds of tr).y0, 6, "chart_trim rescans so the bound shrinks with the window"]

# ---- Ticks ----
tk is chart_ticks of [0, 10, 5]
assert_eq of [len of tk, 6, "chart_ticks covers [0,10] at step 2"]
assert_eq of [tk[0], 0, "first tick"]
assert_eq of [tk[1], 2, "ticks land on a 1/2/5 x power-of-ten step"]
assert_eq of [tk[5], 10, "last tick"]
tk2 is chart_ticks of [0.13, 0.42, 4]
assert_true of [len of tk2 > 0, "chart_ticks handles a sub-unit range"]
assert_near of [tk2[0], 0.2, 0.000001, "sub-unit ticks land on a round 1/2/5 step, not on the range edge"]
assert_true of [tk2[0] >= 0.13, "no tick below the range"]
assert_true of [tk2[(len of tk2) - 1] <= 0.42, "no tick above the range"]
tk3 is chart_ticks of [5, 5, 4]
assert_true of [len of tk3 <= 1, "a zero-width range does not spin"]

# ---- Pan: the data under the cursor follows the drag ----
pz is chart of ["pz", 0, 0, 300, 200]
pz.pad_frac is 0
chart_add_series of [pz, chart_series of ["d", [0, 100], [0, 100], null]]
d_before is chart_from_pixel of [pz, 100, 100]
chart_pan_by of [pz, 30, 0 - 20]
d_after is chart_from_pixel of [pz, 130, 80]
assert_near of [d_after[0], d_before[0], 0.000001, "drag-pan carries the data point with the cursor in x"]
assert_near of [d_after[1], d_before[1], 0.000001, "drag-pan carries the data point with the cursor in y"]
chart_reset_view of pz
assert_eq of [pz.pan_x, 0.0, "chart_reset_view clears pan"]
assert_eq of [pz.zoom, 1.0, "chart_reset_view restores zoom"]

# ---- Zoom is anchored on the cursor ----
anchor_before is chart_from_pixel of [pz, 120, 60]
chart_zoom_at of [pz, 2.0, 120, 60]
anchor_after is chart_from_pixel of [pz, 120, 60]
assert_eq of [pz.zoom, 2.0, "chart_zoom_at scales the zoom"]
assert_near of [anchor_after[0], anchor_before[0], 0.000001, "the data under the anchor pixel does not move in x"]
assert_near of [anchor_after[1], anchor_before[1], 0.000001, "the data under the anchor pixel does not move in y"]
# A point away from the anchor DOES move — otherwise nothing zoomed.
away_after is chart_from_pixel of [pz, 250, 150]
assert_true of [(abs of (away_after[0] - anchor_before[0])) > 0, "zoom actually changed the view away from the anchor"]
# Zooming in halves the visible span.
zv is chart_view of pz
assert_near of [zv.x1 - zv.x0, 50, 0.000001, "zoom 2 halves the visible x span"]
chart_reset_view of pz

# ---- The wheel path reads the pointer out of _ui, so no consumer shadows it (#822) ----
wroot is panel of ["wroot", 0, 0, 400, 300]
wpl is chart of ["wpl", 0, 0, 300, 200]
wpl.pad_frac is 0
chart_add_series of [wpl, chart_series of ["d", [0, 100], [0, 100], null]]
add_child of [wroot, wpl]
_layout of [wroot, 0, 0]
dispatch of [wroot, {"type": "mousemove", "x": 120, "y": 60}]
assert_eq of [_ui.last_mouse_x, 120, "dispatch caches the pointer for the wheel path"]
w_before is chart_from_pixel of [wpl, 120, 60]
dispatch of [wroot, {"type": "wheel", "x": 0, "y": 1}]
assert_true of [wpl.zoom > 1.0, "a wheel over the chart zooms in"]
w_after is chart_from_pixel of [wpl, 120, 60]
assert_near of [w_after[0], w_before[0], 0.000001, "wheel zoom is anchored on the cached cursor position, not the widget centre"]
assert_near of [w_after[1], w_before[1], 0.000001, "wheel zoom anchor holds in y"]
dispatch of [wroot, {"type": "wheel", "x": 0, "y": 0 - 1}]
assert_near of [wpl.zoom, 1.0, 0.000001, "an opposite wheel step returns to the original zoom"]
chart_reset_view of wpl

# ---- Drag to pan, through the real dispatch path ----
dispatch of [wroot, {"type": "mousedown", "x": 120, "y": 60, "button": 1}]
assert_true of [_ui.drag_widget != null, "mousedown on a chart claims the pointer"]
assert_eq of [_ui.drag_widget.id, "wpl", "the chart itself is the claimant"]
p_before is chart_from_pixel of [wpl, 120, 60]
dispatch of [wroot, {"type": "mousemove", "x": 150, "y": 60}]
p_after is chart_from_pixel of [wpl, 150, 60]
assert_near of [p_after[0], p_before[0], 0.000001, "a drag through dispatch pans the chart with the cursor"]
dispatch of [wroot, {"type": "mouseup", "x": 150, "y": 60, "button": 1}]
assert_eq of [_ui.drag_widget, null, "mouseup releases the chart's pointer capture"]
chart_reset_view of wpl
# interactive 0 opts out of both.
wpl.interactive is 0
dispatch of [wroot, {"type": "mousemove", "x": 120, "y": 60}]
dispatch of [wroot, {"type": "wheel", "x": 0, "y": 1}]
assert_eq of [wpl.zoom, 1.0, "interactive 0 disables wheel zoom"]
dispatch of [wroot, {"type": "mousedown", "x": 120, "y": 60, "button": 1}]
assert_eq of [_ui.drag_widget, null, "interactive 0 disables drag-pan"]
wpl.interactive is 1

# ---- Hover picks the nearest sample in PIXEL space ----
hv is chart of ["hv", 0, 0, 300, 200]
hv.pad_frac is 0
hv._ax is 0
hv._ay is 0
chart_add_series of [hv, chart_series of ["h", [0, 10, 100], [0, 0, 0], null]]
hv.y_min is 0 - 1
hv.y_max is 1
# x=10 sits at 44 + 10/100*248 = 68.8 px; x=0 sits at 44.
_mousemove_chart of [hv, null, 69, 91]
assert_eq of [hv.hover_series, 0, "hover reports the series"]
assert_eq of [hv.hover_index, 1, "hover picks the nearest sample by pixel distance, not by index-from-x"]
_mousemove_chart of [hv, null, 45, 91]
assert_eq of [hv.hover_index, 0, "hover moves to the nearer sample"]
_mousemove_chart of [hv, null, 170, 91]
assert_eq of [hv.hover_index, -1, "no sample within the snap radius clears hover"]
_clear_hover_chart of hv
assert_eq of [hv.hover_series, -1, "clear_hover clears the series too"]
hv.hover_enabled is 0
_mousemove_chart of [hv, null, 69, 91]
assert_eq of [hv.hover_index, -1, "hover_enabled 0 skips the nearest-sample scan"]

# ============================================================
# #819/#823: the plot is CLIPPED — data leaving the view never
# paints over the surrounding chrome
# ============================================================

clip_ch is chart of ["clip_ch", 10, 20, 300, 200]
clip_ch.pad_frac is 0
clip_ch.x_min is 0
clip_ch.x_max is 10
clip_ch.y_min is 0
clip_ch.y_max is 10
# One sample inside the window, the rest far outside it in every
# direction — including a segment that crosses the whole plot area.
chart_add_series of [clip_ch, chart_series of ["wild", [0 - 500, 5, 900, 5, 5], [5, 5, 5, 0 - 800, 700], null]]
clip_ch.series[0].style is "both"
chart_add_marker of [clip_ch, chart_marker of ["vline", 0 - 40, 0, "way left", null]]
chart_add_marker of [clip_ch, chart_marker of ["point", 400, 400, "way out", null]]
chart_add_marker of [clip_ch, chart_marker of ["hline", 0 - 90, 0, "way below", null]]
clip_ch.x_label is "an x caption long enough to overflow this widget several times over"
clip_ch.y_label is "and a y caption that is also far too long for the gutter it sits in"
n_prims is _record_render of [clip_ch, 10, 20]
assert_true of [n_prims > 10, "the clipping probe actually rendered something"]
assert_eq of [_outside of [10, 20, 300, 200], 0, "#819 no primitive is drawn outside the chart rect"]

# The same, panned so far that every sample is off-screen.
clip_ch.pan_x is 100000
clip_ch.pan_y is 0 - 100000
_record_render of [clip_ch, 10, 20]
assert_eq of [_outside of [10, 20, 300, 200], 0, "#819 an extreme pan draws nothing outside the chart rect"]
# ...and zoomed so far in that the visible window is a sliver.
clip_ch.pan_x is 0
clip_ch.pan_y is 0
clip_ch.zoom is 5000
_record_render of [clip_ch, 10, 20]
assert_eq of [_outside of [10, 20, 300, 200], 0, "#819 an extreme zoom draws nothing outside the chart rect"]
clip_ch.zoom is 0.0001
_record_render of [clip_ch, 10, 20]
assert_eq of [_outside of [10, 20, 300, 200], 0, "#819 an extreme zoom-out draws nothing outside the chart rect"]
chart_reset_view of clip_ch

# The gate is real: the same probe on an UNCLIPPED draw of the same data
# is red. This is the planted fault — if _outside could not see an
# escaping primitive, every assertion above would be vacuous.
_gfx_log is []
_gfx_rec is 1
esc is chart_to_pixel of [clip_ch, 900, 700]
gfx_line of [44, 28, floor of esc[0], floor of esc[1], 1, 2, 3]
_gfx_rec is 0
assert_true of [_outside of [10, 20, 300, 200] > 0, "#819 the containment probe DOES flag an unclipped primitive (planted fault)"]

# gfx_clip is set for the real renderer as well, and cleared afterwards.
_record_render of [clip_ch, 10, 20]
assert_true of [(_count_kind of "clip") >= 2, "#819 the render sets and clears a renderer clip rect"]
clip_last is null
for ci in range of (len of _gfx_log):
    if _gfx_log[ci][0] == "clip":
        clip_last is _gfx_log[ci][1]
assert_eq of [clip_last, null, "#819 the renderer clip rect is cleared before the render returns"]

# Series geometry is confined to the PLOT rect, tighter than the widget.
_record_render of [clip_ch, 10, 20]
cv is chart_view of clip_ch
line_out is 0
for li in range of (len of _gfx_log):
    if _gfx_log[li][0] == "line":
        le is _prim_extent of (_gfx_log[li])
        if le[0] < cv.px:
            line_out is line_out + 1
        elif le[1] < cv.py:
            line_out is line_out + 1
        elif le[2] > cv.px + cv.pw:
            line_out is line_out + 1
        elif le[3] > cv.py + cv.ph:
            line_out is line_out + 1
assert_eq of [line_out, 0, "#819 every drawn segment stays inside the plot rect"]

# ---- Marker placement lands on the data coordinate ----
mk_ch is chart of ["mk_ch", 0, 0, 300, 200]
mk_ch.pad_frac is 0
mk_ch.grid is 0
mk_ch.axes is 0
mk_ch.legend is 0
chart_add_series of [mk_ch, chart_series of ["m", [0, 100], [0, 100], null]]
mk_ch.series[0].style is "points"
chart_add_marker of [mk_ch, chart_marker of ["vline", 25, 0, "", [9, 9, 9]]]
_record_render of [mk_ch, 0, 0]
mk_px is chart_to_pixel of [mk_ch, 25, 0]
assert_near of [mk_px[0], 106, 0.000001, "the marker's data x maps to the expected column"]
found_marker is 0
for mi in range of (len of _gfx_log):
    if _gfx_log[mi][0] == "line":
        ma is _gfx_log[mi][1]
        if ma[4] == 9 and ma[0] == (floor of mk_px[0]) and ma[2] == (floor of mk_px[0]):
            found_marker is 1
assert_eq of [found_marker, 1, "#819 a vline marker is drawn as a full-height rule at its data x"]

# ---- Theme keying: the data surface restyles with the chrome (#820) ----
saved_theme is theme of null
set_theme of (theme_light of null)
_record_render of [mk_ch, 0, 0]
lt is theme of null
bg_ok is 0
for bi in range of (len of _gfx_log):
    if _gfx_log[bi][0] == "rect":
        ba is _gfx_log[bi][1]
        if ba[0] == 0 and ba[1] == 0 and ba[2] == 300 and ba[3] == 200:
            if ba[4] == lt.plot_bg[0] and ba[5] == lt.plot_bg[1] and ba[6] == lt.plot_bg[2]:
                bg_ok is 1
assert_eq of [bg_ok, 1, "#820 the plot background comes from the theme, not a literal"]
set_theme of saved_theme
_record_render of [mk_ch, 0, 0]
dt is theme of null
bg_dark is 0
for bi in range of (len of _gfx_log):
    if _gfx_log[bi][0] == "rect":
        ba is _gfx_log[bi][1]
        if ba[0] == 0 and ba[1] == 0 and ba[2] == 300 and ba[3] == 200:
            if ba[4] == dt.plot_bg[0]:
                bg_dark is 1
assert_eq of [bg_dark, 1, "#820 switching the theme back switches the plot surface back"]
# Series colors default off the theme palette, and an explicit color wins.
assert_eq of [(_chart_series_color of [mk_ch, 0])[0], dt.plot_series[0][0], "series color defaults to the theme palette by position"]
mk_ch.series[0].color is [7, 7, 7]
assert_eq of [(_chart_series_color of [mk_ch, 0])[0], 7, "an explicit series color overrides the palette"]
# A theme dict predating these keys still renders (fallback defaults).
old_theme is {}
for k in ["bg", "text_color", "text_dim", "accent", "font_scale", "char_h", "char_w", "focus_ring", "radius_sm", "disabled_overlay"]:
    old_theme[k] is dt[k]
set_theme of old_theme
assert_eq of [_record_render of [mk_ch, 0, 0] > 0, 1, "#820 a theme dict without the plot keys falls back instead of crashing"]
set_theme of saved_theme

# ---- The two in-repo consumers of the old y-vs-index chart still work ----
legacy is chart of ["legacy", 0, 0, 200, 100]
legacy.series is [{"label": "Avg H", "data": [], "color": [80, 180, 220]}]
for i in range of 5:
    append of [legacy.series[0].data, i * 0.5]
lb is chart_bounds of legacy
assert_eq of [lb.x0, 0, "a bare y-list series still spans index 0..n-1"]
assert_eq of [lb.x1, 4, "a bare y-list series upper index bound"]
assert_eq of [_record_render of [legacy, 0, 0] > 0, 1, "a bare y-list series still renders"]
assert_eq of [_outside of [0, 0, 200, 100], 0, "a bare y-list series stays inside its rect too"]

_gfx_log is []

# ============================================================
# 26. code_view styled spans (#838)
# ============================================================

print of "--- code_view Styled Span Tests (#838) ---"

# Stub metrics: 6 px/char at scale 1, so columns land at 6*col.
cvs is code_view of ["cvs", 0, 0, 300, 100, "abc\ndef"]
cvs.line_numbers is 0
assert_eq of [len of cvs.spans, 0, "code_view starts with no spans"]

# No spans: rendering records no span rects beyond the background/border
_gfx_rec is 1
_gfx_log is []
_render_code_view of [cvs, 0, 0]
_gfx_rec is 0
base_rects is 0
for i in range of (len of _gfx_log):
    if _gfx_log[i][0] == "rect":
        base_rects is base_rects + 1

# Span over "de" (offsets 4..6 — line 2 starts at offset 4): bg rect at
# the line-2 text origin, 2 chars wide; fg redraw of exactly "de".
cvs.spans is [{"start": 4, "end": 6, "bg": [11, 22, 33], "fg": [44, 55, 66]}]
_gfx_rec is 1
_gfx_log is []
_render_code_view of [cvs, 0, 0]
_gfx_rec is 0
span_rect is null
span_text is null
for i in range of (len of _gfx_log):
    e is _gfx_log[i]
    if e[0] == "rect":
        if (e[1])[4] == 11 and (e[1])[5] == 22 and (e[1])[6] == 33:
            span_rect is e[1]
    if e[0] == "text":
        if (e[1])[2] == "de":
            span_text is e[1]
assert_true of [span_rect != null, "span bg rect recorded in the span color"]
assert_eq of [span_rect[0], 4, "span bg starts at the text origin (col 0, gutter off)"]
assert_eq of [span_rect[2], 12, "span bg is 2 chars wide (6 px/char stub)"]
assert_true of [span_text != null, "span fg redraw covers exactly the span text"]
assert_eq of [span_text[0], 4, "span fg redraw at the span x"]

# Cross-line span clips to each line: "bc" on line 1, "d" on line 2
cvs.spans is [{"start": 1, "end": 5, "bg": [11, 22, 33], "fg": null}]
_gfx_rec is 1
_gfx_log is []
_render_code_view of [cvs, 0, 0]
_gfx_rec is 0
srects is []
for i in range of (len of _gfx_log):
    e is _gfx_log[i]
    if e[0] == "rect":
        if (e[1])[4] == 11:
            append of [srects, e[1]]
assert_eq of [len of srects, 2, "cross-line span paints one rect per touched line"]
r0 is srects[0]
assert_eq of [r0[0], 10, "line-1 segment starts at col 1"]
assert_eq of [r0[2], 12, "line-1 segment covers 'bc'"]
r1 is srects[1]
assert_eq of [r1[0], 4, "line-2 segment starts at col 0"]
assert_eq of [r1[2], 6, "line-2 segment covers 'd'"]
_gfx_log is []

# ============================================================
# Summary
# ============================================================

test_summary of null
