# Observer interaction tests — the observer model under stress.
# Tests that predicates, entropy tracking, and thresholds interact
# correctly with loops, functions, and the unobserved block.

# === PREDICATE CONSISTENCY ===
# A converged value should NOT also be diverging/improving.

# Drive a value to convergence
x is 100
loop while not converged:
    x is x * 0.1

# Check mutual exclusion of predicates
assert of [converged == 1, "OI1 converged after descent"]
assert of [diverging == 0, "OI2 converged implies not diverging"]
assert of [improving == 0, "OI3 converged implies not improving (dH~0)"]

# === OBSERVER STATE THROUGH FUNCTION CALLS ===

# When a function is called, does it update the caller's __observer__?
define compute(val) as:
    result is val * 2
    return result

y is 10
y is compute of y
# After the call, __observer__ should reflect the return value
rep is report of y
assert of [type of rep == "str", "OI4 report after function call is string"]

# === UNOBSERVED BLOCK SEMANTICS ===

# Inside unobserved, assignments skip update_observer
a is 50
obs_before is observe of a

unobserved:
    a is a + 1
    a is a + 1
    a is a + 1

# After unobserved, the observer state should be stale (from before)
assert of [a == 53, "OI5 unobserved block still mutates value"]

# Re-observe by assigning
a is a
obs_after is observe of a
assert of [type of obs_after == "list", "OI6 observe returns list after re-assignment"]

# === OBSERVER TRACKING ACROSS LOOP ===

# Verify that repeated halving drives entropy toward convergence.
# Use a counter to track iterations and check the value afterward.
z is 1000
for iter in range of 20:
    z is z * 0.5
assert of [z < 1, "OI7 repeated halving decreases value"]

# Check that observer tracked the changes
rep is report of z
assert of [type of rep == "str", "OI8 report returns a classification string"]

# === THRESHOLD SENSITIVITY ===

# Verify thresholds can be read and written
saved is get_observer_thresholds of null
assert of [len of saved == 3, "OI9 get_observer_thresholds returns 3 values"]
assert of [saved[0] > 0, "OI10a dh_zero is positive"]
assert of [saved[0] < saved[1], "OI10b dh_zero < dh_small"]

# Set and verify
set_observer_thresholds of [0.005, 0.05, 0.5]
updated is get_observer_thresholds of null
assert of [updated[0] == 0.005, "OI10c threshold set correctly"]

# Restore
set_observer_thresholds of [saved[0], saved[1], saved[2]]
restored is get_observer_thresholds of null
assert of [restored[0] == saved[0], "OI10d thresholds restored"]

# === INTERROGATIVES CHECK VALUES ===

test_val is [1, 2, 3, 4, 5]
assert of [(what is test_val) == 5, "OI11 what-is gives list length"]

test_str is "hello"
assert of [(what is test_str) == 5, "OI12 what-is gives string length"]

test_num is 42
assert of [(what is test_num) == 42, "OI13 what-is gives numeric value"]

assert of [(when is test_val) > 0, "OI14 when-is gives observation age > 0"]

# === OBSERVER ALIAS VS FREED VALUE (UAF regression) ===
# g_last_observer is a borrowed alias. Rebinding the observed value so
# its last ref drops (`ob is null`) used to leave the alias dangling;
# the next loop-condition stall check dereferenced freed memory
# (heap-use-after-free in observer_ensure_fresh under ASan).
ob is buffer of 2
loop while ob != null:
    ob is null
assert of [ob == null, "OI15 freed observed value cleared safely"]

# Same shape through a predicate read after the free.
ob2 is buffer of 2
ob2 is null
p is converged
assert of [(p == 0) or (p == 1), "OI16 predicate after observed free"]

# === REGRESSION FOR #187 ===
# `report` switches improving/diverging at dh_small; the bare predicates
# used to switch at dh_zero, so in the gray band (dh_zero < |dH| < dh_small)
# `stable` and `improving` (or `diverging`) were both true at once, and
# `report` disagreed with `improving`/`diverging`. The fix aligns the
# direction predicates to dh_small; `oscillating` stays on dh_zero
# (it's a deadband escape, not a direction verdict).
saved2 is get_observer_thresholds of null
# Widen so any nonzero dH lands in the gray band; allow stable to fire.
# Windowed stable (#205) needs a FULL window (count==N), so drive g with a full
# monotone window of gray-band steps: stable fires, improving/diverging cannot
# (their "down"/"up" steps must clear dh_small=1e9, which nothing does here).
set_observer_thresholds of [0.0000001, 1.0e9, 0.0000001]

g is 100
g is 120
g is 140
g is 160
g is 180
g is 200
g is 220
g is 240
g is 260
g is 280
g is 300
# Evaluate all four reads against g before any intervening assignment
# repoints the last-observer alias.
preds is [improving, diverging, stable, report of g]

set_observer_thresholds of [saved2[0], saved2[1], saved2[2]]

imp_g is preds[0]
div_g is preds[1]
stb_g is preds[2]
rep_g is preds[3]

# Mutual exclusion within {stable, improving, diverging}.
assert of [not (stb_g == 1 and imp_g == 1), "OI17 stable + improving must not collide in gray band (#187)"]
assert of [not (stb_g == 1 and div_g == 1), "OI18 stable + diverging must not collide in gray band (#187)"]

# Predicates must agree with `report`.
if rep_g == "stable":
    assert of [imp_g == 0, "OI19 report=stable => improving=0 (#187)"]
    assert of [div_g == 0, "OI20 report=stable => diverging=0 (#187)"]



# === #895: OBSERVER CALL-FORMS ON A MODULE-SLOT-PROMOTED NAME ===
# A name assigned only inside an `unobserved:` block and never referenced
# outside it is promoted to a module frame slot (Part B). The observer
# call-forms that take a bare name each choose between a *_SLOT and a
# *_NAME opcode, and at module scope they used to skip slot resolution
# entirely — so they emitted the *_NAME form, whose env lookup finds
# nothing for a promoted name, and `report of m` raised "undefined
# variable" two lines above a plain read of `m` that works. The answers
# below must be the ones the same code gives when the name is NOT
# promoted: an optimization may not change an answer, and it may
# certainly not turn one into an error.

unobserved:  # lint: allow W020 -- promotion of a block-local name is the point
    m895 is 9.0
    m895 is m895 * 0.5
    rep895 is report of m895
    repv895 is report_value of m895
    traj895 is trajectory of m895
    obs895 is observe of m895
    plain895 is m895

assert of [plain895 == 4.5, "OI-895 the plain read still works"]
assert of [rep895 == "equilibrium", "OI-895 report of a promoted name resolves"]
assert of [repv895 == "equilibrium", "OI-895 report_value of a promoted name resolves"]
assert of [traj895.observed == 0, "OI-895 trajectory of a promoted name resolves"]
assert of [obs895[0] == "equilibrium", "OI-895 observe of a promoted name resolves"]

# Same block, but the name escapes it, so nothing is promoted and the
# *_NAME opcodes run. The answers must be identical.
unobserved:  # lint: allow W020 -- the control for the case above
    e895 is 9.0
    e895 is e895 * 0.5
    erep895 is report of e895
    etraj895 is trajectory of e895
escaped895 is e895
assert of [erep895 == rep895, "OI-895 promoted and env-bound report agree"]
assert of [etraj895.observed == traj895.observed,
           "OI-895 promoted and env-bound trajectory agree"]
assert of [escaped895 == 4.5, "OI-895 the control's name really did escape"]

# A predicate on a promoted name still raises the #871 message — the block
# suppresses the trajectory, and that is a different failure from the name
# being unresolvable.
caught895 is 0
try:
    unobserved:  # lint: allow W020 -- ditto
        p895 is 9.0
        p895 is p895 * 0.5
        q895 is converged of p895
catch err895:
    caught895 is 1
assert of [caught895 == 1, "OI-895 a predicate on a promoted name still raises"]

print of "observer interactions: all passed"
