# Mutable values crossing a channel or thread_join are snapshots (#1148).
load_file of "lib/test.eigs"

c is channel of 4
b is buffer of 2
buf_set of [b, 0, 1.5]
send of [c, b]
buf_set of [b, 0, 99]
assert_eq of [buf_get of [(recv of c), 0], 1.5, "channel buffer snapshot"]

nested is buffer of 1
buf_set of [nested, 0, 7]
send of [c, {"payload": nested}]
buf_set of [nested, 0, -7]
assert_eq of [buf_get of [((recv of c)["payload"]), 0], 7, "nested buffer snapshot"]

tb is text_builder_new of null
text_builder_append of [tb, "before"]
send of [c, tb]
text_builder_append of [tb, "+AFTER"]
assert_eq of [text_builder_to_string of (recv of c), "before", "channel text_builder snapshot"]

join_buf is buffer of 1
buf_set of [join_buf, 0, 11]
define return_buf() as:
    return join_buf
hb is spawn of return_buf
joined_buf is thread_join of hb
buf_set of [join_buf, 0, 22]
assert_eq of [buf_get of [joined_buf, 0], 11, "joined buffer snapshot"]

join_tb is text_builder_new of null
text_builder_append of [join_tb, "worker"]
define return_builder() as:
    return join_tb
ht is spawn of return_builder
joined_tb is thread_join of ht
text_builder_append of [join_tb, "+parent"]
assert_eq of [text_builder_to_string of joined_tb, "worker", "joined text_builder snapshot"]

test_summary of null
