# #971 item 3 — underflow-to-zero is detectable.  Clean controls run before
# the first underflow because numeric status is intentionally sticky.
pass is 1
define fail(msg) as:
    pass is 0
    print of ("FAIL: " + msg)
define uf() as:
    return (math_flags of null)["underflow"]

# Controls in a fresh process.
c is 5.0 - 5.0
d is 0.0 + 0.0
e is 3.0 * 0.0
f is 2.0 * 3.0
if (uf of null) or not (f == 6):
    fail of "exact/ordinary arithmetic raised underflow"

define uf_leaf(x, y) as:
    return x * y
define uf_local(x, y) as:
    local p is x * y
    return p
r is uf_leaf of [2, 3]
if (uf of null) or not (r == 6):
    fail of "a normal leaf product raised underflow"

# Raising paths and sticky behavior.
a is 1e-300 * 1e-300
if not (a == 0 and (uf of null)):
    fail of "multiplication underflow was not flagged"
b is 1e-300 / 1e300
if not (uf of null):
    fail of "division underflow was not flagged"
h is 2.0 * 3.0
if not (uf of null):
    fail of "underflow flag did not stay sticky"
fl is math_flags of null
if fl["overflow"] or fl["invalid"]:
    fail of "underflow set another status flag"
r is uf_leaf of [1e-200, 1e-200]
if not ((math_flags of null)["underflow"]):
    fail of "leaf return product did not set underflow"
r is uf_local of [1e-200, 1e-200]
if not ((math_flags of null)["underflow"]):
    fail of "local product did not set underflow"

if pass == 1:
    print of "MATH_UNDERFLOW_ALL_PASS"
else:
    print of "SOME TESTS FAILED"
