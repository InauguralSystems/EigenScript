# format.hexdump — exact row format, multi-row offsets, buffer parity.
# All-pass prints HEXDUMP_ALL_PASS.
load_file of "lib/format.eigs"

fails is 0
define check(tag, got, want) as:
    if got == want:
        print of f"  PASS: {tag}"
    if got != want:
        print of f"  FAIL: {tag}"
        print of f"    got  [{got}]"
        print of f"    want [{want}]"
        fails is fails + 1

print of "=== HEXDUMP (lib/format.eigs) ==="

# Ordinary-value rounding matches Python's fixed-point formatting, including
# values where scaling masks which side of a decimal tie the binary value is.
check of ["fmt_num Python 2.675", fmt_num of [2.675, 2], "2.67"]
check of ["fmt_num Python 9.995", fmt_num of [9.995, 2], "9.99"]
check of ["fmt_num Python 1.005", fmt_num of [1.005, 2], "1.00"]
check of ["fmt_num Python 2.685", fmt_num of [2.685, 2], "2.69"]
check of ["fmt_num Python 0.045", fmt_num of [0.045, 2], "0.04"]
check of ["fmt_num Python 0.055", fmt_num of [0.055, 2], "0.06"]
check of ["fmt_num Python decimal", fmt_num of [1234.5678, 2], "1234.57"]
check of ["fmt_num Python negative", fmt_num of [-2.675, 2], "-2.67"]
check of ["fmt_num Python zero", fmt_num of [0, 2], "0.00"]
check of ["fmt_num Python integer", fmt_num of [42, 0], "42"]

# Large magnitudes must not leak str's exponent notation into fixed-point output.
check of ["fmt_num 1e16", fmt_num of [1e16, 0], "10000000000000000"]
check of ["fmt_num 1e20", fmt_num of [1e20, 2], "100000000000000000000.00"]

check of ["one short row", hexdump of "Hello!", "00000000  48 65 6C 6C 6F 21                                |Hello!|"]

# non-printables become dots
nl is chr of 10
check of ["control byte dotted", hexdump of ("A" + nl), "00000000  41 0A                                            |A.|"]

# two rows: second offset is 00000010
long is "0123456789ABCDEF-tail"
d is hexdump of long
lines is split of [d, "\n"]
check of ["two rows", len of lines, 2]
check of ["second row offset", char_at of [lines[1], 7], "0"]
check of ["second row starts at byte 16", contains of [lines[1], "2D 74 61 69 6C"], true]

# buffer input equals string input
b is buffer of 6
i is 0
loop while i < 6:
    buf_set of [b, i, ord of (char_at of ["Hello!", i])]
    i is i + 1
check of ["buffer == string", hexdump of b, hexdump of "Hello!"]

check of ["empty input is empty string", hexdump of "", ""]

if fails == 0:
    print of "HEXDUMP_ALL_PASS"
if fails > 0:
    print of f"{str of fails} FAILURES"
    throw of "hexdump tests failed"
