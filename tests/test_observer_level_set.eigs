# R3.1: scalar predicates use value trajectories. Singleton containers
# retain entropy(value)+1, so sign/reciprocal level sets remain entropy-blind.
# Compare numeric oscillation against that independent nonnumeric channel.

define run_signflip() as:
    local x is 5.0
    local boxed_x is [x]
    local k is 0
    loop while k < 60:
        x is 0 - x
        boxed_x is [x]
        k is k + 1
    return [classify of [trajectory of boxed_x, "entropy"], report of x, oscillating of x]

# Reciprocal: y = 1000, 0.001, 1000, ... The worse case — six orders of
# magnitude per step, and the entropy channel calls it the STRONGEST rest band.
define run_recip() as:
    local y is 1000.0
    local boxed_y is [y]
    local k is 0
    loop while k < 60:
        y is 1.0 / y
        boxed_y is [y]
        k is k + 1
    return [classify of [trajectory of boxed_y, "entropy"], report of y, oscillating of y]

local pass is 1

# --- Case 1: sign flip, value-channel surfaces must see it -----------------
local r1 is run_signflip of null
local ent1 is r1[0]
local rep1 is r1[1]
local osc1 is r1[2]
print of ("sign-flip:  entropy=" + ent1 + " report=" + rep1 + " oscillating=" + (str of osc1))
if not (rep1 == "oscillating"):
    pass is 0
    print of ("FAIL: `report` missed a sign-flip oscillator on the level set, got " + rep1)
if not (osc1 == true):
    pass is 0
    print of "FAIL: `oscillating of x` did not fire on a sign-flip oscillator"

# --- Case 2: reciprocal, value-channel surfaces must see it ----------------
local r2 is run_recip of null
local ent2 is r2[0]
local rep2 is r2[1]
local osc2 is r2[2]
print of ("reciprocal: entropy=" + ent2 + " report=" + rep2 + " oscillating=" + (str of osc2))
if not (rep2 == "oscillating"):
    pass is 0
    print of ("FAIL: `report` missed a reciprocal oscillator on the level set, got " + rep2)
if not (osc2 == true):
    pass is 0
    print of "FAIL: `oscillating of y` did not fire on a reciprocal oscillator"

# --- Case 3: the entropy channel is still blind, BY NAME -------------------
# This is the other half of the contract, and it is what makes cases 1-2 a
# real guard rather than a coincidence: the signal these two trajectories are
# classified from CANNOT be the entropy channel, because on the level set that
# channel has nothing in it. `dH` is identically 0, so the entropy classifier
# must land in a rest band. If this case ever goes red, the entropy formula
# changed and #862's analysis has to be redone from the top.
if ent1 == "oscillating":
    pass is 0
    print of "FAIL: entropy channel reported oscillating on a level set (dH is identically 0 there) — the entropy formula changed"
if ent2 == "oscillating":
    pass is 0
    print of "FAIL: entropy channel reported oscillating on a reciprocal level set — the entropy formula changed"

# --- Case 4: the two channels DISAGREE here --------------------------------
# The routing (#861/#892) is the only reason these programs classify correctly.
# Pinning the disagreement directly means a regression that re-routes numeric
# predicates back to entropy fails here even if someone relaxes cases 1-3.
if ent1 == rep1:
    pass is 0
    print of ("FAIL: entropy and value channels agree on the level set (both " + ent1 + ") — numeric routing may have regressed")
if ent2 == rep2:
    pass is 0
    print of ("FAIL: entropy and value channels agree on the reciprocal level set (both " + ent2 + ") — numeric routing may have regressed")

if pass == 1:
    print of "All tests passed."
else:
    print of "SOME TESTS FAILED"
