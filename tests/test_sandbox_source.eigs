# #1404: the source overload must use compiler.c, then converge with descriptor
# chunks at the sealed-root sandbox policy and result boundary.
load_file of "lib/test.eigs"

pure is sandbox_run of ["x is 2 + 3\nx * 4", 1000]
assert_eq of [pure["ok"], 1, "source sandbox: pure computation succeeds"]
assert_eq of [pure["result"], 20, "source sandbox: pure result"]
host_secret_1404 is 99
assert_eq of [(sandbox_run of ["host_secret_1404", 1000])["ok"], 0, "source sandbox: sealed root hides host globals"]

# Parse and compile failures are structured and never execute partial code.
bad_parse is sandbox_run of ["x is (", 1000]
assert_eq of [bad_parse["ok"], 0, "source sandbox: parse failure"]
assert_eq of [bad_parse["error"]["kind"], "compile", "source sandbox: parse kind"]
assert_eq of [bad_parse["error"]["line"], 1, "source sandbox: parse line"]
bad_compile is sandbox_run of ["break", 1000]
assert_eq of [bad_compile["ok"], 0, "source sandbox: compile failure"]
assert_eq of [bad_compile["error"]["kind"], "compile", "source sandbox: compile kind"]
assert_eq of [bad_compile["error"]["line"], 1, "source sandbox: compile line"]

# Every capability denied for descriptors remains denied for compiled source.
remove_file of "/tmp/eigs_1404_breach"
write_r is sandbox_run of ["write_text of [\"/tmp/eigs_1404_breach\", \"bad\"]", 1000]
assert_eq of [write_r["error"]["kind"], "sandbox", "source sandbox: write blocked"]
assert_eq of [file_exists of "/tmp/eigs_1404_breach", 0, "source sandbox: no write"]
assert_eq of [(sandbox_run of ["exit of 0", 1000])["error"]["kind"], "sandbox", "source sandbox: exit blocked"]
assert_eq of [(sandbox_run of ["usleep of 30000000", 1000])["error"]["kind"], "sandbox", "source sandbox: blocking call blocked"]
assert_eq of [(sandbox_run of ["import math", 1000])["error"]["kind"], "sandbox", "source sandbox: import blocked"]
# Compilation must not resolve literal host paths while the observer gate is closed.
assert_eq of [(sandbox_run of ["load_file of \"/dev/zero\"", 1000])["error"]["kind"], "sandbox", "source sandbox: compile performs no host read"]
assert_eq of [(sandbox_run of ["eval of \"2 + 2\"", 1000])["error"]["kind"], "sandbox", "source sandbox: code exec blocked"]

# Compiler loop checks and cumulative VM back edges are independently bounded.
loop_r is sandbox_run of ["i is 0\nloop while 1:\n    i is i + 1", 10]
assert_eq of [loop_r["ok"], 0, "source sandbox: compiler loop cap"]
assert of [(index_of of [loop_r["error"]["message"], "partial run"]) >= 0, "source sandbox: compiler cap is partial"]
backedge_src is "define spin() as:\n    local i is 0\n    loop while i < 3:\n        i is i + 1\n    return i\nspin of []\nspin of []\n9"
backedge_r is sandbox_run of [backedge_src, 5]
assert_eq of [backedge_r["ok"], 0, "source sandbox: cumulative back-edge cap"]

bytes_r is sandbox_run of ["range of 10000", 1000, 128]
assert_eq of [bytes_r["ok"], 0, "source sandbox: max_bytes"]
prep_bytes_r is sandbox_run of ["2 + 3", 1000, 1]
assert_eq of [prep_bytes_r["error"]["kind"], "sandbox", "source sandbox: preparation uses max_bytes"]
# A refusal raised by compiler allocation accounting must win over a
# simultaneous syntax error without escaping sandbox_run into the host.
prep_parse_r is sandbox_run of ["x is (", 1000, 128]
assert_eq of [prep_parse_r["ok"], 0, "source sandbox: budgeted parse failure stays structured"]
assert_eq of [prep_parse_r["error"]["kind"], "sandbox", "source sandbox: budget refusal wins over parse error"]

# Callables and results too large to verify never cross the boundary.
fn_r is sandbox_run of ["define f() as:\n    return 1\nf", 1000]
assert_eq of [fn_r["ok"], 0, "source sandbox: returned function refused"]
nested_fn_r is sandbox_run of ["define f() as:\n    return 1\n[f]", 1000]
assert_eq of [nested_fn_r["ok"], 0, "source sandbox: nested function refused"]
big_r is sandbox_run of ["range of 200000", 1000, 268435456]
assert_eq of [big_r["ok"], 0, "source sandbox: oversized result scan refused"]
assert of [(index_of of [big_r["error"]["message"], "too large to scan"]) >= 0, "source sandbox: scan diagnostic"]

# Divergences that motivated the C-compiler entry all compile and run here.
unobs_r is sandbox_run of ["x is 0\nunobserved:\n    x is x + 1\nx", 1000]
assert_eq of [unobs_r["result"], 1, "source sandbox: unobserved"]
shadow_r is sandbox_run of ["define f() as:\n    local len is 7\n    return len\nf of []", 1000]
assert_eq of [shadow_r["result"], 7, "source sandbox: local shadowing"]
one_r is sandbox_run of ["define one(a) as:\n    return a\none of [7]", 1000]
assert_eq of [one_r["result"], 7, "source sandbox: single-element call list"]

test_summary of null
