# R1.6 behaviour-table probe: net_listen (int-requiring; port; returns a handle; PROFILE server (make server), loopback only); phase2-exercises: {"int-requiring":["fractional","integral-float-success"],"integral-float-success":{"stdout-line":4}}
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
try:
    l is net_listen of 0
catch e:
    print of ["capability", e.kind, e.message]
    exit of 0
pt is net_port of l
print of [nt of l, l > 0]
try:
    print of ["fraction-answer", (net_listen of 0.5) > 0]
catch e:
    print of ["port-fraction", e.kind]
try:
    print of ["65536-answer", (net_listen of 65536) > 0]
catch e:
    print of ["port-65536", e.kind]
m is net_listen of 0.0
print of [nt of m, m > 0]
