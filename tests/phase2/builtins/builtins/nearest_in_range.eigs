# R1.6 behaviour-table probe: nearest_in_range (float-producing; geometry floats, the index field is an int)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
ents is [{"px": 1, "py": 1, "active": true}, {"px": 5, "py": 5, "active": true}]
r is nearest_in_range of [ents, 0, 0, 3, 100, 100]
print of [r["index"], nt of r["index"], r["dist"], nt of r["dist"], nt of r["dx"], nt of r["dy"]]
