# R2.4/N12 new builtin, R24-1; phase2-exercises: {"int-requiring":["fractional","integral-float-success"],"integral-float-success":{"stdout-line":1}}
b is buf_from_list of ([1.5, -0.0])
try:
    x is buf_get_bits of [b, 0.0]
    print of ["integral-float", x, num_type of x]
catch e:
    print of ["integral-float", e.kind]
try:
    print of ["negative-zero", buf_get_bits of [b, 1]]
catch e:
    print of ["negative-zero", e.kind]
try:
    buf_set_bits of [b, 1, 9218868437227405313]
    print of ["payload", buf_get_bits of [b, 1]]
catch e:
    print of ["payload", e.kind]
try:
    print of ["fraction-answer", buf_get_bits of [b, 0.5]]
catch e:
    print of ["index-fraction", e.kind]
try:
    print of ["negative-answer", buf_get_bits of [b, -1]]
catch e:
    print of ["index-negative", e.kind]
try:
    print of ["high-answer", buf_get_bits of [b, 2]]
catch e:
    print of ["index-high", e.kind]
try:
    print of ["outside-answer", buf_get_bits of [b, 1e100]]
catch e:
    print of ["index-outside-int64", e.kind]
try:
    print of ["index-type", buf_get_bits of [b, "x"]]
catch e:
    print of ["index-type", e.kind]
try:
    print of ["buffer-type", buf_get_bits of ["x", 0]]
catch e:
    print of ["buffer-type", e.kind]
try:
    print of ["few", buf_get_bits of ([b])]
catch e:
    print of ["few", e.kind]
