# R1.6 behaviour-table probe: gfx_poll (int-preserving; event fields x, y, scancode, button are ints; HOOK events: SDL_PollEvent delivers motion, key and button events (ruling B3))
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
log is env_get of "R16_HOOK_LOG"
ok is gfx_open of [64, 48, "r16"]
m is gfx_poll of null
print of [m["x"], nt of m["x"], m["y"], nt of m["y"]]
k is gfx_poll of null
print of [k["scancode"], nt of k["scancode"]]
b is gfx_poll of null
print of [b["button"], nt of b["button"], b["x"], nt of b["x"], b["y"], nt of b["y"]]
gfx_close of null
write of (read_text of log)
