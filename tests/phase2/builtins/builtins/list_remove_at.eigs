# R1.6 behaviour-table probe: list_remove_at (int-requiring; position (Lua table.remove))
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
xs is [1, 2, 3, 4]
list_remove_at of [xs, 1]
print of xs
try:
    list_remove_at of [xs, 0.5]
    print of ["fraction accepted", xs]
catch e:
    print of ["index-fraction", e.kind]
list_remove_at of [xs, 0.0]
print of xs
