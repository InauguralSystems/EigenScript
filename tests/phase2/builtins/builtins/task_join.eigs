# R1.6 behaviour-table probe: task_join (int-requiring; task handle)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
define w(x) as:
    return x * 2
t is task_spawn of [w, 21]
try:
    print of ["fraction-answer", task_join of (t + 0.5)]
catch e:
    print of ["id-fraction", e.kind]
r is task_join of (t + 0.0)
print of [r, nt of r]
