# R1.6 behaviour-table probe: audio_play (other, Q7 bounded; samples clamp to [-1, 1], then round to int16; returns a channel number; HOOK mix: the delivered mixer PCM (ruling B1))
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
define wait_for(path, want) as:
    local i is 0
    loop while i < 200:
        if contains of [read_text of path, want]:
            return true
        usleep of 20000
        i is i + 1
    return false
log is env_get of "R16_HOOK_LOG"
d is audio_open of [44100, 1]
audio_pause of 1
c is audio_play of [2.5, -3, 0.5, 0]
print of [c, nt of c]
audio_pause of 0
print of ["mixed", wait_for of [log, "mix:"]]
audio_close of null
write of (read_text of log)
