# R1.6 behaviour-table probe: bit_not (int-requiring; Lua unary ~)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
a is bit_not of 9007199254740992
print of [a, nt of a]
try:
    print of ["fraction-answer", bit_not of 1.5]
catch e:
    print of ["fraction", e.kind]
f is bit_not of 0.0
print of [f, nt of f]
