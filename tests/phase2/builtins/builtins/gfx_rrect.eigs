# R1.6 behaviour-table probe: gfx_rrect (other, Q7 geometry,bounded; the rect and radius are clipped in float space, then rounded); phase2-exercises: {"q7":["geometry","bounded"]}
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
ok is gfx_open of [64, 48, "r16"]
print of ["open", ok]
gfx_clear of [0, 0, 0]
gfx_rrect of [-3e9, -3e9, 6e9, 6e9, 10, 0, 255, 0]
