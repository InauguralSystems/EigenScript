# R1.6 behaviour-table probe: record_history (other; truthiness flag in, previous flag out)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
p is record_history of 1
q is record_history of 0
print of [p, nt of p, q, nt of q]
r is record_history of 0.5
s is record_history of 0
print of [r, nt of r, s, nt of s]
