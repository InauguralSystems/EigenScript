# R1.6 behaviour-table probe: store_query (other, LOSS; decodes records; integer text through strtod today)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
p is env_get of "EIGS_PROBE_TMP"
s is store_open of (p + "/db")
k is store_put of [s, "c", {"n": 9007199254740993, "f": 2.5, "i": -7}]
rows is store_query of [s, "c"]
r is rows[0]
print of [r["n"], nt of r["n"], r["f"], nt of r["f"], r["i"], nt of r["i"]]
store_close of s
