# R1.6 behaviour-table probe: close_channel (int-requiring; channel handle ids); phase2-exercises: {"int-requiring":["fractional","integral-float-success"],"integral-float-success":{"stdout-line":2}}
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
c is channel of null
id is c["_channel_id"]
gen is c["_channel_gen"]
try:
    close_channel of {"_channel_id": id + 0.5, "_channel_gen": gen}
    print of ["fraction closed it", channel_closed of c]
catch e:
    print of ["id-fraction", e.kind]
close_channel of {"_channel_id": id + 0.0, "_channel_gen": gen + 0.0}
print of (channel_closed of c)
