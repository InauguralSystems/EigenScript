# R1.6 behaviour-table probe: gfx_ticks (int-preserving; SDL ticks (Uint32 ms); prints a kind and an ordering only)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
a is gfx_ticks of null
print of [a, nt of a]
ok is gfx_open of [64, 48, "r16"]
b is gfx_ticks of null
c is gfx_ticks of null
print of [nt of b, c >= b]
gfx_close of null
