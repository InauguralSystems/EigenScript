# R1.6 behaviour-table probe: store_delete (int-requiring, LOSS; key formatted %d of an (int) cast); phase2-exercises: {"int-requiring":["fractional","integral-float-success"],"integral-float-success":{"stdout-line":3}}
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
p is env_get of "EIGS_PROBE_TMP"
s is store_open of (p + "/db")
k is store_put of [s, "c", {"v": 1}]
try:
    print of (store_delete of [s, "c", 1.9])
catch e:
    print of ["key-fraction", e.kind]
print of ["count-after-fraction", store_count of [s, "c"]]
d is store_delete of [s, "c", 1.0]
print of [d, store_count of [s, "c"]]
k2 is store_put of [s, "c", {"_id": "9007199254740993", "v": 1}]
d2 is store_delete of [s, "c", 9007199254740993]
print of ["delete-big-key", d2, store_count of [s, "c"]]
store_close of s
