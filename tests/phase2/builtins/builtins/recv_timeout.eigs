# R1.6 behaviour-table probe: recv_timeout (int-requiring, Q7 magnitude; handle by N5, a timeout the C long cannot hold raises)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
c is channel of null
id is c["_channel_id"]
gen is c["_channel_gen"]
send of [c, 5]
send of [c, 6]
send of [c, 7]
try:
    print of ["fraction-answer", recv_timeout of [{"_channel_id": id + 0.5, "_channel_gen": gen}, 10]]
catch e:
    print of ["id-fraction", e.kind]
try:
    print of ["huge-timeout-answer", recv_timeout of [c, 1e300]]
catch e:
    print of ["timeout-magnitude", e.kind]
try:
    print of ["past-limit-answer", recv_timeout of [c, 9223372036854775808]]
catch e:
    print of ["timeout-past-int64", e.kind]
v is recv_timeout of [{"_channel_id": id + 0.0, "_channel_gen": gen + 0.0}, 10]
print of [v, nt of v]
print of (recv_timeout of [c, 0.5])
