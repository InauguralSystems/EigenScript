# R1.6 behaviour-table probe: bit_shl (int-requiring; Lua << (R1.5): count >=64 gives 0, a negative count shifts right)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
a is bit_shl of [1, 63]
print of [a, nt of a]
print of [bit_shl of [1, 64], bit_shl of [8, -1]]
try:
    print of ["fraction-answer", bit_shl of [1, 1.5]]
catch e:
    print of ["fraction", e.kind]
f is bit_shl of [1.0, 4.0]
print of [f, nt of f]
