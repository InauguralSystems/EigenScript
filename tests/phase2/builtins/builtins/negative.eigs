# R1.6 behaviour-table probe: negative (int-preserving, LOSS; mirrors unary -, N4b)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
r is negative of 9007199254740993
print of [r, nt of r]
f is negative of 2.5
print of [f, nt of f]
try:
    print of (negative of (-9223372036854775807 - 1))
catch e:
    print of ["int64-min", e.kind]
