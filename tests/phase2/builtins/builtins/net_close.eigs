# R1.6 behaviour-table probe: net_close (int-requiring; socket handle; PROFILE server (make server), loopback only)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
try:
    l is net_listen of 0
catch e:
    print of ["capability", e.kind, e.message]
    exit of 0
pt is net_port of l
try:
    print of ["fraction-answer", net_close of (l + 0.5)]
catch e:
    print of ["handle-fraction", e.kind]
print of (net_close of (l + 0.0))
