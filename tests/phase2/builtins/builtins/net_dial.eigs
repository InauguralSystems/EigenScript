# R1.6 behaviour-table probe: net_dial (int-requiring; port; returns a handle; PROFILE server (make server), loopback only)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
try:
    l is net_listen of 0
catch e:
    print of ["capability", e.kind, e.message]
    exit of 0
pt is net_port of l
c is net_dial of ["127.0.0.1", pt]
print of [nt of c, c > 0]
try:
    print of ["fraction-answer", net_dial of ["127.0.0.1", pt + 0.5]]
catch e:
    print of ["port-fraction", e.kind]
try:
    print of ["65536-answer", net_dial of ["127.0.0.1", 65536]]
catch e:
    print of ["port-65536", e.kind]
d is net_dial of ["127.0.0.1", pt + 0.0]
print of [nt of d, d > 0]
