# R1.6 behaviour-table probe: gfx_delay (other, Q7 magnitude; the milliseconds round, a delay Uint32 cannot hold raises); phase2-exercises: {"q7":["magnitude"]}
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
ok is gfx_open of [64, 48, "r16"]
print of ["open", ok]
print of (gfx_delay of 1.6)
try:
    print of ["huge-delay-answer", gfx_delay of 1e300]
catch e:
    print of ["delay-magnitude", e.kind]
gfx_close of null
