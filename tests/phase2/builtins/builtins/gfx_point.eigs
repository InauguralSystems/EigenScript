# R1.6 behaviour-table probe: gfx_point (other, Q7 geometry,bounded; a point outside the drawable area draws nothing)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
ok is gfx_open of [64, 48, "r16"]
print of ["open", ok]
gfx_clear of [0, 0, 0]
gfx_point of [-0.6, 5, 0, 255, 0]
print of (gfx_read of [0, 5])
gfx_point of [10.6, 7, 0, 0, 255]
print of [gfx_read of [10, 7], gfx_read of [11, 7]]
gfx_point of [20, 20, 300, -20, 127.6]
print of (gfx_read of [20, 20])
gfx_close of null
