# R1.6 behaviour-table probe: gfx_clip (other, Q7 geometry; the clip rect is intersected with the drawable area in float space, then rounded); phase2-exercises: {"q7":["geometry"]}
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
ok is gfx_open of [64, 48, "r16"]
print of ["open", ok]
