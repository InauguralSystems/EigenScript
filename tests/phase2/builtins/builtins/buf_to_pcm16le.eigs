# R1.6 behaviour-table probe: buf_to_pcm16le (other, Q7 bounded; samples clamp to [-1, 1] and round (today's behaviour); offsets and counts by N5)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
b is buf_from_list of [0.5, 2.5, -3]
r is buf_to_pcm16le of [b, 0, 3]
print of [r[0], r[1], r[2], r[3], r[4], r[5], nt of r[0]]
try:
    print of ["fraction-answer", buf_len of (buf_to_pcm16le of [b, 0.5, 1])]
catch e:
    print of ["offset-fraction", e.kind]
try:
    print of ["fraction-answer", buf_len of (buf_to_pcm16le of [b, 0, 1.5])]
catch e:
    print of ["count-fraction", e.kind]
