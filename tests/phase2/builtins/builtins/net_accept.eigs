# R1.6 behaviour-table probe: net_accept (int-requiring; socket handle; PROFILE server (make server), loopback only)
define nt(x) as:
    try:
        return num_type of x
    catch e:
        return e.kind
try:
    l is net_listen of 0
catch e:
    print of ["capability", e.kind, e.message]
    exit of 0
pt is net_port of l
c is net_dial of ["127.0.0.1", pt]
try:
    print of ["fraction-answer", net_accept of [l + 0.5, 2000]]
catch e:
    print of ["handle-fraction", e.kind]
a is net_accept of [l + 0.0, 2000]
print of [nt of a, a != null]
