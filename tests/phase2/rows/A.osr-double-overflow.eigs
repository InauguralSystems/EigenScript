# ROW: A.osr-double-overflow
# ITEMS: A
# EXPECT-RC: 0
# SHAPE: O
# WITNESS: osr-stop dbl MUL
# OPS: MUL
define dbl(n, two) as:
    x is two
    i is 1.0
    loop while true:
        x is x * two
        i is i + 1.0
        if i >= n:
            return x
try:
    print of (dbl of [63.0, 2])
catch e:
    print of e.kind
