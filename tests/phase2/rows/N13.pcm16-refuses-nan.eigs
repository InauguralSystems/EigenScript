# ROW: N13.pcm16-refuses-nan
# ITEMS: N13
# EXPECT-RC: 0
# SHAPE: S
# WITNESS: none
# OPS:
# R2.6 (R23-1 invariant): the quantizer's reader refuses a NaN sample on base.
# A NaN reaches the buffer through N12 bits; an ordinary store refuses it first.
b is buffer of 1
buf_set_bits of [b, 0, 9221120237041090560]
try:
    o is buf_to_pcm16le of [b, 0, 1]
    print of ["accepted", o[0], o[1]]
catch e:
    print of e.kind
