# ROW: N5.osr-index-set
# ITEMS: N5
# EXPECT-RC: 0
# SHAPE: O
# WITNESS: osr fill
# OPS: INDEX_SET NUM_ONE ADD GE JUMP_IF_FALSE SET_LOCAL POP
define fill(big, n) as:
    xs is [0, 0, 0, 0]
    i is 0.0
    loop while true:
        xs[i] is big
        i is i + 1.0
        if i >= n:
            return xs
print of (fill of [9007199254740993, 4.0])
