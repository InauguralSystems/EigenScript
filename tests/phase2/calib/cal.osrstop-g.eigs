# ROW: cal.osrstop-g
# ITEMS: N3
# EXPECT-RC: 0
# SHAPE: O
# WITNESS: osr-stop g ADD
# OPS: ADD
# every OSR entry hands back at the string ADD
define g(n) as:
    s is ""
    i is 0.0
    loop while true:
        s is s + "a"
        i is i + 1.0
        if i >= n:
            return s
print of (g of 4.0)
try:
    print of (5.5 & 1)
catch e:
    print of e.kind
