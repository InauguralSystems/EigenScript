# ROW: cal.fn-keep
# ITEMS: N1
# EXPECT-RC: 0
# SHAPE: F
# WITNESS: fn keep
# OPS: SET_LOCAL
# keep runs natively to its return on its 60th call
define keep(q) as:
    t is q
    return t
k is 0
r is 0
loop while k < 60:
    r is keep of 2.5
    k is k + 1
print of r
try:
    print of (5.5 & 1)
catch e:
    print of e.kind
