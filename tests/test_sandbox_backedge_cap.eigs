# #940: sandbox_run's loop budget is enforced at the back edge itself.
#
# sandbox_run's documented contract is that loops are capped so untrusted code
# cannot hang. The cap used to live only at OP_LOOP_CAP_CHECK /
# OP_LOOP_STALL_CHECK, which the COMPILER emits — an assembled chunk owes
# nobody a cap check, so a bare back edge crossed no budget at all:
#
#   r is sandbox_run of [[1, [30, 3, 0, 40], []], 10]   # JUMP_BACK to itself
#
# spun forever at 100% CPU with max_iterations = 10 (DoS only — the memory
# half of this surface was #939). The budget now also trips at OP_JUMP_BACK,
# through a SECOND counter: a compiler-emitted loop crosses both a cap check
# and a back edge per iteration, so one shared counter would halve the
# documented max_iterations (#772). Two counters against one budget, whichever
# trips first — compiler output trips at the cap check at exactly the
# documented max; assembled chunks trip at the back edge.
#
# This file is the regression gate, and its failure mode is special: pre-fix,
# the chunks in sections 1/2/5 never return at all, so what fails the file
# without the fix is the suite's per-test timeout (run_all_tests.sh's
# EIGS_TEST_TIMEOUT runaway guard, rc=124), not an assertion. An assertion
# that passed both with and without the trip would be worthless here.

load_file of "lib/test.eigs"

ABI is 1

# Opcode numbers (src/vm.h enum order) — same literal-constant discipline as
# test_vm_run_bytecode.eigs / test_chunk_verify_stack.eigs: an external
# bytecode producer hardcodes these too.
JUMP_BACK is 30
RETURN is 40
LOOP_CAP_CHECK is 63

# ---- 1. The reported reproducer -------------------------------------------
# [OP_JUMP_BACK 3, OP_RETURN] jumps to itself. Pre-fix: infinite loop.
spin is sandbox_run of [[ABI, [JUMP_BACK,3,0, RETURN], []], 10]
assert_eq of [spin["ok"], 0, "bare back edge returns a cap error, not a hang"]
assert_eq of [spin["error"]["kind"], "sandbox",
              "bare back edge names the sandbox budget"]

# ---- 2. The cap is a property, not a constant ------------------------------
# Same shape under a generous budget must trip too — the point is that SOME
# bound exists where none did, not the particular max_iterations value.
spin_big is sandbox_run of [[ABI, [JUMP_BACK,3,0, RETURN], []], 100000]
assert_eq of [spin_big["ok"], 0, "bare back edge trips under a large budget too"]

# ---- 3. A compiler-shaped loop still trips at the CAP CHECK -----------------
# [LOOP_CAP_CHECK +3, JUMP_BACK 6, RETURN]: one cap check AND one back edge
# per iteration — the shape the compiler emits for a plain loop. With
# max_iterations = 10 the cap check trips first: the loop exits gracefully,
# the program runs to RETURN, and sandbox_run reports the run as CAPPED
# (ok=0 with the "partial run" message) — a truncated program did not "run
# cleanly"; reporting ok=1 here let a graded validator award its top rung to
# infinite programs. The #772 regression guard survives in the MESSAGE: the
# cap-check trip yields the synthesized partial-run error, while a shared
# counter would count 20 and die at the back edge with the raise message
# ("back-edge iterations") instead.
capped is sandbox_run of [[ABI, [LOOP_CAP_CHECK,3,0, JUMP_BACK,6,0, RETURN], []], 10]
assert_eq of [capped["ok"], 0,
              "compiler-shaped capped loop reports NOT ok (partial run)"]
has_partial is index_of of [capped["error"]["message"], "partial run"]
assert_eq of [has_partial >= 0, 1,
              "cap-check trip names the partial run, not the back-edge raise"]

# ---- 3b. An untripped run under an armed budget still reports ok ------------
# The cap-hit flag is per-run (saved/restored at the sandbox boundary): after
# section 3's capped run, a clean run must NOT inherit the flag.
CONST is 0
POP is 35
small is sandbox_run of [[ABI, [CONST,0,0, POP, RETURN], [7]], 100]
assert_eq of [small["ok"], 1, "a non-looping run under an armed budget stays ok"]

# ---- 4. The trip leaves the host untripped ----------------------------------
# The counter is armed only inside sandbox_run: after a tripped run, the
# host's own loops run as before (every for-loop back edge crosses the same
# opcode).
total is 0
for i in range of 100:
    total is total + i
assert_eq of [total, 4950, "host loops run normally after a tripped sandbox"]

# ---- 5. A second run starts from zero ----------------------------------------
# The counter is saved/restored at the sandbox boundary (and only there — a
# per-frame restore would let a chunk reset its own budget by calling a
# function). A tripped budget must not leak into the next run: the same chunk
# trips on its own ten back edges, not on an inherited count.
again is sandbox_run of [[ABI, [JUMP_BACK,3,0, RETURN], []], 10]
assert_eq of [again["ok"], 0, "a second run trips on its own fresh budget"]

# ---- 6. The back-edge budget is CUMULATIVE ACROSS CALL FRAMES (#948) --------
# The two counters are scoped differently, on purpose. The per-frame loop
# counter is saved/restored at every call frame (frame->saved_loop_iter), so
# each invocation's cap check starts fresh. The back-edge counter is NOT — it
# is scoped to the whole sandbox_run, so an assembled chunk cannot reset its
# own DoS budget by calling a function.
#
# The consequence is user-visible and was undocumented: the SAME loop, in the
# same function, reports differently depending on how many times it is called
# within one run. Section 3 pins the flat-module case; this pins the crossing.
GET_NAME is 25
SET_NAME_LOCAL is 27
CLOSURE is 38
CALL is 39
RETURN_NULL is 41

xf_fn is [[LOOP_CAP_CHECK,3,0, JUMP_BACK,6,0, RETURN_NULL], [], [], 0, "f", []]
xf_one is [CLOSURE,0,0, SET_NAME_LOCAL,0,0, GET_NAME,0,0, CALL,0,0, POP, RETURN_NULL]
xf_two is [CLOSURE,0,0, SET_NAME_LOCAL,0,0, GET_NAME,0,0, CALL,0,0, POP,
           GET_NAME,0,0, CALL,0,0, POP, RETURN_NULL]

# One call: the frame's own cap check trips, the loop exits gracefully, and the
# run is reported as a capped PARTIAL run.
xf_r1 is sandbox_run of [[ABI, xf_one, ["f"], [xf_fn], 0, "m", []], 10]
assert_eq of [xf_r1["ok"], 0, "#948 one call: capped run is not ok"]
xf_p1 is index_of of [xf_r1["error"]["message"], "partial run"]
assert_eq of [xf_p1 >= 0, 1, "#948 one call trips the per-frame CAP CHECK"]

# Two calls: the second frame's cap check starts fresh, but the back-edge
# total does not — so the run dies at the back-edge RAISE instead. Same loop,
# same per-call iteration count, different verdict.
xf_r2 is sandbox_run of [[ABI, xf_two, ["f"], [xf_fn], 0, "m", []], 10]
assert_eq of [xf_r2["ok"], 0, "#948 two calls: still not ok"]
xf_p2 is index_of of [xf_r2["error"]["message"], "back-edge iterations"]
assert_eq of [xf_p2 >= 0, 1,
              "#948 two calls trip the CUMULATIVE back-edge budget, not the per-frame cap"]

# Both negatives, so neither assertion above can pass merely because the two
# messages happen to be the same string.
assert_eq of [(index_of of [xf_r1["error"]["message"], "back-edge iterations"]) < 0, 1,
              "#948 one call does NOT reach the back-edge budget"]
assert_eq of [(index_of of [xf_r2["error"]["message"], "partial run"]) < 0, 1,
              "#948 two calls do NOT report a graceful partial run"]

test_summary of null
