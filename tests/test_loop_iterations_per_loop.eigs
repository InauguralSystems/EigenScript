# #1906: the public binding is per loop, including nested-loop precedence.
a is 0
loop while a < 3:
    a is a + 1
print of __loop_iterations__
b is 0
loop while b < 3:
    b is b + 1
print of __loop_iterations__

outer is 0
loop while outer < 1:
    outer is outer + 1
    inner is 0
    loop while inner < 2:
        inner is inner + 1
    nested_seen is __loop_iterations__
print of nested_seen
