# Predicate family regression matrix — pins the ROUTED predicate semantics
# (#861: numeric bindings answer from the value channel; docs/PREDICATES.md).
# The trajectories below drive numbers, so every row was re-measured against
# the value-channel classifiers when the routing landed; rows whose old
# entropy-band expectations inverted are annotated in place. (#200 first
# pinned the windowed entropy semantics; those still hold for non-numeric
# bindings and are covered via classify-entropy in the windowed_* suites.) Covers what
# test_windowed_converged.eigs does not: the routed verdict matrix for
# stable/improving/diverging/oscillating/equilibrium, full-window
# agreement, documented overlapping predicates, and Newton sqrt
# correctness. Self-asserting: any failure aborts via `assert` (nonzero rc);
# all-pass prints PREDICATE_MATRIX_ALL_PASS.
#
# Every signal for a trajectory is read inside ONE list literal so that
# g_last_observer stays equal to the trajectory variable (each top-level
# `x is ...` would otherwise repoint it). List index map:
#   [0]=converged [1]=stable [2]=improving [3]=diverging
#   [4]=oscillating [5]=equilibrium [6]=report
# Thresholds (defaults): dh_zero=0.001 dh_small=0.01 h_low=0.1.
# Numeric rows test values, raw/relative steps, and STD/D1/D2. Historical
# entropy-shaped inputs remain as explicit comparisons with the former route.

print of "=== PREDICATE MATRIX (docs/PREDICATES.md) ==="

define expect(tag, p, conv, stab, impr, div, osc, eq, rep) as:
    assert of [p[0] == conv, f"{tag}: converged expected {conv} got {p[0]}"]
    assert of [p[1] == stab, f"{tag}: stable expected {stab} got {p[1]}"]
    assert of [p[2] == impr, f"{tag}: improving expected {impr} got {p[2]}"]
    assert of [p[3] == div,  f"{tag}: diverging expected {div} got {p[3]}"]
    assert of [p[4] == osc,  f"{tag}: oscillating expected {osc} got {p[4]}"]
    assert of [p[5] == eq,   f"{tag}: equilibrium expected {eq} got {p[5]}"]
    assert of [p[6] == rep,  f"{tag}: report expected {rep} got {p[6]}"]
    print of f"  PASS: {tag}"

# --- historical entropy-improving witness: numeric growth is diverging ---
a is 2.0
a is 3.0
a is 4.0
a is 5.0
a is 9.0
a is 19.0
a is 99.0
pa is [converged, stable, improving, diverging, oscillating, equilibrium, report of a]
# #861: growth 2->99 is a runaway on the value route (raw same-sign non-vanishing); "improving" was the entropy channel reading its own descent
expect of ["improving", pa, false, false, false, true, false, false, "diverging"]

# --- historical entropy-diverging witness: numeric descent is improving ---
b is 99.0
b is 19.0
b is 9.0
b is 5.0
b is 4.0
b is 3.0
b is 2.0
pb is [converged, stable, improving, diverging, oscillating, equilibrium, report of b]
# #861: decay 99->2 contracts its steps toward a limit — improving; "diverging" was the entropy-rising artifact
expect of ["diverging", pb, false, false, true, false, false, false, "improving"]

# --- oscillating only: sustained alternation between 70 and 75. ---
c is 70.0
c is 75.0
c is 70.0
c is 75.0
c is 70.0
c is 75.0
c is 70.0
pc is [converged, stable, improving, diverging, oscillating, equilibrium, report of c]
expect of ["oscillating", pc, false, false, false, false, true, false, "oscillating"]

# --- steady full-window drift: raw steps do not vanish, so diverging. ---
e is 30.0
e is 32.0
e is 34.0
e is 36.0
e is 38.0
e is 40.0
e is 42.0
e is 44.0
e is 46.0
e is 48.0
e is 50.0
pe is [converged, stable, improving, diverging, oscillating, equilibrium, report of e]
# #861: a steady drift is a linear runaway on the value route (the #422 additive class the entropy gray band hid)
expect of ["stable", pe, false, false, false, true, false, false, "diverging"]

# --- constant 2: converged, stable and equilibrium all hold.
#     Report resolves to converged at a full window. ---
g is 2.0
g is 2.0
g is 2.0
g is 2.0
g is 2.0
g is 2.0
g is 2.0
g is 2.0
g is 2.0
g is 2.0
g is 2.0
pg is [converged, stable, improving, diverging, oscillating, equilibrium, report of g]
# #1891: a settled value independently certifies equilibrium; converged implies stable
expect of ["equilibrium+stable", pg, true, true, false, false, false, true, "converged"]

# --- converged: constant value, FULL window (ten steps). converged is a
#     strict subset of stable. These zero steps also independently satisfy
#     equilibrium; report resolves to converged. ---
k is 1000000.0
k is 1000000.0
k is 1000000.0
k is 1000000.0
k is 1000000.0
k is 1000000.0
k is 1000000.0
k is 1000000.0
k is 1000000.0
k is 1000000.0
k is 1000000.0
pk is [converged, stable, improving, diverging, oscillating, equilibrium, report of k]
# #861: converged implies stable now (all-under-deadband satisfies both)
expect of ["converged", pk, true, true, false, false, false, true, "converged"]

# --- large-amplitude alternation is oscillating, not same-sign divergence.
#     Seven values give six steps and five sign flips. ---
d is 2.0
d is 10.0
d is 2.0
d is 10.0
d is 2.0
d is 10.0
d is 2.0
pd is [converged, stable, improving, diverging, oscillating, equilibrium, report of d]
expect of ["osc-only (no longer co-fires diverging)", pd, false, false, false, false, true, false, "oscillating"]

# --- constant 100: the same rest verdicts hold at another magnitude.
#     Numeric STD/D1 have no entropy h_low boundary. ---
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
h is 100.0
ph is [converged, stable, improving, diverging, oscillating, equilibrium, report of h]
# #861: same lattice at the h_low boundary value — the boundary is meaningless on the value route
expect of ["converged-at-boundary", ph, true, true, false, false, false, true, "converged"]

# --- #735/#1045: a halving tail is still improving before its full value
#     window fits STD convergence, then can be both improving and converged.
#     Report preserves the existing priority of improving over converged. ---
m is 0.9
mi is 0
loop while mi < 20:
    m is m * 0.5
    mi is mi + 1
pm20 is [converged of m, stable of m, improving of m, diverging of m, oscillating of m, equilibrium of m, report of m]
# At 20 halvings the full value-window diameter still exceeds STD
# convergence tolerance; D2 records a recent running-best improvement.
expect of ["mid-decay toward zero (#1045)", pm20, false, false, true, false, false, false, "improving"]
loop while mi < 30:
    m is m * 0.5
    mi is mi + 1
pm is [converged of m, stable of m, improving of m, diverging of m, oscillating of m, equilibrium of m, report of m]
# At 30 halvings the full value window fits STD convergence. D2 patience
# still holds, so improving also fires and keeps priority in report. The
# one-direction raw tail remains outside equilibrium.
expect of ["full-window residual drift (#735)", pm, true, true, true, false, false, false, "improving"]

# --- The full-window agreement guarantee (PREDICATES.md "The report builtin"),
#     asserted directly instead of in prose. At a full window `report of x` must
#     name a band whose bare predicate is TRUE, or "moving" when none is. #735
#     survived because this invariant was documented and never checked: a report
#     that names a band the predicates deny is the silent-wrong-answer class.
#     Only full-window shapes qualify — a partial window is explicitly allowed to
#     disagree (the instantaneous fallback). ---
define agrees(tag, p) as:
    local names is ["oscillating", "diverging", "improving", "converged", "equilibrium", "stable"]
    local idx is [4, 3, 2, 0, 5, 1]     # each band's index in p
    local r is p[6]
    local ok is false
    local n_true is 0
    local j is 0
    loop while j < 6:
        if p[j]:
            n_true is n_true + 1
        j is j + 1
    local i is 0
    loop while i < 6:
        if names[i] == r:
            ok is p[idx[i]]
        i is i + 1
    if r == "moving":
        if n_true == 0:
            ok is true
    assert of [ok, f"{tag}: report={r} is not backed by a true predicate (p={p})"]
    print of f"  PASS: full-window agreement {tag} (report={r})"

agrees of ["stable", pe]
agrees of ["equilibrium+stable", pg]
agrees of ["converged", pk]
agrees of ["converged-at-boundary", ph]
agrees of ["residual drift (#735)", pm]

# --- Newton sqrt correctness (independent of predicates): pin that the math
#     still converges across magnitudes. |result^2 - n| < 1e-6 (two-sided). ---
define check_sqrt(n) as:
    r is sqrt of n
    diff is r * r - n
    assert of [diff < 0.000001, f"sqrt({n}): r^2-n too high ({diff})"]
    assert of [diff > -0.000001, f"sqrt({n}): r^2-n too low ({diff})"]
    print of f"  PASS: sqrt({n}) = {r}"

check_sqrt of 2.0
check_sqrt of 10.0
check_sqrt of 100.0
check_sqrt of 1000000.0
check_sqrt of 0.000001

print of "PREDICATE_MATRIX_ALL_PASS"
