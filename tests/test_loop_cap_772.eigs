# EigenScript #772 regression: ordinary execution must never truncate a loop.
# Pre-fix, an unconditional 100,000,000-iteration default cap (the sandbox
# arm's fallback) silently broke the running loop every 1e8 cumulative
# in-frame iterations — wrong results with exit 0. Found by polymethod's
# brute-force differential oracle (4 corrupted outputs in 524,288 at n=19).
# This loop crosses the old boundary; the armed sandbox cap keeps its own
# coverage in test_vm_run_bytecode.eigs. R1.3 spells this legacy float
# probe explicitly; integer native-loop recovery is measured by phase2_cost.
i is 0.0
unobserved:
    loop while i < 105000000.0:
        i is i + 1.0
if i == 105000000.0:
    print of "cap772: loop crossed 1e8 uncapped PASS"
else:
    print of f"cap772 FAIL: loop stopped at {i}"
    exit of 1
