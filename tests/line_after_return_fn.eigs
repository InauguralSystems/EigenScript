# #1424 uncaught, inside a function frame, hot: `outer` and `dec` are
# JIT-compiled after 6001 calls from a module loop, and `/` on line 11 raises
# on the last call; the module frame is the call on line 15.
# Pre-fix: "Error line 8" and "at outer (line 8)".
# LINE-NUMBER SENSITIVE (the [0g] runner section greps these numbers).
define dec(x) as:
    y is x - 1
    return y
define outer(x) as:
    q is x + 1
    r is 1 / (dec of x)
    return r
k is 6001
loop while k > 0:
    w is outer of k
    k is k - 1
