# Bitwise operation tests
load_file of "lib/test.eigs"

# AND
assert_eq of [bit_and of [0xFF, 0x0F], 15, "AND FF & 0F"]
assert_eq of [bit_and of [12, 10], 8, "AND 12 & 10"]
assert_eq of [bit_and of [7, 0], 0, "AND 7 & 0"]

# OR
assert_eq of [bit_or of [0xF0, 0x0F], 255, "OR F0 | 0F"]
assert_eq of [bit_or of [4, 2], 6, "OR 4 | 2"]
assert_eq of [bit_or of [0, 0], 0, "OR 0 | 0"]

# XOR
assert_eq of [bit_xor of [0xFF, 0x0F], 240, "XOR FF ^ 0F"]
assert_eq of [bit_xor of [5, 3], 6, "XOR 5 ^ 3"]

# Shift left
assert_eq of [bit_shl of [1, 0], 1, "SHL 1 << 0"]
assert_eq of [bit_shl of [1, 3], 8, "SHL 1 << 3"]
assert_eq of [bit_shl of [5, 2], 20, "SHL 5 << 2"]

# Shift right
assert_eq of [bit_shr of [8, 3], 1, "SHR 8 >> 3"]
assert_eq of [bit_shr of [255, 4], 15, "SHR 255 >> 4"]

# Bitmask patterns
unlocked is 0
unlocked is bit_or of [unlocked, bit_shl of [1, 0]]
unlocked is bit_or of [unlocked, bit_shl of [1, 2]]
assert_eq of [bit_and of [unlocked, 1], 1, "bitmask bit 0 set"]
assert_eq of [bit_and of [unlocked, 2], 0, "bitmask bit 1 clear"]
assert_eq of [bit_and of [unlocked, 4], 4, "bitmask bit 2 set"]

# Shift amount masking — out-of-range shifts are defined, not UB
# int64 semantics (aligned with the infix operators): counts are real
# up to 63 — the old int32-era &31 masking (1<<32 == 1) is gone.
assert_eq of [bit_shl of [1, 32], 4294967296, "SHL 1 << 32 is 2^32 (int64, no 31-masking)"]
assert_eq of [bit_shl of [1, 33], 8589934592, "SHL 1 << 33 is 2^33"]
assert_eq of [bit_shr of [8, 35], 0, "SHR 8 >> 35 shifts out to 0"]

# Out-of-range shift COUNTS are defined (masked & 63), not C UB — for BOTH the
# infix operators and the bit_* builtins. Count 64 == count 0 (64 & 63 == 0),
# count 65 == count 1, count 100 == count 36. Without the mask the infix path
# was undefined behavior (only untested counts kept UBSan quiet).
assert_eq of [1 << 64, 1, "infix << 64 masks to << 0 (defined, not UB)"]
assert_eq of [1 << 65, 2, "infix << 65 masks to << 1"]
assert_eq of [1 << 100, 68719476736, "infix << 100 masks to << 36 == 2^36"]
assert_eq of [bit_shl of [1, 64], 1, "bit_shl count 64 masks to 0 (matches infix)"]
assert_eq of [256 >> 64, 256, "infix >> 64 masks to >> 0"]

# Type safety — non-numeric args raise (strict error model, not UB, not 0).
# Builtins:
caught_and is ""
try:
    x is bit_and of ["abc", 5]
catch err:
    caught_and is err
assert_true of [contains of [caught_and.message, "bit_and"], "bit_and string arg raises"]

caught_or is ""
try:
    x is bit_or of [null, 5]
catch err:
    caught_or is err
assert_true of [contains of [caught_or.message, "bit_or"], "bit_or null arg raises"]

caught_shl is ""
try:
    x is bit_shl of [[1,2], 4]
catch err:
    caught_shl is err
assert_true of [contains of [caught_shl.message, "bit_shl"], "bit_shl list arg raises"]

caught_not is ""
try:
    x is bit_not of "abc"
catch err:
    caught_not is err
assert_true of [contains of [caught_not.message, "bit_not"], "bit_not string arg raises"]

# Operators:
caught_op_and is ""
try:
    x is "a" & 1
catch err:
    caught_op_and is err
assert_true of [contains of [caught_op_and.message, "cannot apply"], "& string operand raises"]

caught_op_shl is ""
try:
    x is null << 2
catch err:
    caught_op_shl is err
assert_true of [contains of [caught_op_shl.message, "cannot apply"], "<< null operand raises"]

caught_op_not is ""
try:
    x is ~null
catch err:
    caught_op_not is err
assert_true of [contains of [caught_op_not.message, "cannot apply"], "~ null operand raises"]

# --- int64 alignment: the bit_* builtins ARE the infix operators ---
# (they used to be a divergent int32 implementation: UB past 2^31 and
# sign-extended results — 0xEDB88320, CRC-32's polynomial, was the
# first casualty. Every pair below asserts builtin == infix on the
# same operands, including the high-bit range.)
assert_eq of [bit_and of [0xEDB88320, 0xFFFFFFFF], 0xEDB88320 & 0xFFFFFFFF, "AND matches infix at 2^31..2^32"]
assert_eq of [bit_and of [0xEDB88320, 0xFFFFFFFF], 0xEDB88320, "AND identity holds unsigned"]
assert_eq of [bit_xor of [0xEDB88320, 0xEDB88320], 0, "XOR self-cancels in high range"]
assert_eq of [bit_xor of [0xEDB88320, 0], 0xEDB88320, "XOR zero is identity, unsigned result"]
assert_eq of [bit_or of [0x80000000, 0x1], 0x80000001, "OR keeps bit 31 unsigned"]
assert_eq of [bit_shr of [0xEDB88320, 1], 0x76DC4190, "SHR is logical on non-negative operands"]
assert_eq of [bit_shr of [0xEDB88320, 1], 0xEDB88320 >> 1, "SHR matches infix"]
assert_eq of [bit_shl of [0x40000000, 1], 0x80000000, "SHL crosses bit 31 without sign-extending"]
assert_eq of [bit_shl of [1, 40], 1 << 40, "SHL matches infix past 32 bits"]
assert_eq of [bit_and of [bit_not of 0, 0xFFFFFFFF], 0xFFFFFFFF, "NOT of 0 masked to u32 is all-ones"]
# one CRC-32 update step, the motivating consumer shape
crc_step is bit_xor of [bit_shr of [0xFFFFFFFF, 8], 0xEDB88320]
assert_eq of [crc_step, (0xFFFFFFFF >> 8) ^ 0xEDB88320, "CRC step: builtin chain == infix chain"]

# --- #1740: an operand must be an EXACT int64 (Lua 5.4's rule) ---
# A fractional operand, or one outside [-2^63, 2^63), has no integer
# representation: the operation raises `value` (catchable), on every operand
# including the shift count. (#1739 had mapped out-of-range to INT64_MIN.)
define bw_raise(op, a, b) as:
    local got is "no raise"
    try:
        if op == "&":
            local r is a & b
        elif op == "|":
            local r is a | b
        elif op == "^":
            local r is a ^ b
        elif op == "<<":
            local r is a << b
        elif op == ">>":
            local r is a >> b
        elif op == "~":
            local r is ~a
        elif op == "bit_and":
            local r is bit_and of [a, b]
        elif op == "bit_or":
            local r is bit_or of [a, b]
        elif op == "bit_xor":
            local r is bit_xor of [a, b]
        elif op == "bit_shl":
            local r is bit_shl of [a, b]
        elif op == "bit_shr":
            local r is bit_shr of [a, b]
        else:
            local r is bit_not of a
    catch e:
        got is e.kind
        if not (contains of [e.message, "'" + op + "'"]):
            got is "message does not name the operator: " + e.message
        elif not (contains of [e.message, "has no integer representation"]):
            got is "wrong message: " + e.message
    return got

big is 1e30
assert_eq of [bw_raise of ["|", 1.5, 0], "value", "1.5 | 0 raises value"]
assert_eq of [bw_raise of ["<<", 0.5, 1], "value", "0.5 << 1 raises value"]
assert_eq of [bw_raise of ["<<", 1, 0.5], "value", "1 << 0.5 raises value (shift count)"]
assert_eq of [bw_raise of [">>", 8, 0.5], "value", "8 >> 0.5 raises value (shift count)"]
assert_eq of [bw_raise of ["<<", 1, big], "value", "1 << 1e30 raises value (count out of range)"]
assert_eq of [bw_raise of ["&", 1, 0.5], "value", "1 & 0.5 raises value (right operand)"]
assert_eq of [bw_raise of ["^", 1.5, 1], "value", "1.5 ^ 1 raises value"]
assert_eq of [bw_raise of ["|", big, 0], "value", "1e30 | 0 raises value"]
assert_eq of [bw_raise of ["|", 0 - big, 0], "value", "-1e30 | 0 raises value"]
assert_eq of [bw_raise of ["|", 9223372036854775808, 0], "value", "2^63 | 0 raises value"]
assert_eq of [bw_raise of ["&", -1e19, 1], "value", "-1e19 & 1 raises value"]
assert_eq of [bw_raise of ["~", 0.5, 0], "value", "~0.5 raises value"]
assert_eq of [bw_raise of ["~", big, 0], "value", "~1e30 raises value"]
assert_eq of [bw_raise of ["bit_and", 1.5, 1], "value", "bit_and of [1.5, 1] raises value"]
assert_eq of [bw_raise of ["bit_or", 1, big], "value", "bit_or of [1, 1e30] raises value"]
assert_eq of [bw_raise of ["bit_xor", 0.5, 0], "value", "bit_xor of [0.5, 0] raises value"]
assert_eq of [bw_raise of ["bit_shl", 1, 0.5], "value", "bit_shl of [1, 0.5] raises value (count)"]
assert_eq of [bw_raise of ["bit_shr", 1, big], "value", "bit_shr of [1, 1e30] raises value (count)"]
assert_eq of [bw_raise of ["bit_not", 1.5, 0], "value", "bit_not of 1.5 raises value"]
assert_eq of [bw_raise of ["bit_not", 9223372036854775808, 0], "value", "bit_not of 2^63 raises value"]
# Exact integers at the edges stay valid, unchanged from #1739.
int64_min is -9223372036854775808
assert_eq of [bw_raise of ["|", int64_min, 0], "no raise", "-2^63 | 0 is valid"]
assert_eq of [int64_min | 0, int64_min, "-2^63 | 0 returns itself"]
assert_eq of [bit_or of [int64_min, 0], int64_min, "bit_or of [-2^63, 0] returns itself"]
assert_eq of [9223372036854774784 | 0, 9223372036854774784, "largest double below 2^63 is valid"]
assert_eq of [~int64_min, 9223372036854775807, "~(-2^63) is INT64_MAX"]
assert_eq of [(0 - 0) | 0, 0, "zero is valid"]
assert_eq of [(0 - 1) << 1, 0 - 2, "SHL of a negative is defined (unsigned shift)"]
assert_eq of [bit_shl of [0 - 1, 1], (0 - 1) << 1, "bit_shl matches infix on a negative"]
assert_eq of [1 << (0 - 1), int64_min, "a negative exact count is masked & 63"]

# --- JIT tier: the native path must raise exactly where the VM does ---
# Each callee is called > EIGS_JIT_ENTRY_THRESHOLD (50) times with integers
# first, so its thunk exists before a non-integer operand arrives; the OSR
# loop runs past EIGS_JIT_OSR_THRESHOLD (5000) back-edges before its bad
# iteration. tools/jit_diff.sh runs this file JIT-off, default and forced OSR.
define hot_or(a, b) as:
    return a | b
define hot_shl(a, b) as:
    return a << b
define hot_not(a) as:
    return ~a
define hot_count(f, n) as:
    local raised is 0
    local sum is 0
    local k is 0
    loop while k < n:
        local a is k
        local b is 3
        if k % 7 == 6:
            a is k + 0.5
        if k % 11 == 10:
            b is 0.25
        if k % 13 == 12:
            a is 1e30
        try:
            if f == "or":
                sum is sum + (hot_or of [a, b])
            elif f == "shl":
                sum is sum + (hot_shl of [a, b])
            else:
                sum is sum + (hot_not of a)
        catch e:
            if e.kind == "value":
                raised is raised + 1
        k is k + 1
    return [raised, sum]
# The oracle: the same counts from the bit_* builtins (C, never JIT-emitted).
define oracle_count(f, n) as:
    local raised is 0
    local sum is 0
    local k is 0
    loop while k < n:
        local a is k
        local b is 3
        if k % 7 == 6:
            a is k + 0.5
        if k % 11 == 10:
            b is 0.25
        if k % 13 == 12:
            a is 1e30
        try:
            if f == "or":
                sum is sum + (bit_or of [a, b])
            elif f == "shl":
                sum is sum + (bit_shl of [a, b])
            else:
                sum is sum + (bit_not of a)
        catch e:
            if e.kind == "value":
                raised is raised + 1
        k is k + 1
    return [raised, sum]
for f in ["or", "shl", "not"]:
    hot is hot_count of [f, 3000]
    want is oracle_count of [f, 3000]
    assert_true of [hot[0] > 0, f"hot {f}: some operands raised"]
    assert_eq of [hot[0], want[0], f"hot {f}: raise count equals the builtin oracle"]
    assert_eq of [hot[1], want[1], f"hot {f}: result sum equals the builtin oracle"]

define osr_loop(n, bad_at) as:
    local i is 0
    local acc is 0
    local v is 0
    try:
        loop while i < n:
            v is i
            if i == bad_at:
                v is i + 0.5
            acc is (acc ^ (v << 1)) & 0xFFFFFF
            acc is acc | (v & 3)
            i is i + 1
    catch e:
        return [i, acc, e.kind]
    return [i, acc, "none"]
define osr_oracle(n) as:
    local i is 0
    local acc is 0
    loop while i < n:
        acc is bit_and of [bit_xor of [acc, bit_shl of [i, 1]], 0xFFFFFF]
        acc is bit_or of [acc, bit_and of [i, 3]]
        i is i + 1
    return acc
osr is osr_loop of [9000, 8000]
assert_eq of [osr[0], 8000, "OSR loop raised at the fractional iteration"]
assert_eq of [osr[2], "value", "OSR loop raised value"]
assert_eq of [osr[1], osr_oracle of 8000, "OSR loop state at the raise equals the builtin oracle"]
osr_ok is osr_loop of [9000, 0 - 1]
assert_eq of [osr_ok[0], 9000, "OSR loop with exact integers completes"]
assert_eq of [osr_ok[1], osr_oracle of 9000, "OSR loop with exact integers equals the builtin oracle"]

test_summary of null
