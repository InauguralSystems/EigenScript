# vm_run_bytecode — the self-hosting bootstrap bridge. Assemble a chunk from
# EigenScript values (code bytes + constant pool) and run it on the C VM.
# Opcodes/operands are exactly what compile_ast emits (operands are
# little-endian, 16-bit except OP_LINE's, which is 32-bit since #630); this is
# what an EigenScript-written compiler will produce.
#
# This file is the ABI contract for external bytecode producers (ouroboros'
# self-hosted codegen, iLambdaAi's vendored copy of it). Changing an opcode's
# NUMBER or its OPERAND WIDTH breaks every one of them silently — a misaligned
# chunk runs as garbage at rc=0 — and their CI cannot see it, because they pin
# a release. So any such change belongs here, in the same PR (#704).
#
# Since #704 every top-level descriptor is stamped with the bytecode ABI
# revision it was built against: [ABI, code, constants, ...]. A producer that
# predates a revision bump is now refused by name instead of running garbage.

load_file of "lib/test.eigs"

# Opcode numbers (src/vm.h enum order)
CONST is 0
ADD is 4
GT is 20
GET_NAME is 25
JUMP_IF_FALSE is 31
CALL is 39
RETURN is 40

# #704: the bytecode ABI revision this file was written against. Deliberately a
# LITERAL, exactly as an external producer must hardcode it — never read back
# from the runtime, which would always agree and make the guard decoration. When
# EIGS_BYTECODE_ABI is bumped in src/vm.h, this constant is bumped in the same
# PR and the bump is the reminder that every external producer needs one too.
ABI is 1

# 2 + 3 -> 5
assert_eq of [vm_run_bytecode of [ABI, [CONST,0,0, CONST,1,0, ADD, RETURN], [2, 3]], 5, "arith add"]

# string concat "a" + "b" -> "ab"
assert_eq of [vm_run_bytecode of [ABI, [CONST,0,0, CONST,1,0, ADD, RETURN], ["a", "b"]], "ab", "string concat via ADD"]

# comparison 10 > 3 -> 1
assert_eq of [vm_run_bytecode of [ABI, [CONST,0,0, CONST,1,0, GT, RETURN], [10, 3]], 1, "comparison GT"]

# builtin call: len of "hello" -> 5  (GET_NAME resolves "len" in the global env)
assert_eq of [vm_run_bytecode of [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["len", "hello"]], 5, "builtin call via GET_NAME+CALL"]

# control flow: max(a, b) via JUMP_IF_FALSE (relative forward offset)
#   CONST a; CONST b; GT; JUMP_IF_FALSE +4; CONST a; RETURN; CONST b; RETURN
maxcode is [CONST,0,0, CONST,1,0, GT, JUMP_IF_FALSE,4,0, CONST,0,0, RETURN, CONST,1,0, RETURN]
assert_eq of [vm_run_bytecode of [ABI, maxcode, [10, 3]], 10, "max(10,3) fall-through branch"]
assert_eq of [vm_run_bytecode of [ABI, maxcode, [3, 10]], 10, "max(3,10) jump-taken branch"]
assert_eq of [vm_run_bytecode of [ABI, maxcode, [7, 2]], 7, "max(7,2)"]

# bad args degrade to null, not a crash — once past the ABI stamp
assert_eq of [vm_run_bytecode of [ABI, 42, []], null, "non-list code -> null"]

# nested function chunk: define double(x) = x + x; double of 21 -> 42
CLOSURE is 38
SET_NAME_LOCAL is 27
GET_LOCAL is 23
RETURN_NULL is 41
POP is 35
# function body: GET_LOCAL 0; GET_LOCAL 0; ADD; RETURN; RETURN_NULL
# NOTE: nested descriptors carry NO ABI stamp — the revision describes the chunk
# handed across the boundary, not every chunk nested inside it.
dbl_desc is [[GET_LOCAL,0,0, GET_LOCAL,0,0, ADD, RETURN, RETURN_NULL], [], [], 1, "double", ["x"]]
# module: CLOSURE 0; SET_NAME_LOCAL 0("double"); POP; GET_NAME 0; CONST 1(21); CALL 1; RETURN
mod_code is [CLOSURE,0,0, SET_NAME_LOCAL,0,0, POP, GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN]
assert_eq of [vm_run_bytecode of [ABI, mod_code, ["double", 21], [dbl_desc], 0, "<module>", []], 42, "nested function call"]

# record_history toggles per-assignment history recording (for prev / at queries
# in self-hosted programs) and returns the previous setting.
record_history of 0
assert_eq of [record_history of 1, 0, "record_history: was off -> returns 0"]
assert_eq of [record_history of 1, 1, "record_history: now on -> returns 1"]
record_history of 0

# A non-numeric flag raises rather than silently coercing to disable (#255):
# silently turning history OFF on a bad arg made prev/at return null with no
# error, hard to trace back to this call. Strict, like the rest of the runtime.
rh_null_caught is 0
try:
    record_history of null
catch e:
    rh_null_caught is 1
assert of [rh_null_caught == 1, "record_history: null flag raises (no silent disable)"]
rh_str_caught is 0
try:
    record_history of "yes"
catch e:
    rh_str_caught is 1
assert of [rh_str_caught == 1, "record_history: string flag raises (no silent disable)"]
record_history of 0

# sandbox_run: safe code runs and returns {ok, result}. The arg is
# [descriptor, max_iter] where descriptor is [ABI, code, constants].
safe_desc is [ABI, [CONST,0,0, CONST,1,0, ADD, RETURN], [2, 3]]
sr_safe is sandbox_run of [safe_desc, 100000]
assert_eq of [sr_safe["ok"], 1, "sandbox: safe code ok"]
assert_eq of [sr_safe["result"], 5, "sandbox: safe result"]

# sandbox_run: a dangerous builtin (write_text) is shadowed -> blocked, ok=0,
# and no file is written.
remove_file of "/tmp/eigs_sandbox_breach"
block_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["write_text", "/tmp/eigs_sandbox_breach"]]
sr_block is sandbox_run of [block_desc, 100000]
assert_eq of [sr_block["ok"], 0, "sandbox: dangerous builtin blocked"]
assert_eq of [file_exists of "/tmp/eigs_sandbox_breach", 0, "sandbox: nothing written"]

# sandbox_run: BLOCKING builtins are denied too. The g_sandbox_loop_max bound
# counts loop back-edges, not time inside one builtin, so a single blocking call
# (usleep/raw_key/recv) would hang the host indefinitely. These must be shadowed
# -> {ok:0}, NOT executed. If any regresses, this run HANGS (the suite timeout
# is the backstop): usleep would sleep 30s, raw_key would read() stdin, recv
# would wait on a channel condvar forever.
usleep_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["usleep", 30000000]]
assert_eq of [(sandbox_run of [usleep_desc, 100000])["ok"], 0, "sandbox: usleep blocked (no 30s hang)"]
rawkey_desc is [ABI, [GET_NAME,0,0, CALL,0,0, RETURN], ["raw_key"]]
assert_eq of [(sandbox_run of [rawkey_desc, 100000])["ok"], 0, "sandbox: raw_key blocked (no stdin read)"]
recv_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["recv", 0]]
assert_eq of [(sandbox_run of [recv_desc, 100000])["ok"], 0, "sandbox: recv blocked (no channel-wait hang)"]
send_desc is [ABI, [GET_NAME,0,0, CONST,1,0, CALL,1,0, RETURN], ["send", 0]]
assert_eq of [(sandbox_run of [send_desc, 100000])["ok"], 0, "sandbox: send blocked"]

# sandbox_run: a runaway loop is bounded by the iteration cap (returns, no hang).
# NUM_ONE; JUMP_IF_FALSE +6; LOOP_CAP_CHECK +3; JUMP_BACK 10; RETURN_NULL
loopcode is [3, 31,6,0, 63,3,0, 30,10,0, 41]
sr_loop is sandbox_run of [[ABI, loopcode, []], 1000]
assert_eq of [sr_loop["ok"], 1, "sandbox: runaway loop bounded (returned)"]

# --- bytecode verifier: out-of-range operands are rejected, not run ---
# Untrusted/hand-assembled descriptors must never reach the VM with an
# operand that drives an out-of-bounds read. The verifier rejects the chunk
# (vm_run_bytecode -> null; sandbox_run -> {ok:0}) instead of segfaulting.

# constant index past the pool (0xFFFF) — was an OOB read of constants[]
assert_eq of [vm_run_bytecode of [ABI, [CONST,255,255, RETURN], [42]], null, "verify: OOB const index rejected"]
# forward jump target past the end of code
assert_eq of [vm_run_bytecode of [ABI, [CONST,0,0, JUMP_IF_FALSE,255,255, RETURN], [1]], null, "verify: OOB jump target rejected"]
# CLOSURE referencing a function index with no functions present
assert_eq of [vm_run_bytecode of [ABI, [CLOSURE,0,0, RETURN], []], null, "verify: OOB function index rejected"]
# truncated operand (opcode with no room for its 2 operand bytes)
assert_eq of [vm_run_bytecode of [ABI, [CONST], [42]], null, "verify: truncated operand rejected"]
# unknown opcode byte
assert_eq of [vm_run_bytecode of [ABI, [254, RETURN], []], null, "verify: unknown opcode rejected"]
# same, through the sandbox: a bad descriptor returns ok=0, no crash
sr_bad is sandbox_run of [[ABI, [CONST,255,255, RETURN], [42]], 1000]
assert_eq of [sr_bad["ok"], 0, "verify: sandbox rejects OOB const (ok=0)"]

# a name-consuming opcode (GET_NAME) whose constant index points at a NUMERIC
# constant — the interned-name pointer is NULL for non-strings, so the VM
# dereferenced NULL. The verifier now requires name operands to be strings.
DICT is 43
assert_eq of [vm_run_bytecode of [ABI, [GET_NAME,0,0, RETURN], [42]], null, "verify: name op on numeric const rejected"]
# OP_DICT with a count larger than the live stack — once an out-of-bounds stack
# read, then bounded at runtime to the pairs actually present, and now refused
# outright by the verifier's stack-height pass.
#
# The runtime clamp is not enough on its own and this is why the pass exists:
# it clamps the base at ZERO, the bottom of the whole VM stack, not at this
# chunk's frame base. Run nested — sandbox_run called from inside a host
# expression, which is how a grading ladder uses it — an over-claimed count
# consumes the CALLER's operands and decrefs them, freeing values the host is
# still using. A count the stack cannot cover is refused before it runs.
dr is vm_run_bytecode of [ABI, [DICT,255,255, RETURN], []]
assert_eq of [dr, null, "verify: OP_DICT oversized count refused"]
# The honest form still builds its dict.
dr_ok is vm_run_bytecode of [ABI, [CONST,0,0, CONST,1,0, DICT,1,0, RETURN], ["k", 7]]
assert_eq of [dr_ok["k"], 7, "verify: OP_DICT with the pairs present still runs"]

# --- #348: an out-of-range SET_LOCAL raises instead of silently dropping ---
# (Slot indices are absolute env positions for module-level chunks, so use
# 65535 — beyond any real env. GET_LOCAL out-of-range deliberately stays a
# silent null: that path implements missing-parameter-reads-null for
# underfed calls — see the call-semantics suite.)
GET_LOCAL is 23
SET_LOCAL is 24
sl348 is 0
try:
    rs348 is vm_run_bytecode of [ABI, [CONST,0,0, SET_LOCAL,255,255, RETURN], [7]]
catch es348:
    sl348 is 1
assert_eq of [sl348, 1, "SET_LOCAL out-of-range slot raises (#348)"]
assert_eq of [vm_run_bytecode of [ABI, [GET_LOCAL,255,255, RETURN], []], null, "GET_LOCAL out-of-range reads null (missing-param semantics)"]

# --- #630/#704: OP_LINE's operand is 32-bit, and that width IS the ABI ---
# #630 widened this operand from 16 to 32 bits. No opcode number changed, so
# nothing here failed — this file emitted no OP_LINE at all — and the break
# only surfaced at the next consumer bump, where ouroboros produced empty
# output for every program and iLambdaAi's grader lost its top rung. Both were
# silent: rc=0, no error, just a chunk executing misaligned garbage.
LINE is 68
# well-formed: OP_LINE <line:32> then 2 + 3. A 4-byte operand keeps the stream
# aligned, so this is 5. Emit three bytes instead and ADD lands on the wrong
# byte — which is exactly what every external producer did on the v0.33.0 bump.
assert_eq of [vm_run_bytecode of [ABI, [LINE,7,0,0,0, CONST,0,0, CONST,1,0, ADD, RETURN], [2, 3]], 5, "OP_LINE 32-bit operand keeps the stream aligned"]
# the pre-#630 shape — OP_LINE + 2 operand bytes — must NOT still evaluate to 5.
# It is either verifier-rejected or misaligned garbage; either way the contract
# is that it is no longer the arithmetic the producer intended.
old_shape is vm_run_bytecode of [ABI, [LINE,7,0, CONST,0,0, CONST,1,0, ADD, RETURN], [2, 3]]
assert of [old_shape != 5, "pre-#630 16-bit OP_LINE emission no longer silently works"]
# a line number past 65535 — the regime #630 exists for — survives the operand.
assert_eq of [vm_run_bytecode of [ABI, [LINE,161,134,1,0, CONST,0,0, RETURN], [99]], 99, "OP_LINE carries a line past 65535 (#630)"]
# truncated 32-bit operand is rejected by the verifier, not read off the end.
assert_eq of [vm_run_bytecode of [ABI, [LINE,7,0,0], []], null, "verify: truncated OP_LINE operand rejected"]

# --- #704: the ABI revision stamp itself ---
# The canary above catches an operand-width change only for the ONE opcode it
# happens to emit, and only in this repo. The stamp is the general gate: a
# producer built against a different revision is refused BY NAME, whatever it
# emits. These assertions are the planted faults that prove the gate is live —
# without them a stamp that was never checked would look identical to one that
# is. Each stale form must fail, and fail loudly.

# an unstamped descriptor — every pre-#704 producer — raises, and does NOT
# quietly return null the way a malformed chunk does. This is the exact shape
# ouroboros shipped at the v0.33.0 bump.
abi_unstamped is 0
abi_unstamped_msg is ""
try:
    ru is vm_run_bytecode of [[CONST,0,0, CONST,1,0, ADD, RETURN], [2, 3]]
catch eu:
    abi_unstamped is 1
    abi_unstamped_msg is eu["kind"]
assert_eq of [abi_unstamped, 1, "#704: unstamped (pre-revision) descriptor raises"]
assert_eq of [abi_unstamped_msg, "value", "#704: unstamped descriptor raises kind=value"]

# a descriptor stamped with a revision this runtime does not speak raises. Both
# directions: a producer older than us, and one newer.
abi_old is 0
try:
    ro is vm_run_bytecode of [ABI - 1, [CONST,0,0, CONST,1,0, ADD, RETURN], [2, 3]]
catch eo:
    abi_old is 1
assert_eq of [abi_old, 1, "#704: descriptor from an older ABI revision raises"]
abi_new is 0
try:
    rn is vm_run_bytecode of [ABI + 1, [CONST,0,0, CONST,1,0, ADD, RETURN], [2, 3]]
catch en:
    abi_new is 1
assert_eq of [abi_new, 1, "#704: descriptor from a newer ABI revision raises"]

# a non-list argument is refused by name too — previously a silent null.
abi_notlist is 0
try:
    rl is vm_run_bytecode of 5
catch el:
    abi_notlist is 1
assert_eq of [abi_notlist, 1, "#704: non-list descriptor raises (was a silent null)"]

# sandbox_run does not throw — it reports the mismatch structurally, and with a
# message distinct from a malformed chunk's, so a grading ladder can tell
# "your producer is stale" from "your bytecode is wrong" without re-running.
sr_stale is sandbox_run of [[ABI + 1, [CONST,0,0, CONST,1,0, ADD, RETURN], [2, 3]], 1000]
assert_eq of [sr_stale["ok"], 0, "#704: sandbox_run rejects a stale-revision chunk"]
assert_eq of [sr_stale["error"]["kind"], "value", "#704: sandbox_run reports kind=value"]
assert of [sr_stale["error"]["message"] != "invalid chunk descriptor", "#704: stale revision is distinguishable from a malformed chunk"]
assert of [contains of [sr_stale["error"]["message"], "ABI revision"], "#704: the message names the ABI revision"]

# and the current revision still runs through the sandbox unchanged.
sr_ok is sandbox_run of [[ABI, [CONST,0,0, CONST,1,0, ADD, RETURN], [2, 3]], 1000]
assert_eq of [sr_ok["ok"], 1, "#704: current-revision chunk still runs in the sandbox"]
assert_eq of [sr_ok["result"], 5, "#704: current-revision sandbox result"]

# ---- #721: chunk_verify is the boundary, so it must reject a chunk that can
# run PAST its last instruction. Opcodes, operand bounds and jump targets were
# all checked; fall-through off the end was not. The VM then decoded the zeroed
# slack of the code buffer as OP_CONST[0] and dereferenced constants[0] with no
# NULL check — an immediate segfault, driven entirely by sandboxed input.
JUMP is 29
RETURN_NULL is 41
LIST is 42
ITER_NEXT is 49
TRY_BEGIN is 54

assert_eq of [vm_run_bytecode of [ABI, [1], []], null, "#721: chunk with no terminator is refused (was a SEGV)"]
assert_eq of [vm_run_bytecode of [ABI, [CONST,0,0], [7]], null, "#721: trailing CONST falls off the end — refused"]
assert_eq of [vm_run_bytecode of [ABI, [CONST,0,0, RETURN], [7]], 7, "#721: the same chunk WITH a terminator still runs"]
assert_eq of [vm_run_bytecode of [ABI, [RETURN_NULL], []], null, "#721: RETURN_NULL terminates too"]

sr_fall is sandbox_run of [[ABI, [1], []], 1000]
assert_eq of [sr_fall["ok"], 0, "#721: sandbox_run refuses an unterminated chunk"]

# ---- #737: the verifier's operand-layout table had DRIFTED. OP_TRAJECTORY_SLOT
# (91) was missing from op_verify_operands while its NAME sibling was present,
# so it fell through the old `default: return 0` and the verifier walked the
# 3-byte instruction as 1 byte — marking its two OPERAND bytes as valid
# instruction starts. A jump could then land mid-instruction and pass pass 2
# (the #721 surface, reopened). Fixed by making op_verify_operands an
# exhaustive switch on OpCode with no default arm (-Werror=switch keeps it
# closed). Red-then-green: on the drifted table the first assert returned 7.
TRAJECTORY_SLOT is 91

# The trajectory operand bytes are 1,1 (OP_NULL, a 0-operand op) so that on the
# DRIFTED table — where TRAJECTORY_SLOT was walked as a 1-byte op — the walk
# stayed synced (two clean OP_NULLs) and the outcome turns purely on whether
# those bytes are instruction boundaries. That isolates the bug.
NULLOP is 1

# Positive control — a jump to offset 6 (the CONST, one instruction PAST the
# 2-byte trajectory operand) is a real boundary and is accepted under both
# tables (it returns 7 either way; it proves the fix doesn't blanket-reject a
# chunk that merely CONTAINS a trajectory op).
# Layout: 0:JUMP 3:TRAJ_SLOT[operand] 6:CONST[7] 9:RETURN. JUMP end=3, off=3 -> 6.
traj_ok is [JUMP,3,0, TRAJECTORY_SLOT,NULLOP,NULLOP, CONST,0,0, RETURN]
assert_eq of [vm_run_bytecode of [ABI, traj_ok, [7]], 7, "#737: a jump PAST the trajectory operand is a valid boundary — accepted"]

# The drift — same chunk, JUMP off=1 -> target 4, the SECOND byte of
# TRAJECTORY_SLOT's operand. With the operand correctly counted, offset 4 is not
# an instruction boundary and the chunk is refused (null). On the drifted table
# offset 4 was a start (the 1-byte walk), the jump passed pass 2, and execution
# fell through the two OP_NULLs into the CONST -> returned 7.
traj_mid is [JUMP,1,0, TRAJECTORY_SLOT,NULLOP,NULLOP, CONST,0,0, RETURN]
assert_eq of [vm_run_bytecode of [ABI, traj_mid, [7]], null, "#737: a jump INTO the trajectory operand is not a boundary — refused (was 7)"]

# The constant pool of a DESCRIPTOR is indexed positionally by the code stream,
# but it was loaded through the deduplicating add: a repeated number collapsed
# two entries into one and shifted every later index down, so the code silently
# loaded the wrong constant. Here idx 2 must be 3 (not the deduped 2).
assert_eq of [vm_run_bytecode of [ABI, [CONST,0,0, CONST,2,0, ADD, RETURN], [2, 2, 3]], 5, "#721: duplicate constants keep positional indices"]
assert_eq of [vm_run_bytecode of [ABI, [CONST,1,0, RETURN], ["a", "a"]], "a", "#721: duplicate strings do not shift the pool"]

# A bare OP_ITER_NEXT runs against whatever list is on TOS, so the index slot is
# attacker-chosen. It was read as ->data.num with no type check and bounds-checked
# only at the upper end: a negative index reached items[idx] BELOW the array and
# val_incref'd whatever pointer it found there.
iter_neg is [CONST,0,0, CONST,1,0, LIST,2,0, ITER_NEXT,1,0, RETURN, CONST,2,0, RETURN]
assert_eq of [vm_run_bytecode of [ABI, iter_neg, [[10, 20, 30], -5, "EXITED"]], "EXITED", "#721: negative iterator index exits instead of reading out of bounds"]
assert_eq of [vm_run_bytecode of [ABI, iter_neg, [[10, 20, 30], "nan", "EXITED"]], "EXITED", "#721: non-numeric iterator index is not type-confused"]
assert_eq of [vm_run_bytecode of [ABI, iter_neg, [[10, 20, 30], 1, "EXITED"]], 20, "#721: a valid iterator index still yields its element"]

# ---- #726: the per-frame handler stack is MAX_TRY_HANDLERS deep. Compiled
# source can no longer nest deeper, but a descriptor reaches TRY_BEGIN with no
# compiler involved. The 9th TRY_BEGIN must RAISE rather than register nothing
# and let its TRY_END pop the 8th try's still-live handler. Nine TRY_BEGINs,
# all catching at byte 30: with the guard the 9th raises and handler #8 catches
# ("CAUGHT8"); without it, execution fell through the JUMP to "NOERR".
try9 is [TRY_BEGIN,27,0, TRY_BEGIN,24,0, TRY_BEGIN,21,0, TRY_BEGIN,18,0, TRY_BEGIN,15,0, TRY_BEGIN,12,0, TRY_BEGIN,9,0, TRY_BEGIN,6,0, TRY_BEGIN,3,0, JUMP,4,0, CONST,1,0, RETURN, CONST,0,0, RETURN]
assert_eq of [vm_run_bytecode of [ABI, try9, ["NOERR", "CAUGHT8"]], "CAUGHT8", "#726: the 9th TRY_BEGIN raises instead of silently mis-pairing"]

test_summary of null
