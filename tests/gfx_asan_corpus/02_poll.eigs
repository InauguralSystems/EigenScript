# The event pump. gfx_poll allocates a dict per event and used to leak it on
# the two paths that decode nothing (a non-resize SDL_WINDOWEVENT and any
# event type it has no case for) -- 584 bytes / 6 allocations, the only leak
# `make asan-gfx` surfaced over this corpus (#1007).
o is gfx_open of [32, 32, "poll"]
n is 0
for i in range of 200:
    e is gfx_poll of null
    if e != null:
        n is n + 1
    ignore is gfx_present of null
print of f"events seen: {n >= 0}"
ignore is gfx_close of null
print of "02 done"
