# The REJECTED-argument paths, which is where #1007's guards live. Every
# call must raise type_mismatch in every state; rejected() catches only that
# kind so the corpus reaches and leak-checks every guard in one process.
o is gfx_open of [32, 32, "rejected"]
define rejected(thunk) as:
    raised is false
    try:
        thunk of null
    catch rejected_error:
        if rejected_error.kind != "type_mismatch":
            throw of "wrong rejection kind"
        raised is true
    if not raised:
        throw of "rejected gfx/audio argument returned"

rejected of ((_) => gfx_rect of ["10", 10, 50, 50, 255, 0, 0])
rejected of ((_) => gfx_line of ["0", 0, 10, 10, 1, 2, 3])
rejected of ((_) => gfx_point of ["1", 2, 3, 4, 5])
rejected of ((_) => gfx_circle of ["1", 2, 3, 4, 5, 6])
rejected of ((_) => gfx_rrect of ["1", 2, 3, 4, 5, 6, 7, 8])
rejected of ((_) => gfx_clip of ["1", 2, 3, 4])
rejected of ((_) => gfx_clear of ["1", 2, 3])
rejected of ((_) => gfx_text of [1, 2, "hi", "255", 0, 0])
rejected of ((_) => gfx_fb of [42, 4, 4, 0, 0, 1])
rejected of ((_) => gfx_read of ["1", 1])
rejected of ((_) => gfx_delay of "5")
rejected of ((_) => gfx_title of 42)
rejected of ((_) => gfx_text_width of 5)
rejected of ((_) => gfx_text_height of "2")
rejected of ((_) => ppu_render_frame of [1, 2])
rejected of ((_) => audio_mix of [["a"], [0.1]])
rejected of ((_) => audio_gain of [["a"], 2.0])
rejected of ((_) => audio_envelope of [["a"], 0.01, 0.01, 0.5, 0.01])
rejected of ((_) => audio_sine of ["440", 0.01, 0.5])
rejected of ((_) => audio_play_loop of [[0.1], "2"])
rejected of ((_) => audio_volume of ["1", 1])
rejected of ((_) => audio_stop of "x")
rejected of ((_) => audio_pause of "x")
rejected of ((_) => audio_music_play of [42])
rejected of ((_) => audio_music_volume of "loud")
rejected of ((_) => audio_open of ["44100", "1"])
rejected of ((_) => audio_capture_open of ["44100", "1"])
rejected of ((_) => audio_stream_open of ["44100", "1"])
# #1007 round 3: the CONTAINER axis. A short or non-list argument to the three
# openers used to walk past the element guard and open the device at the
# defaults; a non-list `samples` used to answer the documented "nothing to
# play" 0. Both take a new early-return path, so both are walked here — a
# guard whose return is never executed under ASan is a guard nobody has
# checked for a leak.
rejected of ((_) => audio_open of [44100])
rejected of ((_) => audio_capture_open of [44100])
rejected of ((_) => audio_stream_open of [48000])
rejected of ((_) => audio_open of 44100)
rejected of ((_) => audio_play of 42)
rejected of ((_) => audio_stream_push of "zzz")
rejected of ((_) => audio_play_loop of [42, 2])
# Cleanup controls remain harmless after the rejected opens.
ignore is audio_close of null
ignore is audio_capture_close of null
ignore is audio_stream_close of null
rejected of ((_) => gfx_open of ["800", "600", "t"])
ignore is gfx_close of null
print of "06 done"
