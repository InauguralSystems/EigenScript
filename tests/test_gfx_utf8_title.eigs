load_file of "lib/test.eigs"

initial is env_get of "EIGS_INITIAL_TITLE"
updated is env_get of "EIGS_UPDATED_TITLE"
opened is gfx_open of [120, 80, initial]
assert_true of [opened, "X11 window opens"]
if updated != "":
    gfx_delay of 500
    gfx_title of updated
gfx_delay of 2000
gfx_close of null

test_summary of null
