load_file of "lib/test.eigs"
load_file of "lib/geometry.eigs"

_EPSILON_2298 is 2.220446049250313e-16

# 256 operations' worth of binary64 roundoff covers distance construction and
# the intersection arithmetic, relative to each circle's radius and centre.
define abs_2298(x) as:
    if x < 0:
        return 0 - x
    return x

define assert_residuals_2298(circle, expected_count, description) as:
    local points is circle_intersection_points of [circle[0], circle[1], circle[2], circle[3], circle[4], circle[5]]
    assert_eq of [len of points, expected_count, description + " shape"]
    for point in points:
        local dx1 is point[0] - circle[0]
        local dy1 is point[1] - circle[1]
        local dx2 is point[0] - circle[3]
        local dy2 is point[1] - circle[4]
        local residual1 is abs_2298 of ((sqrt of (dx1 * dx1 + dy1 * dy1)) - circle[2])
        local residual2 is abs_2298 of ((sqrt of (dx2 * dx2 + dy2 * dy2)) - circle[5])
        local bound1 is 256 * _EPSILON_2298 * (circle[2] + (abs_2298 of circle[0]) + (abs_2298 of circle[1]))
        local bound2 is 256 * _EPSILON_2298 * (circle[5] + (abs_2298 of circle[3]) + (abs_2298 of circle[4]))
        assert_true of [residual1 <= bound1, description + " point on first circle"]
        assert_true of [residual2 <= bound2, description + " point on second circle"]

issue is [0, 0, 1771450.845521109, 1771450.8459096379, 0, 0.01874238839135805]
assert_residuals_2298 of [issue, 2, "issue"]
assert_residuals_2298 of [[issue[3], issue[4], issue[5], issue[0], issue[1], issue[2]], 2, "swapped"]
assert_residuals_2298 of [[0, 0, issue[2], issue[3], 0 - issue[4], issue[5]], 2, "mirrored in x"]
assert_residuals_2298 of [[0, 0, issue[2], 0 - issue[3], issue[4], issue[5]], 2, "mirrored in y"]
assert_residuals_2298 of [[0, 0, issue[2] * 1e-6, issue[3] * 1e-6, 0, issue[5] * 1e-6], 2, "scaled down"]
assert_residuals_2298 of [[0, 0, issue[2] * 1e6, issue[3] * 1e6, 0, issue[5] * 1e6], 2, "scaled up"]

for ratio in [1e3, 1e6, 1e8, 1e10]:
    assert_residuals_2298 of [[0, 0, ratio, ratio + 0.5, 0, 1], 2, "radius-ratio crossing"]

assert_residuals_2298 of [[0, 0, 1, 1, 0, 1], 2, "equal circles"]
assert_residuals_2298 of [[0, 0, 2, 1, 0, 1], 1, "internal tangent"]
assert_residuals_2298 of [[0, 0, 1, 2, 0, 1], 1, "external tangent"]
assert_residuals_2298 of [[0, 0, 3, 1, 0, 1], 0, "contained"]
assert_residuals_2298 of [[0, 0, 1, 0, 0, 1], 0, "concentric"]
assert_residuals_2298 of [[0, 0, 1, 3, 0, 1], 0, "apart"]

test_summary of null
