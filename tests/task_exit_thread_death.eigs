# #1736 row 4 (unchanged, #1112): an OS THREAD that dies of an uncaught error
# does not stop main. Thread timing is not on the trace tape (#148), so a
# fail-fast stop here would land at a different point in main on every run.
# The join makes sure the death happened before main goes on (it returns
# null today, #1745; the try keeps this test honest if that becomes a raise).
# Expected: the worker's trace, MAIN_AFTER_DEATH, MARK_END, rc 1.
define w() as:
    missing
h is spawn of w
try:
    r is thread_join of h
    print of f"JOINED {r}"
catch e:
    print of f"JOIN_RAISED {e.kind}"
print of "MAIN_AFTER_DEATH"
i is 0
loop while i < 1000:
    i is i + 1
print of "MARK_END"
