# #1661: the issue's reproducer, verbatim. A 2-param callee called
# under-arity reads its unsent param at recursion depth 3000; the JIT read a
# stale freelist slot (heap-use-after-free; release aborted in malloc).
# g writes FLOAT literals so the JIT compiles it: the JIT refuses int code
# until R5 (docs/design/phase2-numbers.md section 3). Its int twin returns
# at R5 (round plan, Round 5 obligations).
n is {"d": 0.0}
define g(A, Q) as:
    if Q == 1.0:
        return 0.0
    n.d is n.d + 1.0
    if n.d > 3000.0:
        return 0.0
    local args is [A]
    return g of (args)

g of ([1])
n.d is 0.0
g of ([1])
print of "ok"
