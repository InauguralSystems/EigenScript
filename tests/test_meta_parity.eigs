# #306: lib/eigen.eigs (the meta-circular interpreter) must agree with the C
# evaluator on the cases that used to diverge. eigen_run returns the value of
# its (last) expression, so we compare that value to what `./src/eigenscript`
# produces for the same source. Diagnostics (error line numbers, the div-by-zero
# stderr warning) are documented best-effort differences and not checked here;
# VALUES and the raise-vs-null behavior are.

load_file of "lib/eigen.eigs"

checks is 0
passed is 0

define check(label, got, want) as:
    checks is checks + 1
    if got == want:
        passed is passed + 1
    else:
        print of f"FAIL: {label}: got {got}, want {want}"

# --- #355: a parenthesised literal list is ONE argument (no spread) ---
check of ["paren'd literal list binds whole",
    eigen_run of "define one(a) as:\n    return a\nr is one of ([1, 2])\nr",
    [1, 2]]
check of ["paren'd literal to 2-param binds first",
    eigen_run of "define fst(a, b) as:\n    return a\nr is fst of ([1, 2])\nr",
    [1, 2]]
check of ["bare literal still spreads",
    eigen_run of "define fst(a, b) as:\n    return a\nr is fst of [1, 2]\nr",
    1]

# --- and/or: value-returning short-circuit (Python/Lua style), matching C ---
check of ["1 and 2", eigen_run of "1 and 2", 2]
check of ["0 and 2", eigen_run of "0 and 2", 0]
check of ["1 or 3", eigen_run of "1 or 3", 1]
check of ["0 or 3", eigen_run of "0 or 3", 3]
check of ["empty-str or 3", eigen_run of "\"\" or 3", 3]
check of ["null or 3", eigen_run of "null or 3", 3]
check of ["2 and 0", eigen_run of "2 and 0", 0]
check of ["empty-list or 3", eigen_run of "[] or 3", 3]
check of ["chained and", eigen_run of "1 and 2 and 3", 3]
check of ["or short-circuits to left", eigen_run of "7 or 9", 7]

# --- a name bound to null is NOT "undefined": returns null, does not raise ---
check of ["null-bound var", eigen_run of "x is null\nx", null]
check of ["normal var", eigen_run of "y is 42\ny", 42]

# --- div / mod by zero must RAISE in both (C VM raises; meta throws) ---
div0_caught is 0
try:
    r is eigen_run of "5 / 0"
catch e:
    div0_caught is 1
check of ["5 / 0 raises", div0_caught, 1]
mod0_caught is 0
try:
    r is eigen_run of "5 % 0"
catch e:
    mod0_caught is 1
check of ["5 % 0 raises", mod0_caught, 1]

# --- unbound identifier must RAISE (C VM raises; old meta-interp returned null) ---
undef_caught is 0
try:
    r is eigen_run of "undefined_xyz"
catch e:
    undef_caught is 1
check of ["unbound identifier raises", undef_caught, 1]

# a use inside a larger expression must also raise (assign/binop form — a
# `print of <unbound>` form would additionally surface a separate, pre-existing
# host bug where a throw inside a function body doesn't halt the caller's next
# statement, so the host `print` runs once with null; that's tracked separately
# and is not what this parity test asserts).
undef2_caught is 0
try:
    r2 is eigen_run of "q is nope_abc"
catch e2:
    undef2_caught is 1
check of ["unbound in assignment raises", undef2_caught, 1]

undef3_caught is 0
try:
    r3 is eigen_run of "nope_def + 1"
catch e3:
    undef3_caught is 1
check of ["unbound in binop raises", undef3_caught, 1]

# --- #338: unsupported operators must RAISE, not silently lex to wrong values ---
tok1_caught is 0
try:
    t1 is eigen_run of "x is 2\nx += 2\nx"
catch te1:
    tok1_caught is 1
check of ["compound += raises (was: silently x+2)", tok1_caught, 1]

tok2_caught is 0
try:
    t2 is eigen_run of "a is 5 & 3\na"
catch te2:
    tok2_caught is 1
check of ["bitwise & raises (was: silently 5)", tok2_caught, 1]

tok3_caught is 0
try:
    t3 is eigen_run of "b is 4 | 2\nb"
catch te3:
    tok3_caught is 1
check of ["bitwise | raises", tok3_caught, 1]

# --- #338: call spread parity — literal-only, 2+ elements, null-fill ---
spread_src_lit is "define f2(a, b) as:\n    if b == null:\n        return 99\n    return b\nf2 of [3, 4]"
check of ["literal 2-elem list spreads", eigen_run of spread_src_lit, 4]

spread_src_var is "define f2(a, b) as:\n    if b == null:\n        return 99\n    return b\npair is [3, 4]\nf2 of pair"
check of ["variable list does NOT spread (b is null)", eigen_run of spread_src_var, 99]

spread_src_one is "define f2(a, b) as:\n    if b == null:\n        return a\n    return 0\nf2 of [7]"
check of ["1-elem literal arg list passes the element (#405)", eigen_run of spread_src_one, 7]

spread_src_paren is "define f2(a, b) as:\n    if b == null:\n        return len of a\n    return 0\nf2 of ([7])"
check of ["paren'd 1-elem literal binds whole list (#355)", eigen_run of spread_src_paren, 1]

spread_src_fill is "define f3(a, b, c) as:\n    if c == null:\n        return a + b\n    return 0\nf3 of [1, 2]"
check of ["short spread null-fills trailing params", eigen_run of spread_src_fill, 3]

# --- #1102/#1111: `report` / `report_value` are reserved observer forms ---
# Native: the shared parser rejects every binding position and every
# non-identifier operand with E005 before the unit runs (`eval` raises kind
# "parse"). Meta: lib/eigen.eigs's tokenizer/parser must reject the same
# programs, with a message that carries the runtime's E005 shape. Each probe
# asserts BOTH sides raise (the div-by-zero pattern above, on both oracles).
define both_reject(label, src) as:
    local native_kind is "did not raise"
    try:
        eval of src
    catch ne:
        native_kind is ne.kind
    check of [f"native E005 (parse) rejects: {label}", native_kind, "parse"]
    local meta_msg is "did not raise"
    try:
        eigen_run of src
    catch me:
        meta_msg is me
    check of [f"meta rejects: {label}", contains of [meta_msg, "is a reserved observer form"], 1]
    check of [f"meta names E005: {label}", contains of [meta_msg, "[E005]"], 1]

# binding positions (the issue's two probes first)
both_reject of ["report is 4 / print of report", "report is 4\nprint of report"]
both_reject of ["define report(v) shadows the form", "define report(v) as:\n    return \"mine\"\nrx is 1\nrx is 2\nprint of (report of rx)"]
both_reject of ["report_value is 4 / print of report_value", "report_value is 4\nprint of report_value"]
both_reject of ["define report_value(v)", "define report_value(v) as:\n    return 1"]
both_reject of ["bare report as a value", "rb is 1\nprint of report"]
both_reject of ["report as a parameter", "define rf(a, report) as:\n    return a"]
both_reject of ["report_value as a lambda parameter", "rg is (a, report_value) => a"]
both_reject of ["report as a for variable", "for report in [1]:\n    print of 1"]
both_reject of ["report as a comprehension variable", "rys is [1 for report in [1]]"]
both_reject of ["report_value as a catch name", "try:\n    rt is 1\ncatch report_value:\n    rt is 2"]
# non-identifier operands (replaces the old `report of 5` == "equilibrium" pin)
both_reject of ["report of 5", "report of 5"]
both_reject of ["report_value of (x + 1)", "rq is 1\nreport_value of (rq + 1)"]
both_reject of ["report of -x", "ru is 1\nreport of -ru"]
both_reject of ["report of d.field", "rd is {\"a\": 1}\nreport of rd.a"]
both_reject of ["report of ([1])", "report of ([1])"]

# an UNBOUND identifier operand is a run-time error on both sides
unb_native is "did not raise"
try:
    eval of "report of nope_report_operand"
catch une:
    unb_native is une.kind
check of ["native: report of unbound raises undefined_name", unb_native, "undefined_name"]
unb_meta is "did not raise"
try:
    eigen_run of "report of nope_report_operand"
catch ume:
    unb_meta is ume
check of ["meta: report of unbound raises", contains of [unb_meta, "undefined variable"], 1]

# positive controls: a bound identifier operand still works on both sides.
# Values are the documented divergence (the meta bridge classifies the VALUE
# with no host trajectory -> "equilibrium"; host functions -> "opaque"), so
# the native side is pinned as "does not raise, returns a string".
pv_native is eval of "pv1 is 1\npv1 is 2\nreport of pv1"
check of ["native: report of bound ident returns a label", type of pv_native, "str"]
check of ["meta: report of bound ident (bridge fallback)", eigen_run of "pv2 is 1\npv2 is 2\nreport of pv2", "equilibrium"]
check of ["meta: report_value of bound ident (bridge fallback)", eigen_run of "pv3 is 1\npv3 is 2\nreport_value of pv3", "equilibrium"]
check of ["meta: parenthesised identifier operand", eigen_run of "pv4 is 1\nreport of (pv4)", "equilibrium"]
check of ["meta: report_value of ((x))", eigen_run of "pv5 is 1\nreport_value of ((pv5))", "equilibrium"]
check of ["meta: `of` binds the identifier only (report of x + \"!\")", eigen_run of "pv6 is 1\nreport of pv6 + \"!\"", "equilibrium!"]
check of ["native: `of` binds the identifier only", ends_with of [eval of "pv7 is 1\nreport of pv7 + \"!\"", "!"], 1]
check of ["meta: host function operand is opaque", eigen_run of "report of print", "opaque"]
check of ["meta: dict fields named report/report_value stay data keys", eigen_run of "rdk is {\"report\": 7, \"report_value\": 8}\nrdk.report is 9\nrdk.report + rdk.report_value", 17]
check of ["native: dict fields named report/report_value stay data keys", eval of "rdn is {\"report\": 7, \"report_value\": 8}\nrdn.report is 9\nrdn.report + rdn.report_value", 17]

# --- #1105: a fresh `for` binder is loop-scoped in a function too (both raise) ---
define meta_probe(src) as:
    try:
        return ["ok", eigen_run of src]
    catch pe:
        return ["err"]
check of ["fresh function binder: meta raises after the loop",
    meta_probe of "define probe() as:\n    for z in [7, 8]:\n        0\n    return z\nprobe of []",
    ["err"]]
check of ["fresh module binder: meta raises after the loop",
    meta_probe of "for m in [7, 8]:\n    0\nm",
    ["err"]]
check of ["parameter binder: restored after the loop",
    meta_probe of "define f(p) as:\n    for p in [7, 8]:\n        p is p + 10\n    return p\nf of 1",
    ["ok", 1]]
check of ["fresh binder over a module name: module value after the loop",
    meta_probe of "x is 5\ndefine g() as:\n    for x in [7, 8]:\n        0\n    return x\ng of []",
    ["ok", 5]]
check of ["post-loop write is a fresh binding",
    meta_probe of "define h() as:\n    for z in [7, 8]:\n        0\n    z is 5\n    return z\nh of []",
    ["ok", 5]]
# The C VM answers the same five programs (the oracle side of the parity).
define vm_probe(src) as:
    try:
        return ["ok", eval of src]
    catch ve:
        return ["err"]
check of ["VM: fresh function binder raises",
    vm_probe of "define probe1105() as:\n    for z in [7, 8]:\n        0\n    return z\nprobe1105 of []",
    ["err"]]
check of ["VM: parameter binder restored",
    vm_probe of "define f1105(p) as:\n    for p in [7, 8]:\n        p is p + 10\n    return p\nf1105 of 1",
    ["ok", 1]]

if checks == passed:
    print of "All tests passed"
else:
    print of f"{passed}/{checks} passed"
