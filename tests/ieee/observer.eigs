# #1746 Phase 1 (ieee build only): the observer with real IEEE edges.
#
# Graded against mathematics, not against the old spec:
#   - a constant sequence converges (Cauchy), whatever its magnitude, so a
#     literal 1e308 held constant is `converged` (the #861 magnitude rule read
#     it `diverging`; that rule is removed in this build);
#   - x <- x * 1e20 is unbounded: it reaches inf, and inf is `diverging`;
#   - NaN is in no band: all six predicates false, `report` says "moving"
#     (the rule chosen and documented for this experiment);
#   - entropy (`where`) never becomes NaN itself;
#   - a trajectory that passed through a non-finite value restarts, so a
#     binding that recovers to a held constant converges again.
#
# Output: `CHECKS <n>` then exactly n lines `CHECK <name> ok|FAIL <detail>`.

# Predicates are read on the binding itself (a parameter would be a fresh
# binding with no trajectory), hence the repeated list in each runner.
define run_const_1e308() as:
    local c is 1e308
    local k is 0
    loop while k < 12:
        c is 1e308
        k is k + 1
    return [report of c, converged of c, diverging of c, stable of c,
            equilibrium of c, improving of c, oscillating of c]

define run_const_5() as:
    local c is 5
    local k is 0
    loop while k < 12:
        c is 5
        k is k + 1
    return [report of c, converged of c, diverging of c, stable of c,
            equilibrium of c, improving of c, oscillating of c]

define run_runaway() as:
    local x is 1.0
    local k is 0
    loop while k < 30:
        x is x * 1e20
        k is k + 1
    local p is [report of x, converged of x, diverging of x, stable of x,
            equilibrium of x, improving of x, oscillating of x]
    append of [p, x]
    append of [p, where is x]
    return p

define run_runaway_neg() as:
    local x is -1.0
    local k is 0
    loop while k < 30:
        x is x * 1e20
        k is k + 1
    local p is [report of x, converged of x, diverging of x, stable of x,
            equilibrium of x, improving of x, oscillating of x]
    append of [p, x]
    return p

define run_nan() as:
    local x is 1.0
    local k is 0
    loop while k < 12:
        x is x * 0.5
        k is k + 1
    x is 0 / 0
    x is 0 / 0
    local p is [report of x, converged of x, diverging of x, stable of x,
            equilibrium of x, improving of x, oscillating of x]
    append of [p, where is x]
    append of [p, x]
    return p

define run_recover() as:
    local x is 1.0
    local k is 0
    loop while k < 30:
        x is x * 1e20
        k is k + 1
    k is 0
    loop while k < 12:
        x is 5
        k is k + 1
    return [report of x, converged of x, diverging of x, stable of x,
            equilibrium of x, improving of x, oscillating of x]

results is []
define check(name, cond, detail) as:
    verdict is "FAIL"
    if cond:
        verdict is "ok"
    append of [results, f"CHECK {name} {verdict} {detail}"]
    return 0

c8 is run_const_1e308 of null
check of ["const_1e308_report", c8[0] == "converged", c8[0]]
check of ["const_1e308_converged", c8[1] == true, str of c8[1]]
check of ["const_1e308_not_diverging", c8[2] == false, str of c8[2]]

c5 is run_const_5 of null
check of ["const_5_converged", (c5[0] == "converged") and (c5[1] == true), c5[0]]

r is run_runaway of null
check of ["runaway_value_inf", (str of r[7]) == "inf", str of r[7]]
check of ["runaway_report", r[0] == "diverging", r[0]]
check of ["runaway_diverging", r[2] == true, str of r[2]]
rest is r[1] or r[3] or r[4] or r[5] or r[6]
check of ["runaway_no_other_band", rest == false, str of rest]
check of ["runaway_entropy_finite", r[8] == r[8], str of r[8]]

rn is run_runaway_neg of null
check of ["runaway_neg_value", (str of rn[7]) == "-inf", str of rn[7]]
check of ["runaway_neg_diverging", (rn[0] == "diverging") and (rn[2] == true), rn[0]]

nn is run_nan of null
anyp is nn[1] or nn[2] or nn[3] or nn[4] or nn[5] or nn[6]
check of ["nan_all_false", anyp == false, str of anyp]
check of ["nan_report_moving", nn[0] == "moving", nn[0]]
check of ["nan_entropy_finite", nn[7] == nn[7], str of nn[7]]
check of ["nan_value_prints", (str of nn[8]) == "nan", str of nn[8]]

rc is run_recover of null
check of ["recover_converged", (rc[0] == "converged") and (rc[1] == true), rc[0]]

print of f"CHECKS {len of results}"
for line in results:
    print of line
