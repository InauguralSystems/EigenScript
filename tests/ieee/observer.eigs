# #1746 Phase 1 (ieee build only): the observer on the extended real line,
# graded against mathematics (Rudin, Principles of Mathematical Analysis;
# IEEE 754-2019), not against the old spec. Each check cites its definition.
#
#   converged   Def. 3.1/3.11: a sequence of REALS whose terms settle; a
#               constant converges at any magnitude (1e308 included). Every
#               term in the window must be defined (no NaN), and a full window
#               of defined terms must follow the last NaN.
#   diverging   Def. 3.15: tends to +inf (lim inf = +inf) or -inf (lim sup =
#               -inf): growth to inf, inf held, -inf held. 1 <-> inf has
#               lim inf 1 and inf <-> -inf has lim inf -inf: NOT diverging.
#   oscillating Def. 3.16-3.17: lim inf != lim sup (1 <-> inf, inf <-> -inf).
#   NaN         IEEE 754-2019 sec. 7.2 (invalid operation: undefined). While
#               the current value is NaN all six predicates are false and
#               `report` is "undefined"; NaN never enters a ring.
#   Ring steps involving +-inf are finite (held 0; finite<->inf rel +-1, raw
#   +-max(|finite|,1e-3); inf<->-inf rel +-2, raw +-2e-3; a finite step that
#   overflows: rel -2, raw -DBL_MAX). Entropy (`where`) and dH (`why`) stay
#   finite.
#
# Each case runs observed AND, where marked, inside `unobserved:` (the JIT's
# value sampler). tools/ieee_rows.sh runs this under EIGS_JIT_OFF=1, the
# default JIT and EIGS_JIT_OSR_THRESHOLD=1 and requires identical output.
#
# Output: `CHECKS <n>` then exactly n lines `CHECK <name> ok|FAIL <detail>`.

inf is 1e308 * 10
q is 0 / 0

# Every ring entry is a finite number (NaN != NaN; inf - inf is NaN).
define all_finite(xs) as:
    for v in xs:
        if v != v:
            return false
        if (v - v) != 0:
            return false
    return true

# [report, converged, diverging, stable, equilibrium, improving, oscillating,
#  rel, raw, where, why] -- read on the binding itself.
define const_1e308() as:
    local x is 1e308
    for k in range of 12:
        x is 1e308
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, where is x, why is x]

define growth_to_inf(u) as:
    local x is 1.0
    for j in range of 30:
        x is x * 1e20
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, where is x, why is x]

# The unobserved: twins are straight-line `loop while` bodies run past the
# default OSR threshold (5000), the shape that reaches the JIT's value sampler.
# They read no `where`/`why`: an interrogative in the function takes its
# observe ops off the sampler path (measured), so those slots hold 0.
define growth_to_inf_unobs(u) as:
    local x is 1.0
    local k is 0
    unobserved:
        loop while k < 20000:
            x is x * 1e20
            k is k + 1
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, 0, 0]

define const_inf() as:
    local x is inf
    for k in range of 12:
        x is inf
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, where is x, why is x]

define alt_one_inf(u, end_at_inf) as:
    local x is 1.0
    for k in range of 40:
        x is inf
        x is 1.0
    if end_at_inf:
        x is inf
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, where is x, why is x]

define alt_one_inf_unobs(u, end_at_inf) as:
    local x is 1.0
    local k is 0
    unobserved:
        loop while k < 20000:
            x is inf
            x is 1.0
            k is k + 1
    if end_at_inf:
        x is inf
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, 0, 0]

define inf_then_const() as:
    local x is inf
    for k in range of 12:
        x is 5
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, where is x, why is x]

define nan_current() as:
    local x is 1.0
    for k in range of 12:
        x is x * 0.5
    x is q
    x is q
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, where is x, why is x]

define nan_interleaved(u) as:
    local x is 1.0
    for k in range of 40:
        x is 1.0 + k
    for k in range of 20:
        x is q
        x is 5
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, where is x, why is x]

define nan_interleaved_unobs(u) as:
    local x is 1.0
    local k is 0
    loop while k < 40:
        x is 1.0 + k
        k is k + 1
    k is 0
    unobserved:
        loop while k < 20000:
            x is q
            x is 5
            k is k + 1
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, 0, 0]

define alt_inf_ninf() as:
    local x is inf
    for k in range of 40:
        x is -inf
        x is inf
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, where is x, why is x]

define const_ninf() as:
    local x is 0
    for k in range of 12:
        x is -inf
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, where is x, why is x]

define nan_then_held() as:
    local x is 1.0
    x is q
    for k in range of 12:
        x is 5
    local t is trajectory of x
    return [report of x, converged of x, diverging of x, stable of x, equilibrium of x, improving of x, oscillating of x, t.rel, t.raw, where is x, why is x]

# Def. 3.1 at the window boundary: 5, 5, NaN, then k fives. A window of 10
# steps spans 11 terms, so at k=10 the NaN is still one of them (not
# converged); at k=11 every term is defined (converged).
define nan_boundary(k) as:
    local x is 5
    x is 5
    x is q
    for j in range of k:
        x is 5
    return [report of x, converged of x]

define step_table() as:
    local x is 1.0
    x is inf
    x is 1.0
    x is inf
    x is -inf
    x is -inf
    x is 1e308
    x is -1e308
    local t is trajectory of x
    return [t.rel, t.raw]

results is []
define check(name, cond, detail) as:
    verdict is "FAIL"
    if cond:
        verdict is "ok"
    append of [results, f"CHECK {name} {verdict} {detail}"]
    return 0

define none_of(p) as:
    return not (p[1] or p[2] or p[3] or p[4] or p[5] or p[6])

define finite_obs(p) as:
    return (all_finite of p[7]) and (all_finite of p[8]) and (all_finite of ([p[9], p[10]]))

# Def. 3.1: a constant sequence converges, whatever its magnitude.
c8 is const_1e308 of null
check of ["const_1e308_converged", (c8[0] == "converged") and c8[1] and (not c8[2]), c8[0]]

# Def. 3.15: growth to +inf tends to +inf.
for u in [false, true]:
    g is growth_to_inf of u
    if u:
        g is growth_to_inf_unobs of u
    check of [f"growth_to_inf_diverging_u{u}", (g[0] == "diverging") and g[2], g[0]]
    check of [f"growth_to_inf_finite_u{u}", finite_obs of g, str of [g[7], g[8]]]

# Def. 3.15: +inf held tends to +inf; no rest band (Def. 3.1 is about reals).
ci is const_inf of null
check of ["const_inf_diverging", (ci[0] == "diverging") and ci[2] and (not ci[1]) and (not ci[3]) and (not ci[4]), ci[0]]
check of ["const_inf_finite", finite_obs of ci, str of [ci[7], ci[8]]]

# Def. 3.15: -inf held tends to -inf.
cn is const_ninf of null
check of ["const_ninf_diverging", (cn[0] == "diverging") and cn[2], cn[0]]

# Def. 3.16-3.17: 1 <-> inf has lim inf 1 != lim sup inf -> oscillating, read
# at either end; Def. 3.15: lim inf = 1, so NOT diverging.
for u in [false, true]:
    a1 is alt_one_inf of [u, false]
    if u:
        a1 is alt_one_inf_unobs of [u, false]
    check of [f"alt_1_inf_at_1_oscillating_u{u}", (a1[0] == "oscillating") and a1[6] and (not a1[2]), a1[0]]
    check of [f"alt_1_inf_finite_u{u}", finite_obs of a1, str of [a1[7], a1[8]]]
    ai is alt_one_inf of [u, true]
    if u:
        ai is alt_one_inf_unobs of [u, true]
    check of [f"alt_1_inf_at_inf_oscillating_not_diverging_u{u}", (ai[0] == "oscillating") and ai[6] and (not ai[2]), str of [ai[0], ai[2], ai[6]]]

# Def. 3.16-3.17 / 3.15: inf <-> -inf oscillates and does not diverge.
an is alt_inf_ninf of null
check of ["alt_inf_ninf_oscillating_not_diverging", (an[0] == "oscillating") and an[6] and (not an[2]), str of [an[0], an[2], an[6]]]
check of ["alt_inf_ninf_finite", finite_obs of an, str of [an[7], an[8]]]

# Def. 3.1: after inf, a held real converges once a full window follows.
ic is inf_then_const of null
check of ["inf_then_const_converged", (ic[0] == "converged") and ic[1], ic[0]]

# IEEE 754 sec. 7.2: a current NaN is undefined -- every predicate false.
nc is nan_current of null
check of ["nan_current_undefined", nc[0] == "undefined", nc[0]]
check of ["nan_current_all_false", none_of of nc, str of nc]
check of ["nan_current_finite", finite_obs of nc, str of [nc[7], nc[8], nc[9], nc[10]]]

# Def. 3.1 (sequences of reals): 5, NaN, 5, NaN... has undefined terms in every
# window, so no rest band (converged/stable/equilibrium/improving) may hold.
for u in [false, true]:
    ni is nan_interleaved of u
    if u:
        ni is nan_interleaved_unobs of u
    rest is ni[1] or ni[3] or ni[4] or ni[5]
    check of [f"nan_interleaved_no_rest_band_u{u}", (ni[0] != "converged") and (rest == false), str of [ni[0], ni[1], ni[3], ni[4], ni[5]]]
    check of [f"nan_interleaved_finite_u{u}", finite_obs of ni, str of [ni[7], ni[8]]]

# Def. 3.1: a NaN followed by a full window of a held real converges again.
nh is nan_then_held of null
check of ["nan_then_full_window_converged", (nh[0] == "converged") and nh[1], nh[0]]

b10 is nan_boundary of 10
check of ["nan_boundary_k10_not_converged", (b10[1] == false) and (b10[0] != "converged"), str of b10]
b11 is nan_boundary of 11
check of ["nan_boundary_k11_converged", (b11[1] == true) and (b11[0] == "converged"), str of b11]

st is step_table of null
check of ["step_rel", (str of st[0]) == "[1, -1, 1, -2, 0, 1, -2]", str of st[0]]
check of ["step_raw", (str of st[1]) == "[1, -1, 1, -0.002, 0, 1e+308, -1.7976931348623157e+308]", str of st[1]]

print of f"CHECKS {len of results}"
for line in results:
    print of line
