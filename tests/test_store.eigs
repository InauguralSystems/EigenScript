load_file of "lib/test.eigs"

# Clean up any leftover test database
if file_exists of "/tmp/test_eigenstore.db":
    rm of "/tmp/test_eigenstore.db"

# Open creates file
db is store_open of "/tmp/test_eigenstore.db"
assert of [db != null, "store_open returns handle"]
assert of [file_exists of "/tmp/test_eigenstore.db", "db file created"]

# Collections starts empty
cols is store_collections of db
assert_eq of [len of cols, 0, "no collections initially"]

# Put
k1 is store_put of [db, "users", {"name": "Alice", "age": 30}]
assert of [k1 != null, "put returns key"]

k2 is store_put of [db, "users", {"name": "Bob", "age": 25}]

# Collections
cols is store_collections of db
assert_eq of [len of cols, 1, "one collection"]

# Count
c is store_count of [db, "users"]
assert_eq of [c, 2, "two records"]

# Get
r is store_get of [db, "users", k1]
assert of [r != null, "get returns record"]
assert_eq of [r.name, "Alice", "get returns correct record"]

# Query all
all is store_query of [db, "users"]
assert_eq of [len of all, 2, "query returns all"]

# Update
store_update of [db, "users", k1, {"name": "Alice", "age": 31}]
r2 is store_get of [db, "users", k1]
assert_eq of [r2.age, 31, "update works"]

# Delete
d is store_delete of [db, "users", k2]
assert_eq of [d, 1, "delete returns 1"]
c2 is store_count of [db, "users"]
assert_eq of [c2, 1, "count after delete"]

# Custom key
store_put of [db, "config", {"_id": "theme", "value": "dark"}]
cfg is store_get of [db, "config", "theme"]
assert_eq of [cfg.value, "dark", "custom key works"]

# Persistence — close and reopen
store_close of db
db2 is store_open of "/tmp/test_eigenstore.db"
r3 is store_get of [db2, "users", k1]
assert_eq of [r3.name, "Alice", "persists after close/reopen"]
c3 is store_count of [db2, "users"]
assert_eq of [c3, 1, "count persists"]
cfg2 is store_get of [db2, "config", "theme"]
assert_eq of [cfg2.value, "dark", "config persists"]

# Drop collection
store_drop of [db2, "config"]
cols2 is store_collections of db2
assert_eq of [len of cols2, 1, "drop removes collection"]

# Multiple collections
store_put of [db2, "logs", {"msg": "test"}]
cols3 is store_collections of db2
assert_eq of [len of cols3, 2, "multiple collections"]

# List-valued fields — exercises store_json_encode's VAL_LIST branch on
# write and store_json_parse_array on read-back. No prior test stored a
# record containing a list, so the array parser was at 0%.
lk is store_put of [db2, "items", {"name": "Carol", "tags": ["red", "green", "blue"], "scores": [10, 20, 30], "empty": []}]
li is store_get of [db2, "items", lk]
assert_eq of [type of li.tags, "list", "list field decodes as list"]
assert_eq of [len of li.tags, 3, "list field length"]
assert_eq of [li.tags[0], "red", "list string element"]
assert_eq of [li.tags[2], "blue", "list last element"]
assert_eq of [li.scores[1], 20, "numeric list element"]
assert_eq of [len of li.empty, 0, "empty list field round-trips"]

# Buffer-valued fields — #805. store_json_encode wrote VAL_BUFFER as JSON
# `null`, so a stored buffer came back as null and the bytes were silently
# gone. The tagged encoding restores both the type and the exact contents.
# The interesting bytes are a zero byte and bytes that are not valid UTF-8
# (0xFF/0xFE): those are exactly where a naive string encoding breaks.
bz is buffer of 5
bz[0] is 0
bz[1] is 65
bz[2] is 0
bz[3] is 255
bz[4] is 254
bk is store_put of [db2, "blobs", {"name": "raw", "bytes": bz}]
bi is store_get of [db2, "blobs", bk]
assert_eq of [type of bi.bytes, "buffer", "buffer field decodes as a buffer"]
assert_eq of [len of bi.bytes, 5, "buffer field length"]
assert_eq of [bi.bytes[0], 0, "buffer keeps a leading zero byte"]
assert_eq of [bi.bytes[1], 65, "buffer keeps an ASCII byte"]
assert_eq of [bi.bytes[2], 0, "buffer keeps an interior zero byte"]
assert_eq of [bi.bytes[3], 255, "buffer keeps 0xFF (invalid UTF-8)"]
assert_eq of [bi.bytes[4], 254, "buffer keeps 0xFE (invalid UTF-8)"]
assert_eq of [bi.name, "raw", "sibling field survives next to a buffer"]

# Non-integral elements round-trip bit-exactly (the element encoder uses the
# 17-significant-digit form, as trace.c's buffer tape encoding does).
fb is buffer of 2
fb[0] is 0.1
fb[1] is 0 - 2.5
fk is store_put of [db2, "blobs", {"f": fb}]
fi is store_get of [db2, "blobs", fk]
assert_eq of [fi.f[0], 0.1, "fractional buffer element is exact"]
assert_eq of [fi.f[1], 0 - 2.5, "negative buffer element is exact"]

# A non-finite element survives too. It is reachable — the flat-buffer matmul
# kernel accumulates without num_guard, so a large enough product overflows to
# +Inf — and `inf` is not a JSON literal, so encoding it bare would cost the
# whole RECORD, not just the buffer. It rides as a sentinel string instead.
nb is buffer of 4
nb[0] is 1e300
nb[1] is 1e300
nb[2] is 1e300
nb[3] is 1e300
nm is reshape of [nb, 2, 2]
np is matmul of [nm, nm]
assert_true of [np[0] > 1e308, "matmul overflow really is non-finite"]
nk is store_put of [db2, "blobs", {"n": np}]
ni is store_get of [db2, "blobs", nk]
assert_eq of [type of ni.n, "buffer", "non-finite buffer still decodes as a buffer"]
assert_eq of [ni.n[0], np[0], "non-finite buffer element round-trips"]

# An empty buffer stays an empty buffer, not a null and not an empty list.
eb is buffer of 0
ek is store_put of [db2, "blobs", {"e": eb}]
ei is store_get of [db2, "blobs", ek]
assert_eq of [type of ei.e, "buffer", "empty buffer decodes as a buffer"]
assert_eq of [len of ei.e, 0, "empty buffer length"]

# The degenerate shapes `buffer of` accepts — [0, n] (rows 0, cols kept, no
# elements) and [n, 0] — are still buffers on the way back. The decoder's
# shape check has to accept every triple the constructors can build, or it
# quietly hands back a dict.
zb is buffer of [0, 5]
wb is buffer of [3, 0]
zk is store_put of [db2, "blobs", {"z": zb, "w": wb}]
zi is store_get of [db2, "blobs", zk]
assert_eq of [type of zi.z, "buffer", "buffer of [0, n] decodes as a buffer"]
assert_eq of [type of zi.w, "buffer", "buffer of [n, 0] decodes as a buffer"]

# A 2-D shaped buffer keeps its shape (rows/cols are part of the value —
# `shape of` reads them back, so dropping them is data loss too).
gb is buffer of 4
gb[0] is 1
gb[1] is 2
gb[2] is 3
gb[3] is 4
gs is reshape of [gb, 2, 2]
gk is store_put of [db2, "blobs", {"m": gs}]
gi is store_get of [db2, "blobs", gk]
assert_eq of [type of gi.m, "buffer", "shaped buffer decodes as a buffer"]
assert_eq of [len of (shape of gi.m), 2, "shaped buffer stays 2-D"]
assert_eq of [(shape of gi.m)[0], 2, "shaped buffer rows"]
assert_eq of [(shape of gi.m)[1], 2, "shaped buffer cols"]
assert_eq of [gi.m[3], 4, "shaped buffer contents"]
assert_eq of [len of (shape of bi.bytes), 1, "unshaped buffer stays 1-D"]

# The buffer tag must not swallow ordinary values: a plain dict field and a
# plain list field still decode as dict and list.
dk is store_put of [db2, "blobs", {"d": {"a": 1}, "l": [1, 2]}]
di is store_get of [db2, "blobs", dk]
assert_eq of [type of di.d, "dict", "an ordinary dict field is still a dict"]
assert_eq of [di.d.a, 1, "ordinary dict field contents"]
assert_eq of [type of di.l, "list", "an ordinary list field is still a list"]

# Nested list survives a close/reopen too (parsed from disk, not cache).
store_close of db2
db3 is store_open of "/tmp/test_eigenstore.db"
li2 is store_get of [db3, "items", lk]
assert_eq of [len of li2.tags, 3, "list field persists across reopen"]
assert_eq of [li2.scores[2], 30, "numeric list persists"]
bi2 is store_get of [db3, "blobs", bk]
assert_eq of [type of bi2.bytes, "buffer", "buffer field persists as a buffer"]
assert_eq of [bi2.bytes[0], 0, "buffer zero byte persists"]
assert_eq of [bi2.bytes[3], 255, "buffer 0xFF persists"]
gi2 is store_get of [db3, "blobs", gk]
assert_eq of [(shape of gi2.m)[1], 2, "buffer shape persists"]
store_close of db3

# --- Corruption recovery: store_open rejects invalid files cleanly ---
# Each malformed file drives a different store_read_header reject branch;
# all must return null (and the runtime error is catchable, not a crash).
define open_status(path) as:
    status is "opened"
    try:
        h is store_open of path
        if h == null:
            status is "null"
    catch e:
        status is "caught"
    return status

# Too short to hold a 64-byte header → fread fails.
write_text of ["/tmp/eigs_store_short.db", "tiny"]
assert of [(open_status of "/tmp/eigs_store_short.db") != "opened", "short file rejected"]

# Right size, wrong magic (not 'EIGS').
write_text of ["/tmp/eigs_store_badmagic.db", "NOTMAGIC_padded_out_to_more_than_sixty_four_bytes_xxxxxxxxxxxxxxxxxx"]
assert of [(open_status of "/tmp/eigs_store_badmagic.db") != "opened", "bad magic rejected"]

# Valid 'EIGS' magic but garbage version field.
write_text of ["/tmp/eigs_store_badver.db", "EIGSwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww"]
assert of [(open_status of "/tmp/eigs_store_badver.db") != "opened", "bad version rejected"]

rm of "/tmp/eigs_store_short.db"
rm of "/tmp/eigs_store_badmagic.db"
rm of "/tmp/eigs_store_badver.db"

# #816: number encoding at and beyond int's range. The old guard ran the
# double->int cast BEFORE the magnitude check (UB past int's range; the
# fixed order checks first). These pin the output at the boundary — int
# path below 2^31, %.15g at and above it, huge magnitudes intact.
bdb is store_open of "/tmp/eigs816_bounds.db"
bk is store_put of [bdb, "nums", {"imax": 2147483647, "past": 2147483648, "imin": 0 - 2147483648, "huge": 1e300, "nhuge": 0 - 1e300}]
bn is store_get of [bdb, "nums", bk]
assert_eq of [bn.imax, 2147483647, "INT_MAX round-trips (#816)"]
assert_eq of [bn.past, 2147483648, "2^31 (past int) round-trips (#816)"]
assert_eq of [bn.imin, 0 - 2147483648, "int min boundary round-trips (#816)"]
assert_eq of [bn.huge, 1e300, "1e300 round-trips, cast never runs (#816)"]
assert_eq of [bn.nhuge, 0 - 1e300, "-1e300 round-trips (#816)"]
store_close of bdb
rm of "/tmp/eigs816_bounds.db"

# --- #1006: a REJECTED update must not destroy the record it was updating ---
# store_update is delete-then-put, and store_put has real failure returns
# ("record exceeds page size" is the one reachable from EigenScript). Before
# the fix the delete had already happened when the put was rejected, so the
# row was gone and a later store_get simply found nothing.
#
# The bar is byte-exactness, not merely "the row is readable": the whole .db
# file must be unchanged, because the tombstone is undone in place and the
# JSON body is never touched.
if file_exists of "/tmp/eigs1006_update.db":
    rm of "/tmp/eigs1006_update.db"
udb is store_open of "/tmp/eigs1006_update.db"
# Neighbours on both sides, plus a 1-char key: the tombstone overwrites the
# 4 bytes after key_len, which for a short key runs into json_len as well, so
# the restore has to rebuild both fields, not just the key.
store_put of [udb, "docs", {"_id": "a", "body": "neighbour-before"}]
store_put of [udb, "docs", {"_id": "doc1", "body": "original", "n": 42}]
store_put of [udb, "docs", {"_id": "zzz", "body": "neighbour-after"}]
store_close of udb

# A position-weighted checksum over the raw file: any byte that moves, changes
# or disappears shifts it. (sha256 takes a string; the .db holds NULs.)
# `read_bytes` answers a LIST, not a buffer — an earlier draft of this
# fingerprint reached for buf_len/buf_get, which answer 0 for a list without
# complaining, so every file fingerprinted to 0 and the byte-identity
# assertion below compared 0 to 0.
define db_fingerprint(path) as:
    b is read_bytes of path
    n is len of b
    acc is n
    for i in range of n:
        acc is (acc * 31 + b[i] + i) % 1000000007
    return acc

# The fingerprint is worth nothing unless it can fail, so prove it can before
# relying on it: a non-zero reading, and one changed byte moving it.
write_text of ["/tmp/eigs1006_fp_a", "abc"]
write_text of ["/tmp/eigs1006_fp_b", "abd"]
write_text of ["/tmp/eigs1006_fp_c", "abcc"]
assert of [(db_fingerprint of "/tmp/eigs1006_fp_a") != 0, "#1006: db_fingerprint reads a non-empty file as non-zero"]
assert of [(db_fingerprint of "/tmp/eigs1006_fp_a") != (db_fingerprint of "/tmp/eigs1006_fp_b"), "#1006: db_fingerprint sees one changed byte"]
assert of [(db_fingerprint of "/tmp/eigs1006_fp_a") != (db_fingerprint of "/tmp/eigs1006_fp_c"), "#1006: db_fingerprint sees an appended byte"]
rm of "/tmp/eigs1006_fp_a"
rm of "/tmp/eigs1006_fp_b"
rm of "/tmp/eigs1006_fp_c"

before_bytes is db_fingerprint of "/tmp/eigs1006_update.db"

udb is store_open of "/tmp/eigs1006_update.db"
# 4200 bytes of payload — past STORE_PAGE_DATA_SIZE (4089), so store_put
# rejects it with a `limit` error.
oversized is ""
for i in range of 420:
    oversized is oversized + "xxxxxxxxxx"

u_kind is "none"
try:
    store_update of [udb, "docs", "doc1", {"body": oversized}]
catch e:
    u_kind is e.kind
assert_eq of [u_kind, "limit", "#1006: an oversized update raises, catchably"]

# store_update's RETURN value is only observable when nothing raises, because
# the raise preempts the assignment — `x is store_update of [...]` leaves `x`
# at its previous value on every failing path, so "a rejected update never
# reports 1" is not assertable from EigenScript and an assertion that looks
# like it is true of HEAD too. The 0 that IS observable is the locate miss,
# which the refactor rewrote, so pin that instead.
assert_eq of [store_update of [udb, "docs", "no-such-key", {"body": "x"}], 0, "#1006: updating an absent key reports 0 and raises nothing"]
assert_eq of [store_count of [udb, "docs"], 3, "#1006: an absent-key update inserts nothing"]

# The record and both neighbours are exactly as they were.
u_after is store_get of [udb, "docs", "doc1"]
assert of [u_after != null, "#1006: the record survives a rejected update"]
assert_eq of [u_after.body, "original", "#1006: its body is unchanged"]
assert_eq of [u_after.n, 42, "#1006: its other fields are unchanged"]
assert_eq of [(store_get of [udb, "docs", "a"]).body, "neighbour-before", "#1006: short-key neighbour intact"]
assert_eq of [(store_get of [udb, "docs", "zzz"]).body, "neighbour-after", "#1006: trailing neighbour intact"]
assert_eq of [store_count of [udb, "docs"], 3, "#1006: no row was lost"]

# Same for a 1-char key, where the tombstone's skip field overlaps json_len.
u_kind is "none"
try:
    store_update of [udb, "docs", "a", {"body": oversized}]
catch e:
    u_kind is e.kind
assert_eq of [u_kind, "limit", "#1006: oversized update on a 1-char key raises"]
assert_eq of [(store_get of [udb, "docs", "a"]).body, "neighbour-before", "#1006: 1-char-key record survives"]

# A non-dict record is rejected before anything is removed. The restore path
# would cover it either way, so the assertion that pins the pre-check is the
# error TEXT: rejected upfront it names store_update, and no page is written
# at all; rejected downstream it names store_put and the record has already
# made a round trip through delete-and-restore.
u_kind is "none"
u_msg is ""
try:
    store_update of [udb, "docs", "doc1", "not-a-dict"]
catch e:
    u_kind is e.kind
    u_msg is e.message
assert_eq of [u_kind, "type_mismatch", "#1006: a non-dict record raises a type error"]
assert of [contains of [u_msg, "store_update:"], "#1006: the error names store_update, so nothing was written"]

# ...but only once a record has been FOUND. An absent key answered a silent 0
# before #1006 without ever inspecting the record, and still must: hoisting the
# record check above the locate would raise on an argument shape that used to
# be quiet, with the strict flag off. Nothing else in the suite pins this — a
# build with the check hoisted passes every other assertion in this file.
assert_eq of [store_update of [udb, "docs", "no-such-key", "not-a-dict"], 0, "#1006: an absent key with a non-dict record stays a silent 0"]
assert_eq of [(store_get of [udb, "docs", "doc1"]).body, "original", "#1006: non-dict update leaves the record"]

store_close of udb
after_bytes is db_fingerprint of "/tmp/eigs1006_update.db"
assert_eq of [after_bytes, before_bytes, "#1006: rejected updates leave the file byte-identical"]

# The store is not wedged: a legitimate update still replaces the record.
udb is store_open of "/tmp/eigs1006_update.db"
assert_eq of [store_update of [udb, "docs", "doc1", {"body": "replaced"}], 1, "#1006: a valid update still reports 1"]
assert_eq of [(store_get of [udb, "docs", "doc1"]).body, "replaced", "#1006: a valid update still replaces"]
assert_eq of [store_count of [udb, "docs"], 3, "#1006: a valid update does not duplicate the row"]
store_close of udb
rm of "/tmp/eigs1006_update.db"

# Clean up
rm of "/tmp/test_eigenstore.db"

test_summary of null
