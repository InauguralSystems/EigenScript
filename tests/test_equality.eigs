# Structural equality for == / != (pre-v1 semantics pass).
# Scalars compare by value; lists/dicts compare by structure; mixed types
# never equal; functions/builtins by identity.

assert of [[1, 2, 3] == [1, 2, 3], "list structural eq"]
assert of [(not ([1, 2] == [1, 2, 3])), "list different length"]
assert of [[[1], [2, 3]] == [[1], [2, 3]], "nested list eq"]
assert of [(not ([[1], [2]] == [[1], [9]])), "nested list diff"]

assert of [({"a": 1, "b": 2} == {"b": 2, "a": 1}), "dict order-independent"]
assert of [(not ({"a": 1} == {"a": 2})), "dict different value"]
assert of [(not ({"a": 1} == {"a": 1, "b": 2})), "dict different size"]

assert of [(["x", "y"] == ["x", "y"]), "list of strings eq"]
assert of [(3 == 3.0), "number eq"]
assert of [("hi" == "hi"), "string eq"]
assert of [(not ([1] == 1)), "mixed type never equal"]
assert of [(not ("1" == 1)), "string vs number never equal"]

assert of [([1, 2] != [1, 3]), "list inequality true"]
assert of [(not ([1, 2] != [1, 2])), "list inequality false"]

# match/case relies on the same structural equality
m is "no"
match [1, 2]:
    case [1, 2]:
        m is "yes"
    case _:
        m is "fallthrough"
assert of [m == "yes", "match on list literal"]

print of "All tests passed"
