# #1883: binders inside a module-level unobserved block must read from the
# same storage to which their binding opcode writes.  In particular, catch
# binds by name; module-slot promotion must not redirect its reads to a null
# frame slot.  Every binder that writes by name stays off the slot path, even
# when the block also assigns its name with `is`.
load_file of "lib/test.eigs"

unobserved:  # lint: allow W020 -- storage transparency is the subject
    try:
        catch_only_value is 1 / 0
    catch catch_only:
        assert_eq of [catch_only.kind, "value", "1883 catch-only binding is the error dictionary"]

# Re-enter the catch through a loop, including forced OSR runs of this suite.
repeated_kinds is []
unobserved:  # lint: allow W020 -- storage transparency is the subject
    for catch_iteration in range of 8:
        try:
            repeated_value is catch_iteration / 0
        catch repeated_error:
            append of [repeated_kinds, repeated_error.kind]
assert_eq of [repeated_kinds,
              ["value", "value", "value", "value", "value", "value", "value", "value"],
              "1883 repeated catch bindings stay readable"]

# An outside reference used to prevent promotion and pin the catch binding's
# module visibility.  Since #1737 a catch name is local to its handler, so
# the outside read is an undefined name; the inside read still pins that the
# binder reads the storage its binding opcode wrote.
unobserved:  # lint: allow W020 -- storage transparency is the subject
    try:
        escaping_value is 1 / 0
    catch escaping_error:
        escaping_seen_inside is escaping_error.kind
escaping_after_kind is "none"
try:
    escaping_probe is escaping_error.kind
catch escaping_after:
    escaping_after_kind is escaping_after.kind
assert_eq of [escaping_after_kind, "undefined_name", "1737 catch binding is not visible after its handler"]
assert_eq of [escaping_seen_inside, "value", "1883 escaping catch binding is readable inside too"]

# Binder audit probes.  `for` and list-comprehension variables use name-based
# binding and are deliberately not candidates for module-slot promotion.
unobserved:
    for binder_for in [7]:
        binder_for_seen is binder_for
    binder_comp_seen is [binder_comp for binder_comp in [8]]
assert_eq of [binder_for_seen, 7, "1883 for binder reads its env write"]
assert_eq of [binder_comp_seen, [8], "1883 comprehension binder reads its env write"]

# Destructuring names are promotion candidates, but their stores go through
# emit_assign_for_tos and therefore select the same slot as their reads.
unobserved:
    [binder_left, binder_right] is [9, 10]
    binder_destructure_seen is binder_left + binder_right
assert_eq of [binder_destructure_seen, 19, "1883 destructuring binder uses promoted slots consistently"]

# Named function definitions also bind through OP_SET_NAME_LOCAL.  Their body
# is a nested scope, and their name must remain on the name path at this scope.
unobserved:  # lint: allow W020 -- binder storage is the subject
    define binder_function(binder_function_parameter) as:
        return binder_function_parameter + 2
    binder_function_seen is binder_function of 10
assert_eq of [binder_function_seen, 12, "1883 function-name binder reads its env write"]

# Lambda parameters introduce a nested compiler scope and never reach the
# module collector; this guards that boundary as part of the binder audit.
unobserved:  # lint: allow W020 -- binder boundary is the subject
    binder_lambda_seen is ((binder_parameter) => binder_parameter + 1) of 10
assert_eq of [binder_lambda_seen, 11, "1883 lambda parameter stays in its nested scope"]

# Review finding 1: the module-name prepass keeps a defined function's name
# and a catch binder; only slot promotion leaves them out.  A function that
# assigns such a name updates the module binding instead of making a local.
define module_fn_target() as:
    return 1
define module_fn_retarget() as:
    module_fn_target is 42
    return 0
module_fn_status is module_fn_retarget of []
assert_eq of [module_fn_target, 42, "1883 a function's write reaches a module function name"]

# The same, with the definition inside an unobserved block.
unobserved:
    define module_fn_target_in_block() as:
        return 1
define module_fn_retarget_in_block() as:
    module_fn_target_in_block is 42
    return 0
module_fn_status_in_block is module_fn_retarget_in_block of []
assert_eq of [module_fn_target_in_block, 42, "1883 a function's write reaches a module function name defined in an unobserved block"]

# A module-level catch binder is a module name too.
try:
    module_catch_value is 1 / 0
catch module_catch_target:
    module_catch_kind is module_catch_target.kind
define module_catch_retarget() as:
    module_catch_target is 42
    return 0
module_catch_status is module_catch_retarget of []
assert_eq of [module_catch_target, 42, "1883 a function's write reaches a module catch binder"]

# The same, with the catch inside an unobserved block.
unobserved:
    try:
        module_catch_value_in_block is 1 / 0
    catch module_catch_target_in_block:
        module_catch_kind_in_block is module_catch_target_in_block.kind
define module_catch_retarget_in_block() as:
    module_catch_target_in_block is 42
    return 0
module_catch_status_in_block is module_catch_retarget_in_block of []
assert_eq of [module_catch_target_in_block, 42, "1883 a function's write reaches a module catch binder bound in an unobserved block"]

# Review finding 2: a catch body that assigns its own binder leaves it bound by
# name, so the block must not promote it.  From here on each tested name is
# used only inside its block, which is what makes it a promotion candidate.
unobserved:
    try:
        self_catch_value is 1 / 0
    catch self_catch_error:
        self_catch_error is self_catch_error
        self_catch_seen is self_catch_error
self_catch_kind is "not a dict"
if (type of self_catch_seen) == "dict":
    self_catch_kind is self_catch_seen.kind
assert_eq of [self_catch_kind, "value", "1883 catch e: e is e keeps the error dictionary"]

# The same with `e is e.kind`.  Unfixed, reading e.kind raises; the outer try
# records that instead of ending the file.
kind_catch_seen is "unset"
try:
    unobserved:
        try:
            kind_catch_value is 1 / 0
        catch kind_catch_error:
            kind_catch_error is kind_catch_error.kind
            kind_catch_seen is kind_catch_error
catch kind_catch_raised:
    kind_catch_seen is "raised: " + kind_catch_raised.message
assert_eq of [kind_catch_seen, "value", "1883 catch e: e is e.kind reads the error's kind"]

# The other binders that write by name, found from the OP_SET_NAME_LOCAL
# emitters and the VM's env writes, each also assigned by the block.  A `for`
# binder that its body assigns:
unobserved:
    for_binder_seen is []
    for for_binder_var in [1, 2, 3]:
        append of [for_binder_seen, for_binder_var]
        for_binder_var is 0
assert_eq of [for_binder_seen, [1, 2, 3], "1883 a for binder that its body assigns reads each element"]

# A comprehension binder:
unobserved:
    comp_binder_var is 5
    comp_binder_seen is [comp_binder_var for comp_binder_var in [1, 2, 3]]
assert_eq of [comp_binder_seen, [1, 2, 3], "1883 a comprehension binder that the block assigns reads each element"]

# A defined function's name:
unobserved:
    define defined_binder_fn() as:
        return 1
    defined_binder_seen is type of defined_binder_fn
    defined_binder_fn is 2
assert_eq of [defined_binder_seen, "fn", "1883 a defined function that the block reassigns reads as a function"]

# An imported module's name:
unobserved:
    import math
    import_binder_seen is type of math
    math is 0
assert_eq of [import_binder_seen, "dict", "1883 an imported module name that the block reassigns reads the module"]

# `loop while` publishes __loop_exit__ (compiler); a source binding is E006.
loop_exit_refused is false
try:
    eval of "__loop_exit__ is \"unset\""
catch loop_exit_err:
    loop_exit_refused is true
unobserved:
    loop_exit_counter is 0
    loop while loop_exit_counter < 3:
        loop_exit_counter is loop_exit_counter + 1
    loop_exit_seen is __loop_exit__
assert_true of [loop_exit_refused, "1908 __loop_exit__ binding is refused"]
assert_eq of [loop_exit_seen, "normal", "1883 unobserved still preserves the runtime loop-exit binding"]

# A binder OUTSIDE the block writes the same module binding.  Here a `loop
# while` before the block publishes an absolute, per-loop count.  Reading the
# binding directly still protects escape analysis for the runtime-owned name.
loop_iterations_counter is 0
loop while loop_iterations_counter < 3:
    loop_iterations_counter is loop_iterations_counter + 1
unobserved:
    loop_iterations_seen is __loop_iterations__
loop_iterations_refused is false
try:
    eval of "__loop_iterations__ is -1"
catch loop_iterations_err:
    loop_iterations_refused is true
assert_eq of [loop_iterations_seen, 3, "1883 __loop_iterations__ from a loop before the block reads the loop's count"]
assert_true of [loop_iterations_refused, "1908 __loop_iterations__ binding is refused"]

# A module imported before the block:
import json
unobserved:
    import_outside_seen is type of json
    json is 0
assert_eq of [import_outside_seen, "dict", "1883 a module imported before the block reads the module"]

# A comprehension before the block whose expression never reads its binder:
comp_outside_list is [0 for comp_outside_var in [1, 2, 3]]
unobserved:
    comp_outside_seen is comp_outside_var
    comp_outside_var is 9
assert_eq of [comp_outside_seen, 3, "1883 a comprehension binder bound before the block reads its last element"]

# A slot-eligible `local` in a `for` body binds in the enclosing unobserved
# block's slot. It is not a by-name loop binder (#1995):
unobserved:
    local_for_name is "outer"
    for local_for_iter in [1]:
        local local_for_name is "inner"
    local_for_seen is local_for_name
assert_eq of [local_for_seen, "inner", "1995 a slot-eligible local in a for body stays in its slot"]

# A block inside a module-level `for` body: its own `local` binds in that loop
# env, which every iteration clears.
nested_local_seen is []
for nested_local_iter in [1, 2]:
    unobserved:
        if nested_local_iter == 2:
            try:
                append of [nested_local_seen, nested_local_name]
            catch nested_local_unbound:
                append of [nested_local_seen, nested_local_unbound.kind]
        local nested_local_name is "inner"
assert_eq of [nested_local_seen, ["undefined_name"], "1883 a local in a block inside a for loop is per iteration"]

# #1902: dynamic access by eval sees the same module binding as static code.
unobserved:  # lint: allow W020 -- storage transparency is the subject
    eval_target_1902 is 5
    eval_seen_1902 is eval of "eval_target_1902"
print of eval_seen_1902
assert_eq of [eval_seen_1902, 5, "1902 eval reads an unobserved-block assignment by name"]

# The other caller-scope builtin writes that same binding by name.
unobserved:  # lint: allow W020 -- storage transparency is the subject
    lf_target_1902 is 1
    load_file of "issue_1902_writer.eigs"
    lf_seen_1902 is lf_target_1902
print of lf_seen_1902
assert_eq of [lf_seen_1902, 9, "1902 load_file updates an unobserved-block assignment by name"]

# Reachability boundary: even a statically named user function may reach eval.
define dynamic_reader_1902() as:
    return eval of "boundary_target_1902"
unobserved:  # lint: allow W020 -- storage transparency is the subject
    boundary_target_1902 is 11
    boundary_seen_1902 is dynamic_reader_1902 of []
assert_eq of [boundary_seen_1902, 11, "1902 user-call reachability stays on the name path"]

# Child-position plants for the shared scope walk. Each call dynamically reads
# a name assigned by its block, so skipping that child would wrongly promote
# the name and make the row fail.
unobserved:  # lint: allow W020 -- visitor coverage is the subject
    if_condition_target_1902 is true
    if eval of "if_condition_target_1902":
        if_condition_seen_1902 is if_condition_target_1902
assert_eq of [if_condition_seen_1902, true, "1902 calls in if conditions disable promotion"]

unobserved:  # lint: allow W020 -- visitor coverage is the subject
    loop_condition_target_1902 is 0
    loop while eval of "loop_condition_target_1902 < 1":
        loop_condition_target_1902 is loop_condition_target_1902 + 1
    loop_condition_seen_1902 is loop_condition_target_1902
assert_eq of [loop_condition_seen_1902, 1, "1902 calls in loop conditions disable promotion"]

unobserved:  # lint: allow W020 -- visitor coverage is the subject
    match_pattern_target_1902 is 7
    match 7:
        case eval of "match_pattern_target_1902":
            match_pattern_seen_1902 is match_pattern_target_1902
assert_eq of [match_pattern_seen_1902, 7, "1902 calls in match patterns disable promotion"]

unobserved:  # lint: allow W020 -- visitor coverage is the subject
    interrogate_operand_target_1902 is 8
    interrogate_operand_ignored_1902 is what is (eval of "interrogate_operand_target_1902")
    interrogate_operand_seen_1902 is interrogate_operand_target_1902
assert_eq of [interrogate_operand_seen_1902, 8, "1902 calls in interrogated operands disable promotion"]

# No call means promotion remains available. The first name has no outside
# reference and is therefore still a slot candidate; its value is copied to
# the escaping witness using only static operations.
unobserved:
    promotion_fast_target_1902 is 12
    promotion_fast_seen_1902 is promotion_fast_target_1902 + 1
assert_eq of [promotion_fast_seen_1902, 13, "1902 call-free blocks retain slot promotion"]

test_summary of null
