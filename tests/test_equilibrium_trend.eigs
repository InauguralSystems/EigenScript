# Regression for #1891: numeric equilibrium rejects a full-window raw trend.
# Each case is exercised as a module binding and as a function-local loop.

define want(tag, got, expected) as:
    assert of [got == expected, f"{tag}: expected {expected}, got {got}"]
    print of f"  PASS: {tag}"

define loop_case(tag, values, expected) as:
    local x is values[0]
    for i in range of 10:
        x is values[i + 1]
    want of [tag + " loop", equilibrium of x, expected]

# geometric
a is 1
a is 0.1
a is 0.01
a is 0.001
a is 0.0001
a is 1e-05
a is 1e-06
a is 1e-07
a is 1e-08
a is 1e-09
a is 1e-10
want of ["geometric module", equilibrium of a, false]
loop_case of ["geometric", [1, 0.1, 0.01, 0.001, 0.0001, 1e-05, 1e-06, 1e-07, 1e-08, 1e-09, 1e-10], false]

# harmonic
b is 1.00000001
b is 1.00000000999001
b is 1.00000000998004
b is 1.0000000099700896
b is 1.0000000099601594
b is 1.0000000099502488
b is 1.0000000099403579
b is 1.0000000099304867
b is 1.000000009920635
b is 1.0000000099108028
b is 1.00000000990099
want of ["harmonic module", equilibrium of b, false]
loop_case of ["harmonic", [1.00000001, 1.00000000999001, 1.00000000998004, 1.0000000099700896, 1.0000000099601594, 1.0000000099502488, 1.0000000099403579, 1.0000000099304867, 1.000000009920635, 1.0000000099108028, 1.00000000990099], false]

