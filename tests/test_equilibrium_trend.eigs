loop_case of ["underflow", [1e-160, 9.999999999e-161, 9.999999998e-161, 9.999999997e-161, 9.999999996e-161, 9.999999995e-161, 9.999999994e-161, 9.999999993e-161, 9.999999992e-161, 9.999999991e-161, 9.99999999e-161], false]

